#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENWEATHER_API_KEY=
# STRIPE_SECRET_KEY=
