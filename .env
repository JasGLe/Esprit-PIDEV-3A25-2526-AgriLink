# IMPORTANT: These are default values for MAMP macOS.
# Each developer must override these in their local .env.local file based on their environment.
# See UPLOAD_SETUP.md for detailed configuration instructions for XAMPP, WAMP, MAMP on different OS.
# Default path for uploads (used in MAMP on macOS)
UPLOADS_BASE_DIR="/Applications/MAMP/htdocs/agrilink/uploads"
# Base URL to access uploaded files (override based on your setup)
UPLOADS_BASE_URL="/agrilink/uploads"
