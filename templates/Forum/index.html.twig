{% extends 'layouts/dashboard_layout.html.twig' %}
{% block title %}Forum - AgriLink{% endblock %}
{% block page_title %}Forum{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .forum-yield-panel {
            border-radius: 1.25rem;
            overflow: hidden;
            border: 1px solid #dbe7d8;
            background: linear-gradient(135deg, #f7fbf3 0%, #ffffff 100%);
        }

        .forum-yield-panel__hero {
            padding: 1.5rem;
            background:
                radial-gradient(circle at top right, rgba(34, 197, 94, 0.14), transparent 28%),
                linear-gradient(135deg, #14532d 0%, #166534 100%);
            color: #fff;
        }

        .forum-yield-panel__hero-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.75rem;
            height: 2.75rem;
            border-radius: 0.9rem;
            background: rgba(255, 255, 255, 0.14);
            font-weight: 700;
            font-size: 1.15rem;
        }

        .forum-yield-panel__body {
            padding: 1.5rem;
        }

        .forum-yield-panel__result {
            padding: 1rem 1.1rem;
            border-radius: 1rem;
            background: #ecfdf5;
            border: 1px solid #bbf7d0;
        }

        .forum-yield-panel__result-value {
            font-size: 1.8rem;
            font-weight: 800;
            color: #166534;
            line-height: 1;
        }

        .forum-yield-panel__hint {
            font-size: 0.875rem;
            color: #64748b;
        }

        .forum-reco-panel {
            border-radius: 1.25rem;
            overflow: hidden;
            border: 1px solid #d7e3ef;
            background: linear-gradient(135deg, #f8fbff 0%, #ffffff 100%);
        }

        .forum-reco-panel__hero {
            padding: 1.5rem;
            background:
                radial-gradient(circle at top right, rgba(59, 130, 246, 0.16), transparent 28%),
                linear-gradient(135deg, #1d4ed8 0%, #2563eb 100%);
            color: #fff;
        }

        .forum-reco-panel__hero-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.75rem;
            height: 2.75rem;
            border-radius: 0.9rem;
            background: rgba(255, 255, 255, 0.16);
            font-weight: 700;
            font-size: 1rem;
        }

        .forum-reco-panel__body {
            padding: 1.5rem;
        }

        .forum-reco-panel__result {
            padding: 1rem 1.1rem;
            border-radius: 1rem;
            background: #eff6ff;
            border: 1px solid #bfdbfe;
        }

        .forum-reco-panel__result-value {
            font-size: 1.6rem;
            font-weight: 800;
            color: #1d4ed8;
            line-height: 1.1;
        }

        .forum-profit-panel {
            border-radius: 1.25rem;
            overflow: hidden;
            border: 1px solid #f3d7c3;
            background: linear-gradient(135deg, #fffaf5 0%, #ffffff 100%);
        }

        .forum-profit-panel__hero {
            padding: 1.5rem;
            background:
                radial-gradient(circle at top right, rgba(249, 115, 22, 0.18), transparent 28%),
                linear-gradient(135deg, #c2410c 0%, #ea580c 100%);
            color: #fff;
        }

        .forum-profit-panel__hero-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.75rem;
            height: 2.75rem;
            border-radius: 0.9rem;
            background: rgba(255, 255, 255, 0.16);
            font-weight: 700;
            font-size: 1rem;
        }

        .forum-profit-panel__body {
            padding: 1.5rem;
        }

        .forum-profit-panel__result {
            padding: 1rem 1.1rem;
            border-radius: 1rem;
            background: #fff7ed;
            border: 1px solid #fed7aa;
        }

        .forum-profit-panel__result-value {
            font-size: 1.7rem;
            font-weight: 800;
            color: #c2410c;
            line-height: 1.1;
        }

        .forum-yield-panel .form-control.is-invalid,
        .forum-yield-panel .form-select.is-invalid,
        .forum-reco-panel .form-control.is-invalid,
        .forum-reco-panel .form-select.is-invalid,
        .forum-profit-panel .form-control.is-invalid,
        .forum-profit-panel .form-select.is-invalid {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.15) !important;
            background-image: none !important;
        }

        .forum-yield-panel .invalid-feedback,
        .forum-reco-panel .invalid-feedback,
        .forum-profit-panel .invalid-feedback {
            display: block;
            font-size: 0.875rem;
            font-weight: 600;
            color: #dc3545;
            margin-top: 0.35rem;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function getServerFeedback(field) {
                return field.parentElement.querySelector('.invalid-feedback:not(.js-inline-error)');
            }

            function setFieldError(field, message) {
                field.classList.add('is-invalid');

                let feedback = field.parentElement.querySelector('.js-inline-error');
                if (!feedback) {
                    feedback = document.createElement('div');
                    feedback.className = 'invalid-feedback d-block js-inline-error';
                    field.parentElement.appendChild(feedback);
                }

                feedback.textContent = message;
            }

            function clearFieldError(field) {
                field.classList.remove('is-invalid');
                const feedback = field.parentElement.querySelector('.js-inline-error');
                if (feedback) {
                    feedback.remove();
                }
            }

            function validateField(field, rules) {
                const value = field.value.trim();
                const serverFeedback = getServerFeedback(field);

                if (serverFeedback) {
                    serverFeedback.remove();
                }

                clearFieldError(field);

                if (value === '') {
                    setFieldError(field, rules.requiredMessage);
                    return false;
                }

                if (rules.type === 'number') {
                    const parsed = Number(value);
                    if (!Number.isFinite(parsed)) {
                        setFieldError(field, rules.numericMessage);
                        return false;
                    }

                    if (parsed < 0) {
                        setFieldError(field, rules.minMessage);
                        return false;
                    }
                }

                if (rules.type === 'choice' && rules.choices.indexOf(value) === -1) {
                    setFieldError(field, rules.invalidChoiceMessage);
                    return false;
                }

                return true;
            }

            function formatNumber(value) {
                return Number(value).toFixed(2);
            }

            function openPanel(panelId) {
                const panel = document.getElementById(panelId);
                if (panel) {
                    panel.classList.add('show');
                }
            }

            function setResult(valueSelector, messageSelector, value, message) {
                const valueElement = document.querySelector(valueSelector);
                const messageElement = document.querySelector(messageSelector);

                if (valueElement) {
                    valueElement.textContent = value;
                }

                if (messageElement) {
                    messageElement.textContent = message;
                }
            }

            const configs = [
                {
                    formId: 'forum-yield-form',
                    panelId: 'forumYieldForecastPanel',
                    resultValueSelector: '#yield-result-value',
                    resultMessageSelector: '#yield-result-message',
                    fields: [
                        {
                            selector: '#yield_forecast_surface',
                            type: 'number',
                            requiredMessage: 'Surface est obligatoire.',
                            numericMessage: 'Surface doit etre numerique.',
                            minMessage: 'Surface doit etre superieur ou egal a zero.'
                        },
                        {
                            selector: '#yield_forecast_cropCoefficient',
                            type: 'number',
                            requiredMessage: 'Coefficient culture est obligatoire.',
                            numericMessage: 'Coefficient culture doit etre numerique.',
                            minMessage: 'Coefficient culture doit etre superieur ou egal a zero.'
                        },
                        {
                            selector: '#yield_forecast_weatherCoefficient',
                            type: 'number',
                            requiredMessage: 'Coefficient meteo est obligatoire.',
                            numericMessage: 'Coefficient meteo doit etre numerique.',
                            minMessage: 'Coefficient meteo doit etre superieur ou egal a zero.'
                        }
                    ]
                },
                {
                    formId: 'forum-reco-form',
                    panelId: 'forumCropRecommendationPanel',
                    resultValueSelector: '#reco-result-value',
                    resultMessageSelector: '#reco-result-message',
                    fields: [
                        {
                            selector: '#crop_recommendation_soil',
                            type: 'choice',
                            requiredMessage: 'Le type de sol est obligatoire.',
                            invalidChoiceMessage: 'Le type de sol selectionne est invalide.',
                            choices: ['sableux', 'argileux']
                        },
                        {
                            selector: '#crop_recommendation_season',
                            type: 'choice',
                            requiredMessage: 'La saison est obligatoire.',
                            invalidChoiceMessage: 'La saison selectionnee est invalide.',
                            choices: ['ete', 'hiver']
                        }
                    ]
                },
                {
                    formId: 'forum-profit-form',
                    panelId: 'forumProfitabilityPanel',
                    resultValueSelector: '#profit-result-value',
                    resultMessageSelector: '#profit-result-message',
                    fields: [
                        {
                            selector: '#profitability_revenue',
                            type: 'number',
                            requiredMessage: 'Revenu est obligatoire.',
                            numericMessage: 'Revenu doit etre numerique.',
                            minMessage: 'Revenu doit etre superieur ou egal a zero.'
                        },
                        {
                            selector: '#profitability_fertilizer',
                            type: 'number',
                            requiredMessage: 'Engrais est obligatoire.',
                            numericMessage: 'Engrais doit etre numerique.',
                            minMessage: 'Engrais doit etre superieur ou egal a zero.'
                        },
                        {
                            selector: '#profitability_water',
                            type: 'number',
                            requiredMessage: 'Eau est obligatoire.',
                            numericMessage: 'Eau doit etre numerique.',
                            minMessage: 'Eau doit etre superieur ou egal a zero.'
                        },
                        {
                            selector: '#profitability_labor',
                            type: 'number',
                            requiredMessage: "Main d'oeuvre est obligatoire.",
                            numericMessage: "Main d'oeuvre doit etre numerique.",
                            minMessage: "Main d'oeuvre doit etre superieur ou egal a zero."
                        },
                        {
                            selector: '#profitability_seeds',
                            type: 'number',
                            requiredMessage: 'Semences est obligatoire.',
                            numericMessage: 'Semences doit etre numerique.',
                            minMessage: 'Semences doit etre superieur ou egal a zero.'
                        }
                    ]
                }
            ];

            configs.forEach(function (config) {
                const form = document.getElementById(config.formId);
                if (!form) {
                    return;
                }

                form.addEventListener('submit', function (event) {
                    let valid = true;

                    config.fields.forEach(function (fieldConfig) {
                        const field = form.querySelector(fieldConfig.selector);
                        if (!field) {
                            return;
                        }

                        if (!validateField(field, fieldConfig)) {
                            valid = false;
                        }
                    });

                    if (!valid) {
                        event.preventDefault();
                        openPanel(config.panelId);
                        return;
                    }

                    event.preventDefault();

                    if (config.formId === 'forum-yield-form') {
                        const surface = Number(form.querySelector('#yield_forecast_surface').value.trim());
                        const cropCoefficient = Number(form.querySelector('#yield_forecast_cropCoefficient').value.trim());
                        const weatherCoefficient = Number(form.querySelector('#yield_forecast_weatherCoefficient').value.trim());
                        const result = surface * cropCoefficient * weatherCoefficient;

                        setResult(
                            config.resultValueSelector,
                            config.resultMessageSelector,
                            formatNumber(result),
                            'Calcul effectue avec succes.'
                        );
                    }

                    if (config.formId === 'forum-reco-form') {
                        const soil = form.querySelector('#crop_recommendation_soil').value.trim();
                        const season = form.querySelector('#crop_recommendation_season').value.trim();
                        let result = 'Aucune recommandation';
                        let message = 'Aucune regle ne correspond a cette combinaison pour le moment.';

                        if (soil === 'sableux' && season === 'ete') {
                            result = 'Pasteque';
                            message = 'Regle appliquee avec succes.';
                        } else if (soil === 'argileux' && season === 'hiver') {
                            result = 'Ble';
                            message = 'Regle appliquee avec succes.';
                        }

                        setResult(
                            config.resultValueSelector,
                            config.resultMessageSelector,
                            result,
                            message
                        );
                    }

                    if (config.formId === 'forum-profit-form') {
                        const revenue = Number(form.querySelector('#profitability_revenue').value.trim());
                        const fertilizer = Number(form.querySelector('#profitability_fertilizer').value.trim());
                        const water = Number(form.querySelector('#profitability_water').value.trim());
                        const labor = Number(form.querySelector('#profitability_labor').value.trim());
                        const seeds = Number(form.querySelector('#profitability_seeds').value.trim());
                        const result = revenue - (fertilizer + water + labor + seeds);
                        let message = "Le resultat est a l'equilibre.";

                        if (result > 0) {
                            message = 'Exploitation rentable selon les valeurs saisies.';
                        } else if (result < 0) {
                            message = 'Le resultat indique une perte selon les valeurs saisies.';
                        }

                        setResult(
                            config.resultValueSelector,
                            config.resultMessageSelector,
                            formatNumber(result),
                            message
                        );
                    }

                    openPanel(config.panelId);
                });

                config.fields.forEach(function (fieldConfig) {
                    const field = form.querySelector(fieldConfig.selector);
                    if (!field) {
                        return;
                    }

                    const eventName = field.tagName === 'SELECT' ? 'change' : 'input';
                    field.addEventListener(eventName, function () {
                        if (field.classList.contains('is-invalid') || getServerFeedback(field)) {
                            validateField(field, fieldConfig);
                        }
                    });

                    field.addEventListener('blur', function () {
                        validateField(field, fieldConfig);
                    });
                });
            });
        });
    </script>
{% endblock %}

{% block dashboard_content %}
    {% set yield_state = tool_state.yield %}
    {% set reco_state = tool_state.recommendation %}
    {% set profit_state = tool_state.profitability %}

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fs-4 fw-bold text-dark mb-1">Forum communautaire</h2>
            <p class="text-muted mb-0">Retrouvez les sujets de discussion et poursuivez les echanges.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button
                type="button"
                class="btn btn-outline-success"
                data-bs-toggle="collapse"
                data-bs-target="#forumYieldForecastPanel"
                aria-expanded="false"
                aria-controls="forumYieldForecastPanel"
            >
                Prevision de rendement
            </button>
            <button
                type="button"
                class="btn btn-outline-primary"
                data-bs-toggle="collapse"
                data-bs-target="#forumCropRecommendationPanel"
                aria-expanded="false"
                aria-controls="forumCropRecommendationPanel"
            >
                Recommandation de culture
            </button>
            <button
                type="button"
                class="btn btn-outline-warning"
                data-bs-toggle="collapse"
                data-bs-target="#forumProfitabilityPanel"
                aria-expanded="false"
                aria-controls="forumProfitabilityPanel"
            >
                Analyse de rentabilite
            </button>
            <a href="{{ path('forum_new') }}" class="btn btn-success">Nouveau sujet</a>
        </div>
    </div>

    <div class="collapse mb-4 {{ tool_state.active_panel == 'yield' ? 'show' : '' }}" id="forumYieldForecastPanel">
        <div class="forum-yield-panel shadow-sm">
            <div class="forum-yield-panel__hero">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                    <div class="d-flex align-items-start gap-3">
                        <div class="forum-yield-panel__hero-badge">YR</div>
                        <div>
                            <h3 class="fs-5 fw-bold mb-1">Systeme de Prevision de Rendement Agricole</h3>
                            <p class="mb-0 text-white text-opacity-75">Calculez rapidement une estimation de rendement a partir de la surface et des coefficients terrain/meteo.</p>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light">Outil rapide</span>
                </div>
            </div>

            <div class="forum-yield-panel__body">
                <div class="row g-4 align-items-start">
                    <div class="col-12 col-xl-7">
                        {{ form_start(yield_form, {'method': 'POST', 'action': path('forum_index'), 'attr': {'id': 'forum-yield-form', 'novalidate': 'novalidate', 'class': 'row g-3'}}) }}
                            <div class="col-12 col-md-4">
                                {{ form_label(yield_form.surface, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(yield_form.surface, {'attr': {'class': 'form-control' ~ (yield_form.surface.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if yield_form.surface.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(yield_form.surface) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 col-md-4">
                                {{ form_label(yield_form.cropCoefficient, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(yield_form.cropCoefficient, {'attr': {'class': 'form-control' ~ (yield_form.cropCoefficient.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if yield_form.cropCoefficient.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(yield_form.cropCoefficient) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 col-md-4">
                                {{ form_label(yield_form.weatherCoefficient, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(yield_form.weatherCoefficient, {'attr': {'class': 'form-control' ~ (yield_form.weatherCoefficient.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if yield_form.weatherCoefficient.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(yield_form.weatherCoefficient) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 d-flex flex-wrap gap-2">
                                <button type="submit" class="btn btn-success">Calculer</button>
                                <a href="{{ path('forum_index') }}" class="btn btn-outline-secondary">Reinitialiser</a>
                            </div>
                        {{ form_end(yield_form) }}
                    </div>

                    <div class="col-12 col-xl-5">
                        <div class="forum-yield-panel__result">
                            <div class="small text-uppercase fw-semibold text-success mb-2">Rendement estime</div>
                            <div id="yield-result-value" class="forum-yield-panel__result-value">{{ yield_state.result }}</div>
                            <div id="yield-result-message" class="forum-yield-panel__hint mt-2">
                                {{ yield_state.message }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="collapse mb-4 {{ tool_state.active_panel == 'recommendation' ? 'show' : '' }}" id="forumCropRecommendationPanel">
        <div class="forum-reco-panel shadow-sm">
            <div class="forum-reco-panel__hero">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                    <div class="d-flex align-items-start gap-3">
                        <div class="forum-reco-panel__hero-badge">RC</div>
                        <div>
                            <h3 class="fs-5 fw-bold mb-1">Systeme Intelligent de Recommandation de Culture</h3>
                            <p class="mb-0 text-white text-opacity-75">Choisissez le type de sol et la saison pour obtenir une suggestion de culture selon les regles definies.</p>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light">Assistant rapide</span>
                </div>
            </div>

            <div class="forum-reco-panel__body">
                <div class="row g-4 align-items-start">
                    <div class="col-12 col-xl-7">
                        {{ form_start(recommendation_form, {'method': 'POST', 'action': path('forum_index'), 'attr': {'id': 'forum-reco-form', 'novalidate': 'novalidate', 'class': 'row g-3'}}) }}
                            <div class="col-12 col-md-6">
                                {{ form_label(recommendation_form.soil, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(recommendation_form.soil, {'attr': {'class': 'form-select' ~ (recommendation_form.soil.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if recommendation_form.soil.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(recommendation_form.soil) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 col-md-6">
                                {{ form_label(recommendation_form.season, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(recommendation_form.season, {'attr': {'class': 'form-select' ~ (recommendation_form.season.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if recommendation_form.season.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(recommendation_form.season) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 d-flex flex-wrap gap-2">
                                <button type="submit" class="btn btn-primary">Recommander</button>
                                <a href="{{ path('forum_index') }}" class="btn btn-outline-secondary">Reinitialiser</a>
                            </div>
                        {{ form_end(recommendation_form) }}
                    </div>

                    <div class="col-12 col-xl-5">
                        <div class="forum-reco-panel__result">
                            <div class="small text-uppercase fw-semibold text-primary mb-2">Culture recommandee</div>
                            <div id="reco-result-value" class="forum-reco-panel__result-value">{{ reco_state.result }}</div>
                            <div id="reco-result-message" class="forum-yield-panel__hint mt-2">
                                {{ reco_state.message }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="collapse mb-4 {{ tool_state.active_panel == 'profitability' ? 'show' : '' }}" id="forumProfitabilityPanel">
        <div class="forum-profit-panel shadow-sm">
            <div class="forum-profit-panel__hero">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                    <div class="d-flex align-items-start gap-3">
                        <div class="forum-profit-panel__hero-badge">PR</div>
                        <div>
                            <h3 class="fs-5 fw-bold mb-1">Systeme d'Analyse de Rentabilite Agricole</h3>
                            <p class="mb-0 text-white text-opacity-75">Estimez rapidement le profit agricole a partir du revenu et des charges principales.</p>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light">Assistant financier</span>
                </div>
            </div>

            <div class="forum-profit-panel__body">
                <div class="row g-4 align-items-start">
                    <div class="col-12 col-xl-7">
                        {{ form_start(profitability_form, {'method': 'POST', 'action': path('forum_index'), 'attr': {'id': 'forum-profit-form', 'novalidate': 'novalidate', 'class': 'row g-3'}}) }}
                            <div class="col-12 col-md-6">
                                {{ form_label(profitability_form.revenue, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(profitability_form.revenue, {'attr': {'class': 'form-control' ~ (profitability_form.revenue.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if profitability_form.revenue.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(profitability_form.revenue) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 col-md-6">
                                {{ form_label(profitability_form.fertilizer, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(profitability_form.fertilizer, {'attr': {'class': 'form-control' ~ (profitability_form.fertilizer.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if profitability_form.fertilizer.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(profitability_form.fertilizer) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 col-md-4">
                                {{ form_label(profitability_form.water, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(profitability_form.water, {'attr': {'class': 'form-control' ~ (profitability_form.water.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if profitability_form.water.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(profitability_form.water) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 col-md-4">
                                {{ form_label(profitability_form.labor, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(profitability_form.labor, {'attr': {'class': 'form-control' ~ (profitability_form.labor.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if profitability_form.labor.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(profitability_form.labor) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 col-md-4">
                                {{ form_label(profitability_form.seeds, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(profitability_form.seeds, {'attr': {'class': 'form-control' ~ (profitability_form.seeds.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if profitability_form.seeds.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(profitability_form.seeds) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 d-flex flex-wrap gap-2">
                                <button type="submit" class="btn btn-warning text-dark">Calculer</button>
                                <a href="{{ path('forum_index') }}" class="btn btn-outline-secondary">Reinitialiser</a>
                            </div>
                        {{ form_end(profitability_form) }}
                    </div>

                    <div class="col-12 col-xl-5">
                        <div class="forum-profit-panel__result">
                            <div class="small text-uppercase fw-semibold text-warning-emphasis mb-2">Profit estime</div>
                            <div id="profit-result-value" class="forum-profit-panel__result-value">{{ profit_state.result }}</div>
                            <div id="profit-result-message" class="forum-yield-panel__hint mt-2">
                                {{ profit_state.message }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-12 col-lg-6">
                    <label for="forum-search" class="form-label fw-semibold small text-dark">Recherche</label>
                    <input
                        id="forum-search"
                        type="text"
                        name="q"
                        value="{{ filters.q|default('') }}"
                        class="form-control"
                        placeholder="Rechercher par titre ou categorie"
                    >
                </div>
                <div class="col-12 col-md-4 col-lg-3">
                    <label for="forum-sort" class="form-label fw-semibold small text-dark">Tri</label>
                    <select id="forum-sort" name="sort" class="form-select">
                        <option value="recent" {{ (filters.sort|default('recent')) == 'recent' ? 'selected' : '' }}>Plus recents</option>
                        <option value="az" {{ (filters.sort|default('recent')) == 'az' ? 'selected' : '' }}>Titre A-Z</option>
                        <option value="za" {{ (filters.sort|default('recent')) == 'za' ? 'selected' : '' }}>Titre Z-A</option>
                    </select>
                </div>
                <div class="col-12 col-md-8 col-lg-3 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-outline-success">Rechercher</button>
                    <a href="{{ path('forum_index') }}" class="btn btn-outline-secondary">Reinitialiser</a>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4">
        {% for forum in forums %}
            <div class="col-12 col-xl-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                            <div>
                                <h3 class="fs-5 fw-bold text-dark mb-1">{{ forum.titre }}</h3>
                                <p class="small text-muted mb-0">Cree le {{ forum.dateCreation|date('d/m/Y H:i') }}</p>
                            </div>
                            <span class="badge text-bg-light border">{{ forum.categorie }}</span>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <a href="{{ path('forum_show', {id: forum.id}) }}" class="btn btn-sm btn-outline-primary">Ouvrir</a>
                            <a href="{{ path('forum_edit', {id: forum.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5 text-center text-muted">
                        Aucun sujet pour le moment.
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}
