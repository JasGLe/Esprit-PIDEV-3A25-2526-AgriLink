{% extends 'layouts/dashboard_layout.html.twig' %}
{% block title %}Forum - AgriLink{% endblock %}
{% block page_title %}Forum{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .forum-yield-panel {
            border-radius: 1.25rem;
            overflow: hidden;
            border: 1px solid #dbe7d8;
            background: linear-gradient(135deg, #f7fbf3 0%, #ffffff 100%);
        }

        .forum-yield-panel__hero {
            padding: 1.5rem;
            background:
                radial-gradient(circle at top right, rgba(34, 197, 94, 0.14), transparent 28%),
                linear-gradient(135deg, #14532d 0%, #166534 100%);
            color: #fff;
        }

        .forum-yield-panel__hero-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.75rem;
            height: 2.75rem;
            border-radius: 0.9rem;
            background: rgba(255, 255, 255, 0.14);
            font-weight: 700;
            font-size: 1.15rem;
        }

        .forum-yield-panel__body {
            padding: 1.5rem;
        }

        .forum-yield-panel__result {
            padding: 1rem 1.1rem;
            border-radius: 1rem;
            background: #ecfdf5;
            border: 1px solid #bbf7d0;
        }

        .forum-yield-panel__result-value {
            font-size: 1.8rem;
            font-weight: 800;
            color: #166534;
            line-height: 1;
        }

        .forum-profit-panel {
            border-radius: 1.25rem;
            overflow: hidden;
            border: 1px solid #f3d7c3;
            background: linear-gradient(135deg, #fffaf5 0%, #ffffff 100%);
        }

        .forum-profit-panel__hero {
            padding: 1.5rem;
            background:
                radial-gradient(circle at top right, rgba(249, 115, 22, 0.18), transparent 28%),
                linear-gradient(135deg, #c2410c 0%, #ea580c 100%);
            color: #fff;
        }

        .forum-profit-panel__hero-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.75rem;
            height: 2.75rem;
            border-radius: 0.9rem;
            background: rgba(255, 255, 255, 0.16);
            font-weight: 700;
            font-size: 1rem;
        }

        .forum-profit-panel__body {
            padding: 1.5rem;
        }

        .forum-profit-panel__result {
            padding: 1rem 1.1rem;
            border-radius: 1rem;
            background: #fff7ed;
            border: 1px solid #fed7aa;
        }

        .forum-profit-panel__result-value {
            font-size: 1.7rem;
            font-weight: 800;
            color: #c2410c;
            line-height: 1.1;
        }

        .forum-yield-panel .form-control.is-invalid,
        .forum-yield-panel .form-select.is-invalid,
        .forum-profit-panel .form-control.is-invalid,
        .forum-profit-panel .form-select.is-invalid {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.15) !important;
            background-image: none !important;
        }

        .forum-yield-panel .invalid-feedback,
        .forum-profit-panel .invalid-feedback {
            display: block;
            font-size: 0.875rem;
            font-weight: 600;
            color: #dc3545;
            margin-top: 0.35rem;
        }

        .forum-tool-hint {
            font-size: 0.875rem;
            color: #64748b;
        }
    </style>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        function initForumCalculators() {
            function normalizeNumericValue(value) {
                return (value || '').trim().replace(/\s+/g, '').replace(',', '.');
            }

            function setFieldError(field, message) {
                field.classList.add('is-invalid');

                let feedback = field.parentElement.querySelector('.js-inline-error');
                if (!feedback) {
                    feedback = document.createElement('div');
                    feedback.className = 'invalid-feedback d-block js-inline-error';
                    field.parentElement.appendChild(feedback);
                }

                feedback.textContent = message;
            }

            function clearFieldError(field) {
                field.classList.remove('is-invalid');
                const feedback = field.parentElement.querySelector('.js-inline-error');
                if (feedback) {
                    feedback.remove();
                }
            }

            function clearFormErrors(form) {
                form.querySelectorAll('.is-invalid').forEach(function (field) {
                    field.classList.remove('is-invalid');
                });

                form.querySelectorAll('.invalid-feedback').forEach(function (feedback) {
                    feedback.remove();
                });
            }

            function validateRequiredTextField(field, emptyMessage, numericMessage) {
                const value = normalizeNumericValue(field.value);
                clearFieldError(field);

                if (value === '') {
                    setFieldError(field, emptyMessage);
                    return false;
                }

                if (numericMessage !== null) {
                    const parsed = Number(value);
                    if (!Number.isFinite(parsed) || parsed < 0) {
                        setFieldError(field, numericMessage);
                        return false;
                    }

                    field.value = value;
                }

                return true;
            }

            function validateRequiredChoice(field, emptyMessage) {
                clearFieldError(field);

                if ((field.value || '').trim() === '') {
                    setFieldError(field, emptyMessage);
                    return false;
                }

                return true;
            }

            function parseNumericField(form, selector) {
                const field = form.querySelector(selector);
                return field ? Number(normalizeNumericValue(field.value)) : 0;
            }

            function renderYieldResult(form) {
                const surface = parseNumericField(form, '#yield_forecast_surface');
                const cropCoefficient = parseNumericField(form, '#yield_forecast_cropCoefficient');
                const weatherCoefficient = parseNumericField(form, '#yield_forecast_weatherCoefficient');
                const result = (surface * cropCoefficient * weatherCoefficient).toFixed(2);

                const resultValue = document.getElementById('yield-result-value');
                const resultMessage = document.getElementById('yield-result-message');

                if (resultValue) {
                    resultValue.textContent = result;
                }

                if (resultMessage) {
                    resultMessage.textContent = 'Calcul effectue avec succes.';
                }
            }

            function renderProfitResult(form) {
                const revenue = parseNumericField(form, '#profitability_revenue');
                const fertilizer = parseNumericField(form, '#profitability_fertilizer');
                const water = parseNumericField(form, '#profitability_water');
                const labor = parseNumericField(form, '#profitability_labor');
                const seeds = parseNumericField(form, '#profitability_seeds');
                const result = (revenue - (fertilizer + water + labor + seeds)).toFixed(2);

                const resultValue = document.getElementById('profit-result-value');
                const resultMessage = document.getElementById('profit-result-message');

                if (resultValue) {
                    resultValue.textContent = result;
                }

                if (resultMessage) {
                    if (Number(result) > 0) {
                        resultMessage.textContent = 'Exploitation rentable selon les valeurs saisies.';
                    } else if (Number(result) < 0) {
                        resultMessage.textContent = 'Le resultat indique une perte selon les valeurs saisies.';
                    } else {
                        resultMessage.textContent = 'Le resultat est a l\'equilibre.';
                    }
                }
            }

            function validateConfiguredForm(form, config) {
                let valid = true;

                config.fields.forEach(function (fieldConfig) {
                    const field = form.querySelector(fieldConfig[0]);
                    if (!field) {
                        return;
                    }

                    const isChoice = field.tagName === 'SELECT';
                    const fieldValid = isChoice
                        ? validateRequiredChoice(field, fieldConfig[1])
                        : validateRequiredTextField(field, fieldConfig[1], fieldConfig[2]);

                    if (!fieldValid) {
                        valid = false;
                    }
                });

                return valid;
            }

            const configs = [
                {
                    formId: 'forum-yield-form',
                    fields: [
                        ['#yield_forecast_surface', 'Surface est obligatoire.', 'Surface doit etre numerique.'],
                        ['#yield_forecast_cropCoefficient', 'Coefficient culture est obligatoire.', 'Coefficient culture doit etre numerique.'],
                        ['#yield_forecast_weatherCoefficient', 'Coefficient meteo est obligatoire.', 'Coefficient meteo doit etre numerique.']
                    ]
                },
                {
                    formId: 'forum-profit-form',
                    fields: [
                        ['#profitability_revenue', 'Revenu est obligatoire.', 'Revenu doit etre numerique.'],
                        ['#profitability_fertilizer', 'Engrais est obligatoire.', 'Engrais doit etre numerique.'],
                        ['#profitability_water', 'Eau est obligatoire.', 'Eau doit etre numerique.'],
                        ['#profitability_labor', "Main d'oeuvre est obligatoire.", "Main d'oeuvre doit etre numerique."],
                        ['#profitability_seeds', 'Semences est obligatoire.', 'Semences doit etre numerique.']
                    ]
                }
            ];

            configs.forEach(function (config) {
                const form = document.getElementById(config.formId);
                if (!form || form.dataset.forumCalculatorBound === '1') {
                    return;
                }

                form.dataset.forumCalculatorBound = '1';

                form.addEventListener('submit', function (event) {
                    const valid = validateConfiguredForm(form, config);
                    if (!valid) {
                        event.preventDefault();
                        return;
                    }

                    if (config.formId === 'forum-yield-form') {
                        event.preventDefault();
                        renderYieldResult(form);
                    }

                    if (config.formId === 'forum-profit-form') {
                        event.preventDefault();
                        renderProfitResult(form);
                    }
                });

                config.fields.forEach(function (fieldConfig) {
                    const field = form.querySelector(fieldConfig[0]);
                    if (!field) {
                        return;
                    }

                    const eventName = field.tagName === 'SELECT' ? 'change' : 'input';
                    field.addEventListener(eventName, function () {
                        if ((field.value || '').trim() !== '') {
                            clearFieldError(field);
                        }
                    });
                });
            });

            const yieldCalculateButton = document.getElementById('forum-yield-calculate');
            const yieldForm = document.getElementById('forum-yield-form');
            const yieldConfig = configs.find(function (config) {
                return config.formId === 'forum-yield-form';
            });

            if (yieldCalculateButton && yieldForm && yieldCalculateButton.dataset.forumCalcBound !== '1') {
                yieldCalculateButton.dataset.forumCalcBound = '1';
                yieldCalculateButton.addEventListener('click', function () {
                    if (!yieldConfig || !validateConfiguredForm(yieldForm, yieldConfig)) {
                        return;
                    }

                    renderYieldResult(yieldForm);
                });
            }

            const profitCalculateButton = document.getElementById('forum-profit-calculate');
            const profitForm = document.getElementById('forum-profit-form');
            const profitConfig = configs.find(function (config) {
                return config.formId === 'forum-profit-form';
            });

            if (profitCalculateButton && profitForm && profitCalculateButton.dataset.forumCalcBound !== '1') {
                profitCalculateButton.dataset.forumCalcBound = '1';
                profitCalculateButton.addEventListener('click', function () {
                    if (!profitConfig || !validateConfiguredForm(profitForm, profitConfig)) {
                        return;
                    }

                    renderProfitResult(profitForm);
                });
            }

            document.querySelectorAll('[data-forum-reset-form]').forEach(function (button) {
                if (button.dataset.forumResetBound === '1') {
                    return;
                }

                button.dataset.forumResetBound = '1';

                button.addEventListener('click', function () {
                    const form = document.getElementById(button.getAttribute('data-forum-reset-form'));
                    if (!form) {
                        return;
                    }

                    form.reset();
                    clearFormErrors(form);

                    const resultValue = document.getElementById(button.getAttribute('data-forum-reset-value'));
                    const resultMessage = document.getElementById(button.getAttribute('data-forum-reset-message'));

                    if (resultValue) {
                        resultValue.textContent = button.getAttribute('data-forum-default-value') || '';
                    }

                    if (resultMessage) {
                        resultMessage.textContent = button.getAttribute('data-forum-default-message') || '';
                    }
                });
            });
        }

        document.addEventListener('DOMContentLoaded', initForumCalculators);
        document.addEventListener('turbo:load', initForumCalculators);
    </script>
{% endblock %}

{% block dashboard_content %}
    {% set yield_state = tool_state.yield %}
    {% set profit_state = tool_state.profitability %}

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fs-4 fw-bold text-dark mb-1">Forum communautaire</h2>
            <p class="text-muted mb-0">Retrouvez les sujets de discussion et poursuivez les echanges.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button
                type="button"
                class="btn btn-outline-success"
                data-bs-toggle="collapse"
                data-bs-target="#forumYieldForecastPanel"
                aria-expanded="false"
                aria-controls="forumYieldForecastPanel"
            >
                Prevision de rendement
            </button>
            <button
                type="button"
                class="btn btn-outline-warning"
                data-bs-toggle="collapse"
                data-bs-target="#forumProfitabilityPanel"
                aria-expanded="false"
                aria-controls="forumProfitabilityPanel"
            >
                Analyse de rentabilite
            </button>
            <a href="{{ path('forum_new') }}" class="btn btn-success">Nouveau sujet</a>
        </div>
    </div>

    <div class="collapse mb-4 {{ tool_state.active_panel == 'yield' ? 'show' : '' }}" id="forumYieldForecastPanel">
        <div class="forum-yield-panel shadow-sm">
            <div class="forum-yield-panel__hero">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                    <div class="d-flex align-items-start gap-3">
                        <div class="forum-yield-panel__hero-badge">YR</div>
                        <div>
                            <h3 class="fs-5 fw-bold mb-1">Systeme de Prevision de Rendement Agricole</h3>
                            <p class="mb-0 text-white text-opacity-75">Calculez rapidement une estimation de rendement a partir de la surface et des coefficients terrain/meteo.</p>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light">Outil rapide</span>
                </div>
            </div>

            <div class="forum-yield-panel__body">
                <div class="row g-4 align-items-start">
                    <div class="col-12 col-xl-7">
                        {{ form_start(yield_form, {'method': 'POST', 'action': path('forum_index'), 'attr': {'id': 'forum-yield-form', 'novalidate': 'novalidate', 'data-turbo': 'false', 'class': 'row g-3'}}) }}
                            <div class="col-12 col-md-4">
                                {{ form_label(yield_form.surface, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(yield_form.surface, {'attr': {'class': 'form-control' ~ (yield_form.surface.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if yield_form.surface.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(yield_form.surface) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 col-md-4">
                                {{ form_label(yield_form.cropCoefficient, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(yield_form.cropCoefficient, {'attr': {'class': 'form-control' ~ (yield_form.cropCoefficient.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if yield_form.cropCoefficient.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(yield_form.cropCoefficient) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 col-md-4">
                                {{ form_label(yield_form.weatherCoefficient, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(yield_form.weatherCoefficient, {'attr': {'class': 'form-control' ~ (yield_form.weatherCoefficient.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if yield_form.weatherCoefficient.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(yield_form.weatherCoefficient) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-success" id="forum-yield-calculate">Calculer</button>
                                <button
                                    type="button"
                                    class="btn btn-outline-secondary"
                                    data-forum-reset-form="forum-yield-form"
                                    data-forum-reset-value="yield-result-value"
                                    data-forum-reset-message="yield-result-message"
                                    data-forum-default-value="0.00"
                                    data-forum-default-message="Renseignez les trois champs puis cliquez sur Calculer."
                                >
                                    Reinitialiser
                                </button>
                            </div>
                        {{ form_end(yield_form) }}
                    </div>

                    <div class="col-12 col-xl-5">
                        <div class="forum-yield-panel__result">
                            <div class="small text-uppercase fw-semibold text-success mb-2">Rendement estime</div>
                            <div id="yield-result-value" class="forum-yield-panel__result-value">{{ yield_state.result }}</div>
                            <div id="yield-result-message" class="forum-tool-hint mt-2">{{ yield_state.message }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="collapse mb-4 {{ tool_state.active_panel == 'profitability' ? 'show' : '' }}" id="forumProfitabilityPanel">
        <div class="forum-profit-panel shadow-sm">
            <div class="forum-profit-panel__hero">
                <div class="d-flex flex-wrap align-items-start justify-content-between gap-3">
                    <div class="d-flex align-items-start gap-3">
                        <div class="forum-profit-panel__hero-badge">PR</div>
                        <div>
                            <h3 class="fs-5 fw-bold mb-1">Systeme d'Analyse de Rentabilite Agricole</h3>
                            <p class="mb-0 text-white text-opacity-75">Estimez rapidement le profit agricole a partir du revenu et des charges principales.</p>
                        </div>
                    </div>
                    <span class="badge rounded-pill text-bg-light">Assistant financier</span>
                </div>
            </div>

            <div class="forum-profit-panel__body">
                <div class="row g-4 align-items-start">
                    <div class="col-12 col-xl-7">
                        {{ form_start(profitability_form, {'method': 'POST', 'action': path('forum_index'), 'attr': {'id': 'forum-profit-form', 'novalidate': 'novalidate', 'data-turbo': 'false', 'class': 'row g-3'}}) }}
                            <div class="col-12 col-md-6">
                                {{ form_label(profitability_form.revenue, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(profitability_form.revenue, {'attr': {'class': 'form-control' ~ (profitability_form.revenue.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if profitability_form.revenue.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(profitability_form.revenue) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 col-md-6">
                                {{ form_label(profitability_form.fertilizer, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(profitability_form.fertilizer, {'attr': {'class': 'form-control' ~ (profitability_form.fertilizer.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if profitability_form.fertilizer.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(profitability_form.fertilizer) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 col-md-4">
                                {{ form_label(profitability_form.water, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(profitability_form.water, {'attr': {'class': 'form-control' ~ (profitability_form.water.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if profitability_form.water.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(profitability_form.water) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 col-md-4">
                                {{ form_label(profitability_form.labor, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(profitability_form.labor, {'attr': {'class': 'form-control' ~ (profitability_form.labor.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if profitability_form.labor.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(profitability_form.labor) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 col-md-4">
                                {{ form_label(profitability_form.seeds, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
                                {{ form_widget(profitability_form.seeds, {'attr': {'class': 'form-control' ~ (profitability_form.seeds.vars.errors|length ? ' is-invalid' : '')}}) }}
                                {% if profitability_form.seeds.vars.errors|length %}
                                    <div class="invalid-feedback d-block">{{ form_errors(profitability_form.seeds) }}</div>
                                {% endif %}
                            </div>
                            <div class="col-12 d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-warning text-dark" id="forum-profit-calculate">Calculer</button>
                                <button
                                    type="button"
                                    class="btn btn-outline-secondary"
                                    data-forum-reset-form="forum-profit-form"
                                    data-forum-reset-value="profit-result-value"
                                    data-forum-reset-message="profit-result-message"
                                    data-forum-default-value="0.00"
                                    data-forum-default-message="Saisissez le revenu et les charges puis cliquez sur Calculer."
                                >
                                    Reinitialiser
                                </button>
                            </div>
                        {{ form_end(profitability_form) }}
                    </div>

                    <div class="col-12 col-xl-5">
                        <div class="forum-profit-panel__result">
                            <div class="small text-uppercase fw-semibold text-warning-emphasis mb-2">Profit estime</div>
                            <div id="profit-result-value" class="forum-profit-panel__result-value">{{ profit_state.result }}</div>
                            <div id="profit-result-message" class="forum-tool-hint mt-2">{{ profit_state.message }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-12 col-lg-6">
                    <label for="forum-search" class="form-label fw-semibold small text-dark">Recherche</label>
                    <input
                        id="forum-search"
                        type="text"
                        name="q"
                        value="{{ filters.q|default('') }}"
                        class="form-control"
                        placeholder="Rechercher par titre ou categorie"
                    >
                </div>
                <div class="col-12 col-md-4 col-lg-3">
                    <label for="forum-sort" class="form-label fw-semibold small text-dark">Tri</label>
                    <select id="forum-sort" name="sort" class="form-select">
                        <option value="recent" {{ (filters.sort|default('recent')) == 'recent' ? 'selected' : '' }}>Plus recents</option>
                        <option value="az" {{ (filters.sort|default('recent')) == 'az' ? 'selected' : '' }}>Titre A-Z</option>
                        <option value="za" {{ (filters.sort|default('recent')) == 'za' ? 'selected' : '' }}>Titre Z-A</option>
                    </select>
                </div>
                <div class="col-12 col-md-8 col-lg-3 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-outline-success">Rechercher</button>
                    <a href="{{ path('forum_index') }}" class="btn btn-outline-secondary">Reinitialiser</a>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-4">
        {% for forum in forums %}
            <div class="col-12 col-xl-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                            <div>
                                <h3 class="fs-5 fw-bold text-dark mb-1">{{ forum.titre }}</h3>
                                <p class="small text-muted mb-0">Cree le {{ forum.dateCreation|date('d/m/Y H:i') }}</p>
                            </div>
                            <span class="badge text-bg-light border">{{ forum.categorie }}</span>
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <a href="{{ path('forum_show', {id: forum.id}) }}" class="btn btn-sm btn-outline-primary">Ouvrir</a>
                            <a href="{{ path('forum_edit', {id: forum.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-5 text-center text-muted">
                        Aucun sujet pour le moment.
                    </div>
                </div>
            </div>
