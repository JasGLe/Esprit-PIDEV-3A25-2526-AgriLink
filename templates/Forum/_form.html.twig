{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
    {% if form.vars.errors|length > 0 %}
        <div class="alert alert-danger border-danger-subtle">
            {{ form_errors(form) }}
        </div>
    {% endif %}
    <div class="row g-3">
        <div class="col-12">
            {{ form_label(form.titre, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
            {{ form_widget(form.titre, {'attr': {'class': 'form-control' ~ (form.titre.vars.errors|length ? ' is-invalid' : ''), 'placeholder': 'Titre du sujet'}}) }}
            {% if form.titre.vars.errors|length %}
                <div class="text-danger small mt-1 fw-semibold">
                    {{ form_errors(form.titre) }}
                </div>
            {% endif %}
        </div>

        <div class="col-12">
            {{ form_label(form.categorie, null, {'label_attr': {'class': 'form-label fw-semibold small text-dark'}}) }}
            {{ form_widget(form.categorie, {'attr': {'class': 'form-select' ~ (form.categorie.vars.errors|length ? ' is-invalid' : '')}}) }}
            {% if form.categorie.vars.errors|length %}
                <div class="text-danger small mt-1 fw-semibold">
                    {{ form_errors(form.categorie) }}
                </div>
            {% endif %}
        </div>
    </div>

    <style>
        .is-invalid {
            border-color: #dc3545 !important;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.15) !important;
            background-image: none !important;
        }
    </style>

    <div class="d-flex flex-wrap gap-2 mt-4">
        <button type="submit" class="btn btn-success">{{ submit_label|default('Enregistrer') }}</button>
        <a href="{{ path('forum_index') }}" class="btn btn-outline-secondary">Annuler</a>
    </div>
{{ form_end(form) }}
