<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Discussion Forum - {{ forum.titre }}</title>
    <style>
        @page {
            margin: 28px 32px;
        }

        body {
            font-family: DejaVu Sans, Arial, sans-serif;
            color: #111827;
            font-size: 12px;
            line-height: 1.45;
            margin: 0;
        }

        .header {
            border-bottom: 2px solid #166534;
            padding-bottom: 14px;
            margin-bottom: 18px;
        }

        .brand {
            width: 150px;
            margin-bottom: 10px;
        }

        .title {
            font-size: 23px;
            font-weight: 700;
            color: #14532d;
            margin: 0 0 6px;
        }

        .meta {
            color: #4b5563;
            margin: 0;
        }

        .summary {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 8px;
            padding: 12px 14px;
            margin-bottom: 18px;
        }

        .summary-row {
            margin: 2px 0;
        }

        .label {
            font-weight: 700;
            color: #14532d;
        }

        .messages-title {
            font-size: 16px;
            font-weight: 700;
            color: #111827;
            margin: 0 0 12px;
        }

        .message {
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            padding: 11px 12px;
            margin-bottom: 10px;
            page-break-inside: avoid;
        }

        .message-head {
            margin-bottom: 7px;
            color: #4b5563;
            font-size: 11px;
        }

        .author {
            font-weight: 700;
            color: #166534;
        }

        .content {
            white-space: pre-wrap;
            word-wrap: break-word;
        }

        .audio-note {
            display: inline-block;
            margin-top: 8px;
            padding: 5px 8px;
            border-radius: 999px;
            background: #eff6ff;
            color: #1d4ed8;
            font-size: 11px;
            font-weight: 700;
        }

        .empty {
            border: 1px dashed #d1d5db;
            border-radius: 8px;
            padding: 18px;
            text-align: center;
            color: #6b7280;
        }

        .footer {
            margin-top: 18px;
            padding-top: 10px;
            border-top: 1px solid #e5e7eb;
            color: #6b7280;
            font-size: 10px;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="header">
        {% if logoDataUri %}
            <img class="brand" src="{{ logoDataUri }}" alt="AgriLink">
        {% endif %}
        <h1 class="title">{{ forum.titre }}</h1>
        <p class="meta">Export PDF de la discussion Forum AgriLink</p>
    </div>

    <div class="summary">
        <div class="summary-row"><span class="label">Categorie :</span> {{ forum.categorie }}</div>
        <div class="summary-row"><span class="label">Date de creation :</span> {{ forum.dateCreation|date('d/m/Y H:i') }}</div>
        <div class="summary-row"><span class="label">Nombre de messages :</span> {{ messageCount }}</div>
        <div class="summary-row"><span class="label">Genere le :</span> {{ generatedAt|date('d/m/Y H:i') }}</div>
    </div>

    <h2 class="messages-title">Messages</h2>

    {% for message in messages %}
        <div class="message">
            <div class="message-head">
                <span class="author">{{ message.user.displayName }}</span>
                - {{ message.dateEnvoi|date('d/m/Y H:i') }}
            </div>

            {% if message.contenu is not empty %}
                <div class="content">{{ message.contenu }}</div>
            {% else %}
                <div class="content">Message sans texte.</div>
            {% endif %}

            {% if message.audioPath %}
                <div class="audio-note">Message vocal joint : {{ message.audioPath|split('/')|last }}</div>
            {% endif %}
        </div>
    {% else %}
        <div class="empty">Aucun message dans cette discussion.</div>
    {% endfor %}

    <div class="footer">
        AgriLink - Export automatique de discussion forum
    </div>
</body>
</html>
