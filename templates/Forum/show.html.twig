{% extends 'layouts/dashboard_layout.html.twig' %}
{% block title %}{{ forum.titre }} - Forum{% endblock %}
{% block page_title %}Discussion{% endblock %}

{% block dashboard_content %}
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <h2 class="fs-3 fw-bold text-dark mb-0">{{ forum.titre }}</h2>
                <span class="badge text-bg-light border">{{ forum.categorie }}</span>
            </div>
            <p class="text-muted mb-0">Sujet cree le {{ forum.dateCreation|date('d/m/Y H:i') }}</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('forum_edit', {id: forum.id}) }}" class="btn btn-outline-secondary">Modifier</a>
            <a href="{{ path('forum_index') }}" class="btn btn-outline-primary">Retour au forum</a>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4 p-lg-5" style="background: #f8fafc;">
            <div class="d-flex flex-column gap-3">
                {% for message in messages %}
                    <div class="d-flex {{ message.isOwn ? 'justify-content-end' : 'justify-content-start' }}">
                        <div class="d-flex gap-3 {{ message.isOwn ? 'flex-row-reverse text-end' : '' }}" style="max-width: 75%;">
                            <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center fw-semibold text-secondary flex-shrink-0" style="width: 2.5rem; height: 2.5rem;">
                                {{ message.authorInitials }}
                            </div>
                            <div>
                                <div class="small text-muted mb-1">{{ message.authorName }} · {{ message.sentAt|date('d/m/Y H:i') }}</div>
                                <div class="rounded-4 px-3 py-2 {{ message.isOwn ? 'bg-success text-white' : 'bg-white border' }}">
                                    {{ message.content|nl2br }}
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="text-center py-4 text-muted">
                        Aucun message pour l'instant. Soyez le premier a contribuer.
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form method="post" action="{{ path('forum_message_create', {id: forum.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('forum_message_' ~ forum.id) }}">
                <label for="forum-message-content" class="form-label fw-semibold small text-dark">Nouveau message</label>
                <textarea
                    id="forum-message-content"
                    name="contenu"
                    rows="4"
                    maxlength="500"
                    class="form-control"
                    placeholder="Ecrivez votre message..."
                    required
                ></textarea>
                <div class="d-flex justify-content-between align-items-center mt-3 gap-3">
                    <span class="text-muted small">Les messages sont maintenant enregistres dans la discussion.</span>
                    <button type="submit" class="btn btn-success">Envoyer</button>
                </div>
            </form>
        </div>
    </div>
{% endblock %}
