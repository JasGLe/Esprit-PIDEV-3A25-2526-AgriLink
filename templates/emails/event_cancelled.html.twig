<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Annulation d'un événement - AgriLink</title>
</head>
<body style="margin:0;padding:0;background-color:#f1f5f1;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;color:#1a1a1a;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f1f5f1;">
        <tr>
            <td align="center" style="padding:40px 16px;">
                <table role="presentation" width="100%" style="max-width:600px;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.08);" cellpadding="0" cellspacing="0">

                    {# Logo Header #}
                    <tr>
                        <td style="background-color:#ffffff;padding:28px 40px 20px;text-align:center;border-bottom:3px solid #dc2626;">
                            <img src="{{ appUrl }}/logo_with_text.png" alt="AgriLink" style="height:56px;width:auto;display:block;margin:0 auto;" />
                        </td>
                    </tr>

                    {# Icon Banner — Red for cancellation #}
                    <tr>
                        <td style="background-color:#7f1d1d;padding:24px 40px;text-align:center;">
                            <table role="presentation" cellpadding="0" cellspacing="0" align="center">
                                <tr>
                                    <td style="background-color:rgba(255,255,255,0.15);border-radius:50%;width:52px;height:52px;text-align:center;vertical-align:middle;">
                                        <svg width="28" height="28" fill="none" stroke="#ffffff" viewBox="0 0 24 24" style="display:inline-block;vertical-align:middle;margin-top:12px;">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4v2m0 4v2m0-16v2m0 0a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                    </td>
                                    <td style="padding-left:14px;text-align:left;">
                                        <p style="margin:0;color:#ffffff;font-size:18px;font-weight:700;letter-spacing:-0.01em;">Annulation d'un événement</p>
                                        <p style="margin:4px 0 0;color:rgba(255,255,255,0.75);font-size:13px;">Notification importante</p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    {# Body #}
                    <tr>
                        <td style="background-color:#ffffff;padding:36px 40px;">
                            <p style="margin:0 0 8px;font-size:15px;color:#374151;">Bonjour,</p>
                            <p style="margin:0 0 28px;font-size:15px;color:#374151;line-height:1.6;">
                                Nous vous informons que l'événement <strong>{{ event.titre ?? event.title }}</strong> prévu le <strong>{{ event.dateEvenement|date('d/m/Y') }}</strong> a été annulé.
                            </p>

                            {# Info box — Red for cancellation #}
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:24px;">
                                <tr>
                                    <td style="background-color:#fef2f2;border-left:4px solid #dc2626;border-radius:0 8px 8px 0;padding:16px 18px;">
                                        <table role="presentation" cellpadding="0" cellspacing="0">
                                            <tr>
                                                <td style="vertical-align:top;padding-right:10px;padding-top:2px;">
                                                    <svg width="18" height="18" fill="none" stroke="#b91c1c" viewBox="0 0 24 24" style="display:block;">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16H5v-4m0-5H3m18 0h-2m0 0V7m0 4h2m-6 0h6m0 0v4m0 0v2m0-6V7"/>
                                                    </svg>
                                                </td>
                                                <td style="color:#7f1d1d;font-size:14px;line-height:1.6;">
                                                    <strong style="display:block;margin-bottom:4px;color:#b91c1c;">Événement annulé</strong>
                                                    Nous nous excusons pour tout inconvénient causé.
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            {# Support text #}
                            <p style="margin:0;font-size:14px;color:#6b7280;line-height:1.6;">
                                Si vous avez des questions concernant cette annulation, n'hésitez pas à nous <a href="mailto:support@agrilink.com" style="color:#dc2626;text-decoration:none;font-weight:600;">contacter</a>.
                            </p>
                        </td>
                    </tr>

                    {# Footer #}
                    <tr>
                        <td style="background-color:#f9fafb;border-top:1px solid #e5e7eb;padding:20px 40px;text-align:center;">
                            <p style="margin:0 0 4px;font-size:12px;color:#6b7280;">Cet email a été envoyé automatiquement par AgriLink.</p>
                            <p style="margin:12px 0 0;font-size:11px;color:#d1d5db;">&copy; {{ "now"|date("Y") }} AgriLink — La plateforme agricole de confiance</p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>
