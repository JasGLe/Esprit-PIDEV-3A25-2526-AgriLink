<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mot de passe modifié - AgriLink</title>
</head>
<body style="margin:0;padding:0;background-color:#f1f5f1;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;color:#1a1a1a;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f1f5f1;">
        <tr>
            <td align="center" style="padding:40px 16px;">
                <table role="presentation" width="100%" style="max-width:600px;border-radius:16px;overflow:hidden;box-shadow:0 4px 24px rgba(0,0,0,0.08);" cellpadding="0" cellspacing="0">

                    {# Logo Header #}
                    <tr>
                        <td style="background-color:#ffffff;padding:28px 40px 20px;text-align:center;border-bottom:3px solid #16a34a;">
                            <img src="{{ absolute_url(asset('logo_with_text.png')) }}" alt="AgriLink" style="height:56px;width:auto;display:block;margin:0 auto;" />
                        </td>
                    </tr>

                    {# Icon Banner #}
                    <tr>
                        <td style="background-color:#166534;padding:24px 40px;text-align:center;">
                            <table role="presentation" cellpadding="0" cellspacing="0" align="center">
                                <tr>
                                    <td style="background-color:rgba(255,255,255,0.15);border-radius:50%;width:52px;height:52px;text-align:center;vertical-align:middle;">
                                        <svg width="26" height="26" fill="none" stroke="#ffffff" viewBox="0 0 24 24" style="display:inline-block;vertical-align:middle;margin-top:13px;">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                    </td>
                                    <td style="padding-left:14px;text-align:left;">
                                        <p style="margin:0;color:#ffffff;font-size:18px;font-weight:700;letter-spacing:-0.01em;">Mot de passe modifié</p>
                                        <p style="margin:4px 0 0;color:rgba(255,255,255,0.75);font-size:13px;">Votre mot de passe a été mis à jour avec succès</p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    {# Body #}
                    <tr>
                        <td style="background-color:#ffffff;padding:36px 40px;">
                            <p style="margin:0 0 8px;font-size:15px;color:#374151;">Bonjour <strong>{{ user.displayName }}</strong>,</p>
                            <p style="margin:0 0 28px;font-size:15px;color:#374151;line-height:1.6;">
                                Votre mot de passe AgriLink a été modifié avec succès.
                            </p>

                            {# Event details #}
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:24px;background-color:#f9fafb;border-radius:10px;overflow:hidden;">
                                <tr>
                                    <td style="padding:20px 24px;">
                                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                                            <tr>
                                                <td style="padding:8px 0;border-bottom:1px solid #e5e7eb;">
                                                    <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                                                        <tr>
                                                            <td style="width:40%;vertical-align:middle;">
                                                                <table role="presentation" cellpadding="0" cellspacing="0">
                                                                    <tr>
                                                                        <td style="padding-right:8px;vertical-align:middle;">
                                                                            <svg width="14" height="14" fill="none" stroke="#6b7280" viewBox="0 0 24 24" style="display:block;">
                                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                                                            </svg>
                                                                        </td>
                                                                        <td style="font-size:13px;font-weight:600;color:#6b7280;">Date</td>
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                            <td style="font-size:13px;color:#111827;font-weight:500;">{{ date|date('d/m/Y à H:i') }}</td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td style="padding:8px 0;">
                                                    <table role="presentation" cellpadding="0" cellspacing="0" width="100%">
                                                        <tr>
                                                            <td style="width:40%;vertical-align:middle;">
                                                                <table role="presentation" cellpadding="0" cellspacing="0">
                                                                    <tr>
                                                                        <td style="padding-right:8px;vertical-align:middle;">
                                                                            <svg width="14" height="14" fill="none" stroke="#6b7280" viewBox="0 0 24 24" style="display:block;">
                                                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                                                            </svg>
                                                                        </td>
                                                                        <td style="font-size:13px;font-weight:600;color:#6b7280;">Email du compte</td>
                                                                    </tr>
                                                                </table>
                                                            </td>
                                                            <td style="font-size:13px;color:#111827;font-weight:500;">{{ user.email }}</td>
                                                        </tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            {# Security alert #}
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:24px;">
                                <tr>
                                    <td style="background-color:#fef9c3;border-left:4px solid #eab308;border-radius:0 8px 8px 0;padding:16px 18px;">
                                        <table role="presentation" cellpadding="0" cellspacing="0">
                                            <tr>
                                                <td style="vertical-align:top;padding-right:10px;padding-top:2px;">
                                                    <svg width="18" height="18" fill="none" stroke="#92400e" viewBox="0 0 24 24" style="display:block;">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                                                    </svg>
                                                </td>
                                                <td style="color:#78350f;font-size:14px;line-height:1.6;">
                                                    <strong style="display:block;margin-bottom:4px;color:#92400e;">Important</strong>
                                                    Si vous n'êtes pas à l'origine de ce changement, veuillez contacter immédiatement notre support ou réinitialiser votre mot de passe.
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <p style="margin:0;font-size:14px;color:#6b7280;line-height:1.6;">
                                Pour toute question ou assistance, n'hésitez pas à nous contacter.
                            </p>
                        </td>
                    </tr>

                    {# Footer #}
                    <tr>
                        <td style="background-color:#f9fafb;border-top:1px solid #e5e7eb;padding:20px 40px;text-align:center;">
                            <p style="margin:0 0 4px;font-size:12px;color:#6b7280;">Cet email a été envoyé automatiquement par AgriLink.</p>
                            <p style="margin:12px 0 0;font-size:11px;color:#d1d5db;">&copy; {{ "now"|date("Y") }} AgriLink. Tous droits réservés.</p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>
</body>
</html>
