                        margin-left: 16rem;
                        transition: margin-left 0.25s ease;
                    }
                    .dashboard-main-content.sidebar-collapsed {
                        margin-left: 4rem;
                    }
                }
            </style>
            <div class="dashboard-main-content">
                {# Top header #}
                <header class="d-none d-lg-flex align-items-center justify-content-between bg-white border-bottom border-secondary px-4" style="height: 4rem;">
                    <div>
                        <h1 class="fs-5 fw-semibold text-dark mb-0">{% block page_title %}Tableau de bord{% endblock %}</h1>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        {# Notifications placeholder #}
                        <button type="button" class="btn btn-link text-secondary p-0">
                            <svg style="width: 1.5rem; height: 1.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                            </svg>
                        </button>

                        {# User dropdown #}
