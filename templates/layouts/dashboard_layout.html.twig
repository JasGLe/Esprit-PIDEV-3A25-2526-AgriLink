{% extends 'base.html.twig' %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    {# Mobile sidebar toggle #}
    <div class="lg:hidden fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-200">
        <div class="flex items-center justify-between px-4 h-16">
            <a href="{{ path('app_dashboard') }}" class="flex items-center space-x-2">
                <img src="{{ asset('logo_without_text.png') }}" alt="AgriLink" class="logo logo-nav">
                <span class="text-xl font-bold text-primary-600">AgriLink</span>
            </a>
            <button type="button" onclick="document.getElementById('mobile-sidebar').classList.toggle('hidden')" class="text-gray-500 hover:text-gray-700">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        </div>
    </div>

    {# Mobile sidebar overlay #}
    <div id="mobile-sidebar" class="lg:hidden hidden fixed inset-0 z-40">
        <div class="fixed inset-0 bg-gray-600 bg-opacity-75" onclick="document.getElementById('mobile-sidebar').classList.add('hidden')"></div>
        <div class="fixed inset-y-0 left-0 flex flex-col w-64 bg-white">
            <div class="h-16 flex items-center justify-between px-4 border-b border-gray-200">
                <a href="{{ path('app_dashboard') }}" class="flex items-center space-x-2">
                    <img src="{{ asset('logo_without_text.png') }}" alt="AgriLink" class="logo logo-nav">
                    <span class="text-xl font-bold text-primary-600">AgriLink</span>
                </a>
                <button type="button" onclick="document.getElementById('mobile-sidebar').classList.add('hidden')" class="text-gray-500">
                    <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <nav class="flex-1 px-2 py-4 space-y-1 overflow-y-auto">
                {# Same navigation as desktop #}
                <a href="{{ path('app_dashboard') }}" class="flex items-center px-3 py-2 text-sm font-medium rounded-md {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'bg-primary-100 text-primary-900' : 'text-gray-700 hover:bg-gray-100' }}">
                    <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                    </svg>
                    Tableau de bord
                </a>

                <a href="{{ path('app_profile') }}" class="flex items-center px-3 py-2 text-sm font-medium rounded-md {{ app.request.attributes.get('_route') starts with 'app_profile' ? 'bg-primary-100 text-primary-900' : 'text-gray-700 hover:bg-gray-100' }}">
                    <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    Mon profil
                </a>

                {% if is_granted('ROLE_ADMIN') %}
                    <hr class="my-3 border-gray-200">
                    <div class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                        Administration
                    </div>
                    
                    <a href="{{ path('admin_dashboard') }}" class="flex items-center px-3 py-2 text-sm font-medium rounded-md {{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'bg-primary-100 text-primary-900' : 'text-gray-700 hover:bg-gray-100' }}">
                        <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                        Tableau de bord admin
                    </a>
                    
                    <a href="{{ path('admin_users_list') }}" class="flex items-center px-3 py-2 text-sm font-medium rounded-md {{ app.request.attributes.get('_route') starts with 'admin_users' ? 'bg-primary-100 text-primary-900' : 'text-gray-700 hover:bg-gray-100' }}">
                        <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        Gestion des utilisateurs
                    </a>

                    <a href="{{ path('admin_security_logs') }}" class="flex items-center px-3 py-2 text-sm font-medium rounded-md {{ app.request.attributes.get('_route') starts with 'admin_security' ? 'bg-primary-100 text-primary-900' : 'text-gray-700 hover:bg-gray-100' }}">
                        <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                        Sécurité
                    </a>
                {% endif %}
            </nav>
        </div>
    </div>

    <div class="flex">
        {# Desktop Sidebar #}
        <aside class="hidden lg:flex lg:flex-shrink-0 lg:fixed lg:inset-y-0 lg:z-40">
            <div class="flex flex-col w-64">
                <div class="flex flex-col h-full bg-white border-r border-gray-200">
                    {# Logo #}
                    <div class="h-16 flex items-center px-4 border-b border-gray-200">
                        <a href="{{ path('app_dashboard') }}" class="flex items-center space-x-2">
                            <img src="{{ asset('logo_without_text.png') }}" alt="AgriLink" class="logo logo-nav">
                            <span class="text-xl font-bold text-primary-600">AgriLink</span>
                        </a>
                    </div>

                    {# User info in sidebar #}
                    <div class="px-4 py-4 border-b border-gray-200">
                        <div class="flex items-center space-x-3">
                            {{ include('components/_avatar.html.twig', {user: app.user, size: 'medium'}) }}
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-gray-900 truncate">{{ app.user.displayName }}</p>
                                <p class="text-xs text-gray-500 truncate">{{ app.user.email }}</p>
                            </div>
                        </div>
                        <div class="mt-2">
                            {% block role_badge %}
                                {# Display highest priority role #}
                                {% set displayRole = 'ROLE_USER' %}
                                {% if is_granted('ROLE_ADMIN') %}
                                    {% set displayRole = 'ROLE_ADMIN' %}
                                {% elseif is_granted('ROLE_AGRIPLUS') %}
                                    {% set displayRole = 'ROLE_AGRIPLUS' %}
                                {% elseif is_granted('ROLE_FOURNISSEUR') %}
                                    {% set displayRole = 'ROLE_FOURNISSEUR' %}
                                {% elseif is_granted('ROLE_AGRICULTEUR') %}
                                    {% set displayRole = 'ROLE_AGRICULTEUR' %}
                                {% endif %}
                                {{ include('components/_role_badge.html.twig', {role: displayRole}) }}
                            {% endblock %}
                        </div>
                    </div>

                    {# Navigation #}
                    <nav class="flex-1 px-2 py-4 space-y-1 overflow-y-auto">
                        {# Dashboard link #}
                        <a href="{{ path('app_dashboard') }}" class="flex items-center px-3 py-2 text-sm font-medium rounded-md {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'bg-primary-100 text-primary-900' : 'text-gray-700 hover:bg-gray-100' }}">
                            <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                            </svg>
                            Tableau de bord
                        </a>

                        {# Profile link #}
                        <a href="{{ path('app_profile') }}" class="flex items-center px-3 py-2 text-sm font-medium rounded-md {{ app.request.attributes.get('_route') starts with 'app_profile' ? 'bg-primary-100 text-primary-900' : 'text-gray-700 hover:bg-gray-100' }}">
                            <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            Mon profil
                        </a>

                        {# Admin section - only show if user is admin #}
                        {% if is_granted('ROLE_ADMIN') %}
                            <hr class="my-3 border-gray-200">
                            <div class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                Administration
                            </div>
                            
                            <a href="{{ path('admin_dashboard') }}" class="flex items-center px-3 py-2 text-sm font-medium rounded-md {{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'bg-primary-100 text-primary-900' : 'text-gray-700 hover:bg-gray-100' }}">
                                <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                                </svg>
                                Tableau de bord admin
                            </a>
                            
                            <a href="{{ path('admin_users_list') }}" class="flex items-center px-3 py-2 text-sm font-medium rounded-md {{ app.request.attributes.get('_route') starts with 'admin_users' ? 'bg-primary-100 text-primary-900' : 'text-gray-700 hover:bg-gray-100' }}">
                                <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                                Gestion des utilisateurs
                            </a>

                            <a href="{{ path('admin_security_logs') }}" class="flex items-center px-3 py-2 text-sm font-medium rounded-md {{ app.request.attributes.get('_route') starts with 'admin_security' ? 'bg-primary-100 text-primary-900' : 'text-gray-700 hover:bg-gray-100' }}">
                                <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                </svg>
                                Sécurité
                            </a>
                        {% endif %}
                    </nav>

                    {# Logout at bottom #}
                    <div class="border-t border-gray-200 p-4">
                        <a href="{{ path('app_logout') }}" class="flex items-center px-3 py-2 text-sm font-medium text-red-600 rounded-md hover:bg-red-50">
                            <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                            Déconnexion
                        </a>
                    </div>
                </div>
            </div>
        </aside>

        {# Main content area #}
        <div class="lg:pl-64 flex flex-col flex-1">
            {# Top header #}
            <header class="hidden lg:flex h-16 bg-white border-b border-gray-200 items-center justify-between px-6">
                <div>
                    <h1 class="text-lg font-semibold text-gray-900">{% block page_title %}Tableau de bord{% endblock %}</h1>
                </div>
                <div class="flex items-center space-x-4">
                    {# Notifications placeholder #}
                    <button type="button" class="text-gray-400 hover:text-gray-500">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                        </svg>
                    </button>

                    {# User dropdown #}
                    <div class="relative group">
                        <button type="button" class="flex items-center space-x-2 focus:outline-none">
                            {{ include('components/_avatar.html.twig', {user: app.user, size: 'small'}) }}
                            <svg class="h-4 w-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </button>
                        <div class="hidden group-hover:block absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-50 border border-gray-200">
                            <div class="px-4 py-2 border-b border-gray-100">
                                <p class="text-sm font-medium text-gray-900">{{ app.user.displayName }}</p>
                                <p class="text-xs text-gray-500">{{ app.user.email }}</p>
                            </div>
                            <a href="{{ path('app_profile') }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Mon profil</a>
                            <a href="{{ path('app_profile_edit') }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Paramètres</a>
                            <hr class="my-1">
                            <a href="{{ path('app_logout') }}" class="block px-4 py-2 text-sm text-red-600 hover:bg-gray-100">Déconnexion</a>
                        </div>
                    </div>
                </div>
            </header>

            {# Main content #}
            <main class="flex-1 pt-16 lg:pt-0">
                {# Flash messages #}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        {{ include('components/_flash.html.twig', {type: label, message: message}) }}
                    {% endfor %}
                {% endfor %}

                <div class="py-6">
                    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                        {% block dashboard_content %}{% endblock %}
                    </div>
                </div>
            </main>
        </div>
    </div>
</div>
{% endblock %}
