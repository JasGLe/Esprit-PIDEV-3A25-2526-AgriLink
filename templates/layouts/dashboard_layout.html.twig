#desktop-sidebar {
    overflow: hidden !important;
    transition: width 0.28s cubic-bezier(0.4, 0, 0.2, 1) !important;
}
#desktop-sidebar.collapsed {
    width: 4rem !important;
}

/* Collapsed nav items – uniform icon buttons */
#desktop-sidebar.collapsed #sidebar-nav a {
    justify-content: center !important;
    width: 2.5rem !important;
    height: 2.5rem !important;
    padding: 0 !important;
    margin: 2px auto !important;
    border-radius: 8px !important;
    display: flex !important;
    align-items: center !important;
}
#desktop-sidebar.collapsed #sidebar-nav a svg {
    margin-right: 0 !important;
    flex-shrink: 0;
}
#desktop-sidebar.collapsed #sidebar-nav a .small {
    display: none !important;
}
/* Show thin HRs as group separators when collapsed */
#desktop-sidebar.collapsed #sidebar-nav hr {
    display: block !important;
    margin: 6px 10px !important;
    opacity: 0.25 !important;
}
/* Hide section label divs */
#desktop-sidebar.collapsed #sidebar-nav > div {
    display: none !important;
}
/* Hide user info & logo text */
#desktop-sidebar.collapsed .sidebar-hide {
    display: none !important;
}
/* Logo centering when collapsed */
#desktop-sidebar.collapsed .sidebar-logo-link {
    justify-content: center !important;
}
/* Logout centered when collapsed */
#desktop-sidebar.collapsed .sidebar-logout-link {
    justify-content: center !important;
    width: 2.5rem !important;
    height: 2.5rem !important;
    padding: 0 !important;
    margin: 0 auto !important;
    border-radius: 8px !important;
    display: flex !important;
    align-items: center !important;
}
#desktop-sidebar.collapsed .sidebar-logout-link svg {
    margin-right: 0 !important;
}
/* Toggle icon flip when collapsed */
#desktop-sidebar.collapsed #sidebar-toggle-icon {
    transform: scaleX(-1);
}
/* Tooltip on collapsed nav items */
#desktop-sidebar.collapsed #sidebar-nav a {
    position: relative;
}
#desktop-sidebar.collapsed #sidebar-nav a[title]:hover::after {
    content: attr(title);
    position: fixed;
    left: 4.5rem;
    background: #1f2937;
    color: #fff;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 0.75rem;
    white-space: nowrap;
    z-index: 9999;
    pointer-events: none;
    box-shadow: 0 2px 8px rgba(0,0,0,0.18);
}
/* Dashboard main content transition */
.dashboard-main-content {
    transition: margin-left 0.28s cubic-bezier(0.4, 0, 0.2, 1) !important;
}
</style>

<script>
(function () {
    // ── Sidebar collapse ──
    const sidebar = document.getElementById('desktop-sidebar');
    const mainContent = document.querySelector('.dashboard-main-content');
    const nav = document.getElementById('sidebar-nav');
    const toggleBtn = document.getElementById('sidebar-toggle');

    function applySidebarState(collapsed, animate) {
        if (!sidebar || !mainContent) return;
        if (collapsed) {
            sidebar.classList.add('collapsed');
            sidebar.style.width = '4rem';
            mainContent.classList.add('sidebar-collapsed');
        } else {
            sidebar.classList.remove('collapsed');
            sidebar.style.width = '16rem';
            mainContent.classList.remove('sidebar-collapsed');
        }
    }

    // Init from localStorage
    var isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
    // Disable transitions on initial load to avoid flash
    if (sidebar) sidebar.style.transition = 'none';
    if (mainContent) mainContent.style.transition = 'none';
    applySidebarState(isCollapsed, false);
    // Re-enable transitions after initial paint
    requestAnimationFrame(function () {
        requestAnimationFrame(function () {
            if (sidebar) sidebar.style.transition = '';
            if (mainContent) mainContent.style.transition = '';
        });
    });

    if (toggleBtn) {
        toggleBtn.addEventListener('click', function () {
            var nowCollapsed = !sidebar.classList.contains('collapsed');
            localStorage.setItem('sidebarCollapsed', nowCollapsed ? 'true' : 'false');
            applySidebarState(nowCollapsed, true);
        });
    }

    // ── Sidebar scroll position persistence ──
    var scrollKey = 'sidebarScrollTop';
    if (nav) {
        // Restore scroll position
        var savedScroll = parseInt(localStorage.getItem(scrollKey) || '0', 10);
        nav.scrollTop = savedScroll;

        // Save scroll position on every scroll
        nav.addEventListener('scroll', function () {
            localStorage.setItem(scrollKey, nav.scrollTop);
        });
    }

    // Scroll to active link if not already visible
    if (nav) {
        var activeLink = nav.querySelector('a.text-success, a.fw-medium.text-success');
        if (activeLink && savedScroll === 0) {
            activeLink.scrollIntoView({ block: 'nearest' });
        }
    }
})();
</script>
{% endblock %}
