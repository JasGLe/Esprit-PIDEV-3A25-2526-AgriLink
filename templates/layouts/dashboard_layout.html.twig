{% extends 'base.html.twig' %}

{% block body %}
<div class="min-vh-100 bg-light">
    {# Mobile sidebar toggle #}
    <div class="d-lg-none position-fixed top-0 start-0 end-0 bg-white border-bottom border-secondary" style="z-index: 1050;">
        <div class="d-flex align-items-center justify-content-between px-4" style="height: 4rem;">
            <a href="{{ path('app_dashboard') }}" class="d-flex align-items-center gap-2 text-decoration-none">
                <img src="{{ asset('logo_without_text.png') }}" alt="AgriLink" class="logo logo-nav">
                <span class="fs-4 fw-bold text-success">AgriLink</span>
            </a>
            <button type="button" onclick="document.getElementById('mobile-sidebar').classList.toggle('d-none')" class="btn btn-link text-secondary p-0">
                <svg style="width: 1.5rem; height: 1.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                </svg>
            </button>
        </div>
    </div>

    {# Mobile sidebar overlay #}
    <div id="mobile-sidebar" class="d-lg-none d-none position-fixed top-0 bottom-0 start-0 end-0" style="z-index: 1040;">
        <div class="position-fixed top-0 bottom-0 start-0 end-0 bg-dark bg-opacity-75" onclick="document.getElementById('mobile-sidebar').classList.add('d-none')"></div>
        <div class="position-fixed top-0 bottom-0 start-0 d-flex flex-column bg-white" style="width: 16rem;">
            <div class="d-flex align-items-center justify-content-between px-4 border-bottom border-secondary" style="height: 4rem;">
                <a href="{{ path('app_dashboard') }}" class="d-flex align-items-center gap-2 text-decoration-none">
                    <img src="{{ asset('logo_without_text.png') }}" alt="AgriLink" class="logo logo-nav">
                    <span class="fs-4 fw-bold text-success">AgriLink</span>
                </a>
                <button type="button" onclick="document.getElementById('mobile-sidebar').classList.add('d-none')" class="btn btn-link text-secondary p-0">
                    <svg style="width: 1.5rem; height: 1.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <nav class="flex-fill px-2 py-3 overflow-auto" style="gap: 0.25rem;"">
                {# Same navigation as desktop #}
                <a href="{{ path('app_dashboard') }}" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                    <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                    </svg>
                    <span class="small fw-medium">Tableau de bord</span>
                </a>

                <a href="{{ path('app_profile') }}" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') starts with 'app_profile' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                    <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    <span class="small fw-medium">Mon profil</span>
                </a>

                <hr class="my-3 border-secondary">
                <div class="px-3 py-2 text-muted text-uppercase small fw-semibold" style="letter-spacing: 0.05em;">
                    Espaces Metiers
                </div>

                <a href="{{ path('activite_list') }}" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') starts with 'activite_' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                    <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V7m0 9v-1m0-11a9 9 0 100 18 9 9 0 000-18z" />
                    </svg>
                    <span class="small fw-medium">Activités</span>
                </a>

                <a href="{{ path('evenement_list') }}" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') starts with 'evenement_' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                    <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span class="small fw-medium">Événements</span>
                </a>

              {# ── GESTION AGRICOLE ── #}
                <hr class="my-2 border-secondary opacity-25">
                <div class="px-3 py-1 text-muted text-uppercase small fw-semibold" style="letter-spacing: 0.05em; font-size: 0.65rem;">
                    Gestion Agricole
                </div>
                <a href="{{ path('exploitation_index') }}" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') starts with 'exploitation' or app.request.attributes.get('_route') starts with 'parcelle' or app.request.attributes.get('_route') starts with 'culture' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                    <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="small fw-medium">Mes Exploitations</span>
                </a>
                <a href="#" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') starts with 'carte' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                    <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                    </svg>
                    <span class="small fw-medium">Carte Exploitations</span>
                </a>
                <a href="#" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') starts with 'statistique' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                    <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                    </svg>
                    <span class="small fw-medium">Statistiques Agricoles</span>
                </a>
                {# ── FIN  ── #}

                {% if is_granted('ROLE_ADMIN') %}
                    <hr class="my-3 border-secondary">
                    <div class="px-3 py-2 text-muted text-uppercase small fw-semibold" style="letter-spacing: 0.05em;">
                        Administration
                    </div>
                    
                    <a href="{{ path('admin_dashboard') }}" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                        <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                        </svg>
                        <span class="small fw-medium">Tableau de bord admin</span>
                    </a>
                    
                    <a href="{{ path('admin_users_list') }}" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') starts with 'admin_users' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                        <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                        </svg>
                        <span class="small fw-medium">Gestion des utilisateurs</span>
                    </a>

                    <a href="{{ path('admin_security_logs') }}" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') starts with 'admin_security' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                        <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                        <span class="small fw-medium">Sécurité</span>
                    </a>
                {% endif %}
            </nav>
        </div>
    </div>

    <div class="d-flex">
        {# Desktop Sidebar #}
        <aside class="d-none d-lg-flex flex-shrink-0 position-fixed top-0 bottom-0" style="z-index: 1040;">
            <div class="d-flex flex-column" style="width: 16rem;">
                <div class="d-flex flex-column h-100 bg-white border-end border-secondary">
                    {# Logo #}
                    <div class="d-flex align-items-center px-4 border-bottom border-secondary" style="height: 4rem;">
                        <a href="{{ path('app_dashboard') }}" class="d-flex align-items-center gap-2 text-decoration-none">
                            <img src="{{ asset('logo_without_text.png') }}" alt="AgriLink" class="logo logo-nav">
                            <span class="fs-4 fw-bold text-success">AgriLink</span>
                        </a>
                    </div>

                    {# User info in sidebar #}
                    <div class="px-4 py-4 border-bottom border-secondary">
                        <div class="d-flex align-items-center gap-3">
                            {{ include('components/_avatar.html.twig', {user: app.user, size: 'medium'}) }}
                            <div class="flex-fill text-truncate">
                                <p class="small fw-medium text-dark mb-0 text-truncate">{{ app.user.displayName }}</p>
                                <p class="text-muted mb-0 text-truncate" style="font-size: 0.75rem;">{{ app.user.email }}</p>
                            </div>
                        </div>
                        <div class="mt-2">
                            {% block role_badge %}
                                {# Display highest priority role #}
                                {% set displayRole = 'ROLE_USER' %}
                                {% if is_granted('ROLE_ADMIN') %}
                                    {% set displayRole = 'ROLE_ADMIN' %}
                                {% elseif is_granted('ROLE_AGRIPLUS') %}
                                    {% set displayRole = 'ROLE_AGRIPLUS' %}
                                {% elseif is_granted('ROLE_FOURNISSEUR') %}
                                    {% set displayRole = 'ROLE_FOURNISSEUR' %}
                                {% elseif is_granted('ROLE_AGRICULTEUR') %}
                                    {% set displayRole = 'ROLE_AGRICULTEUR' %}
                                {% endif %}
                                {{ include('components/_role_badge.html.twig', {role: displayRole}) }}
                            {% endblock %}
                        </div>
                    </div>

                    {# Navigation #}
                    <nav class="flex-fill px-2 py-3 overflow-auto">
                        {# Dashboard link #}
                        <a href="{{ path('app_dashboard') }}" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                            <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                            </svg>
                            <span class="small fw-medium">Tableau de bord</span>
                        </a>

                        {# Profile link #}
                        <a href="{{ path('app_profile') }}" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') starts with 'app_profile' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                            <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            <span class="small fw-medium">Mon profil</span>
                        </a>

                        <hr class="my-3 border-secondary">
                        <div class="px-3 py-2 text-muted text-uppercase small fw-semibold" style="letter-spacing: 0.05em;">
                            Espaces Metiers
                        </div>

                        <a href="{{ path('activite_list') }}" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') starts with 'activite_' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                            <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8V7m0 9v-1m0-11a9 9 0 100 18 9 9 0 000-18z" />
                            </svg>
                            <span class="small fw-medium">Activités</span>
                        </a>

                        <a href="{{ path('evenement_list') }}" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') starts with 'evenement_' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                            <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <span class="small fw-medium">Événements</span>
                        </a>

                       {# ── GESTION AGRICOLE ── #}
                        <hr class="my-2 border-secondary opacity-25">
                        <div class="px-3 py-1 text-muted text-uppercase small fw-semibold" style="letter-spacing: 0.05em; font-size: 0.65rem;">
                            Gestion Agricole
                        </div>
                        <a href="{{ path('exploitation_index') }}" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') starts with 'exploitation' or app.request.attributes.get('_route') starts with 'parcelle' or app.request.attributes.get('_route') starts with 'culture' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                            <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                            <span class="small fw-medium">Mes Exploitations</span>
                        </a>
                        <a href="#" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') starts with 'carte' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                            <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                            </svg>
                            <span class="small fw-medium">Carte Exploitations</span>
                        </a>
                        <a href="#" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') starts with 'statistique' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                            <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                            </svg>
                            <span class="small fw-medium">Statistiques Agricoles</span>
                        </a>
                        {# ── FIN ── #}

                        {# Admin section - only show if user is admin #}
                        {% if is_granted('ROLE_ADMIN') %}
                            <hr class="my-3 border-secondary">
                            <div class="px-3 py-2 text-muted text-uppercase small fw-semibold" style="letter-spacing: 0.05em;">
                                Administration
                            </div>
                            
                            <a href="{{ path('admin_dashboard') }}" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                                <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                                </svg>
                                <span class="small fw-medium">Tableau de bord admin</span>
                            </a>
                            
                            <a href="{{ path('admin_users_list') }}" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') starts with 'admin_users' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                                <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                                <span class="small fw-medium">Gestion des utilisateurs</span>
                            </a>

                            <a href="{{ path('admin_security_logs') }}" class="d-flex align-items-center px-3 py-2 text-decoration-none rounded mb-1 {{ app.request.attributes.get('_route') starts with 'admin_security' ? 'bg-success bg-opacity-10 text-success fw-medium' : 'text-dark' }}">
                                <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                </svg>
                                <span class="small fw-medium">Sécurité</span>
                            </a>
                        {% endif %}
                    </nav>

                    {# Logout at bottom #}
                    <div class="border-top border-secondary p-4">
                        <a href="{{ path('app_logout') }}" class="d-flex align-items-center px-3 py-2 text-decoration-none text-danger rounded">
                            <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                            </svg>
                            <span class="small fw-medium">Déconnexion</span>
                        </a>
                    </div>
                </div>
            </div>
        </aside>

        {# Main content area #}
        <div class="d-flex flex-column flex-fill" style="margin-left: 0;">
            <style>
                @media (min-width: 992px) {
                    .dashboard-main-content {
                        margin-left: 16rem;
                    }
                }
            </style>
            <div class="dashboard-main-content">
                {# Top header #}
                <header class="d-none d-lg-flex align-items-center justify-content-between bg-white border-bottom border-secondary px-4" style="height: 4rem;">
                    <div>
                        <h1 class="fs-5 fw-semibold text-dark mb-0">{% block page_title %}Tableau de bord{% endblock %}</h1>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        {# Notifications placeholder #}
                        <button type="button" class="btn btn-link text-secondary p-0">
                            <svg style="width: 1.5rem; height: 1.5rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                            </svg>
                        </button>

                        {# User dropdown #}
                        <div class="dropdown">
                            <button type="button" class="btn btn-link p-0 text-decoration-none d-flex align-items-center gap-2" data-bs-toggle="dropdown" aria-expanded="false">
                                {{ include('components/_avatar.html.twig', {user: app.user, size: 'small'}) }}
                                <svg style="width: 1rem; height: 1rem;" class="text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end border-secondary" style="min-width: 12rem;">
                                <li class="px-3 py-2 border-bottom">
                                    <p class="small fw-medium text-dark mb-0">{{ app.user.displayName }}</p>
                                    <p class="text-muted mb-0" style="font-size: 0.75rem;">{{ app.user.email }}</p>
                                </li>
                                <li><a href="{{ path('app_profile') }}" class="dropdown-item small">Mon profil</a></li>
                                <li><a href="{{ path('app_profile_edit') }}" class="dropdown-item small">Paramètres</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a href="{{ path('app_logout') }}" class="dropdown-item small text-danger">Déconnexion</a></li>
                            </ul>
                        </div>
                    </div>
                </header>

                {# Main content #}
                <main class="flex-fill" style="padding-top: 4rem;">
                    <style>
                        @media (min-width: 992px) {
                            .dashboard-main-wrapper {
                                padding-top: 0 !important;
                            }
                        }
                    </style>
                    <div class="dashboard-main-wrapper" style="padding-top: 4rem;">
                        {# Flash messages #}
                        {% for label, messages in app.flashes %}
                            {% for message in messages %}
                                {{ include('components/_flash.html.twig', {type: label, message: message}) }}
                            {% endfor %}
                        {% endfor %}

                        <div class="py-4">
                            <div class="container-xxl px-4">
                                {% block dashboard_content %}{% endblock %}
                            </div>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </div>
</div>
{% endblock %}
