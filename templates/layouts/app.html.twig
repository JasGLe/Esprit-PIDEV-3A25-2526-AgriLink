{% extends 'base.html.twig' %}

{% block body %}
<div class="min-vh-100 bg-light">
    {# Navbar #}
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm border-bottom">
        <div class="container-xl">
            <a href="{{ path('app_dashboard') }}" class="navbar-brand d-flex align-items-center">
                <img src="{{ asset('logo_without_text.png') }}" alt="AgriLink" class="logo logo-nav me-2">
                <span class="fs-4 fw-bold text-primary">AgriLink</span>
            </a>
            
            <div class="d-flex align-items-center">
                {# User menu #}
                {% if app.user %}
                    <div class="dropdown">
                        <button type="button" class="btn d-flex align-items-center gap-3" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-semibold" style="width: 40px; height: 40px;">
                                {{ app.user.initials }}
                            </div>
                            <div class="d-none d-md-block text-start">
                                <div class="small fw-medium text-dark">{{ app.user.displayName }}</div>
                                <div class="text-muted" style="font-size: 0.75rem;">{{ app.user.roleBadge }}</div>
                            </div>
                        </button>
                        
                        {# Dropdown menu #}
                        <ul class="dropdown-menu dropdown-menu-end shadow">
                            <li><a href="{{ path('app_profile') }}" class="dropdown-item small">Mon profil</a></li>
                            {% if is_granted('ROLE_ADMIN') %}
                                <li><a href="{{ path('admin_dashboard') }}" class="dropdown-item small">Administration</a></li>
                            {% endif %}
                            <li><hr class="dropdown-divider"></li>
                            <li><a href="{{ path('app_logout') }}" class="dropdown-item small text-danger">Déconnexion</a></li>
                        </ul>
                    </div>
                {% endif %}
            </div>
        </div>
    </nav>

    <div class="d-flex">
        {# Sidebar #}
        <aside class="d-none d-md-flex flex-shrink-0">
            <div class="d-flex flex-column" style="width: 16rem;">
                <div class="d-flex flex-column flex-fill bg-white border-end">
                    <nav class="flex-fill px-2 py-4">
                        <div class="d-flex flex-column gap-1">
                            <a href="{{ path('app_dashboard') }}" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-decoration-none {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'bg-primary bg-opacity-10 text-primary' : 'text-secondary' }}">
                                <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                                </svg>
                                Tableau de bord
                            </a>
                            
                            <a href="{{ path('app_profile') }}" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-decoration-none {{ app.request.attributes.get('_route') starts with 'app_profile' ? 'bg-primary bg-opacity-10 text-primary' : 'text-secondary' }}">
                                <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                Mon profil
                            </a>
                            
                            {% if is_granted('ROLE_ADMIN') %}
                                <hr class="my-2">
                                <div class="px-3 py-2 text-muted text-uppercase fw-semibold" style="font-size: 0.75rem; letter-spacing: 0.05em;">
                                    Administration
                                </div>
                                <a href="{{ path('admin_dashboard') }}" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-decoration-none {{ app.request.attributes.get('_route') starts with 'admin_' ? 'bg-primary bg-opacity-10 text-primary' : 'text-secondary' }}">
                                    <svg class="me-3" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                                    </svg>
                                    Administration
                                </a>
                            {% endif %}
                        </div>
                    </nav>
                </div>
            </div>
        </aside>

        {# Main content #}
        <main class="flex-fill">
            {# Flash messages #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    {{ include('components/_flash.html.twig', {type: label, message: message}) }}
                {% endfor %}
            {% endfor %}

            <div class="py-4">
                <div class="container-xl px-4 px-sm-5 px-md-4">
                    {% block page_content %}{% endblock %}
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
