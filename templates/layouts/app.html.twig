{% extends 'base.html.twig' %}

{% block body %}
<div class="min-h-screen bg-gray-50">
    {# Navbar #}
    <nav class="bg-white shadow-sm border-b border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex items-center">
                    <a href="{{ path('app_dashboard') }}" class="flex items-center space-x-2">
                        <span class="text-2xl">🌾</span>
                        <span class="text-xl font-bold text-primary-600">AgriLink</span>
                    </a>
                </div>
                
                <div class="flex items-center space-x-4">
                    {# User menu #}
                    {% if app.user %}
                        <div class="relative group">
                            <button type="button" class="flex items-center space-x-3 focus:outline-none">
                                <div class="flex items-center justify-center w-10 h-10 rounded-full bg-primary-600 text-white font-semibold">
                                    {{ app.user.initials }}
                                </div>
                                <div class="hidden md:block text-left">
                                    <div class="text-sm font-medium text-gray-700">{{ app.user.displayName }}</div>
                                    <div class="text-xs text-gray-500">{{ app.user.roleBadge }}</div>
                                </div>
                            </button>
                            
                            {# Dropdown menu #}
                            <div class="hidden group-hover:block absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-10">
                                <a href="{{ path('app_profile') }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Mon profil</a>
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('app_admin_users') }}" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100">Administration</a>
                                {% endif %}
                                <hr class="my-1">
                                <a href="{{ path('app_logout') }}" class="block px-4 py-2 text-sm text-red-600 hover:bg-gray-100">Déconnexion</a>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </nav>

    <div class="flex">
        {# Sidebar #}
        <aside class="hidden md:flex md:flex-shrink-0">
            <div class="flex flex-col w-64">
                <div class="flex flex-col h-0 flex-1 bg-white border-r border-gray-200">
                    <nav class="flex-1 px-2 py-4 space-y-1">
                        <a href="{{ path('app_dashboard') }}" class="flex items-center px-3 py-2 text-sm font-medium rounded-md {{ app.request.attributes.get('_route') == 'app_dashboard' ? 'bg-primary-100 text-primary-900' : 'text-gray-700 hover:bg-gray-100' }}">
                            <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                            </svg>
                            Tableau de bord
                        </a>
                        
                        <a href="{{ path('app_profile') }}" class="flex items-center px-3 py-2 text-sm font-medium rounded-md {{ app.request.attributes.get('_route') starts with 'app_profile' ? 'bg-primary-100 text-primary-900' : 'text-gray-700 hover:bg-gray-100' }}">
                            <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                            Mon profil
                        </a>
                        
                        {% if is_granted('ROLE_ADMIN') %}
                            <hr class="my-2 border-gray-200">
                            <div class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                Administration
                            </div>
                            <a href="{{ path('app_admin_users') }}" class="flex items-center px-3 py-2 text-sm font-medium rounded-md {{ app.request.attributes.get('_route') starts with 'app_admin' ? 'bg-primary-100 text-primary-900' : 'text-gray-700 hover:bg-gray-100' }}">
                                <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                                Utilisateurs
                            </a>
                        {% endif %}
                    </nav>
                </div>
            </div>
        </aside>

        {# Main content #}
        <main class="flex-1">
            {# Flash messages #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    {{ include('components/_flash.html.twig', {type: label, message: message}) }}
                {% endfor %}
            {% endfor %}

            <div class="py-6">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8">
                    {% block page_content %}{% endblock %}
                </div>
            </div>
        </main>
    </div>
</div>
{% endblock %}
