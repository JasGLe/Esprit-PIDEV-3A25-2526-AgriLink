{% extends 'base.html.twig' %}

{% block title %}Bienvenue sur AgriLink{% endblock %}

{% block body %}
<div class="min-vh-100 bg-gradient-primary">
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
        <div class="container-xl">
            <a class="navbar-brand d-flex align-items-center" href="{{ path('app_login') }}">
                <span class="fs-2 me-2">🌾</span>
                <span class="fs-4 fw-bold text-success">AgriLink</span>
            </a>
            <div class="d-flex gap-3">
                <a href="{{ path('app_login') }}" class="btn btn-link text-decoration-none text-gray-700 hover-primary">
                    Connexion
                </a>
                <a href="{{ path('app_register') }}" class="btn btn-success">
                    Créer un compte
                </a>
            </div>
        </div>
    </nav>

    <div class="container-xl py-5" style="padding-top: 6rem !important; padding-bottom: 6rem !important;">
        <div class="text-center">
            <h1 class="display-3 fw-bold text-dark mb-4">
                Bienvenue sur <span class="text-success">AgriLink</span>
            </h1>
            <p class="fs-5 text-gray-600 mb-4 mx-auto" style="max-width: 42rem;">
                La plateforme qui connecte agriculteurs, fournisseurs et professionnels du secteur agricole.
            </p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <a href="{{ path('app_register') }}" class="btn btn-success btn-lg px-4 py-3">
                    Commencer maintenant
                </a>
                <a href="{{ path('app_login') }}" class="btn btn-outline-secondary btn-lg px-4 py-3">
                    Se connecter
                </a>
            </div>
        </div>

        <div class="row g-4 mt-5">
            <div class="col-12 col-md-4 text-center">
                <div class="fs-1 mb-3">👨‍🌾</div>
                <h3 class="h5 fw-semibold text-dark mb-2">Pour les Agriculteurs</h3>
                <p class="text-gray-600">Gérez votre exploitation et connectez-vous avec des fournisseurs de confiance.</p>
            </div>
            <div class="col-12 col-md-4 text-center">
                <div class="fs-1 mb-3">🏭</div>
                <h3 class="h5 fw-semibold text-dark mb-2">Pour les Fournisseurs</h3>
                <p class="text-gray-600">Proposez vos produits et services aux professionnels agricoles.</p>
            </div>
            <div class="col-12 col-md-4 text-center">
                <div class="fs-1 mb-3">🤝</div>
                <h3 class="h5 fw-semibold text-dark mb-2">Réseau Professionnel</h3>
                <p class="text-gray-600">Échangez avec une communauté active d'experts du secteur.</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
