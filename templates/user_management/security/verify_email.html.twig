{% extends 'base.html.twig' %}

{% block title %}Vérification de l'email - AgriLink{% endblock %}

{% block body %}
{{ include('components/_auth_background.html.twig') }}

<style>
    .auth-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,.08), 0 1px 4px rgba(0,0,0,.04);
        padding: 2.5rem 2rem;
    }
    .email-icon-wrap {
        width: 72px; height: 72px; border-radius: 50%;
        background: linear-gradient(135deg, #ffc107, #fd7e14);
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 1.25rem;
        box-shadow: 0 4px 16px rgba(255,193,7,.35);
    }
    .email-address-pill {
        display: inline-flex; align-items: center; gap: .375rem;
        background: #f0fff4; border: 1px solid #b7ebc8;
        border-radius: 50px; padding: .3rem .875rem;
        font-size: .8125rem; font-weight: 600; color: #166534;
        max-width: 100%; overflow: hidden; text-overflow: ellipsis;
    }
    .otp-input {
        width: 13rem;
        border: 2px solid #dee2e6;
        border-radius: 12px;
        font-size: 2rem; font-family: monospace; font-weight: 700;
        text-align: center; letter-spacing: .6em;
        padding: .625rem 1rem;
        transition: border-color .15s, box-shadow .15s;
    }
    .otp-input:focus {
        border-color: #ffc107;
        box-shadow: 0 0 0 4px rgba(255,193,7,.2);
        outline: none;
    }
    .otp-input.is-valid { border-color: #198754; }
    .otp-input.is-invalid { border-color: #dc3545; }
    .timer-badge {
        display: inline-flex; align-items: center; gap: .5rem;
        padding: .4rem .875rem; border-radius: 50px;
        font-size: .8125rem; font-weight: 600; transition: all .3s;
    }
    .timer-badge.ok     { background: #d1e7dd; color: #0a3622; }
    .timer-badge.warn   { background: #fff3cd; color: #664d03; }
    .timer-badge.danger { background: #f8d7da; color: #58151c; }
    .btn-verify {
        border-radius: 10px; padding: .7rem 1.5rem; font-weight: 600;
        background: linear-gradient(135deg, #ffc107, #fd7e14);
        border: none; color: #1a1a1a;
        transition: opacity .15s, transform .1s;
    }
    .btn-verify:hover  { opacity: .9; transform: translateY(-1px); color:#000; }
    .btn-verify:active { transform: none; }
    .btn-verify:disabled { opacity: .55; transform: none; }
    .skip-link {
        font-size: .8125rem; color: #6c757d;
        text-decoration: none; transition: color .15s;
    }
    .skip-link:hover { color: #495057; }
    .alert-auth { border-radius: 10px; border: none; font-size: .875rem; }
    
    /* Verification tabs */
    .verify-tabs {
        display: flex;
        gap: 0.5rem;
        border-bottom: 2px solid #dee2e6;
        margin-bottom: 1.5rem;
    }
    
    .verify-tab-btn {
        padding: 0.75rem 1rem;
        background: none;
        border: none;
        border-bottom: 3px solid transparent;
        color: #6c757d;
        font-weight: 500;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    .verify-tab-btn:hover {
        color: #495057;
    }
    
    .verify-tab-btn.active {
        color: #ffc107;
        border-bottom-color: #ffc107;
    }
</style>

<div class="min-vh-100 d-flex align-items-center justify-content-center py-5 px-3">
    <div class="w-100" style="max-width: 420px;">

        {# Logo #}
        <div class="text-center mb-4">
            <a href="{{ path('app_home') }}">
                <img src="{{ asset('logo_with_text.png') }}" alt="AgriLink" class="logo logo-header">
            </a>
        </div>

        <div class="auth-card">
            {# Verification tabs #}
            <div class="verify-tabs">
                <button 
                    type="button" 
                    class="verify-tab-btn active"
                    data-tab="email"
                >
                    Vérifier par Email
                </button>
                <button 
                    type="button" 
                    class="verify-tab-btn"
                    data-tab="sms"
                >
                    Vérifier par SMS
                </button>
            </div>

            {# Header #}
            <div class="text-center mb-4">
                <div class="email-icon-wrap">
                    <svg fill="none" stroke="#fff" viewBox="0 0 24 24" width="32" height="32">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                </div>
                <h2 class="h5 fw-bold mb-2">Vérifiez votre adresse email</h2>
                <p class="text-muted small mb-2">Un code à 6 chiffres a été envoyé à</p>
                <span class="email-address-pill">
                    <svg fill="currentColor" viewBox="0 0 20 20" width="12" height="12">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                    {{ user.email }}
                </span>
            </div>

            {# Flash messages #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-auth d-flex align-items-start gap-2 mb-3" role="alert">
                        <svg fill="currentColor" viewBox="0 0 20 20" width="16" height="16" class="flex-shrink-0 mt-1">
                            {% if label == 'success' %}
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            {% else %}
                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                            {% endif %}
                        </svg>
                        <span>{{ message }}</span>
                    </div>
                {% endfor %}
            {% endfor %}

            {# Timer #}
            <div class="text-center mb-3">
                {% if timeRemaining > 0 %}
                    <span id="timer-badge"
                          class="timer-badge {{ timeRemaining > 60 ? 'ok' : (timeRemaining > 0 ? 'warn' : 'danger') }}">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span id="timer-text">Valide {{ (timeRemaining / 60)|round(0, 'ceil') }} min</span>
                    </span>
                {% else %}
                    <span class="timer-badge danger">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Code expiré — demandez-en un nouveau
                    </span>
                {% endif %}
            </div>

            {# OTP form #}
            <form method="post" action="{{ path('app_verify_email') }}" id="verify-form">
                <div class="d-flex flex-column align-items-center mb-4">
                    <label for="verification_code" class="form-label fw-semibold mb-3 text-center" style="font-size:.9rem;">
                        Entrez le code à 6 chiffres
                    </label>
                    <input type="text"
                           name="verification_code"
                           id="verification_code"
                           maxlength="6"
                           pattern="[0-9]{6}"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           required
                           class="otp-input"
                           placeholder="——————"
                           autofocus
                           {% if timeRemaining <= 0 %}disabled{% endif %}>
                    <div id="otp-feedback" class="form-text mt-2 text-center" style="min-height:1.2em;"></div>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit"
                            id="submit-btn"
                            class="btn btn-verify"
                            {% if timeRemaining <= 0 %}disabled{% endif %}>
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16" class="me-2">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Vérifier mon email
                    </button>
                </div>
            </form>

            {# Resend #}
            <div class="d-grid gap-2 mb-3">
                {% if canResend %}
                    <form method="post" action="{{ path('app_resend_verification') }}">
                        <button type="submit"
                                class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2"
                                style="border-radius:10px;">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                            </svg>
                            Renvoyer le code
                        </button>
                    </form>
                {% else %}
                    <button type="button"
                            id="resend-disabled"
                            disabled
                            class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2"
                            style="border-radius:10px;"
                            data-wait="{{ resendWaitSeconds }}">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span id="resend-countdown">Renvoyer dans {{ resendWaitSeconds }}s</span>
                    </button>
                    {% if resendMessage %}
                        <p class="text-center text-warning mb-0" style="font-size:.75rem;">{{ resendMessage }}</p>
                    {% endif %}
                {% endif %}
            </div>

            {# Skip #}
            <div class="pt-3 border-top">
                <a href="{{ path('app_skip_verification') }}"
                   class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2"
                   style="border-radius:10px; font-size:.875rem;">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Vérifier plus tard
                </a>
                <p class="text-center text-muted mt-2 mb-0" style="font-size:.75rem;">
                    Vous pourrez le faire depuis les paramètres de sécurité
                </p>
            </div>

            {# Help #}
            <div class="mt-3 p-3 rounded-3 text-muted" style="background:#f8f9fa; font-size:.775rem;">
                <strong>Pas reçu le code ?</strong>
                Vérifiez vos spams · Le code est valable 15 minutes · Assurez-vous que l'email est correct.
            </div>
        </div>
    </div>
</div>

<script>
let timeRemaining = {{ timeRemaining }};
let resendWait    = {{ resendWaitSeconds }};

// Handle tab switching
document.querySelectorAll('.verify-tab-btn').forEach(btn => {
    btn.addEventListener('click', function() {
        const tab = this.getAttribute('data-tab');
        document.querySelectorAll('.verify-tab-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        
        if (tab === 'sms') {
            window.location.href = '{{ path("app_verify_phone") }}';
        }
    });
});

// — Expiration timer —
function tickExpiry() {
    if (timeRemaining <= 0) {
        const badge = document.getElementById('timer-badge');
        if (badge) {
            badge.className = 'timer-badge danger';
            badge.querySelector('#timer-text').textContent = 'Code expiré — demandez-en un nouveau';
        }
        const btn = document.getElementById('submit-btn');
        const inp = document.getElementById('verification_code');
        if (btn) btn.disabled = true;
        if (inp) { inp.disabled = true; inp.classList.add('is-invalid'); }
        return;
    }
    timeRemaining--;
    const m = Math.floor(timeRemaining / 60);
    const s = timeRemaining % 60;
    const label = m > 0 ? `Valide ${m}:${String(s).padStart(2,'0')}` : `Valide ${s}s`;
    const txt = document.getElementById('timer-text');
    if (txt) txt.textContent = label;
    const badge = document.getElementById('timer-badge');
    if (badge) {
        badge.className = 'timer-badge ' + (timeRemaining > 60 ? 'ok' : timeRemaining > 30 ? 'warn' : 'danger');
    }
}
if (timeRemaining > 0) setInterval(tickExpiry, 1000);

// — Resend countdown —
function tickResend() {
    if (resendWait <= 0) { window.location.reload(); return; }
    resendWait--;
    const el = document.getElementById('resend-countdown');
    if (el) el.textContent = `Renvoyer dans ${resendWait}s`;
}
if (resendWait > 0) setInterval(tickResend, 1000);

// — OTP input UX —
document.addEventListener('DOMContentLoaded', function () {
    const inp = document.getElementById('verification_code');
    const fb  = document.getElementById('otp-feedback');
    if (!inp) return;

    inp.addEventListener('input', function () {
        this.value = this.value.replace(/\D/g, '');
        const n = this.value.length;
        if (n > 0 && n < 6) {
            this.classList.remove('is-valid','is-invalid');
            fb.textContent = `${6-n} chiffre${6-n>1?'s':''} restant${6-n>1?'s':''}`;
            fb.className = 'form-text mt-2 text-center text-muted';
        } else if (n === 6) {
            this.classList.add('is-valid');
            this.classList.remove('is-invalid');
            fb.textContent = '✓ Code complet';
            fb.className = 'form-text mt-2 text-center text-success';
            setTimeout(() => document.getElementById('verify-form').submit(), 150);
        } else {
            this.classList.remove('is-valid','is-invalid');
            fb.textContent = '';
        }
    });
    inp.focus();
});
</script>
{% endblock %}
