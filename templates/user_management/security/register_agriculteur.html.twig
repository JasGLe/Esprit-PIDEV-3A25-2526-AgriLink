{% extends 'base.html.twig' %}

{% block title %}Inscription Agriculteur - AgriLink{% endblock %}

{% block body %}
{{ include('components/_auth_background.html.twig') }}
<div class="min-vh-100 d-flex align-items-center justify-content-center py-5 px-3 px-sm-4">
    <div class="w-100" style="max-width: 600px;">
        <div>
            <div class="d-flex justify-content-center">
                <img src="{{ asset('logo_with_text.png') }}" alt="AgriLink Logo" class="logo logo-header">
            </div>
            <h2 class="mt-4 text-center display-6 fw-bold text-dark">
                Inscription Agriculteur
            </h2>
            <p class="mt-2 text-center small text-muted">
                Rejoignez la communauté AgriLink et connectez-vous avec d'autres agriculteurs
            </p>
        </div>

        {{ form_start(registrationForm, {'attr': {'class': 'mt-4', 'novalidate': 'novalidate'}}) }}
            {# Personal Information Section #}
            <div class="card shadow-sm border mb-4">
                <div class="card-body p-4">
                    <h3 class="h5 fw-medium text-dark mb-4 d-flex align-items-center">
                        <svg class="bi me-2 text-primary" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        Informations personnelles
                    </h3>
                    <div class="vstack gap-3">
                    <div>
                        {{ form_label(registrationForm.nom) }}
                        {{ form_widget(registrationForm.nom) }}
                        {{ form_errors(registrationForm.nom) }}
                    </div>

                    <div>
                        {{ form_label(registrationForm.email) }}
                        {{ form_widget(registrationForm.email) }}
                        {{ form_errors(registrationForm.email) }}
                    </div>
                    
                    <div>
                        {{ form_label(registrationForm.dateNaissance) }}
                        {{ form_widget(registrationForm.dateNaissance) }}
                        {{ form_errors(registrationForm.dateNaissance) }}
                    </div>

                    <div>
                        {{ form_label(registrationForm.plainPassword.first) }}
                        <div class="position-relative">
                            {{ form_widget(registrationForm.plainPassword.first, {
                                'attr': {
                                    'class': 'password-input',
                                    'autocomplete': 'new-password'
                                }
                            }) }}
                            <button type="button" class="password-toggle position-absolute end-0 top-50 translate-middle-y border-0 bg-transparent text-muted" style="right: 0.75rem;" onclick="togglePasswordVisibility(this)">
                                <svg class="bi eye-icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            </button>
                        </div>
                        {{ form_errors(registrationForm.plainPassword.first) }}
                        <p class="mt-1 small text-muted">Minimum 6 caractères</p>
                    </div>

                    <div>
                        {{ form_label(registrationForm.plainPassword.second) }}
                        <div class="position-relative">
                            {{ form_widget(registrationForm.plainPassword.second, {
                                'attr': {
                                    'class': 'password-input',
                                    'autocomplete': 'new-password'
                                }
                            }) }}
                            <button type="button" class="password-toggle position-absolute end-0 top-50 translate-middle-y border-0 bg-transparent text-muted" style="right: 0.75rem;" onclick="togglePasswordVisibility(this)">
                                <svg class="bi eye-icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                            </button>
                        </div>
                        {{ form_errors(registrationForm.plainPassword.second) }}
                    </div>
                </div>
            </div>

            {# Contact Information Section #}
            <div class="card shadow-sm border mb-4">
                <div class="card-body p-4">
                    <h3 class="h5 fw-medium text-dark mb-4 d-flex align-items-center">
                        <svg class="bi me-2 text-primary" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                        </svg>
                        Contact
                    </h3>
                    <div class="vstack gap-3">
                        <div>
                            {{ form_label(registrationForm.telephone) }}
                            {{ form_widget(registrationForm.telephone) }}
                            {{ form_errors(registrationForm.telephone) }}
                        </div>
                    </div>
                </div>
            </div>

            {# Location Information Section #}
            <div class="card shadow-sm border mb-4">
                <div class="card-body p-4">
                    <h3 class="h5 fw-medium text-dark mb-4 d-flex align-items-center">
                        <svg class="bi me-2 text-primary" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        Localisation
                    </h3>
                    <div class="vstack gap-3">
                        <div>
                            {{ form_label(registrationForm.gouvernant) }}
                            {{ form_widget(registrationForm.gouvernant) }}
                            {{ form_errors(registrationForm.gouvernant) }}
                        </div>

                        <div class="row g-3">
                            <div class="col-6">
                                {{ form_label(registrationForm.ville) }}
                                {{ form_widget(registrationForm.ville) }}
                                {{ form_errors(registrationForm.ville) }}
                            </div>

                            <div class="col-6">
                                {{ form_label(registrationForm.codePostale) }}
                                {{ form_widget(registrationForm.codePostale) }}
                                {{ form_errors(registrationForm.codePostale) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Professional Information Section #}
            <div class="card shadow-sm border mb-4">
                <div class="card-body p-4">
                    <h3 class="h5 fw-medium text-dark mb-4 d-flex align-items-center">
                        <svg class="bi me-2 text-primary" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                        Expérience professionnelle
                    </h3>
                    <div class="vstack gap-3">
                        <div>
                            {{ form_label(registrationForm.agriculteurExpAnnee) }}
                            {{ form_widget(registrationForm.agriculteurExpAnnee) }}
                            {{ form_errors(registrationForm.agriculteurExpAnnee) }}
                            <p class="mt-1 small text-muted">Nombre d'années d'expérience dans le domaine agricole (0-60)</p>
                        </div>
                    </div>
                </div>
            </div>

            {# Terms and Submit Section #}
            <div class="vstack gap-3">
                <div class="form-check">
                    {{ form_widget(registrationForm.agreeTerms) }}
                    {{ form_label(registrationForm.agreeTerms) }}
                </div>
                {{ form_errors(registrationForm.agreeTerms) }}

                <div class="vstack gap-3">
                    <button type="submit" class="btn btn-primary w-100 py-3 position-relative">
                        <span class="position-absolute start-0 top-50 translate-middle-y ps-3">
                            <svg class="bi" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                            </svg>
                        </span>
                        Créer mon compte Agriculteur
                    </button>

                    <a href="{{ path('app_register') }}" class="btn btn-outline-secondary w-100 py-2">
                        <svg class="bi me-2" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                        </svg>
                        Retour au choix d'inscription
                    </a>
                </div>

                <p class="text-center small text-muted">
                    Vous avez déjà un compte ?
                    <a href="{{ path('app_login') }}" class="fw-medium text-primary">
                        Connectez-vous
                    </a>
                </p>
            </div>
        {{ form_end(registrationForm) }}
    </div>
</div>

<script>
function togglePasswordVisibility(button) {
    const input = button.previousElementSibling;
    const isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';
    button.classList.toggle('opacity-50', !isPassword);
}
</script>
{% endblock %}
