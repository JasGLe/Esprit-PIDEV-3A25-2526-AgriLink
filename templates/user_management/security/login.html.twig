{% extends 'base.html.twig' %}

{% block title %}Connexion - AgriLink{% endblock %}

{% block body %}
{{ include('components/_auth_background.html.twig') }}

<style>
    .auth-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,.08), 0 1px 4px rgba(0,0,0,.04);
        padding: 2.5rem 2rem;
    }
    .auth-input-group .form-control {
        border-radius: 10px;
        padding: .625rem 1rem;
        font-size: .9rem;
        border: 1.5px solid #dee2e6;
        transition: border-color .15s, box-shadow .15s;
    }
    .auth-input-group .form-control:focus {
        border-color: #198754;
        box-shadow: 0 0 0 3px rgba(25,135,84,.12);
        outline: none;
    }
    .auth-input-group .input-group-text {
        border-radius: 10px 0 0 10px;
        border: 1.5px solid #dee2e6;
        border-right: none;
        background: #f8f9fa;
        color: #6c757d;
    }
    .auth-input-group .form-control.has-icon {
        border-radius: 0 10px 10px 0;
        border-left: none;
    }
    .auth-input-group .form-control.has-icon:focus {
        border-color: #198754;
        box-shadow: 0 0 0 3px rgba(25,135,84,.12);
    }
    .auth-input-group .input-group:focus-within .input-group-text {
        border-color: #198754;
    }
    .btn-auth-primary {
        background: linear-gradient(135deg, #198754, #20c997);
        border: none;
        border-radius: 10px;
        padding: .7rem 1.5rem;
        font-weight: 600;
        letter-spacing: .01em;
        transition: opacity .15s, transform .1s;
    }
    .btn-auth-primary:hover { opacity: .9; transform: translateY(-1px); }
    .btn-auth-primary:active { transform: translateY(0); }
    .remember-check .form-check-input:checked {
        background-color: #198754;
        border-color: #198754;
    }
    .divider-text { position: relative; text-align: center; }
    .divider-text::before {
        content: '';
        position: absolute;
        top: 50%; left: 0; right: 0;
        height: 1px; background: #dee2e6;
    }
    .divider-text span {
        position: relative;
        background: #fff;
        padding: 0 .75rem;
        color: #adb5bd;
        font-size: .8rem;
    }
    .password-toggle { cursor: pointer; }
    .alert-auth { border-radius: 10px; border: none; font-size: .875rem; }
    .lock-countdown {
        display: inline-flex; align-items: center; gap: .375rem;
        background: #fff3cd; color: #856404;
        border-radius: 6px; padding: .25rem .625rem;
        font-size: .8rem; margin-top: .5rem;
    }
</style>

<div class="min-vh-100 d-flex align-items-center justify-content-center py-5 px-3">
    <div class="w-100" style="max-width: 440px;">

        {# Logo + title #}
        <div class="text-center mb-4">
            <a href="{{ path('app_home') }}">
                <img src="{{ asset('logo_with_text.png') }}" alt="AgriLink" class="logo logo-header mb-3">
            </a>
            <h1 class="h4 fw-bold text-dark mb-1">Connexion à AgriLink</h1>
            <p class="text-muted small mb-0">
                Pas encore membre ?
                <a href="{{ path('app_register') }}" class="text-success fw-semibold text-decoration-none">
                    Créer un compte
                </a>
            </p>
        </div>

        <div class="auth-card">

            {# Error alert #}
            {% if error %}
                {% set msg = error.messageKey %}
                {% set isLocked   = 'verrouillé' in msg %}
                {% set isInactive = 'désactivé'  in msg %}

                <div class="alert {{ isLocked ? 'alert-warning' : (isInactive ? 'alert-warning' : 'alert-danger') }} alert-auth d-flex align-items-start gap-2 mb-4"
                     role="alert">
                    <div class="flex-shrink-0 mt-1">
                        {% if isLocked %}
                            <svg fill="currentColor" viewBox="0 0 20 20" width="18" height="18">
                                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
                            </svg>
                        {% elseif isInactive %}
                            <svg fill="currentColor" viewBox="0 0 20 20" width="18" height="18">
                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                            </svg>
                        {% else %}
                            <svg fill="currentColor" viewBox="0 0 20 20" width="18" height="18">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                            </svg>
                        {% endif %}
                    </div>
                    <div class="flex-fill">
                        {% if error.messageKey == 'Invalid credentials.' %}
                            <strong>Identifiants incorrects</strong>
                            <p class="mb-0 mt-1" style="font-size:.8125rem;">Vérifiez votre email et mot de passe puis réessayez.</p>
                        {% elseif isLocked %}
                            <strong>Compte temporairement verrouillé</strong>
                            <p class="mb-0 mt-1" style="font-size:.8125rem;">
                                {{ error.messageKey|trans(error.messageData, 'security') }}
                            </p>
                            <div class="lock-countdown mt-2">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                Déverrouillage automatique après le délai indiqué
                            </div>
                        {% elseif isInactive %}
                            <strong>Compte désactivé</strong>
                            <p class="mb-0 mt-1" style="font-size:.8125rem;">
                                {{ error.messageKey|trans(error.messageData, 'security') }}
                                Contactez l'assistance si nécessaire.
                            </p>
                        {% else %}
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {# Login form #}
            <form action="{{ path('app_login') }}" method="post" id="loginForm" novalidate>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                {# Email #}
                <div class="mb-3 auth-input-group">
                    <label for="email" class="form-label fw-medium" style="font-size:.85rem;">Adresse email</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        </span>
                        <input id="email"
                               name="_username"
                               type="email"
                               autocomplete="email"
                               required
                               value="{{ last_username }}"
                               class="form-control has-icon"
                               placeholder="votre@email.com">
                    </div>
                </div>

                {# Password #}
                <div class="mb-3 auth-input-group">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label for="password" class="form-label fw-medium mb-0" style="font-size:.85rem;">Mot de passe</label>
                        <a href="{{ path('app_forgot_password') }}"
                           class="text-success text-decoration-none" style="font-size:.8rem;">Oublié ?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                            </svg>
                        </span>
                        <input id="password"
                               name="_password"
                               type="password"
                               autocomplete="current-password"
                               required
                               class="form-control has-icon"
                               placeholder="••••••••"
                               style="border-radius:0 !important;">
                        <button type="button"
                                class="input-group-text bg-light border-start-0 password-toggle"
                                style="border-radius:0 10px 10px 0; border:1.5px solid #dee2e6;"
                                onclick="togglePassword(this)"
                                tabindex="-1">
                            <svg id="eyeIcon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                            </svg>
                        </button>
                    </div>
                </div>

                {# Remember me #}
                <div class="mb-4 remember-check">
                    <div class="form-check">
                        <input id="remember_me"
                               name="_remember_me"
                               type="checkbox"
                               class="form-check-input"
                               style="width:1.1em; height:1.1em; border-radius:4px;">
                        <label for="remember_me" class="form-check-label" style="font-size:.875rem;">
                            Se souvenir de mon email
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-auth-primary btn-success w-100 text-white">
                    Se connecter
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16" class="ms-2">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                    </svg>
                </button>
            </form>
        </div>

        <p class="text-center text-muted mt-4" style="font-size:.75rem;">
            En vous connectant, vous acceptez nos
            <a href="#" class="text-muted">conditions d'utilisation</a> et notre
            <a href="#" class="text-muted">politique de confidentialité</a>.
        </p>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const emailInput  = document.getElementById('email');
    const rememberChk = document.getElementById('remember_me');
    const form        = document.getElementById('loginForm');

    // Restore remembered email from cookie
    const saved = getCookie('remembered_email');
    if (saved && !emailInput.value) {
        emailInput.value = saved;
        rememberChk.checked = true;
    }

    // Save/clear remembered email on submit
    form.addEventListener('submit', function () {
        if (rememberChk.checked) {
            setCookie('remembered_email', emailInput.value, 365);
        } else {
            setCookie('remembered_email', '', -1);
        }
    });

    function setCookie(name, value, days) {
        let expires = '';
        if (days) {
            const d = new Date();
            d.setTime(d.getTime() + days * 86400000);
            expires = '; expires=' + d.toUTCString();
        }
        document.cookie = name + '=' + (value || '') + expires + '; path=/; SameSite=Lax';
    }

    function getCookie(name) {
        const prefix = name + '=';
        for (const c of document.cookie.split(';')) {
            const trimmed = c.trim();
            if (trimmed.startsWith(prefix)) return decodeURIComponent(trimmed.slice(prefix.length));
        }
        return null;
    }
});

function togglePassword(btn) {
    const input = document.getElementById('password');
    const isHidden = input.type === 'password';
    input.type = isHidden ? 'text' : 'password';
    btn.querySelector('svg').innerHTML = isHidden
        ? `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/>`
        : `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>`;
}
</script>
{% endblock %}
