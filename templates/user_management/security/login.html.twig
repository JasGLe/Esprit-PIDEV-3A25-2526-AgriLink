{% extends 'base.html.twig' %}

{% block title %}Connexion - AgriLink{% endblock %}

{% block body %}
{{ include('components/_auth_background.html.twig') }}
<div class="min-vh-100 d-flex align-items-center justify-content-center py-5 px-3 px-sm-4 px-lg-5">
    <div class="w-100" style="max-width: 448px;">
        <div class="mb-4">
            <div class="d-flex justify-content-center">
                <img src="{{ asset('logo_with_text.png') }}" alt="AgriLink Logo" class="logo logo-header">
            </div>
            <h2 class="mt-4 text-center fs-2 fw-bold text-dark">
                Connexion à AgriLink
            </h2>
            <p class="mt-2 text-center small text-secondary">
                Ou
                <a href="{{ path('app_register') }}" class="fw-medium text-primary text-decoration-none">
                    créez un compte gratuitement
                </a>
            </p>
        </div>

        {% if error %}
            {% set errorMessage = error.messageKey %}
            {% set isLocked = 'verrouillé' in errorMessage %}
            {% set isInactive = 'désactivé' in errorMessage %}
            
            <div class="alert {{ isLocked ? 'alert-warning' : (isInactive ? 'alert-warning' : 'alert-danger') }} d-flex" role="alert">
                <div class="flex-shrink-0">
                    {% if isLocked %}
                        {# Lock icon for locked accounts #}
                        <svg class="text-warning" style="height: 1.25rem; width: 1.25rem;" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
                        </svg>
                    {% elseif isInactive %}
                        {# Warning icon for inactive accounts #}
                        <svg class="text-warning" style="height: 1.25rem; width: 1.25rem;" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                        </svg>
                    {% else %}
                        {# Error icon for other errors #}
                        <svg class="text-danger" style="height: 1.25rem; width: 1.25rem;" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                        </svg>
                    {% endif %}
                </div>
                <div class="ms-3">
                    <p class="mb-0 small">
                        {% if error.messageKey == 'Invalid credentials.' %}
                            Email ou mot de passe incorrect.
                        {% elseif isLocked %}
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        {% elseif isInactive %}
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        {% else %}
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        {% endif %}
                    </p>
                    {% if isLocked %}
                        <p class="mt-2 mb-0" style="font-size: 0.75rem;">
                            <svg class="d-inline" style="height: 1rem; width: 1rem; margin-right: 0.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Votre compte sera automatiquement déverrouillé après le délai indiqué.
                        </p>
                    {% endif %}
                    {% if isInactive %}
                        <p class="mt-2 mb-0" style="font-size: 0.75rem;">
                            Si vous pensez qu'il s'agit d'une erreur, contactez le support.
                        </p>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        <form class="mt-4" action="{{ path('app_login') }}" method="post">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            
            <div class="mb-3">
                <div class="mb-3">
                    <label for="email" class="form-label">Adresse email</label>
                    <input id="email" 
                           name="_username" 
                           type="email" 
                           autocomplete="email" 
                           required 
                           value="{{ last_username }}"
                           class="form-control"
                           placeholder="votre@email.com">
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Mot de passe</label>
                    <input id="password" 
                           name="_password" 
                           type="password" 
                           autocomplete="current-password" 
                           required
                           class="form-control"
                           placeholder="••••••••">
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="form-check">
                    <input id="remember_me" 
                           name="_remember_me" 
                           type="checkbox"
                           class="form-check-input">
                    <label for="remember_me" class="form-check-label">
                        Se souvenir de moi
                    </label>
                </div>
                <div class="small">
                    <a href="{{ path('app_forgot_password') }}" class="text-primary text-decoration-none">
                        Mot de passe oublié ?
                    </a>
                </div>
            </div>

            <div>
                <button type="submit" class="btn btn-success w-100 d-flex justify-content-center align-items-center">
                    Se connecter
                </button>
            </div>
        </form>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const emailInput = document.getElementById('email');
    const rememberCheckbox = document.getElementById('remember_me');
    const loginForm = document.querySelector('form');

    // Check if there's a remembered email in cookie
    const rememberedEmail = getCookie('remembered_email');
    if (rememberedEmail && !emailInput.value) {
        emailInput.value = rememberedEmail;
        rememberCheckbox.checked = true;
    }

    // Handle form submission
    loginForm.addEventListener('submit', function(e) {
        if (rememberCheckbox.checked) {
            // Save email to cookie (1 year expiry)
            setCookie('remembered_email', emailInput.value, 365);
        } else {
            // Clear the cookie if unchecked
            setCookie('remembered_email', '', -1);
        }
    });

    // Cookie helper functions
    function setCookie(name, value, days) {
        let expires = '';
        if (days) {
            const date = new Date();
            date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
            expires = '; expires=' + date.toUTCString();
        }
        document.cookie = name + '=' + (value || '') + expires + '; path=/; SameSite=Lax';
    }

    function getCookie(name) {
        const nameEQ = name + '=';
        const ca = document.cookie.split(';');
        for (let i = 0; i < ca.length; i++) {
            let c = ca[i];
            while (c.charAt(0) === ' ') c = c.substring(1, c.length);
            if (c.indexOf(nameEQ) === 0) return c.substring(nameEQ.length, c.length);
        }
        return null;
    }
});
</script>
{% endblock %}
