{% extends 'base.html.twig' %}

{% block title %}Inscription AgriPlus - AgriLink{% endblock %}

{% block body %}
<div class="min-vh-100" style="background:#f0f4f0;">

    {# ── Green Gradient Header ─────────────────────────────── #}
    <div class="registration-header">
        <div class="header-blob-tr"></div>
        <div class="header-blob-bl"></div>

        <div class="container" style="max-width:900px; position:relative; z-index:1;">
            {# Top bar: logo + nav #}
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="d-flex align-items-center gap-3">
                    <img src="{{ asset('/logo_without_text.png') }}"
                         alt="AgriLink" class="main-logo">
                    <div>
                        <div class="logo-name">AgriLink</div>
                        <div class="logo-tagline">Plateforme Agricole</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <a href="{{ path('app_register') }}"
                       class="nav-link-header d-flex align-items-center gap-1">
                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                        </svg>
                        Retour
                    </a>
                    <a href="{{ path('app_login') }}" class="nav-link-header">Connexion</a>
                </div>
            </div>

            {# Title block #}
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                <div>
                    <span class="role-badge mb-2 d-inline-block">AgriPlus</span>
                    <h1 class="header-title mb-1">Créer votre compte AgriPlus</h1>
                    <p class="header-sub">Choisissez un plan et accédez aux outils premium de la plateforme</p>
                </div>
                <div class="d-none d-md-flex flex-column align-items-end gap-1">
                    <div class="header-stat-pill">
                        <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        Accès à toutes les fonctionnalités
                    </div>
                    <div class="header-stat-pill">
                        <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                        1 mois d'essai gratuit
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container py-4 py-lg-5" style="max-width:900px;">

        {# Flash / form errors #}
        {% for flash_message in app.flashes('error') %}
            <div class="alert alert-danger border-0 rounded-3 shadow-sm mb-4 d-flex align-items-center gap-2">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20" class="flex-shrink-0">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                {{ flash_message }}
            </div>
        {% endfor %}
        {% if registrationForm.vars.errors|length > 0 %}
            <div class="alert alert-danger border-0 rounded-3 shadow-sm mb-4">
                <ul class="mb-0 ps-3">
                    {% for error in registrationForm.vars.errors %}
                        <li>{{ error.message }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {# ── Plan Selection ──────────────────────────────────── #}
        <div class="mb-4">
            <div class="d-flex align-items-baseline justify-content-between mb-3">
                <h2 class="section-title mb-0">Choisissez votre plan</h2>
                <span class="section-sub">Tous les plans incluent 1 mois d'essai gratuit</span>
            </div>

            <div class="row g-3">
                {# Basic #}
                <div class="col-12 col-md-4">
                    <div class="plan-card" data-plan="BASIC" role="button" tabindex="0" aria-label="Sélectionner le plan Basic">
                        <div class="plan-check-mark">
                            <svg width="14" height="14" fill="none" stroke="white" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                            </svg>
                        </div>
                        <div class="plan-icon-wrap plan-icon-basic mb-3">
                            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                            </svg>
                        </div>
                        <div class="plan-name">Basic</div>
                        <div class="plan-price">29 <span class="plan-currency">DT/mois</span></div>
                        <div class="plan-desc">Parfait pour démarrer</div>
                        <ul class="plan-features mt-3">
                            <li>Outils de gestion de base</li>
                            <li>Support par email</li>
                            <li>5 annonces par mois</li>
                            <li>Statistiques simples</li>
                        </ul>
                    </div>
                </div>

                {# Premium (recommended) #}
                <div class="col-12 col-md-4">
                    <div class="plan-card plan-recommended" data-plan="PREMIUM" role="button" tabindex="0" aria-label="Sélectionner le plan Premium">
                        <div class="plan-recommended-badge">
                            <svg width="11" height="11" fill="currentColor" viewBox="0 0 20 20">
                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                            </svg>
                            RECOMMANDÉ
                        </div>
                        <div class="plan-check-mark">
                            <svg width="14" height="14" fill="none" stroke="white" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                            </svg>
                        </div>
                        <div class="plan-icon-wrap plan-icon-premium mb-3">
                            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                            </svg>
                        </div>
                        <div class="plan-name">Premium</div>
                        <div class="plan-price">59 <span class="plan-currency">DT/mois</span></div>
                        <div class="plan-desc">Le plus populaire</div>
                        <ul class="plan-features mt-3">
                            <li><strong>Tout du Basic</strong>, plus :</li>
                            <li>Annonces illimitées</li>
                            <li>Analyses avancées</li>
                            <li>Priorité dans les résultats</li>
                            <li>Support prioritaire</li>
                        </ul>
                    </div>
                </div>

                {# Enterprise #}
                <div class="col-12 col-md-4">
                    <div class="plan-card" data-plan="ENTERPRISE" role="button" tabindex="0" aria-label="Sélectionner le plan Enterprise">
                        <div class="plan-check-mark">
                            <svg width="14" height="14" fill="none" stroke="white" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                            </svg>
                        </div>
                        <div class="plan-icon-wrap plan-icon-enterprise mb-3">
                            <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                            </svg>
                        </div>
                        <div class="plan-name">Enterprise</div>
                        <div class="plan-price">149 <span class="plan-currency">DT/mois</span></div>
                        <div class="plan-desc">Solution complète</div>
                        <ul class="plan-features mt-3">
                            <li><strong>Tout du Premium</strong>, plus :</li>
                            <li>Support dédié 24/7</li>
                            <li>API complète</li>
                            <li>Multi-utilisateurs illimités</li>
                            <li>Personnalisation complète</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        {# ── Registration Form ────────────────────────────────── #}
        <div class="reg-card">
            {# Selected plan banner #}
            <div class="selected-plan-bar" id="selectedPlanBar">
                <div class="d-flex align-items-center gap-2">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span class="fw-semibold">Plan sélectionné :</span>
                    <span id="selectedPlanLabel">Premium — 59 DT/mois</span>
                </div>
                <span class="trial-badge">1 mois gratuit</span>
            </div>

            {{ form_start(registrationForm, {'attr': {'id': 'agriplus-form', 'novalidate': 'novalidate'}}) }}

                {# Hidden subscription radio buttons #}
                <div class="d-none" id="subscription-wrapper">
                    {{ form_widget(registrationForm.agriplusAbonnement) }}
                </div>
                {{ form_errors(registrationForm.agriplusAbonnement) }}

                <div class="reg-body">

                    {# Section: Identité #}
                    <div class="form-section-title">
                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                        </svg>
                        Informations personnelles
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-6">
                            <label class="reg-label" for="{{ registrationForm.nom.vars.id }}">Nom complet</label>
                            <div class="reg-input-wrap">
                                <svg class="reg-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                                {{ form_widget(registrationForm.nom, {
                                    'attr': {'class': 'reg-input', 'placeholder': 'Votre nom complet'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.nom) }}
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="reg-label" for="{{ registrationForm.email.vars.id }}">Adresse email</label>
                            <div class="reg-input-wrap">
                                <svg class="reg-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                                {{ form_widget(registrationForm.email, {
                                    'attr': {'class': 'reg-input', 'placeholder': 'votre@email.com'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.email) }}
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="reg-label" for="{{ registrationForm.telephone.vars.id }}">Téléphone <span class="text-muted fw-normal">(optionnel)</span></label>
                            <div class="reg-input-wrap">
                                <svg class="reg-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                </svg>
                                {{ form_widget(registrationForm.telephone, {
                                    'attr': {'class': 'reg-input', 'placeholder': '+216 XX XXX XXX'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.telephone) }}
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="reg-label" for="{{ registrationForm.dateNaissance.vars.id }}">Date de naissance <span class="text-muted fw-normal">(optionnel)</span></label>
                            <div class="reg-input-wrap">
                                <svg class="reg-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                                {{ form_widget(registrationForm.dateNaissance, {
                                    'attr': {'class': 'reg-input'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.dateNaissance) }}
                        </div>
                    </div>

                    {# Section: Sécurité #}
                    <div class="form-section-title">
                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                        Sécurité du compte
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-6">
                            <label class="reg-label" for="{{ registrationForm.plainPassword.first.vars.id }}">Mot de passe</label>
                            <div class="reg-input-wrap">
                                <svg class="reg-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                </svg>
                                {{ form_widget(registrationForm.plainPassword.first, {
                                    'attr': {'class': 'reg-input', 'placeholder': '••••••••', 'id': 'pwd1'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.plainPassword.first) }}
                            {# Password strength bar #}
                            <div class="pwd-strength-bar mt-2 d-flex gap-1" id="pwdStrengthBar">
                                <div class="pwd-seg" id="s1"></div>
                                <div class="pwd-seg" id="s2"></div>
                                <div class="pwd-seg" id="s3"></div>
                                <div class="pwd-seg" id="s4"></div>
                            </div>
                            <div class="pwd-strength-label" id="pwdStrengthLabel"></div>
                        </div>
                        <div class="col-12 col-md-6">
                            <label class="reg-label" for="{{ registrationForm.plainPassword.second.vars.id }}">Confirmer le mot de passe</label>
                            <div class="reg-input-wrap">
                                <svg class="reg-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                                </svg>
                                {{ form_widget(registrationForm.plainPassword.second, {
                                    'attr': {'class': 'reg-input', 'placeholder': '••••••••', 'id': 'pwd2'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.plainPassword.second) }}
                            <div class="pwd-match-label mt-1" id="pwdMatchLabel"></div>
                        </div>
                    </div>

                    {# Section: Localisation #}
                    <div class="form-section-title">
                        <svg width="15" height="15" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        Localisation <span class="text-muted fw-normal ms-1" style="font-size:.8rem;">(optionnel)</span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-12 col-md-4">
                            <label class="reg-label" for="{{ registrationForm.gouvernant.vars.id }}">Gouvernorat</label>
                            {{ form_widget(registrationForm.gouvernant, {
                                'attr': {'class': 'reg-input reg-select'}
                            }) }}
                            {{ form_errors(registrationForm.gouvernant) }}
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="reg-label" for="{{ registrationForm.ville.vars.id }}">Ville</label>
                            <div class="reg-input-wrap">
                                <svg class="reg-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                </svg>
                                {{ form_widget(registrationForm.ville, {
                                    'attr': {'class': 'reg-input', 'placeholder': 'Votre ville'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.ville) }}
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="reg-label" for="{{ registrationForm.codePostale.vars.id }}">Code postal</label>
                            <div class="reg-input-wrap">
                                <svg class="reg-icon" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 20l4-16m2 16l4-16M6 9h14M4 15h14"/>
                                </svg>
                                {{ form_widget(registrationForm.codePostale, {
                                    'attr': {'class': 'reg-input', 'placeholder': 'Ex: 1000'}
                                }) }}
                            </div>
                            {{ form_errors(registrationForm.codePostale) }}
                        </div>
                    </div>

                    {# Terms + Submit #}
                    <div class="terms-block mb-4">
                        <div class="d-flex align-items-start gap-2">
                            {{ form_widget(registrationForm.agreeTerms, {'attr': {'class': 'form-check-input mt-1 flex-shrink-0'}}) }}
                            <label for="{{ registrationForm.agreeTerms.vars.id }}" class="small text-secondary">
                                J'accepte les
                                <a href="#" class="text-green fw-semibold text-decoration-none">conditions d'utilisation</a>
                                et la
                                <a href="#" class="text-green fw-semibold text-decoration-none">politique de confidentialité</a>
                            </label>
                        </div>
                        {{ form_errors(registrationForm.agreeTerms) }}

                        <div class="info-note mt-3">
                            <svg width="15" height="15" fill="currentColor" viewBox="0 0 20 20" class="flex-shrink-0 mt-1" style="color:#1a7a4a;">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                            </svg>
                            <div>
                                <strong class="small">Essai gratuit de 30 jours</strong>
                                <p class="mb-0 small text-muted">Profitez de toutes les fonctionnalités gratuitement. Le paiement sera effectué après validation de votre compte.</p>
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="btn-register w-100">
                        <svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
                        </svg>
                        Créer mon compte AgriPlus
                    </button>

                    <p class="text-center small text-muted mt-3 mb-0">
                        Déjà inscrit ?
                        <a href="{{ path('app_login') }}" class="text-green fw-semibold text-decoration-none">Se connecter</a>
                    </p>

                </div>{# /.reg-body #}

            {{ form_end(registrationForm) }}
        </div>{# /.reg-card #}

    </div>{# /.container #}
</div>{# /.min-vh-100 #}

<style>
/* ── Page & Header ──────────────────────────────────────── */
.registration-header {
    background: linear-gradient(155deg, #0f4c2a 0%, #1a7a4a 45%, #22c55e 100%);
    padding: 2rem 1.5rem 2.5rem;
    position: relative;
    overflow: hidden;
}
.header-blob-tr {
    position: absolute;
    top: -80px; right: -80px;
    width: 300px; height: 300px;
    border-radius: 50%;
    background: rgba(255,255,255,.06);
    pointer-events: none;
}
.header-blob-bl {
    position: absolute;
    bottom: -60px; left: -60px;
    width: 220px; height: 220px;
    border-radius: 50%;
    background: rgba(255,255,255,.04);
    pointer-events: none;
}
.main-logo {
    width: 52px; height: 52px;
    filter: brightness(0) invert(1);
    flex-shrink: 0;
}
.logo-name {
    font-size: 1.55rem;
    font-weight: 900;
    color: #fff;
    line-height: 1.1;
}
.logo-tagline {
    font-size: .68rem;
    color: rgba(255,255,255,.55);
    text-transform: uppercase;
    letter-spacing: .06em;
}
.nav-link-header {
    font-size: .82rem;
    color: rgba(255,255,255,.75);
    text-decoration: none;
    font-weight: 500;
    transition: color .2s;
}
.nav-link-header:hover { color: #fff; }
.role-badge {
    background: rgba(255,255,255,.18);
    border: 1px solid rgba(255,255,255,.28);
    color: #fff;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    padding: .25rem .75rem;
    border-radius: 999px;
}
.header-title {
    color: #fff;
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -.02em;
    margin: 0;
}
.header-sub {
    color: rgba(255,255,255,.7);
    font-size: .88rem;
    margin: .3rem 0 0;
}
.header-stat-pill {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    background: rgba(255,255,255,.14);
    border: 1px solid rgba(255,255,255,.2);
    color: rgba(255,255,255,.85);
    font-size: .75rem;
    font-weight: 500;
    padding: .3rem .7rem;
    border-radius: 999px;
}

/* ── Section titles ──────────────────────────────────────── */
.section-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1e3a2a;
}
.section-sub {
    font-size: .8rem;
    color: #6b7280;
}

/* ── Plan Cards ──────────────────────────────────────────── */
.plan-card {
    background: #fff;
    border: 2px solid #e5e7eb;
    border-radius: 14px;
    padding: 1.4rem 1.2rem 1.2rem;
    cursor: pointer;
    position: relative;
    transition: border-color .25s, box-shadow .25s, transform .25s;
    height: 100%;
}
.plan-card:hover {
    border-color: #22c55e;
    box-shadow: 0 8px 24px -6px rgba(34,197,94,.2);
    transform: translateY(-3px);
}
.plan-card.plan-selected {
    border-color: #1a7a4a !important;
    box-shadow: 0 10px 28px -6px rgba(26,122,74,.25) !important;
}
.plan-card.plan-selected .plan-check-mark { opacity: 1 !important; }

.plan-recommended {
    border-color: #1a7a4a;
    box-shadow: 0 12px 32px -8px rgba(26,122,74,.3);
}
.plan-recommended-badge {
    position: absolute;
    top: -12px; left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #0f4c2a, #22c55e);
    color: #fff;
    font-size: .65rem;
    font-weight: 700;
    letter-spacing: .08em;
    padding: .25rem .7rem;
    border-radius: 999px;
    display: flex;
    align-items: center;
    gap: .3rem;
    white-space: nowrap;
}
.plan-check-mark {
    position: absolute;
    top: .75rem; right: .75rem;
    width: 26px; height: 26px;
    background: linear-gradient(135deg, #0f4c2a, #22c55e);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity .25s;
}
.plan-icon-wrap {
    width: 52px; height: 52px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
}
.plan-icon-basic  { background: rgba(59,130,246,.1); color: #3b82f6; }
.plan-icon-premium { background: linear-gradient(135deg, #0f4c2a22, #22c55e22); color: #1a7a4a; }
.plan-icon-enterprise { background: rgba(107,114,128,.1); color: #374151; }

.plan-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: .15rem;
}
.plan-price {
    font-size: 1.9rem;
    font-weight: 800;
    color: #111827;
    line-height: 1.1;
}
.plan-currency {
    font-size: .8rem;
    font-weight: 500;
    color: #6b7280;
}
.plan-desc {
    font-size: .78rem;
    color: #9ca3af;
    margin-top: .1rem;
}
.plan-features {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid #f3f4f6;
    padding-top: .8rem;
}
.plan-features li {
    font-size: .8rem;
    color: #4b5563;
    padding: .2rem 0;
    padding-left: 1.1rem;
    position: relative;
}
.plan-features li::before {
    content: '';
    position: absolute;
    left: 0; top: .5rem;
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #22c55e;
}

/* ── Registration Card ──────────────────────────────────── */
.reg-card {
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 4px 24px -4px rgba(0,0,0,.1);
}
.reg-body {
    padding: 1.75rem;
}

/* Selected plan bar */
.selected-plan-bar {
    background: linear-gradient(135deg, #0f4c2a08 0%, #22c55e18 100%);
    border-bottom: 1px solid #d1fae5;
    padding: .9rem 1.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: .88rem;
    color: #1a7a4a;
}
.trial-badge {
    background: #d1fae5;
    color: #065f46;
    font-size: .72rem;
    font-weight: 700;
    padding: .2rem .6rem;
    border-radius: 999px;
    white-space: nowrap;
}

/* Form section titles */
.form-section-title {
    display: flex;
    align-items: center;
    gap: .45rem;
    font-size: .8rem;
    font-weight: 700;
    color: #1a7a4a;
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-bottom: .9rem;
}

/* Inputs */
.reg-label {
    display: block;
    font-size: .8rem;
    font-weight: 600;
    color: #374151;
    margin-bottom: .35rem;
}
.reg-input-wrap {
    position: relative;
}
.reg-icon {
    position: absolute;
    left: .75rem;
    top: 50%;
    transform: translateY(-50%);
    color: #9ca3af;
    pointer-events: none;
}
.reg-input {
    width: 100%;
    padding: .62rem .75rem .62rem 2.35rem;
    font-size: .875rem;
    border: 1.5px solid #d1d5db;
    border-radius: 8px;
    background: #fafafa;
    color: #111827;
    transition: border-color .2s, box-shadow .2s, background .2s;
    outline: none;
    -webkit-appearance: none;
    appearance: none;
}
.reg-input:focus {
    border-color: #1a7a4a;
    box-shadow: 0 0 0 3px rgba(26,122,74,.12);
    background: #fff;
}
.reg-select {
    padding-left: .75rem;
    cursor: pointer;
}

/* Password strength */
.pwd-strength-bar { display: flex; gap: 4px; }
.pwd-seg {
    height: 4px; flex: 1;
    border-radius: 2px;
    background: #e5e7eb;
    transition: background .3s;
}
.pwd-seg.active-1 { background: #ef4444; }
.pwd-seg.active-2 { background: #f59e0b; }
.pwd-seg.active-3 { background: #3b82f6; }
.pwd-seg.active-4 { background: #22c55e; }
.pwd-strength-label, .pwd-match-label {
    font-size: .72rem;
    min-height: 1rem;
    color: #6b7280;
}
.pwd-match-label.match  { color: #16a34a; }
.pwd-match-label.nomatch { color: #dc2626; }

/* Terms block */
.terms-block {
    background: #f9fafb;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 1rem 1.1rem;
}
.form-check-input:checked {
    background-color: #1a7a4a;
    border-color: #1a7a4a;
}
.info-note {
    display: flex;
    align-items: flex-start;
    gap: .5rem;
    background: #ecfdf5;
    border-radius: 8px;
    padding: .7rem .9rem;
}

/* Submit button */
.btn-register {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .5rem;
    padding: .85rem 1.5rem;
    background: linear-gradient(135deg, #0f4c2a 0%, #1a7a4a 50%, #22c55e 100%);
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    transition: opacity .2s, transform .2s, box-shadow .2s;
    letter-spacing: .01em;
}
.btn-register:hover {
    opacity: .92;
    transform: translateY(-1px);
    box-shadow: 0 12px 28px -6px rgba(15,76,42,.4);
}
.btn-register:active { transform: translateY(0); }

/* Utility */
.text-green { color: #1a7a4a !important; }
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {

    /* ── Plan selection ────────────────────────────────── */
    const planCards    = document.querySelectorAll('.plan-card');
    const radioInputs  = document.querySelectorAll('#subscription-wrapper input[type="radio"]');
    const planLabel    = document.getElementById('selectedPlanLabel');

    const PLAN_LABELS = {
        BASIC:      'Basic — 29 DT/mois',
        PREMIUM:    'Premium — 59 DT/mois',
        ENTERPRISE: 'Enterprise — 149 DT/mois',
    };

    function selectPlan(value) {
        // sync radio
        radioInputs.forEach(r => { r.checked = (r.value === value); });
        // update cards
        planCards.forEach(c => {
            c.classList.toggle('plan-selected', c.dataset.plan === value);
        });
        // update banner
        if (planLabel) planLabel.textContent = PLAN_LABELS[value] || value;
    }

    planCards.forEach(card => {
        card.addEventListener('click', () => selectPlan(card.dataset.plan));
        card.addEventListener('keydown', e => {
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectPlan(card.dataset.plan); }
        });
    });

    // Init: read the checked radio (set server-side to PREMIUM) or fall back
    const checkedRadio = document.querySelector('#subscription-wrapper input[type="radio"]:checked');
    selectPlan(checkedRadio ? checkedRadio.value : 'PREMIUM');

    /* ── Password strength ─────────────────────────────── */
    const pwd1 = document.getElementById('pwd1');
    const pwd2 = document.getElementById('pwd2');
    const segs = [document.getElementById('s1'), document.getElementById('s2'),
                  document.getElementById('s3'), document.getElementById('s4')];
    const strengthLabel = document.getElementById('pwdStrengthLabel');
    const matchLabel    = document.getElementById('pwdMatchLabel');

    const STRENGTH = [
        { label: '', cls: '' },
        { label: 'Faible', cls: 'active-1' },
        { label: 'Moyen',  cls: 'active-2' },
        { label: 'Bien',   cls: 'active-3' },
        { label: 'Fort',   cls: 'active-4' },
    ];

    function scorePassword(p) {
        if (!p) return 0;
        let s = 0;
        if (p.length >= 6)  s++;
        if (p.length >= 10) s++;
        if (/[A-Z]/.test(p) && /[a-z]/.test(p)) s++;
        if (/\d/.test(p) && /[^A-Za-z0-9]/.test(p)) s++;
        return Math.max(1, Math.min(4, s));
    }

    if (pwd1) {
        pwd1.addEventListener('input', function () {
            const score = this.value ? scorePassword(this.value) : 0;
            segs.forEach((seg, i) => {
                seg.className = 'pwd-seg';
                if (score > 0 && i < score) seg.classList.add(STRENGTH[score].cls);
            });
            strengthLabel.textContent = STRENGTH[score].label;
            checkMatch();
        });
    }
    if (pwd2) {
        pwd2.addEventListener('input', checkMatch);
    }

    function checkMatch() {
        if (!matchLabel || !pwd1 || !pwd2) return;
        if (!pwd2.value) { matchLabel.textContent = ''; matchLabel.className = 'pwd-match-label mt-1'; return; }
        if (pwd1.value === pwd2.value) {
            matchLabel.textContent = 'Les mots de passe correspondent';
            matchLabel.className = 'pwd-match-label mt-1 match';
        } else {
            matchLabel.textContent = 'Les mots de passe ne correspondent pas';
            matchLabel.className = 'pwd-match-label mt-1 nomatch';
        }
    }
});
</script>
{% endblock %}
