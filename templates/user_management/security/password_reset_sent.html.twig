{% extends 'base.html.twig' %}

{% block title %}Email envoyé - AgriLink{% endblock %}

{% block body %}
{{ include('components/_auth_background.html.twig') }}
<div class="min-vh-100 d-flex align-items-center justify-content-center py-5 px-3">
    <div class="w-100" style="max-width: 28rem;">
        <div class="mb-4">
            <div class="d-flex justify-content-center">
                <img src="{{ asset('logo_with_text.png') }}" alt="AgriLink Logo" class="logo logo-header">
            </div>
            <h2 class="mt-4 text-center display-6 fw-bold text-dark">
                Vérifiez votre boîte de réception
            </h2>
        </div>

        <div class="alert alert-success d-flex align-items-start mb-4" role="alert">
            <svg class="flex-shrink-0 me-3" style="width: 1.5rem; height: 1.5rem;" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <div>
                Si un compte est associé à cette adresse email, vous recevrez un lien de réinitialisation dans quelques instants.
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h5 class="card-title">Que faire maintenant ?</h5>
                <ul class="list-unstyled mb-0 small">
                    <li class="d-flex align-items-start mb-3">
                        <svg class="flex-shrink-0 me-2 text-success" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span>Vérifiez votre boîte de réception (et vos spams)</span>
                    </li>
                    <li class="d-flex align-items-start mb-3">
                        <svg class="flex-shrink-0 me-2 text-success" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span>Le lien expire dans <strong>1 heure</strong></span>
                    </li>
                    <li class="d-flex align-items-start">
                        <svg class="flex-shrink-0 me-2 text-success" style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        <span>Cliquez sur le lien dans l'email pour créer un nouveau mot de passe</span>
                    </li>
                </ul>
            </div>
        </div>

        <div class="text-center mb-4">
            <p class="small text-muted mb-3">
                Vous n'avez pas reçu l'email ?
            </p>
            <a href="{{ path('app_forgot_password') }}" class="btn btn-outline-secondary">
                Renvoyer le lien
            </a>
        </div>

        <div class="text-center pt-4 border-top">
            <a href="{{ path('app_login') }}" class="fw-medium text-success text-decoration-none">
                <svg class="d-inline-block me-1" style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Retour à la connexion
            </a>
        </div>
    </div>
</div>
{% endblock %}
