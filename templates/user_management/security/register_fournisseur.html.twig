{% extends 'base.html.twig' %}

{% block title %}Inscription Fournisseur - AgriLink{% endblock %}

{% block body %}
{{ include('components/_auth_background.html.twig') }}
<div class="min-vh-100 d-flex align-items-center justify-content-center py-5 px-3 px-sm-4">
    <div class="w-100" style="max-width: 800px;">
        <div>
            <div class="d-flex justify-content-center">
                <img src="{{ asset('logo_with_text.png') }}" alt="AgriLink Logo" class="logo logo-header">
            </div>
            <h2 class="mt-4 text-center display-6 fw-bold text-dark">
                Inscription Fournisseur
            </h2>
            <p class="mt-2 text-center small text-muted">
                Rejoignez AgriLink en tant que fournisseur
            </p>
        </div>

        {# Flash messages #}
        {% for flash_message in app.flashes('error') %}
            <div class="alert alert-danger border border-danger d-flex align-items-start mt-3">
                <div class="flex-shrink-0">
                    <svg class="bi" width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <div class="ms-3">
                    <p class="mb-0 small">{{ flash_message }}</p>
                </div>
            </div>
        {% endfor %}

        {# Step indicators #}
        <div class="d-flex justify-content-center mt-4">
            <div class="d-flex align-items-center gap-3">
                <div class="d-flex align-items-center" id="step1-indicator">
                    <span class="d-flex align-items-center justify-content-center rounded-circle bg-primary text-white" style="width: 32px; height: 32px;">1</span>
                    <span class="ms-2 small fw-medium text-primary">Type de compte</span>
                </div>
                <div style="width: 32px; height: 2px;" class="bg-secondary"></div>
                <div class="d-flex align-items-center" id="step2-indicator">
                    <span class="d-flex align-items-center justify-content-center rounded-circle bg-secondary text-white" style="width: 32px; height: 32px;" id="step2-circle">2</span>
                    <span class="ms-2 small fw-medium text-muted" id="step2-text">Informations</span>
                </div>
            </div>
        </div>

        {{ form_start(registrationForm, {'attr': {'class': 'mt-4', 'id': 'fournisseur-form', 'novalidate': 'novalidate'}}) }}
            
            {# Section 1: Type Selection #}
            <div id="step1-section" class="card shadow-sm border p-4">
                <h3 class="h5 fw-semibold text-dark mb-4">
                    <span class="me-2">👤</span> Choisissez votre type de compte
                </h3>
                
                <div class="row g-3 mb-4">
                    {# Personne Card #}
                    <div class="col-12 col-md-6">
                        <div class="type-card cursor-pointer rounded border-2 border p-3 hover-type-card" data-type="PERSONNE" id="card-personne">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <span class="fs-3">👤</span>
                                </div>
                                <div class="ms-3">
                                    <h4 class="h6 fw-semibold text-dark">Personne physique</h4>
                                    <p class="mb-0 small text-muted">Vous êtes un fournisseur individuel</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    {# Société Card #}
                    <div class="col-12 col-md-6">
                        <div class="type-card cursor-pointer rounded border-2 border p-3 hover-type-card" data-type="SOCIETE" id="card-societe">
                            <div class="d-flex align-items-start">
                                <div class="flex-shrink-0">
                                    <span class="fs-3">🏢</span>
                                </div>
                                <div class="ms-3">
                                    <h4 class="h6 fw-semibold text-dark">Société</h4>
                                    <p class="mb-0 small text-muted">Vous représentez une entreprise</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="d-none">
                    {{ form_widget(registrationForm.fournisseurTypeFournisseur) }}
                </div>
                {{ form_errors(registrationForm.fournisseurTypeFournisseur) }}
                
                <div class="d-flex justify-content-end">
                    <button type="button" id="btn-next" disabled class="btn btn-primary">
                        Continuer
                        <svg class="ms-2" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </button>
                </div>
            </div>

            {# Section 2: Information Form #}
            <div id="step2-section" class="d-none">
                {# Back button #}
                <button type="button" id="btn-back" class="btn btn-link mb-3 text-decoration-none text-muted p-0">
                    <svg class="me-1" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    Retour au choix du type
                </button>

                {# Common Information #}
                <div class="card shadow-sm border p-4 mb-4">
                    <h3 class="h5 fw-semibold text-dark mb-4">
                        <span class="me-2">📝</span> Informations générales
                    </h3>
                    
                    <div class="vstack gap-3">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                {{ form_label(registrationForm.nom) }}
                                {{ form_widget(registrationForm.nom) }}
                                {{ form_errors(registrationForm.nom) }}
                            </div>
                            <div class="col-12 col-md-6">
                                {{ form_label(registrationForm.email) }}
                                {{ form_widget(registrationForm.email) }}
                                {{ form_errors(registrationForm.email) }}
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                {{ form_label(registrationForm.plainPassword.first) }}
                                <div class="position-relative">
                                    {{ form_widget(registrationForm.plainPassword.first, {
                                        'attr': {
                                            'class': 'password-input',
                                            'autocomplete': 'new-password'
                                        }
                                    }) }}
                                    <button type="button" class="password-toggle position-absolute end-0 top-50 translate-middle-y border-0 bg-transparent text-muted" style="right: 0.75rem;" onclick="togglePasswordVisibility(this)">
                                        <svg class="bi eye-icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                    </button>
                                </div>
                                {{ form_errors(registrationForm.plainPassword.first) }}
                                <p class="mt-1 small text-muted">Minimum 6 caractères</p>
                            </div>
                            <div class="col-12 col-md-6">
                                {{ form_label(registrationForm.plainPassword.second) }}
                                <div class="position-relative">
                                    {{ form_widget(registrationForm.plainPassword.second, {
                                        'attr': {
                                            'class': 'password-input',
                                            'autocomplete': 'new-password'
                                        }
                                    }) }}
                                    <button type="button" class="password-toggle position-absolute end-0 top-50 translate-middle-y border-0 bg-transparent text-muted" style="right: 0.75rem;" onclick="togglePasswordVisibility(this)">
                                        <svg class="bi eye-icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                    </button>
                                </div>
                                {{ form_errors(registrationForm.plainPassword.second) }}
                            </div>
                        </div>

                        <div>
                            {{ form_label(registrationForm.telephone) }}
                            {{ form_widget(registrationForm.telephone) }}
                            {{ form_errors(registrationForm.telephone) }}
                        </div>
                    </div>
                </div>

                {# Address Information #}
                <div class="card shadow-sm border p-4 mb-4">
                    <h3 class="h5 fw-semibold text-dark mb-4">
                        <span class="me-2">📍</span> Adresse
                    </h3>
                    
                    <div class="vstack gap-3">
                        <div>
                            {{ form_label(registrationForm.gouvernant) }}
                            {{ form_widget(registrationForm.gouvernant) }}
                            {{ form_errors(registrationForm.gouvernant) }}
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                {{ form_label(registrationForm.ville) }}
                                {{ form_widget(registrationForm.ville) }}
                                {{ form_errors(registrationForm.ville) }}
                            </div>
                            <div class="col-12 col-md-6">
                                {{ form_label(registrationForm.codePostale) }}
                                {{ form_widget(registrationForm.codePostale) }}
                                {{ form_errors(registrationForm.codePostale) }}
                            </div>
                        </div>
                    </div>
                </div>

                {# PERSONNE-specific fields #}
                <div id="personne-fields" class="d-none card shadow-sm border p-4 mb-4 border-start border-primary border-4">
                    <h3 class="h5 fw-semibold text-dark mb-4">
                        <span class="me-2">🪪</span> Informations personnelles
                    </h3>
                    
                    <div>
                        {{ form_label(registrationForm.fournisseurCin) }}
                        {{ form_widget(registrationForm.fournisseurCin) }}
                        {{ form_errors(registrationForm.fournisseurCin) }}
                        <p class="mt-1 small text-muted">8 chiffres, obligatoire pour les personnes physiques</p>
                    </div>
                </div>

                {# SOCIETE-specific fields #}
                <div id="societe-fields" class="d-none card shadow-sm border p-4 mb-4 border-start border-success border-4">
                    <h3 class="h5 fw-semibold text-dark mb-4">
                        <span class="me-2">🏢</span> Informations de la société
                    </h3>
                    
                    <div class="vstack gap-3">
                        <div>
                            {{ form_label(registrationForm.fournisseurRaisonSocial) }}
                            {{ form_widget(registrationForm.fournisseurRaisonSocial) }}
                            {{ form_errors(registrationForm.fournisseurRaisonSocial) }}
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                {{ form_label(registrationForm.fournisseurNumRegistre) }}
                                {{ form_widget(registrationForm.fournisseurNumRegistre) }}
                                {{ form_errors(registrationForm.fournisseurNumRegistre) }}
                            </div>
                            <div class="col-12 col-md-6">
                                {{ form_label(registrationForm.fournisseurFormeJuridique) }}
                                {{ form_widget(registrationForm.fournisseurFormeJuridique) }}
                                {{ form_errors(registrationForm.fournisseurFormeJuridique) }}
                            </div>
                        </div>

                        <div>
                            {{ form_label(registrationForm.fournisseurCapital) }}
                            {{ form_widget(registrationForm.fournisseurCapital) }}
                            {{ form_errors(registrationForm.fournisseurCapital) }}
                        </div>
                    </div>
                </div>

                {# Certifications #}
                <div class="card shadow-sm border p-4 mb-4">
                    <h3 class="h5 fw-semibold text-dark mb-4">
                        <span class="me-2">🏅</span> Certifications (optionnel)
                    </h3>
                    
                    <div>
                        {{ form_label(registrationForm.fournisseurCertifications) }}
                        {{ form_widget(registrationForm.fournisseurCertifications) }}
                        {{ form_errors(registrationForm.fournisseurCertifications) }}
                        <p class="mt-1 small text-muted">Listez vos certifications séparées par des virgules (ex: Bio, ISO 9001, HACCP)</p>
                    </div>
                </div>

                {# Terms and Submit #}
                <div class="card shadow-sm border p-4">
                    <div class="form-check mb-4">
                        {{ form_widget(registrationForm.agreeTerms) }}
                        {{ form_label(registrationForm.agreeTerms) }}
                    </div>
                    {{ form_errors(registrationForm.agreeTerms) }}

                    <button type="submit" class="btn btn-primary w-100 py-3">
                        <span class="me-2">📦</span>
                        Créer mon compte Fournisseur
                    </button>
                </div>
            </div>

        {{ form_end(registrationForm) }}

        <div class="text-center mt-4">
            <a href="{{ path('app_register') }}" class="text-decoration-none text-muted small">
                <svg class="me-1" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                Retour au choix du type de compte
            </a>
        </div>

        <div class="text-center mt-3">
            <p class="small text-muted">
                Déjà inscrit ?
                <a href="{{ path('app_login') }}" class="fw-medium text-primary">
                    Se connecter
                </a>
            </p>
        </div>
    </div>
</div>

<style>
.cursor-pointer {
    cursor: pointer;
}
.hover-type-card {
    transition: all 0.2s;
}
.hover-type-card:hover {
    border-color: var(--bs-primary) !important;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Debug: Log all element queries
    console.log('=== Fournisseur Type Selection Debug ===');
    
    const typeSelect = document.getElementById('fournisseur_type');
    const personneFields = document.getElementById('personne-fields');
    const societeFields = document.getElementById('societe-fields');
    const cardPersonne = document.getElementById('card-personne');
    const cardSociete = document.getElementById('card-societe');
    const btnNext = document.getElementById('btn-next');
    const btnBack = document.getElementById('btn-back');
    const step1Section = document.getElementById('step1-section');
    const step2Section = document.getElementById('step2-section');
    const step2Circle = document.getElementById('step2-circle');
    const step2Text = document.getElementById('step2-text');
    
    // Debug logging
    console.log('typeSelect found:', typeSelect ? 'YES' : 'NO', typeSelect);
    console.log('cardPersonne found:', cardPersonne ? 'YES' : 'NO');
    console.log('cardSociete found:', cardSociete ? 'YES' : 'NO');
    console.log('btnNext found:', btnNext ? 'YES' : 'NO');
    
    // If typeSelect not found, try alternative selector
    if (!typeSelect) {
        console.error('❌ Select element not found with ID. Trying name attribute...');
        const altSelect = document.querySelector('[name="registration_fournisseur[fournisseurTypeFournisseur]"]');
        console.log('Alternative selector result:', altSelect);
        
        if (!altSelect) {
            console.error('❌ CRITICAL: Cannot find type select element!');
            alert('Erreur: Le champ de sélection du type de fournisseur est introuvable. Veuillez rafraîchir la page.');
            return;
        }
    }
    
    // Early exit if critical elements missing
    if (!cardPersonne || !cardSociete || !btnNext) {
        console.error('❌ CRITICAL: Missing required elements!');
        console.error('Missing:', {
            cardPersonne: !cardPersonne,
            cardSociete: !cardSociete,
            btnNext: !btnNext
        });
        alert('Erreur: Certains éléments du formulaire sont introuvables. Veuillez rafraîchir la page.');
        return;
    }

    let selectedType = typeSelect ? (typeSelect.value || null) : null;
    console.log('Initial selectedType:', selectedType);

    function updateTypeDisplay() {
        const isPersonne = selectedType === 'PERSONNE';
        const isSociete = selectedType === 'SOCIETE';
        
        console.log('updateTypeDisplay called:', { selectedType, isPersonne, isSociete });
        
        // Update card styles (Bootstrap classes)
        cardPersonne.classList.toggle('border-primary', isPersonne);
        cardPersonne.classList.toggle('bg-primary', isPersonne);
        cardPersonne.classList.toggle('bg-opacity-10', isPersonne);
        cardPersonne.classList.toggle('border-secondary', !isPersonne);
        
        cardSociete.classList.toggle('border-primary', isSociete);
        cardSociete.classList.toggle('bg-primary', isSociete);
        cardSociete.classList.toggle('bg-opacity-10', isSociete);
        cardSociete.classList.toggle('border-secondary', !isSociete);
        
        // Update hidden select
        if (typeSelect && selectedType) {
            typeSelect.value = selectedType;
            console.log('✅ Updated select value to:', typeSelect.value);
        }
        
        // Enable/disable next button
        btnNext.disabled = !selectedType;
        console.log('btnNext.disabled:', btnNext.disabled);
        
        // Show/hide type-specific fields
        if (personneFields) {
            personneFields.classList.toggle('d-none', !isPersonne);
        }
        if (societeFields) {
            societeFields.classList.toggle('d-none', !isSociete);
        }
        
        // Update required attributes based on type
        const cinInput = document.getElementById('registration_fournisseur_fournisseurCin');
        if (cinInput) {
            cinInput.required = isPersonne;
        }
    }

    // Card click handlers
    cardPersonne.addEventListener('click', function() {
        console.log('🖱️ Personne card clicked');
        selectedType = 'PERSONNE';
        updateTypeDisplay();
    });

    cardSociete.addEventListener('click', function() {
        console.log('🖱️ Société card clicked');
        selectedType = 'SOCIETE';
        updateTypeDisplay();
    });

    // Next button handler
    btnNext.addEventListener('click', function() {
        console.log('🚀 Next button clicked');
        
        if (!selectedType) {
            console.error('❌ No type selected!');
            alert('Veuillez sélectionner un type de fournisseur');
            return;
        }
        
        console.log('Advancing to step 2 with type:', selectedType);
        
        if (!step1Section || !step2Section) {
            console.error('❌ Step sections not found!');
            return;
        }
        
        step1Section.classList.add('d-none');
        step2Section.classList.remove('d-none');
        
        // Update step indicator (Bootstrap classes)
        if (step2Circle) {
            step2Circle.classList.remove('bg-secondary');
            step2Circle.classList.add('bg-primary');
        }
        if (step2Text) {
            step2Text.classList.remove('text-muted');
            step2Text.classList.add('text-primary', 'fw-medium');
        }
        
        console.log('✅ Advanced to step 2');
    });

    // Back button handler
    if (btnBack) {
        btnBack.addEventListener('click', function() {
            console.log('⬅️ Back button clicked');
            
            if (!step1Section || !step2Section) return;
            
            step2Section.classList.add('d-none');
            step1Section.classList.remove('d-none');
            
            // Reset step indicator (Bootstrap classes)
            if (step2Circle) {
                step2Circle.classList.add('bg-secondary');
                step2Circle.classList.remove('bg-primary');
            }
            if (step2Text) {
                step2Text.classList.add('text-muted');
                step2Text.classList.remove('text-primary', 'fw-medium');
            }
        });
    }

    // Also listen for direct select changes (for accessibility)
    if (typeSelect) {
        typeSelect.addEventListener('change', function() {
            console.log('📝 Select changed directly:', this.value);
            selectedType = this.value;
            updateTypeDisplay();
        });
    }

    // Initialize display based on any pre-selected value
    if (selectedType) {
        console.log('🔄 Initializing with pre-selected type:', selectedType);
        updateTypeDisplay();
    }
    
    console.log('=== Initialization Complete ===');
});

function togglePasswordVisibility(button) {
    const input = button.previousElementSibling;
    const isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';
    button.classList.toggle('opacity-50', !isPassword);
}
</script>
{% endblock %}
