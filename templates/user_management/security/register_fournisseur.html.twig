{% extends 'base.html.twig' %}

{% block title %}Inscription Fournisseur - AgriLink{% endblock %}

{% block body %}
{{ include('components/_auth_background.html.twig') }}

{# Desktop-First Container #}
<div class="registration-wrapper">
    <div class="registration-container">
        
        {# Top Header #}
        <div class="registration-header">
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                {# Logo lockup #}
                <div class="logo-section">
                    <img src="{{ asset('logo_without_text.png') }}" alt="AgriLink" class="main-logo">
                    <div class="logo-text-group">
                        <span class="logo-name">AgriLink</span>
                        <span class="logo-tagline">Plateforme Agricole</span>
                    </div>
                    <span class="role-badge ms-2">Fournisseur</span>
                </div>
                {# Nav links #}
                <div class="header-nav">
                    <a href="{{ path('app_register') }}">← Choisir un rôle</a>
                    <a href="{{ path('app_login') }}" style="color:#fff;font-weight:600;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.25);padding:.35rem .9rem;border-radius:8px;font-size:.82rem;">Se connecter</a>
                </div>
            </div>

            {# Title + subtitle inside banner #}
            <div class="mt-4" style="position:relative;z-index:1;">
                <h1 style="font-size:1.75rem;font-weight:800;color:#fff;letter-spacing:-.02em;margin-bottom:.4rem;line-height:1.2;">
                    Devenez Fournisseur AgriLink
                </h1>
                <p style="color:rgba(255,255,255,.72);font-size:.9rem;margin:0;max-width:560px;line-height:1.6;">
                    Développez votre activité en rejoignant notre réseau de fournisseurs certifiés et connectez-vous directement avec des agriculteurs.
                </p>
            </div>
        </div>

        {# Main Content Area #}
        <div class="registration-content">

        {# Flash messages #}
        {% for flash_message in app.flashes('error') %}
            <div class="alert alert-danger border border-danger d-flex align-items-start mt-3 animate-fade-in">
                <div class="flex-shrink-0">
                    <svg class="bi" width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <div class="ms-3">
                    <p class="mb-0 small">{{ flash_message }}</p>
                </div>
            </div>
        {% endfor %}

        {# Global Form Errors (e.g., UniqueEntity) #}
        {% if registrationForm.vars.errors|length > 0 %}
            <div class="alert alert-danger border border-danger d-flex align-items-start mt-3 animate-fade-in">
                <div class="flex-shrink-0">
                    <svg class="bi" width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <div class="ms-3">
                    <ul class="mb-0 small ps-3">
                        {% for error in registrationForm.vars.errors %}
                            <li>{{ error.message }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
        {% endif %}

        {# Enhanced Step Indicators #}
        <div class="d-flex justify-content-center mb-4">
            <div class="d-flex align-items-center gap-2 gap-md-3 px-4 py-3 bg-white rounded-pill shadow-sm">
                <div class="d-flex align-items-center" id="step1-indicator">
                    <div class="position-relative">
                        <span class="d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-semibold shadow-sm transition-all" style="width: 40px; height: 40px; font-size: 0.9rem;">1</span>
                        <span class="position-absolute top-0 start-100 translate-middle p-1 bg-success border border-white rounded-circle" style="width: 12px; height: 12px;">
                            <span class="visually-hidden">Current step</span>
                        </span>
                    </div>
                    <span class="ms-2 fw-semibold text-primary d-none d-md-inline">Type de compte</span>
                </div>
                <div class="step-connector" style="width: 40px; height: 3px; background: linear-gradient(to right, var(--bs-primary), var(--bs-secondary));"></div>
                <div class="d-flex align-items-center" id="step2-indicator">
                    <span class="d-flex align-items-center justify-content-center rounded-circle bg-secondary text-white fw-semibold transition-all" style="width: 40px; height: 40px; font-size: 0.9rem;" id="step2-circle">2</span>
                    <span class="ms-2 fw-medium text-muted d-none d-md-inline" id="step2-text">Informations</span>
                </div>
            </div>
        </div>

        {{ form_start(registrationForm, {'attr': {'class': 'mt-4', 'id': 'fournisseur-form', 'novalidate': 'novalidate'}}) }}
            
            {# Section 1: Modern Type Selection #}
            <div id="step1-section" class="animate-slide-up">
                <div class="selection-container">
                    {# Clean Modern Header #}
                    <div class="selection-header text-center mb-5">
                        <div class="selection-icon mb-3">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="48" height="48">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                        </div>
                        <h2 class="selection-title mb-2">Choisissez votre type de compte</h2>
                        <p class="selection-subtitle text-muted">Sélectionnez le profil qui correspond le mieux à votre activité</p>
                    </div>

                    {# Modern Type Cards #}
                    <div class="row g-4 mb-5">
                        {# Personne Physique Card #}
                        <div class="col-12 col-md-6">
                            <div class="type-card-modern" data-type="PERSONNE" id="card-personne">
                                <div class="type-card-modern-inner">
                                    {# Badge Indicator #}
                                    <div class="type-badge" id="badge-personne">
                                        <svg fill="none" stroke="white" viewBox="0 0 24 24" width="14" height="14">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                                        </svg>
                                    </div>
                                    
                                    {# Icon Section #}
                                    <div class="type-icon-wrapper">
                                        <div class="type-icon type-icon-primary">
                                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="32" height="32">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                            </svg>
                                        </div>
                                    </div>
                                    
                                    {# Content #}
                                    <div class="type-content">
                                        <h3 class="type-title">Personne Physique</h3>
                                        <p class="type-description">Professionnel indépendant ou auto-entrepreneur</p>
                                        
                                        <ul class="type-features">
                                            <li>
                                                <svg class="feature-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                                </svg>
                                                Inscription rapide et simplifiée
                                            </li>
                                            <li>
                                                <svg class="feature-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                                </svg>
                                                CIN requis uniquement
                                            </li>
                                            <li>
                                                <svg class="feature-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                                </svg>
                                                Idéal pour activités individuelles
                                            </li>
                                        </ul>
                                    </div>
                                    
                                    {# Selection Indicator #}
                                    <div class="type-selector">
                                        <span class="selector-text">Sélectionner</span>
                                        <svg class="selector-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        {# Société Card #}
                        <div class="col-12 col-md-6">
                            <div class="type-card-modern" data-type="SOCIETE" id="card-societe">
                                <div class="type-card-modern-inner">
                                    {# Badge Indicator #}
                                    <div class="type-badge" id="badge-societe">
                                        <svg fill="none" stroke="white" viewBox="0 0 24 24" width="14" height="14">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/>
                                        </svg>
                                    </div>
                                    
                                    {# Icon Section #}
                                    <div class="type-icon-wrapper">
                                        <div class="type-icon type-icon-success">
                                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="32" height="32">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                                            </svg>
                                        </div>
                                    </div>
                                    
                                    {# Content #}
                                    <div class="type-content">
                                        <h3 class="type-title">Société</h3>
                                        <p class="type-description">Entreprise ou structure juridique établie</p>
                                        
                                        <ul class="type-features">
                                            <li>
                                                <svg class="feature-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                                </svg>
                                                Raison sociale et registre
                                            </li>
                                            <li>
                                                <svg class="feature-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                                </svg>
                                                Forme juridique et capital
                                            </li>
                                            <li>
                                                <svg class="feature-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                                </svg>
                                                Pour entreprises établies
                                            </li>
                                        </ul>
                                    </div>
                                    
                                    {# Selection Indicator #}
                                    <div class="type-selector">
                                        <span class="selector-text">Sélectionner</span>
                                        <svg class="selector-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                        </svg>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    {# Hidden Select #}
                    <div class="d-none">
                        {{ form_widget(registrationForm.fournisseurTypeFournisseur) }}
                    </div>
                        {{ form_errors(registrationForm.fournisseurTypeFournisseur) }}
                        
                    {# Action Buttons #}
                    <div class="d-flex justify-content-between align-items-center mt-4 pt-4 border-top">
                        <a href="{{ path('app_register') }}" class="btn btn-lg btn-outline-secondary px-4">
                            <svg class="me-2" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                            </svg>
                            Retour
                        </a>
                        <button type="button" id="btn-next" disabled class="btn btn-lg btn-primary px-5 shadow-sm">
                            Continuer
                            <svg class="ms-2" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>

            {# Section 2: Information Form #}
            <div id="step2-section" class="d-none">
                {# Back button #}
                <button type="button" id="btn-back" class="btn btn-link mb-3 text-decoration-none text-muted p-0">
                    <svg class="me-1" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    Retour au choix du type
                </button>

                {# Common Information #}
                <div class="card shadow-sm border p-4 mb-4">
                    <h3 class="h5 fw-semibold text-dark mb-4 d-flex align-items-center gap-2">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                        Informations générales
                    </h3>
                    
                    <div class="vstack gap-3">
                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                {{ form_label(registrationForm.nom) }}
                                {{ form_widget(registrationForm.nom) }}
                                {{ form_errors(registrationForm.nom) }}
                            </div>
                            <div class="col-12 col-md-6">
                                {{ form_label(registrationForm.email) }}
                                {{ form_widget(registrationForm.email) }}
                                {{ form_errors(registrationForm.email) }}
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                {{ form_label(registrationForm.plainPassword.first) }}
                                <div class="position-relative">
                                    {{ form_widget(registrationForm.plainPassword.first, {
                                        'attr': {
                                            'class': 'password-input',
                                            'autocomplete': 'new-password'
                                        }
                                    }) }}
                                    <button type="button" class="password-toggle position-absolute end-0 top-50 translate-middle-y border-0 bg-transparent text-muted" style="right: 0.75rem;" onclick="togglePasswordVisibility(this)">
                                        <svg class="bi eye-icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                    </button>
                                </div>
                                {{ form_errors(registrationForm.plainPassword.first) }}
                                <p class="mt-1 small text-muted">Minimum 6 caractères</p>
                            </div>
                            <div class="col-12 col-md-6">
                                {{ form_label(registrationForm.plainPassword.second) }}
                                <div class="position-relative">
                                    {{ form_widget(registrationForm.plainPassword.second, {
                                        'attr': {
                                            'class': 'password-input',
                                            'autocomplete': 'new-password'
                                        }
                                    }) }}
                                    <button type="button" class="password-toggle position-absolute end-0 top-50 translate-middle-y border-0 bg-transparent text-muted" style="right: 0.75rem;" onclick="togglePasswordVisibility(this)">
                                        <svg class="bi eye-icon" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                    </button>
                                </div>
                                {{ form_errors(registrationForm.plainPassword.second) }}
                            </div>
                        </div>

                        <div>
                            {{ form_label(registrationForm.telephone) }}
                            {{ form_widget(registrationForm.telephone) }}
                            {{ form_errors(registrationForm.telephone) }}
                        </div>
                    </div>
                </div>

                {# Address Information #}
                <div class="card shadow-sm border p-4 mb-4">
                    <h3 class="h5 fw-semibold text-dark mb-4 d-flex align-items-center gap-2">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                        Adresse
                    </h3>
                    
                    <div class="vstack gap-3">
                        <div>
                            {{ form_label(registrationForm.gouvernant) }}
                            {{ form_widget(registrationForm.gouvernant) }}
                            {{ form_errors(registrationForm.gouvernant) }}
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                {{ form_label(registrationForm.ville) }}
                                {{ form_widget(registrationForm.ville) }}
                                {{ form_errors(registrationForm.ville) }}
                            </div>
                            <div class="col-12 col-md-6">
                                {{ form_label(registrationForm.codePostale) }}
                                {{ form_widget(registrationForm.codePostale) }}
                                {{ form_errors(registrationForm.codePostale) }}
                            </div>
                        </div>
                    </div>
                </div>

                {# PERSONNE-specific fields #}
                <div id="personne-fields" class="d-none card shadow-sm border p-4 mb-4 border-start border-primary border-4">
                    <h3 class="h5 fw-semibold text-dark mb-4 d-flex align-items-center gap-2">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2"/></svg>
                        Informations personnelles
                    </h3>
                    
                    <div>
                        {{ form_label(registrationForm.fournisseurCin) }}
                        {{ form_widget(registrationForm.fournisseurCin) }}
                        {{ form_errors(registrationForm.fournisseurCin) }}
                        <p class="mt-1 small text-muted">8 chiffres, obligatoire pour les personnes physiques</p>
                    </div>
                </div>

                {# SOCIETE-specific fields #}
                <div id="societe-fields" class="d-none card shadow-sm border p-4 mb-4 border-start border-success border-4">
                    <h3 class="h5 fw-semibold text-dark mb-4 d-flex align-items-center gap-2">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                        Informations de la société
                    </h3>
                    
                    <div class="vstack gap-3">
                        <div>
                            {{ form_label(registrationForm.fournisseurRaisonSocial) }}
                            {{ form_widget(registrationForm.fournisseurRaisonSocial) }}
                            {{ form_errors(registrationForm.fournisseurRaisonSocial) }}
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                {{ form_label(registrationForm.fournisseurNumRegistre) }}
                                {{ form_widget(registrationForm.fournisseurNumRegistre) }}
                                {{ form_errors(registrationForm.fournisseurNumRegistre) }}
                            </div>
                            <div class="col-12 col-md-6">
                                {{ form_label(registrationForm.fournisseurFormeJuridique) }}
                                {{ form_widget(registrationForm.fournisseurFormeJuridique) }}
                                {{ form_errors(registrationForm.fournisseurFormeJuridique) }}
                            </div>
                        </div>

                        <div>
                            {{ form_label(registrationForm.fournisseurCapital) }}
                            {{ form_widget(registrationForm.fournisseurCapital) }}
                            {{ form_errors(registrationForm.fournisseurCapital) }}
                        </div>
                    </div>
                </div>

                {# Certifications #}
                <div class="card shadow-sm border p-4 mb-4">
                    <h3 class="h5 fw-semibold text-dark mb-4 d-flex align-items-center gap-2">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>
                        Certifications <span class="text-muted fw-normal fs-6">(optionnel)</span>
                    </h3>
                    
                    <div>
                        {{ form_label(registrationForm.fournisseurCertifications) }}
                        {{ form_widget(registrationForm.fournisseurCertifications) }}
                        {{ form_errors(registrationForm.fournisseurCertifications) }}
                        <p class="mt-1 small text-muted">Listez vos certifications séparées par des virgules (ex: Bio, ISO 9001, HACCP)</p>
                    </div>
                </div>

                {# Terms and Submit #}
                <div class="card shadow-sm border p-4">
                    <div class="form-check mb-4">
                        {{ form_widget(registrationForm.agreeTerms) }}
                        {{ form_label(registrationForm.agreeTerms) }}
                    </div>
                    {{ form_errors(registrationForm.agreeTerms) }}

                    <button type="submit" class="btn btn-primary w-100 py-3 d-flex align-items-center justify-content-center gap-2">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="18" height="18"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
