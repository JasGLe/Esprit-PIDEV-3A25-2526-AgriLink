.form-control:valid:not(:placeholder-shown) {
    border-color: #198754;
    padding-right: calc(1.5em + 0.75rem);
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 8 8'%3e%3cpath fill='%23198754' d='M2.3 6.73L.6 4.53c-.4-1.04.46-1.4 1.1-.8l1.1 1.4 3.4-3.8c.6-.63 1.6-.27 1.2.7l-4 4.6c-.43.5-.8.4-1.1.1z'/%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right calc(0.375em + 0.1875rem) center;
    background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
}

/* Error state animation */
@keyframes shake {
    0%, 100% { transform: translateX(0); }
    10%, 30%, 50%, 70%, 90% { transform: translateX(-4px); }
    20%, 40%, 60%, 80% { transform: translateX(4px); }
}

.form-control.is-invalid,
.form-select.is-invalid {
    animation: shake 0.5s;
}

/* Invalid feedback styling */
.invalid-feedback {
    display: block;
    font-size: 0.875rem;
    color: #dc3545;
    margin-top: 0.5rem;
    animation: slideDown 0.3s ease;
}

@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

/* Card header gradient with proper text visibility and z-index */
.bg-gradient {
    position: relative;
    overflow: hidden;
    z-index: 10; /* Ensure header is above card body */
}

.bg-gradient::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    opacity: 0.15; /* Reduced from 0.3 to 0.15 for better text visibility */
    z-index: 0;
}

.bg-gradient > * {
    position: relative;
    z-index: 11; /* Above the pattern overlay */
    color: #ffffff !important; /* Force white text color */
}

.bg-gradient h3,
.bg-gradient p,
.bg-gradient svg {
    color: #ffffff !important; /* Ensure all children are white */
    stroke: #ffffff !important; /* For SVG icons */
}

/* Ensure text shadow for better readability */
.bg-gradient h3 {
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
    font-weight: 700 !important;
}

.bg-gradient p {
    color: rgba(255, 255, 255, 0.95) !important; /* Slightly transparent for subtitle */
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
}

/* Ensure card-body doesn't overlap header */
.card-body {
    position: relative;
    z-index: 1; /* Lower than header */
}

/* Loading animation for button */
.btn-primary:active {
    transform: scale(0.98);
}

/* Responsive improvements */
@media (max-width: 768px) {
    .type-card {
        margin-bottom: 1rem;
    }
    
    .hover-lift:hover {
        transform: translateY(-2px);
    }
    
    .btn-outline-secondary:hover {
        transform: translateX(-2px);
    }
}

/* Ripple effect for card clicks */
.ripple-effect {
    position: absolute;
    border-radius: 50%;
    background: rgba(13, 110, 253, 0.3);
    transform: scale(0);
    animation: ripple 0.6s ease-out;
    pointer-events: none;
}

@keyframes ripple {
    to {
        transform: scale(4);
        opacity: 0;
    }
}

/* Enhanced focus states for accessibility */
.type-card:focus-visible,
.btn:focus-visible,
.form-control:focus-visible,
.form-select:focus-visible {
    outline: 2px solid var(--bs-primary);
    outline-offset: 2px;
}

/* Loading spinner for submit button */
@keyframes spin {
    to { transform: rotate(360deg); }
}

.btn-primary.loading {
    position: relative;
    color: transparent;
}

.btn-primary.loading::after {
    content: '';
    position: absolute;
    width: 16px;
    height: 16px;
    top: 50%;
    left: 50%;
    margin-left: -8px;
    margin-top: -8px;
    border: 2px solid #ffffff;
    border-radius: 50%;
    border-top-color: transparent;
    animation: spin 0.6s linear infinite;
}

/* Smooth password toggle icon */
.password-toggle-icon {
    transition: all 0.3s ease;
    cursor: pointer;
}

.password-toggle-icon:hover {
    color: var(--bs-primary) !important;
    transform: scale(1.1);
}

/* Form section stagger animation */
@keyframes staggerFadeIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.card:nth-child(1) { animation-delay: 0s; }
.card:nth-child(2) { animation-delay: 0.1s; }
.card:nth-child(3) { animation-delay: 0.2s; }

/* Tooltip enhancement */
[data-bs-toggle="tooltip"] {
    cursor: help;
    border-bottom: 1px dotted currentColor;
}

</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Use the Symfony-generated select element name attribute (reliable across form name changes)
    const typeSelect = document.querySelector('select[name="registration_fournisseur[fournisseurTypeFournisseur]"]');
    const personneFields = document.getElementById('personne-fields');
    const societeFields = document.getElementById('societe-fields');
    const cardPersonne = document.getElementById('card-personne');
    const cardSociete = document.getElementById('card-societe');
    const btnNext = document.getElementById('btn-next');
    const btnBack = document.getElementById('btn-back');
    const step1Section = document.getElementById('step1-section');
    const step2Section = document.getElementById('step2-section');
    const step2Circle = document.getElementById('step2-circle');
    const step2Text = document.getElementById('step2-text');

    if (!typeSelect || !cardPersonne || !cardSociete || !btnNext) {
        return;
    }

    let selectedType = typeSelect.value || null;

    function updateTypeDisplay() {
        const isPersonne = selectedType === 'PERSONNE';
        const isSociete = selectedType === 'SOCIETE';

        // Enhanced card selection with smooth transitions - NEW CLASSES
        cardPersonne.classList.toggle('selected', isPersonne);
        cardSociete.classList.toggle('selected', isSociete);

        // Update select value
        if (selectedType) typeSelect.value = selectedType;

        // Enable/disable continue button with visual feedback
        btnNext.disabled = !selectedType;
        if (!selectedType) {
            btnNext.classList.add('opacity-50');
        } else {
            btnNext.classList.remove('opacity-50');
        }

        // Show/hide specific fields
        if (personneFields) personneFields.classList.toggle('d-none', !isPersonne);
        if (societeFields) societeFields.classList.toggle('d-none', !isSociete);

        // Update CIN requirement
        const cinInput = document.getElementById('registration_fournisseur_fournisseurCin');
        if (cinInput) cinInput.required = isPersonne;
    }

    cardPersonne.addEventListener('click', function(event) {
        // Add ripple effect
        createRipple(this, event);
        selectedType = 'PERSONNE';
        updateTypeDisplay();
        // Add haptic feedback (if supported)
        if (navigator.vibrate) navigator.vibrate(50);
    });

    cardSociete.addEventListener('click', function(event) {
        // Add ripple effect
        createRipple(this, event);
        selectedType = 'SOCIETE';
        updateTypeDisplay();
        // Add haptic feedback (if supported)
        if (navigator.vibrate) navigator.vibrate(50);
    });

    // Ripple effect function
    function createRipple(element, event) {
        const ripple = document.createElement('span');
        const rect = element.getBoundingClientRect();
        const size = Math.max(rect.width, rect.height);
        const x = event.clientX - rect.left - size / 2;
        const y = event.clientY - rect.top - size / 2;
        
        ripple.style.width = ripple.style.height = size + 'px';
        ripple.style.left = x + 'px';
        ripple.style.top = y + 'px';
        ripple.classList.add('ripple-effect');
        
        element.appendChild(ripple);
        
        setTimeout(() => ripple.remove(), 600);
    }

    btnNext.addEventListener('click', function() {
        if (!selectedType || !step1Section || !step2Section) return;
        
        // Smooth transition with fade out
        step1Section.classList.add('fade-out');
        
        setTimeout(() => {
            step1Section.classList.add('d-none');
            step1Section.classList.remove('fade-out');
            step2Section.classList.remove('d-none');
            step2Section.classList.add('fade-in');
            
            // Smooth scroll to top
            window.scrollTo({ top: 0, behavior: 'smooth' });
            
            // Update step indicators with animation
            if (step2Circle) {
                step2Circle.classList.remove('bg-secondary');
                step2Circle.classList.add('bg-primary');
                document.getElementById('step2-indicator').classList.add('active');
            }
            if (step2Text) {
                step2Text.classList.remove('text-muted');
                step2Text.classList.add('text-primary', 'fw-semibold');
            }
            
            
            // Animate form fields entrance
            setTimeout(() => {
                const formFields = step2Section.querySelectorAll('.mb-3, .mb-4');
                formFields.forEach((field, index) => {
                    setTimeout(() => {
                        field.style.animation = 'slideUp 0.4s ease-out forwards';
                        field.style.opacity = '1';
                    }, index * 50);
                });
            }, 100);
        }, 300);
    });

    if (btnBack) {
        btnBack.addEventListener('click', function() {
            if (!step1Section || !step2Section) return;
            
            // Smooth transition back to step 1
            step2Section.classList.add('fade-out');
            
            setTimeout(() => {
                step2Section.classList.add('d-none');
                step2Section.classList.remove('fade-out', 'fade-in');
                step1Section.classList.remove('d-none');
                step1Section.style.animation = 'slideInRight 0.5s ease-out';
                
                // Update step indicators
                if (step2Circle) {
                    step2Circle.classList.add('bg-secondary');
                    step2Circle.classList.remove('bg-primary');
                    document.getElementById('step2-indicator').classList.remove('active');
                }
                if (step2Text) {
                    step2Text.classList.add('text-muted');
                    step2Text.classList.remove('text-primary', 'fw-semibold');
                }
                
                // Smooth scroll to top
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }, 300);
        });
    }

    typeSelect.addEventListener('change', function() {
        selectedType = this.value;
        updateTypeDisplay();
    });

    if (selectedType) updateTypeDisplay();
    
    // Add real-time validation feedback
    const formInputs = document.querySelectorAll('.form-control, .form-select');
    formInputs.forEach(input => {
        // Focus animation
        input.addEventListener('focus', function() {
            this.parentElement.classList.add('focused');
        });
        
        input.addEventListener('blur', function() {
            this.parentElement.classList.remove('focused');
            
            // Validate on blur
            if (this.value && this.checkValidity()) {
                this.classList.add('is-valid');
                this.classList.remove('is-invalid');
            } else if (this.value && !this.checkValidity()) {
                this.classList.add('is-invalid');
                this.classList.remove('is-valid');
            }
        });
        
        // Clear validation on input
        input.addEventListener('input', function() {
            this.classList.remove('is-valid', 'is-invalid');
        });
    });
    
    // Add loading state to submit button
    const form = document.getElementById('fournisseur-form');
    if (form) {
        form.addEventListener('submit', function() {
            const submitBtn = this.querySelector('button[type="submit"]');
            if (submitBtn) {
                submitBtn.classList.add('loading');
                submitBtn.disabled = true;
            }
        });
    }
    
    // Smooth scroll to first error if validation fails
    const firstError = document.querySelector('.is-invalid, .invalid-feedback');
    if (firstError) {
        firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
});

// Password visibility toggle (global scope for inline onclick handlers)
function togglePasswordVisibility(button) {
    const input = button.previousElementSibling;
    const isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';
    button.classList.toggle('opacity-50', !isPassword);
}
</script>
{% endblock %}
