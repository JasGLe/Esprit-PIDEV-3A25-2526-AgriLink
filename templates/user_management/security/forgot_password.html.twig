{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - AgriLink{% endblock %}

{% block body %}
{{ include('components/_auth_background.html.twig') }}
<div class="min-vh-100 d-flex align-items-center justify-content-center py-5 px-3">
    <div class="w-100" style="max-width: 28rem;">
        <div class="mb-4">
            <div class="d-flex justify-content-center">
                <img src="{{ asset('logo_with_text.png') }}" alt="AgriLink Logo" class="logo logo-header">
            </div>
            <h2 class="mt-4 text-center display-6 fw-bold text-dark">
                Mot de passe oublié ?
            </h2>
            <p class="mt-2 text-center small text-muted">
                Saisissez votre adresse email et nous vous enverrons un lien pour réinitialiser votre mot de passe.
            </p>
        </div>

        {% for message in app.flashes('error') %}
            <div class="alert alert-danger d-flex align-items-start" role="alert">
                <svg class="flex-shrink-0 me-2" style="width: 1.25rem; height: 1.25rem;" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
                <div>{{ message }}</div>
            </div>
        {% endfor %}

        {{ form_start(form, {'attr': {'class': 'mt-4', 'novalidate': 'novalidate'}}) }}
            <div class="mb-4">
                <div>
                    {{ form_label(form.email) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-success w-100 d-flex align-items-center justify-content-center position-relative">
                    <svg class="position-absolute start-0 ms-3" style="width: 1.25rem; height: 1.25rem;" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
                        <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
                    </svg>
                    Envoyer le lien de réinitialisation
                </button>
            </div>
        {{ form_end(form) }}

        <div class="text-center mt-4">
            <a href="{{ path('app_login') }}" class="fw-medium text-success text-decoration-none">
                <svg class="d-inline-block me-1" style="width: 1rem; height: 1rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Retour à la connexion
            </a>
        </div>
    </div>
</div>
{% endblock %}
