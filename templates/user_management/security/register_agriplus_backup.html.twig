{% extends 'base.html.twig' %}

{% block title %}Inscription AgriPlus Premium - AgriLink{% endblock %}

{% block body %}
{# Premium AgriPlus yellow gradient background with curved forms #}
<div class="fixed inset-0 -z-10 overflow-hidden bg-gradient-to-br from-yellow-50 via-white to-yellow-100">
    {# Curved gradient shapes for premium feel #}
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-gradient-to-br from-yellow-100/60 to-yellow-50/40 rounded-full blur-3xl opacity-70"></div>
    <div class="absolute -top-32 -right-32 w-[500px] h-[500px] bg-gradient-to-bl from-orange-100/50 to-transparent rounded-full blur-3xl opacity-60"></div>
    <div class="absolute -bottom-20 -left-20 w-80 h-80 bg-gradient-to-tr from-yellow-100/50 to-transparent rounded-full blur-2xl opacity-50"></div>
    <div class="absolute -bottom-32 -right-16 w-96 h-96 bg-gradient-to-tl from-orange-100/60 to-yellow-50/40 rounded-full blur-3xl opacity-60"></div>
</div>
<div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="text-center mb-8">
            <div class="flex justify-center mb-4">
                <div class="relative">
                    <span class="text-6xl">⭐</span>
                    <span class="absolute -top-1 -right-1 bg-yellow-500 text-white text-xs font-bold px-2 py-1 rounded-full">PREMIUM</span>
                </div>
            </div>
            <h1 class="text-3xl font-bold text-gray-900">
                Rejoignez <span class="text-yellow-600">AgriPlus</span>
            </h1>
            <p class="mt-2 text-gray-600">
                Accédez aux fonctionnalités premium d'AgriLink
            </p>
        </div>

        {% for flash_message in app.flashes('error') %}
            <div class="rounded-md bg-red-50 border border-red-200 p-4 mb-6">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm text-red-800">{{ flash_message }}</p>
                    </div>
                </div>
            </div>
        {% endfor %}

        <!-- Subscription Plans Section -->
        <div class="mb-10">
            <h2 class="text-xl font-semibold text-gray-900 text-center mb-6">Choisissez votre plan</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Basic Plan -->
                <div class="plan-card bg-white rounded-xl shadow-lg border-2 border-gray-200 p-6 relative transition-all duration-300 hover:shadow-xl cursor-pointer" data-plan="BASIC">
                    <div class="text-center">
                        <h3 class="text-lg font-bold text-gray-900 mb-2">Basic</h3>
                        <div class="mb-4">
                            <span class="text-3xl font-bold text-gray-900">29</span>
                            <span class="text-gray-600">DT/mois</span>
                        </div>
                        <ul class="text-sm text-gray-600 space-y-3 text-left">
                            <li class="flex items-center">
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                Accès aux outils de base
                            </li>
                            <li class="flex items-center">
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                Support par email
                            </li>
                            <li class="flex items-center">
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                5 annonces par mois
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Premium Plan (Recommended) -->
                <div class="plan-card bg-white rounded-xl shadow-lg border-2 border-yellow-400 p-6 relative transition-all duration-300 hover:shadow-xl cursor-pointer transform scale-105" data-plan="PREMIUM">
                    <div class="absolute -top-3 left-1/2 transform -translate-x-1/2">
                        <span class="bg-yellow-500 text-white text-xs font-bold px-3 py-1 rounded-full">RECOMMANDÉ</span>
                    </div>
                    <div class="text-center">
                        <h3 class="text-lg font-bold text-yellow-600 mb-2">Premium</h3>
                        <div class="mb-4">
                            <span class="text-3xl font-bold text-yellow-600">59</span>
                            <span class="text-gray-600">DT/mois</span>
                        </div>
                        <ul class="text-sm text-gray-600 space-y-3 text-left">
                            <li class="flex items-center">
                                <svg class="h-5 w-5 text-yellow-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                Toutes les fonctionnalités
                            </li>
                            <li class="flex items-center">
                                <svg class="h-5 w-5 text-yellow-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                Support prioritaire
                            </li>
                            <li class="flex items-center">
                                <svg class="h-5 w-5 text-yellow-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                Annonces illimitées
                            </li>
                            <li class="flex items-center">
                                <svg class="h-5 w-5 text-yellow-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                Statistiques avancées
                            </li>
                        </ul>
                    </div>
                </div>

                <!-- Enterprise Plan -->
                <div class="plan-card bg-white rounded-xl shadow-lg border-2 border-gray-200 p-6 relative transition-all duration-300 hover:shadow-xl cursor-pointer" data-plan="ENTERPRISE">
                    <div class="absolute -top-3 left-1/2 transform -translate-x-1/2">
                        <span class="bg-gray-800 text-white text-xs font-bold px-3 py-1 rounded-full">PRO</span>
                    </div>
                    <div class="text-center">
                        <h3 class="text-lg font-bold text-gray-900 mb-2">Enterprise</h3>
                        <div class="mb-4">
                            <span class="text-3xl font-bold text-gray-900">149</span>
                            <span class="text-gray-600">DT/mois</span>
                        </div>
                        <ul class="text-sm text-gray-600 space-y-3 text-left">
                            <li class="flex items-center">
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                Tout Premium inclus
                            </li>
                            <li class="flex items-center">
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                Support dédié 24/7
                            </li>
                            <li class="flex items-center">
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                Accès API
                            </li>
                            <li class="flex items-center">
                                <svg class="h-5 w-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                </svg>
                                Compte multi-utilisateurs
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Registration Form -->
        <div class="bg-white rounded-xl shadow-lg p-8">
            <h2 class="text-xl font-semibold text-gray-900 mb-6">Informations personnelles</h2>
            
            {{ form_start(registrationForm, {'attr': {'class': 'space-y-6', 'id': 'agriplus-form', 'novalidate': 'novalidate'}}) }}
                
                <!-- Hidden subscription field linked to plan cards -->
                <div class="hidden" id="subscription-wrapper">
                    {{ form_widget(registrationForm.agriplusAbonnement) }}
                </div>
                
                <!-- Selected Plan Display -->
                <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-sm text-yellow-800 font-medium">Plan sélectionné</p>
                            <p class="text-lg font-bold text-yellow-600" id="selected-plan-display">Premium - 59 DT/mois</p>
                        </div>
                        <span class="text-3xl">⭐</span>
                    </div>
                </div>
                {{ form_errors(registrationForm.agriplusAbonnement) }}

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Nom -->
                    <div>
                        {{ form_label(registrationForm.nom) }}
                        {{ form_widget(registrationForm.nom) }}
                        {{ form_errors(registrationForm.nom) }}
                    </div>

                    <!-- Email -->
                    <div>
                        {{ form_label(registrationForm.email) }}
                        {{ form_widget(registrationForm.email) }}
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <!-- Password -->
                    <div>
                        {{ form_label(registrationForm.plainPassword.first) }}
                        {{ form_widget(registrationForm.plainPassword.first) }}
                        {{ form_errors(registrationForm.plainPassword.first) }}
                        <p class="mt-1 text-xs text-gray-500">Minimum 6 caractères</p>
                    </div>

                    <!-- Confirm Password -->
                    <div>
                        {{ form_label(registrationForm.plainPassword.second) }}
                        {{ form_widget(registrationForm.plainPassword.second) }}
                        {{ form_errors(registrationForm.plainPassword.second) }}
                    </div>

                    <!-- Telephone -->
                    <div>
                        {{ form_label(registrationForm.telephone) }}
                        {{ form_widget(registrationForm.telephone) }}
                        {{ form_errors(registrationForm.telephone) }}
                    </div>

                    <!-- Date de naissance -->
                    <div>
                        {{ form_label(registrationForm.dateNaissance) }}
                        {{ form_widget(registrationForm.dateNaissance) }}
                        {{ form_errors(registrationForm.dateNaissance) }}
                    </div>

                    <!-- Gouvernorat -->
                    <div>
                        {{ form_label(registrationForm.gouvernant) }}
                        {{ form_widget(registrationForm.gouvernant) }}
                        {{ form_errors(registrationForm.gouvernant) }}
                    </div>

                    <!-- Ville -->
                    <div>
                        {{ form_label(registrationForm.ville) }}
                        {{ form_widget(registrationForm.ville) }}
                        {{ form_errors(registrationForm.ville) }}
                    </div>

                    <!-- Code Postal -->
                    <div class="md:col-span-2">
                        {{ form_label(registrationForm.codePostale) }}
                        <div class="max-w-xs">
                            {{ form_widget(registrationForm.codePostale) }}
                        </div>
                        {{ form_errors(registrationForm.codePostale) }}
                    </div>
                </div>

                <!-- Terms -->
                <div class="border-t border-gray-200 pt-6">
                    <div class="flex items-start">
                        {{ form_widget(registrationForm.agreeTerms) }}
                        <label for="{{ registrationForm.agreeTerms.vars.id }}" class="ml-2 block text-sm text-gray-700">
                            J'accepte les <a href="#" class="text-yellow-600 hover:underline">conditions d'utilisation</a> et la <a href="#" class="text-yellow-600 hover:underline">politique de confidentialité</a>
                        </label>
                    </div>
                    {{ form_errors(registrationForm.agreeTerms) }}
                </div>

                <!-- Payment Note -->
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                            </svg>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm text-blue-800">
                                <strong>Note :</strong> Le paiement sera effectué après validation de votre compte. Vous bénéficierez d'un mois d'essai gratuit.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <div>
                    <button type="submit" class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-lg text-white bg-gradient-to-r from-yellow-500 to-yellow-600 hover:from-yellow-600 hover:to-yellow-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-yellow-500 shadow-lg transition-all duration-200">
                        <span class="absolute left-0 inset-y-0 flex items-center pl-3">
                            <svg class="h-5 w-5 text-yellow-300 group-hover:text-yellow-200" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
                            </svg>
                        </span>
                        Créer mon compte AgriPlus
                    </button>
                </div>
            {{ form_end(registrationForm) }}
        </div>

        <!-- Back Link -->
        <div class="text-center mt-8">
            <a href="{{ path('app_register') }}" class="inline-flex items-center text-sm text-gray-600 hover:text-yellow-600 transition-colors duration-200">
                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Retour au choix d'inscription
            </a>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const planCards = document.querySelectorAll('.plan-card');
    const subscriptionInputs = document.querySelectorAll('#subscription-wrapper input[type="radio"]');
    const selectedPlanDisplay = document.getElementById('selected-plan-display');
    
    const planLabels = {
        'BASIC': 'Basic - 29 DT/mois',
        'PREMIUM': 'Premium - 59 DT/mois',
        'ENTERPRISE': 'Enterprise - 149 DT/mois'
    };

    function updateSelectedPlan(planValue) {
        // Update radio button
        subscriptionInputs.forEach(input => {
            if (input.value === planValue) {
                input.checked = true;
            }
        });

        // Update plan cards styling
        planCards.forEach(card => {
            const cardPlan = card.dataset.plan;
            if (cardPlan === planValue) {
                card.classList.remove('border-gray-200');
                card.classList.add('border-yellow-400', 'ring-2', 'ring-yellow-300');
            } else {
                card.classList.remove('border-yellow-400', 'ring-2', 'ring-yellow-300');
                if (cardPlan !== 'PREMIUM' || planValue !== 'PREMIUM') {
                    card.classList.add('border-gray-200');
                }
            }
        });

        // Update display
        if (selectedPlanDisplay) {
            selectedPlanDisplay.textContent = planLabels[planValue] || planValue;
        }
    }

    // Add click handlers to plan cards
    planCards.forEach(card => {
        card.addEventListener('click', function() {
            const planValue = this.dataset.plan;
            updateSelectedPlan(planValue);
        });
    });

    // Initialize with Premium as default
    const checkedInput = document.querySelector('#subscription-wrapper input[type="radio"]:checked');
    if (checkedInput) {
        updateSelectedPlan(checkedInput.value);
    } else {
        updateSelectedPlan('PREMIUM');
    }
});
</script>

<style>
.plan-card {
    transition: all 0.3s ease;
}
.plan-card:hover {
    transform: translateY(-4px);
}
.plan-card.border-yellow-400 {
    box-shadow: 0 10px 25px -5px rgba(234, 179, 8, 0.3);
}
</style>
{% endblock %}
