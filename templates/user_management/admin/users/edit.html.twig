{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Modifier {{ user.nom }} - Administration{% endblock %}

{% block stylesheets %}
<style>
    @keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>
{% endblock %}

{% block dashboard_content %}
<div class="py-2">

    {# Breadcrumb #}
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin_users_list') }}" class="text-decoration-none">Utilisateurs</a></li>
            <li class="breadcrumb-item active">Modifier {{ user.nom }}</li>
        </ol>
    </nav>

    {# User profile header #}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center gap-4 flex-wrap">
                <div class="flex-shrink-0">
                    {% if user.photoProfil %}
                        <img src="{{ asset('agrilink/uploads/' ~ user.photoProfil) }}" alt="{{ user.displayName }}"
                             class="rounded-circle" width="72" height="72" style="object-fit:cover;">
                    {% else %}
                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white"
                             style="width:72px;height:72px;background:linear-gradient(135deg,#667eea,#764ba2);font-size:1.5rem;">
                            {{ user.initials }}
                        </div>
                    {% endif %}
                </div>
                <div class="flex-grow-1">
                    <h2 class="h4 fw-bold mb-1">{{ user.displayName }}</h2>
                    <p class="text-muted mb-2">{{ user.email }}</p>
                    <div class="d-flex gap-2 flex-wrap">
                        {% if user.role == 'ADMIN' %}
                            <span class="badge bg-danger">{{ user.roleBadge }}</span>
                        {% elseif user.role == 'AGRIPLUS' %}
                            <span class="badge bg-warning text-dark">AgriPlus</span>
                        {% elseif user.role == 'FOURNISSEUR' %}
                            <span class="badge bg-info text-dark">{{ user.roleBadge }}</span>
                        {% elseif user.role == 'AGRICULTEUR' %}
                            <span class="badge bg-success">Agriculteur</span>
                        {% else %}
                            <span class="badge bg-secondary">Utilisateur</span>
                        {% endif %}
                        {% if user.isActive %}
                            <span class="badge bg-success-subtle text-success border border-success-subtle">Actif</span>
                        {% else %}
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">Inactif</span>
                        {% endif %}
                        {% if user.emailVerified %}
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Email vérifié</span>
                        {% endif %}
                    </div>
                </div>
                <div class="text-end text-muted small">
                    <div>Inscrit le : <strong>{{ user.createdAt ? user.createdAt|date('d/m/Y') : 'N/A' }}</strong></div>
                    <div>Connexion : <strong>{{ user.lastLogin ? user.lastLogin|date('d/m/Y H:i') : 'Jamais' }}</strong></div>
                    {% if user.failedLoginAttempts > 0 %}
                        <div class="text-danger">{{ user.failedLoginAttempts }} tentative(s) échouée(s)</div>
                    {% endif %}
                    {% if user.lockedUntil %}
                        <div class="text-danger">🔒 Verrouillé jusqu'au {{ user.lockedUntil|date('d/m/Y H:i') }}</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {{ form_start(form, {attr: {novalidate: 'novalidate', enctype: 'multipart/form-data'}}) }}

    <div class="row g-4">
        {# Left column #}
        <div class="col-lg-8">

            {# Informations de base #}
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-semibold">
                        <svg class="me-2" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:inline;vertical-align:middle;">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        Informations de base
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_label(form.nom, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.nom, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.nom) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.email, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.email, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.email) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.plainPassword.first, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.plainPassword.first, {attr: {class: 'form-control', placeholder: 'Laisser vide pour conserver'}}) }}
                            {{ form_errors(form.plainPassword.first) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.plainPassword.second, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.plainPassword.second, {attr: {class: 'form-control', placeholder: 'Laisser vide pour conserver'}}) }}
                            {{ form_errors(form.plainPassword.second) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.telephone, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.telephone, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.telephone) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.dateNaissance, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.dateNaissance, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.dateNaissance) }}
                        </div>
                    </div>
                </div>
            </div>

            {# Localisation #}
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-semibold">
                        <svg class="me-2" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:inline;vertical-align:middle;">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        Localisation
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            {{ form_label(form.gouvernant, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.gouvernant, {attr: {class: 'form-select'}}) }}
                            {{ form_errors(form.gouvernant) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.ville, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.ville, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.ville) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.codePostale, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.codePostale, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.codePostale) }}
                        </div>
                    </div>
                </div>
            </div>

            {# Role-specific: Admin #}
            <div id="admin-fields" class="card border-0 shadow-sm mb-4 {{ user.role != 'ADMIN' ? 'd-none' : '' }}">
                <div class="card-header bg-danger bg-opacity-10 border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-semibold text-danger">🛡️ Configuration Administrateur</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_label(form.adminNiveau, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.adminNiveau, {attr: {class: 'form-select'}}) }}
                            {{ form_errors(form.adminNiveau) }}
                        </div>
                    </div>
                </div>
            </div>

            {# Role-specific: Agriculteur #}
            <div id="agriculteur-fields" class="card border-0 shadow-sm mb-4 {{ user.role != 'AGRICULTEUR' ? 'd-none' : '' }}">
                <div class="card-header bg-success bg-opacity-10 border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-semibold text-success">🌱 Informations Agriculteur</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_label(form.agriculteurExpAnnee, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.agriculteurExpAnnee, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.agriculteurExpAnnee) }}
                        </div>
                    </div>
                </div>
            </div>

            {# Role-specific: AgriPlus #}
            <div id="agriplus-fields" class="card border-0 shadow-sm mb-4 {{ user.role != 'AGRIPLUS' ? 'd-none' : '' }}">
                <div class="card-header bg-warning bg-opacity-10 border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-semibold text-warning">⭐ Abonnement AgriPlus</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_label(form.agriplusAbonnement, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.agriplusAbonnement, {attr: {class: 'form-select'}}) }}
                            {{ form_errors(form.agriplusAbonnement) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.agriplusDateExpiration, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.agriplusDateExpiration, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.agriplusDateExpiration) }}
                        </div>
                    </div>
                </div>
            </div>

            {# Role-specific: Fournisseur #}
            <div id="fournisseur-fields" class="card border-0 shadow-sm mb-4 {{ user.role != 'FOURNISSEUR' ? 'd-none' : '' }}">
                <div class="card-header bg-info bg-opacity-10 border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-semibold text-info">🏢 Informations Fournisseur</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            {{ form_label(form.fournisseurTypeFournisseur, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.fournisseurTypeFournisseur, {attr: {class: 'form-select', id: 'fournisseurTypeFournisseur'}}) }}
                            {{ form_errors(form.fournisseurTypeFournisseur) }}
                        </div>
                    </div>

                    <div id="fournisseur-personne-fields" class="mt-4 {{ user.fournisseurTypeFournisseur != 'PERSONNE' ? 'd-none' : '' }}">
                        <hr class="mb-3"><h6 class="fw-semibold mb-3">Informations personnelles</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                {{ form_label(form.fournisseurCin, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.fournisseurCin, {attr: {class: 'form-control'}}) }}
                                {{ form_errors(form.fournisseurCin) }}
                            </div>
                        </div>
                    </div>

                    <div id="fournisseur-societe-fields" class="mt-4 {{ user.fournisseurTypeFournisseur != 'SOCIETE' ? 'd-none' : '' }}">
                        <hr class="mb-3"><h6 class="fw-semibold mb-3">Informations de la société</h6>
                        <div class="row g-3">
                            <div class="col-md-6">
                                {{ form_label(form.fournisseurRaisonSocial, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.fournisseurRaisonSocial, {attr: {class: 'form-control'}}) }}
                                {{ form_errors(form.fournisseurRaisonSocial) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_label(form.fournisseurNumRegistre, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.fournisseurNumRegistre, {attr: {class: 'form-control'}}) }}
                                {{ form_errors(form.fournisseurNumRegistre) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_label(form.fournisseurFormeJuridique, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.fournisseurFormeJuridique, {attr: {class: 'form-control'}}) }}
                                {{ form_errors(form.fournisseurFormeJuridique) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_label(form.fournisseurCapital, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.fournisseurCapital, {attr: {class: 'form-control'}}) }}
                                {{ form_errors(form.fournisseurCapital) }}
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-12">
                            {{ form_label(form.fournisseurCertifications, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.fournisseurCertifications, {attr: {class: 'form-control', rows: 3}}) }}
                            {{ form_errors(form.fournisseurCertifications) }}
                        </div>
                    </div>
                </div>
            </div>

        </div>

        {# Right column #}
        <div class="col-lg-4">

            {# Rôle et statut #}
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-semibold">Rôle et statut</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        {{ form_label(form.role, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.role, {attr: {class: 'form-select', id: 'userRole'}}) }}
                        {{ form_errors(form.role) }}
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            {{ form_widget(form.isActive, {attr: {class: 'form-check-input', role: 'switch'}}) }}
                            {{ form_label(form.isActive, null, {label_attr: {class: 'form-check-label fw-semibold'}}) }}
                        </div>
                    </div>
                    <div>
                        <div class="form-check form-switch">
                            {{ form_widget(form.emailVerified, {attr: {class: 'form-check-input', role: 'switch'}}) }}
                            {{ form_label(form.emailVerified, null, {label_attr: {class: 'form-check-label fw-semibold'}}) }}
                        </div>
                    </div>
                </div>
            </div>

            {# Photo de profil #}
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-semibold">Photo de profil</h5>
                </div>
                <div class="card-body p-4 text-center">
                    {% if user.photoProfil %}
                        <img src="{{ asset('agrilink/uploads/' ~ user.photoProfil) }}" alt="{{ user.displayName }}"
                             class="rounded-circle mb-3" width="100" height="100" style="object-fit:cover;" id="avatar-preview">
                        <div id="avatar-placeholder" class="d-none"></div>
                    {% else %}
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3 fw-bold text-white"
                             style="width:100px;height:100px;background:linear-gradient(135deg,#667eea,#764ba2);font-size:1.8rem;" id="avatar-placeholder">
                            {{ user.initials }}
                        </div>
                        <img id="avatar-preview" src="" alt="" class="rounded-circle mb-3 d-none" width="100" height="100" style="object-fit:cover;">
                    {% endif %}
                    <div class="mt-2 mb-3">
                        {% if user.photoProfil %}
                            <small class="text-muted d-block">Photo actuelle : <strong>{{ user.photoProfil|split('/')|last }}</strong></small>
                        {% else %}
                            <small class="text-muted d-block">Aucune photo</small>
                        {% endif %}
                    </div>
                    
                    {{ form_label(form.profilePhoto, null, {label_attr: {class: 'form-label fw-semibold d-block'}}) }}
                    {{ form_widget(form.profilePhoto, {attr: {class: 'form-control form-control-sm', accept: 'image/jpeg,image/png,image/webp', id: 'profile-photo-input'}}) }}
                    {{ form_errors(form.profilePhoto) }}
                    
                    {# Preview section (hidden until file chosen) #}
                    <div id="photo-preview-section" class="d-none mt-4 p-3 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-2">
                        <p class="text-success small mb-2 fw-semibold">
                            <svg fill="currentColor" viewBox="0 0 20 20" width="14" height="14" style="display:inline; margin-right:4px; vertical-align:middle;">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                            </svg>
                            Aperçu de la nouvelle photo
                        </p>
                        <img id="photo-preview-img" src="" alt="Aperçu" class="rounded-circle mb-2" width="100" height="100" style="object-fit:cover; border:4px solid #198754;">
                        <p id="photo-preview-filename" class="text-muted small mb-0"></p>
                    </div>
                    
                    {# Submit photo button (hidden until file chosen) #}
                    <div id="photo-submit-wrap" class="d-none mt-3 pt-3 border-top">
                        <button type="button" id="submit-photo-btn" class="btn btn-sm btn-success w-100">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14" class="me-1" style="display:inline; vertical-align:middle;">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            Enregistrer la photo seulement
                        </button>
                        <button type="button" id="cancel-photo-btn" class="btn btn-sm btn-outline-secondary w-100 mt-2">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14" class="me-1" style="display:inline; vertical-align:middle;">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                            Annuler
                        </button>
                    </div>
                    
                    {% if user.photoProfil %}
                        <button type="button" class="btn btn-sm btn-outline-danger mt-2 w-100" id="delete-avatar-btn">
                            <svg class="me-1" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:inline;vertical-align:middle;">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                            </svg>
                            Supprimer la photo
                        </button>
                    {% endif %}
                    <small class="text-muted d-block mt-2">JPG, PNG ou WEBP · max 2 Mo</small>
                </div>
            </div>

            {# Actions #}
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success">
                            <svg class="me-2" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:inline;vertical-align:middle;">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                            </svg>
                            Enregistrer les modifications
                        </button>
                        <a href="{{ path('admin_users_list') }}" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    {{ form_end(form) }}

    {# Hidden form for deleting photo (outside main form) #}
    <form id="delete-photo-form" method="POST" action="{{ path('admin_users_delete_photo', {id: user.id}) }}" style="display: none;">
        <input type="hidden" name="_token" value="{{ csrf_token('delete-photo-' ~ user.id) }}">
    </form>

    {# Delete form (outside main form to avoid nested forms) #}
    {% if user.id != app.user.id %}
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-body p-4">
                <h5 class="text-danger mb-3">Zone de danger</h5>
                <p class="text-muted mb-3">Supprimer définitivement cet utilisateur. Cette action est irréversible.</p>
                <form method="POST" action="{{ path('admin_users_delete', {id: user.id}) }}"
                      onsubmit="return confirm('Supprimer définitivement cet utilisateur ? Cette action est irréversible.');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}">
                    <button type="submit" class="btn btn-outline-danger">
                        <svg class="me-2" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:inline;vertical-align:middle;">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                        </svg>
                        Supprimer l'utilisateur
                    </button>
                </form>
            </div>
        </div>
    {% endif %}
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    console.log('Edit page: DOM loaded, initializing...');
    
    // Get elements using name attribute (more reliable than ID)
    const roleSelect = document.querySelector('select[name*="[role]"]');
    const fournisseurTypeSelect = document.querySelector('select[name*="[fournisseurTypeFournisseur]"]');
    
    console.log('Role select found:', roleSelect);
    console.log('Fournisseur type select found:', fournisseurTypeSelect);
    
    // Role sections
    const adminFields = document.getElementById('admin-fields');
    const agriculteurFields = document.getElementById('agriculteur-fields');
    const agriplusFields = document.getElementById('agriplus-fields');
    const fournisseurFields = document.getElementById('fournisseur-fields');
    
    // Fournisseur sub-sections
    const fournisseurPersonneFields = document.getElementById('fournisseur-personne-fields');
    const fournisseurSocieteFields = document.getElementById('fournisseur-societe-fields');
    
    // Toggle role-specific fields
    function toggleRoleFields() {
        if (!roleSelect) {
            console.error('Role select not found!');
            return;
        }
        
        const selectedRole = roleSelect.value;
        console.log('Selected role:', selectedRole);
        
        // Hide all role sections
        if (adminFields) adminFields.classList.add('d-none');
        if (agriculteurFields) agriculteurFields.classList.add('d-none');
        if (agriplusFields) agriplusFields.classList.add('d-none');
        if (fournisseurFields) fournisseurFields.classList.add('d-none');
        
        // Show selected role section
        switch(selectedRole) {
            case 'ADMIN':
                if (adminFields) adminFields.classList.remove('d-none');
                break;
            case 'AGRICULTEUR':
                if (agriculteurFields) agriculteurFields.classList.remove('d-none');
                break;
            case 'AGRIPLUS':
                if (agriplusFields) agriplusFields.classList.remove('d-none');
                break;
            case 'FOURNISSEUR':
                if (fournisseurFields) {
                    fournisseurFields.classList.remove('d-none');
                    // Also trigger fournisseur type fields
                    setTimeout(toggleFournisseurTypeFields, 100);
                }
                break;
        }
    }
    
    // Toggle fournisseur type-specific fields
    function toggleFournisseurTypeFields() {
        if (!fournisseurTypeSelect) {
            console.error('Fournisseur type select not found!');
            return;
        }
        
        const selectedType = fournisseurTypeSelect.value;
        console.log('Selected fournisseur type:', selectedType);
        
        // Hide both sub-sections
        if (fournisseurPersonneFields) fournisseurPersonneFields.classList.add('d-none');
        if (fournisseurSocieteFields) fournisseurSocieteFields.classList.add('d-none');
        
        // Show selected type section
        if (selectedType === 'PERSONNE' && fournisseurPersonneFields) {
            fournisseurPersonneFields.classList.remove('d-none');
        } else if (selectedType === 'SOCIETE' && fournisseurSocieteFields) {
            fournisseurSocieteFields.classList.remove('d-none');
        }
    }
    
    // Attach event listeners
    if (roleSelect) {
        roleSelect.addEventListener('change', function() {
            console.log('Role changed to:', this.value);
            toggleRoleFields();
        });
    }
    
    if (fournisseurTypeSelect) {
        fournisseurTypeSelect.addEventListener('change', function() {
            console.log('Fournisseur type changed to:', this.value);
            toggleFournisseurTypeFields();
        });
    }
    
    // Initialize on page load
    toggleRoleFields();
    toggleFournisseurTypeFields();
    
    // Live photo preview and submit button
    const input = document.getElementById('profile-photo-input');
    const photoPreviewSection = document.getElementById('photo-preview-section');
    const photoPreviewImg = document.getElementById('photo-preview-img');
    const photoPreviewFilename = document.getElementById('photo-preview-filename');
    const photoSubmitWrap = document.getElementById('photo-submit-wrap');
    const submitPhotoBtn = document.getElementById('submit-photo-btn');
    const cancelPhotoBtn = document.getElementById('cancel-photo-btn');
    const form = document.querySelector('form[enctype="multipart/form-data"]');
    
    console.log('Photo upload elements found:', {
        input: !!input,
        photoPreviewSection: !!photoPreviewSection,
        photoPreviewImg: !!photoPreviewImg,
        submitPhotoBtn: !!submitPhotoBtn,
        form: !!form
    });
    
    if (input) {
        input.addEventListener('change', function () {
            const file = this.files[0];
            console.log('File selected:', file?.name);
            if (file) {
                const reader = new FileReader();
                reader.onload = e => {
                    const placeholder = document.getElementById('avatar-placeholder');
                    if (placeholder) placeholder.classList.add('d-none');
                    const img = document.getElementById('avatar-preview');
                    img.src = e.target.result;
                    img.classList.remove('d-none');
                    
                    // Show preview section
                    if (photoPreviewImg) {
                        photoPreviewImg.src = e.target.result;
                        console.log('Preview image src set');
                    }
                    if (photoPreviewFilename) {
                        photoPreviewFilename.textContent = file.name;
                        console.log('Preview filename set:', file.name);
                    }
                    if (photoPreviewSection) {
                        photoPreviewSection.classList.remove('d-none');
                        console.log('Preview section shown');
                    }
                    if (photoSubmitWrap) {
                        photoSubmitWrap.classList.remove('d-none');
                        console.log('Submit button shown');
                    }
                };
                reader.readAsDataURL(file);
            } else {
                // No file selected
                if (photoPreviewSection) photoPreviewSection.classList.add('d-none');
                if (photoSubmitWrap) photoSubmitWrap.classList.add('d-none');
            }
        });
    }
    
    // Submit photo only
    if (submitPhotoBtn && form) {
        submitPhotoBtn.addEventListener('click', function(e) {
            e.preventDefault();
            if (input && input.files[0] && form) {
                console.log('Submitting photo only...');
                // Show loading state
                submitPhotoBtn.disabled = true;
                const originalHTML = submitPhotoBtn.innerHTML;
                submitPhotoBtn.innerHTML = '<svg class="me-1" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:inline;vertical-align:middle;animation:spin 1s linear infinite;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg> Enregistrement...';
                
                // Create FormData from form with only photo field and CSRF
                const formData = new FormData();
                
                // Get CSRF token from hidden input in form
                const csrfToken = form.querySelector('input[name="_token"]');
                if (csrfToken) {
                    formData.append('_token', csrfToken.value);
                    console.log('CSRF token found');
                }
                
                // Add photo file with correct field name
                formData.append('admin_user[profilePhoto]', input.files[0]);
                
                // Post to current URL
                fetch(window.location.href, {
                    method: 'POST',
                    body: formData
                }).then(response => {
                    console.log('Response status:', response.status);
                    if (response.ok) {
                        window.location.reload();
                    } else {
                        submitPhotoBtn.disabled = false;
                        submitPhotoBtn.innerHTML = originalHTML;
                        alert('Erreur lors de l\'enregistrement de la photo');
                    }
                }).catch(error => {
                    console.error('Erreur:', error);
                    submitPhotoBtn.disabled = false;
                    submitPhotoBtn.innerHTML = originalHTML;
                    alert('Erreur lors de l\'enregistrement de la photo');
                });
            }
        });
    }
    
    // Cancel photo selection
    if (cancelPhotoBtn) {
        cancelPhotoBtn.addEventListener('click', function(e) {
            e.preventDefault();
            input.value = '';
            const placeholder = document.getElementById('avatar-placeholder');
            const img = document.getElementById('avatar-preview');
            
            if (placeholder && !img.src) {
                placeholder.classList.remove('d-none');
            } else if (img.src && img.src !== '') {
                // Reset to original image
                img.classList.remove('d-none');
            }
            
            if (photoPreviewSection) photoPreviewSection.classList.add('d-none');
            if (photoSubmitWrap) photoSubmitWrap.classList.add('d-none');
        });
    }

    // Delete avatar button
    const deleteAvatarBtn = document.getElementById('delete-avatar-btn');
    if (deleteAvatarBtn) {
        deleteAvatarBtn.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            if (confirm('Supprimer la photo de profil ? Cette action est irréversible.')) {
                const deleteForm = document.getElementById('delete-photo-form');
                if (deleteForm) {
                    // Disable button and show loading state
                    deleteAvatarBtn.disabled = true;
                    const originalHTML = deleteAvatarBtn.innerHTML;
                    deleteAvatarBtn.innerHTML = '<svg class="me-1" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:inline;vertical-align:middle;animation:spin 1s linear infinite;"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg> Suppression...';
                    deleteForm.submit();
                } else {
                    console.error('Delete photo form not found');
                    alert('Erreur : formulaire de suppression introuvable');
                }
            }
        });
    }
});
</script>
{% endblock dashboard_content %}
