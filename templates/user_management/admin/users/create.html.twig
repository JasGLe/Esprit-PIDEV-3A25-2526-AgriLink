{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Créer un utilisateur - Administration{% endblock %}

{% block main_content %}
<div class="container-fluid py-4">
    {# Page header #}
    <div class="mb-4">
        <div class="mb-3">
            <a href="{{ path('admin_users_list') }}" class="btn btn-sm btn-link text-decoration-none">
                <svg class="me-1" style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Retour à la liste
            </a>
        </div>
        <h1 class="h2 fw-bold">Créer un nouvel utilisateur</h1>
        <p class="text-muted">Remplissez le formulaire pour créer un nouveau compte utilisateur.</p>
    </div>

    {# Flash messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert {{ label == 'success' ? 'alert-success' : (label == 'error' ? 'alert-danger' : 'alert-info') }} alert-dismissible fade show mb-3" role="alert">
                <div class="d-flex align-items-center">
                    {% if label == 'error' %}
                        <svg class="me-2" style="width: 20px; height: 20px;" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                    {% endif %}
                    <span>{{ message }}</span>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        {# Basic Information #}
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h3 class="card-title h5 mb-4">
                    <svg class="me-2" style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                    </svg>
                    Informations de base
                </h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.nom) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.email) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.plainPassword.first, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.plainPassword.first) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.plainPassword.second, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.plainPassword.second) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.telephone, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.telephone, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.telephone) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.dateNaissance, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.dateNaissance, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.dateNaissance) }}
                    </div>
                </div>
            </div>
        </div>

        {# Location #}
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h3 class="card-title h5 mb-4">
                    <svg class="me-2" style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    Localisation
                </h3>
                <div class="row g-3">
                    <div class="col-md-4">
                        {{ form_label(form.gouvernant, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.gouvernant, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.gouvernant) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_label(form.ville, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.ville, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.ville) }}
                    </div>
                    <div class="col-md-4">
                        {{ form_label(form.codePostale, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.codePostale, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.codePostale) }}
                    </div>
                </div>
            </div>
        </div>

        {# Role & Status #}
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h3 class="card-title h5 mb-4">
                    <svg class="me-2" style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                    Rôle et statut
                </h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_label(form.role, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.role, {'attr': {'class': 'form-select', 'id': 'user_role', 'onchange': 'toggleRoleFields()'}}) }}
                        {{ form_errors(form.role) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.profilePhoto, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.profilePhoto, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.profilePhoto) }}
                    </div>
                    <div class="col-12">
                        <div class="d-flex gap-4">
                            <div class="form-check">
                                {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(form.isActive, null, {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                            <div class="form-check">
                                {{ form_widget(form.emailVerified, {'attr': {'class': 'form-check-input'}}) }}
                                {{ form_label(form.emailVerified, null, {'label_attr': {'class': 'form-check-label'}}) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Admin-specific fields #}
        <div id="admin-fields" class="card shadow-sm mb-4 d-none">
            <div class="card-body">
                <h3 class="card-title h5 mb-4">
                    🛡️ Configuration Administrateur
                </h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_label(form.adminNiveau, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.adminNiveau, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.adminNiveau) }}
                    </div>
                </div>
            </div>
        </div>

        {# Agriculteur-specific fields #}
        <div id="agriculteur-fields" class="card shadow-sm mb-4 d-none">
            <div class="card-body">
                <h3 class="card-title h5 mb-4">
                    🌱 Informations Agriculteur
                </h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_label(form.agriculteurExpAnnee, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.agriculteurExpAnnee, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.agriculteurExpAnnee) }}
                    </div>
                </div>
            </div>
        </div>

        {# AgriPlus-specific fields #}
        <div id="agriplus-fields" class="card shadow-sm mb-4 d-none">
            <div class="card-body">
                <h3 class="card-title h5 mb-4">
                    ⭐ Abonnement AgriPlus
                </h3>
                <div class="row g-3">
                    <div class="col-md-6">
                        {{ form_label(form.agriplusAbonnement, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.agriplusAbonnement, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.agriplusAbonnement) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.agriplusDateExpiration, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.agriplusDateExpiration, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.agriplusDateExpiration) }}
                    </div>
                </div>
            </div>
        </div>

        {# Fournisseur-specific fields #}
        <div id="fournisseur-fields" class="card shadow-sm mb-4 d-none">
            <div class="card-body">
                <h3 class="card-title h5 mb-4">
                    🏢 Informations Fournisseur
                </h3>
                <div class="row g-3">
                    <div class="col-12">
                        {{ form_label(form.fournisseurTypeFournisseur, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.fournisseurTypeFournisseur, {'attr': {'class': 'form-select', 'id': 'fournisseur_type', 'onchange': 'toggleFournisseurFields()'}}) }}
                        {{ form_errors(form.fournisseurTypeFournisseur) }}
                    </div>
                </div>

                {# Personne fields #}
                <div id="fournisseur-personne-fields" class="mt-4 d-none">
                    <h4 class="h6 mb-3">Informations personnelles</h4>
                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_label(form.fournisseurCin, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.fournisseurCin, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.fournisseurCin) }}
                        </div>
                    </div>
                </div>

                {# Societe fields #}
                <div id="fournisseur-societe-fields" class="mt-4 d-none">
                    <h4 class="h6 mb-3">Informations de la société</h4>
                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_label(form.fournisseurRaisonSocial, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.fournisseurRaisonSocial, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.fournisseurRaisonSocial) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.fournisseurNumRegistre, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.fournisseurNumRegistre, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.fournisseurNumRegistre) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.fournisseurFormeJuridique, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.fournisseurFormeJuridique, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.fournisseurFormeJuridique) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.fournisseurCapital, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.fournisseurCapital, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.fournisseurCapital) }}
                        </div>
                    </div>
                </div>

                {# Certifications (common) #}
                <div class="mt-4">
                    <div class="row g-3">
                        <div class="col-12">
                            {{ form_label(form.fournisseurCertifications, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.fournisseurCertifications, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.fournisseurCertifications) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Form actions #}
        <div class="d-flex justify-content-end gap-2">
            <a href="{{ path('admin_users_list') }}" class="btn btn-outline-secondary">
                Annuler
            </a>
            <button type="submit" class="btn btn-success">
                <svg class="me-1" style="width: 16px; height: 16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                </svg>
                Créer l'utilisateur
            </button>
        </div>
    {{ form_end(form) }}
</div>

<script>
function toggleRoleFields() {
    const role = document.getElementById('user_role').value;
    
    // Hide all role-specific sections
    document.getElementById('admin-fields').classList.add('d-none');
    document.getElementById('agriculteur-fields').classList.add('d-none');
    document.getElementById('agriplus-fields').classList.add('d-none');
    document.getElementById('fournisseur-fields').classList.add('d-none');
    
    // Show relevant section
    if (role === 'ADMIN') {
        document.getElementById('admin-fields').classList.remove('d-none');
    } else if (role === 'AGRICULTEUR') {
        document.getElementById('agriculteur-fields').classList.remove('d-none');
    } else if (role === 'AGRIPLUS') {
        document.getElementById('agriplus-fields').classList.remove('d-none');
    } else if (role === 'FOURNISSEUR') {
        document.getElementById('fournisseur-fields').classList.remove('d-none');
    }
}

function toggleFournisseurFields() {
    const type = document.getElementById('fournisseur_type').value;
    
    // Hide both
    document.getElementById('fournisseur-personne-fields').classList.add('d-none');
    document.getElementById('fournisseur-societe-fields').classList.add('d-none');
    
    // Show relevant
    if (type === 'PERSONNE') {
        document.getElementById('fournisseur-personne-fields').classList.remove('d-none');
    } else if (type === 'SOCIETE') {
        document.getElementById('fournisseur-societe-fields').classList.remove('d-none');
    }
}

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
    toggleRoleFields();
    toggleFournisseurFields();
});
</script>
{% endblock %}
