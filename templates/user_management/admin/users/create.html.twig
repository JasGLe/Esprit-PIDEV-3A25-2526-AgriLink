{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Créer un utilisateur - Administration{% endblock %}

{% block stylesheets %}
<style>
    .photo-uploader-card {
        background: linear-gradient(180deg, #ffffff 0%, #f8fff9 100%);
    }
    .avatar-frame {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        margin: 0 auto;
        border: 3px solid #d1fae5;
        box-shadow: 0 10px 24px rgba(34, 197, 94, 0.16);
        overflow: hidden;
    }
    .avatar-upload-zone {
        border: 2px dashed #9ca3af;
        border-radius: 14px;
        padding: 1rem;
        text-align: center;
        cursor: pointer;
        background: #fff;
        transition: all .2s ease;
    }
    .avatar-upload-zone:hover,
    .avatar-upload-zone:focus,
    .avatar-upload-zone.is-active {
        border-color: #22c55e;
        background: #f0fdf4;
        box-shadow: 0 0 0 4px rgba(34, 197, 94, .15);
    }
    .photo-meta {
        font-size: .75rem;
        color: #6b7280;
    }
</style>
{% endblock %}

{% block dashboard_content %}
<div class="py-2">

    {# Breadcrumb #}
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin_users_list') }}" class="text-decoration-none">Utilisateurs</a></li>
            <li class="breadcrumb-item active">Créer un utilisateur</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Créer un utilisateur</h1>
            <p class="text-muted mb-0">Remplissez le formulaire pour créer un nouveau compte.</p>
        </div>
        <a href="{{ path('admin_users_list') }}" class="btn btn-outline-secondary btn-sm">
            ← Retour à la liste
        </a>
    </div>

    {{ form_start(form, {attr: {novalidate: 'novalidate', enctype: 'multipart/form-data'}}) }}

    <div class="row g-4">
        {# Left column #}
        <div class="col-lg-8">

            {# Informations de base #}
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-semibold">
                        <svg class="me-2" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:inline;vertical-align:middle;">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                        </svg>
                        Informations de base
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_label(form.nom, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.nom, {attr: {class: 'form-control', placeholder: 'Nom complet'}}) }}
                            {{ form_errors(form.nom) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.email, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.email, {attr: {class: 'form-control', placeholder: 'email@exemple.com'}}) }}
                            {{ form_errors(form.email) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.plainPassword.first, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.plainPassword.first, {attr: {class: 'form-control', placeholder: '••••••••'}}) }}
                            {{ form_errors(form.plainPassword.first) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.plainPassword.second, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.plainPassword.second, {attr: {class: 'form-control', placeholder: '••••••••'}}) }}
                            {{ form_errors(form.plainPassword.second) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.telephone, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.telephone, {attr: {class: 'form-control', placeholder: '+216 XX XXX XXX'}}) }}
                            {{ form_errors(form.telephone) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.dateNaissance, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.dateNaissance, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.dateNaissance) }}
                        </div>
                    </div>
                </div>
            </div>

            {# Localisation #}
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-semibold">
                        <svg class="me-2" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:inline;vertical-align:middle;">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                        Localisation
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            {{ form_label(form.gouvernant, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.gouvernant, {attr: {class: 'form-select'}}) }}
                            {{ form_errors(form.gouvernant) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.ville, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.ville, {attr: {class: 'form-control', placeholder: 'Ville'}}) }}
                            {{ form_errors(form.ville) }}
                        </div>
                        <div class="col-md-4">
                            {{ form_label(form.codePostale, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.codePostale, {attr: {class: 'form-control', placeholder: '1000'}}) }}
                            {{ form_errors(form.codePostale) }}
                        </div>
                    </div>
                </div>
            </div>

            {# Role-specific: Admin #}
            <div id="admin-fields" class="card border-0 shadow-sm mb-4 d-none">
                <div class="card-header bg-danger bg-opacity-10 border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-semibold text-danger">🛡️ Configuration Administrateur</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_label(form.adminNiveau, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.adminNiveau, {attr: {class: 'form-select'}}) }}
                            {{ form_errors(form.adminNiveau) }}
                        </div>
                    </div>
                </div>
            </div>

            {# Role-specific: Agriculteur #}
            <div id="agriculteur-fields" class="card border-0 shadow-sm mb-4 d-none">
                <div class="card-header bg-success bg-opacity-10 border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-semibold text-success">🌱 Informations Agriculteur</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_label(form.agriculteurExpAnnee, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.agriculteurExpAnnee, {attr: {class: 'form-control', placeholder: '5'}}) }}
                            {{ form_errors(form.agriculteurExpAnnee) }}
                        </div>
                    </div>
                </div>
            </div>

            {# Role-specific: AgriPlus #}
            <div id="agriplus-fields" class="card border-0 shadow-sm mb-4 d-none">
                <div class="card-header bg-warning bg-opacity-10 border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-semibold text-warning">⭐ Abonnement AgriPlus</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            {{ form_label(form.agriplusAbonnement, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.agriplusAbonnement, {attr: {class: 'form-select'}}) }}
                            {{ form_errors(form.agriplusAbonnement) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.agriplusDateExpiration, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.agriplusDateExpiration, {attr: {class: 'form-control'}}) }}
                            {{ form_errors(form.agriplusDateExpiration) }}
                        </div>
                    </div>
                </div>
            </div>

            {# Role-specific: Fournisseur #}
            <div id="fournisseur-fields" class="card border-0 shadow-sm mb-4 d-none">
                <div class="card-header bg-info bg-opacity-10 border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-semibold text-info">🏢 Informations Fournisseur</h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            {{ form_label(form.fournisseurTypeFournisseur, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.fournisseurTypeFournisseur, {attr: {class: 'form-select', id: 'fournisseurTypeFournisseur'}}) }}
                            {{ form_errors(form.fournisseurTypeFournisseur) }}
                            <small class="form-text text-muted">Sélectionnez le type de fournisseur pour afficher les champs appropriés</small>
                        </div>
                    </div>

                    <div id="fournisseur-personne-fields" class="mt-4 d-none">
                        <div class="alert alert-info alert-sm d-flex align-items-center mb-3" style="font-size:0.875rem;">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20" class="me-2 flex-shrink-0">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                            </svg>
                            Fournisseur personne physique sélectionné
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                {{ form_label(form.fournisseurCin, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.fournisseurCin, {attr: {class: 'form-control', placeholder: '12345678'}}) }}
                                {{ form_errors(form.fournisseurCin) }}
                                <small class="form-text text-muted">Carte d'identité nationale (8 chiffres)</small>
                            </div>
                        </div>
                    </div>

                    <div id="fournisseur-societe-fields" class="mt-4 d-none">
                        <div class="alert alert-info alert-sm d-flex align-items-center mb-3" style="font-size:0.875rem;">
                            <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20" class="me-2 flex-shrink-0">
                                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd"/>
                            </svg>
                            Fournisseur société sélectionné
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                {{ form_label(form.fournisseurRaisonSocial, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.fournisseurRaisonSocial, {attr: {class: 'form-control', placeholder: 'Nom de la société'}}) }}
                                {{ form_errors(form.fournisseurRaisonSocial) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_label(form.fournisseurNumRegistre, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.fournisseurNumRegistre, {attr: {class: 'form-control', placeholder: 'A12345678'}}) }}
                                {{ form_errors(form.fournisseurNumRegistre) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_label(form.fournisseurFormeJuridique, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.fournisseurFormeJuridique, {attr: {class: 'form-select'}}) }}
                                {{ form_errors(form.fournisseurFormeJuridique) }}
                            </div>
                            <div class="col-md-6">
                                {{ form_label(form.fournisseurCapital, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                                {{ form_widget(form.fournisseurCapital, {attr: {class: 'form-control', placeholder: '10000.00'}}) }}
                                {{ form_errors(form.fournisseurCapital) }}
                                <small class="form-text text-muted">Capital en TND</small>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-12">
                            {{ form_label(form.fournisseurCertifications, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.fournisseurCertifications, {attr: {class: 'form-control', rows: 3, placeholder: 'Listez les certifications séparées par des virgules'}}) }}
                            {{ form_errors(form.fournisseurCertifications) }}
                        </div>
                    </div>
                </div>
            </div>

        </div>

        {# Right column: Role, Photo, Status #}
        <div class="col-lg-4">

            {# Rôle et statut #}
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-semibold">
                        <svg class="me-2" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:inline;vertical-align:middle;">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                        Rôle et statut
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        {{ form_label(form.role, null, {label_attr: {class: 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.role, {attr: {class: 'form-select', id: 'userRole'}}) }}
                        {{ form_errors(form.role) }}
                        <small class="form-text text-muted">Sélectionnez le rôle pour afficher les champs spécifiques</small>
                    </div>
                    <div class="mb-3">
                        <div class="form-check form-switch">
                            {{ form_widget(form.isActive, {attr: {class: 'form-check-input', role: 'switch'}}) }}
                            {{ form_label(form.isActive, null, {label_attr: {class: 'form-check-label fw-semibold'}}) }}
                        </div>
                    </div>
                    <div class="mb-0">
                        <div class="form-check form-switch">
                            {{ form_widget(form.emailVerified, {attr: {class: 'form-check-input', role: 'switch'}}) }}
                            {{ form_label(form.emailVerified, null, {label_attr: {class: 'form-check-label fw-semibold'}}) }}
                        </div>
                    </div>
                </div>
            </div>

            {# Photo de profil #}
            <div class="card border-0 shadow-sm mb-4 photo-uploader-card" id="photo-uploader-create">
                <div class="card-header bg-white border-bottom py-3 px-4">
                    <h5 class="mb-0 fw-semibold">Photo de profil</h5>
                </div>
                <div class="card-body p-4 text-center">
                    <div class="avatar-frame d-flex align-items-center justify-content-center mb-3 bg-white">
                        <span id="avatar-initial" class="fw-bold text-white w-100 h-100 d-flex align-items-center justify-content-center"
                              style="background:linear-gradient(135deg,#667eea,#764ba2);font-size:2rem;">?</span>
                        <img id="avatar-preview" src="" alt="" class="w-100 h-100 d-none" style="object-fit:cover;">
                    </div>

                    {{ form_label(form.profilePhoto, null, {label_attr: {class: 'form-label fw-semibold d-block'}}) }}
                    {{ form_widget(form.profilePhoto, {attr: {class: 'visually-hidden', accept: 'image/jpeg,image/png,image/webp', id: 'profile-photo-input', style: 'display: none;'}}) }}
                    {{ form_errors(form.profilePhoto) }}

                    <button type="button" class="avatar-upload-zone d-block w-100" id="uploadZoneCreate" style="border: 2px dashed #9ca3af; border-radius: 14px; padding: 1rem; text-align: center; cursor: pointer; background: #fff; transition: all .2s ease; display: block; width: 100%; margin-bottom: 0;">
                        <svg fill="none" stroke="#6b7280" viewBox="0 0 24 24" width="28" height="28" class="mb-2" style="pointer-events: none;">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                  d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
                        </svg>
                        <p class="mb-0 fw-medium" id="uploadZoneCreateText" style="pointer-events: none;">
                            <span style="text-decoration:underline;">Cliquez ici</span> pour choisir une photo
                        </p>
                        <p class="photo-meta mb-0 mt-1" style="pointer-events: none;">ou glissez-deposez ici · PNG, JPG, WEBP · Max 2 Mo</p>
                    </button>

                    <div class="alert d-none mt-3 mb-0 py-2 small" id="photo-feedback-create" role="alert"></div>
                    <small class="text-muted d-block mt-2" id="photo-file-meta-create">Aucun fichier selectionne</small>
                    <div class="d-grid mt-2 d-none" id="photo-reset-wrap-create">
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="photo-reset-btn-create">Reinitialiser</button>
                    </div>
                </div>
            </div>

            {# Actions #}
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success">
                            <svg class="me-2" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:inline;vertical-align:middle;">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                            </svg>
                            Créer l'utilisateur
                        </button>
                        <a href="{{ path('admin_users_list') }}" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                </div>
            </div>

        </div>
    </div>

    {{ form_end(form) }}
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const roleSelect = document.querySelector('select[name*="[role]"]');
    const fournisseurTypeSelect = document.querySelector('select[name*="[fournisseurTypeFournisseur]"]');

    function toggleRoleFields() {
        if (!roleSelect) return;

        const selectedRole = roleSelect.value;
        const roleSections = ['admin-fields', 'agriculteur-fields', 'agriplus-fields', 'fournisseur-fields'];
        roleSections.forEach(function(id) {
            const section = document.getElementById(id);
            if (section) section.classList.add('d-none');
        });

        const roleMap = {
            'ADMIN': 'admin-fields',
            'AGRICULTEUR': 'agriculteur-fields',
            'AGRIPLUS': 'agriplus-fields',
            'FOURNISSEUR': 'fournisseur-fields'
        };

        const targetId = roleMap[selectedRole];
        const targetElement = targetId ? document.getElementById(targetId) : null;
        if (targetElement) {
            targetElement.classList.remove('d-none');
            if (selectedRole === 'FOURNISSEUR') {
                setTimeout(toggleFournisseurFields, 100);
            }
        }
    }

    function toggleFournisseurFields() {
        if (!fournisseurTypeSelect) return;

        const selectedType = fournisseurTypeSelect.value;
        const personneFields = document.getElementById('fournisseur-personne-fields');
        const societeFields = document.getElementById('fournisseur-societe-fields');

        if (personneFields) personneFields.classList.add('d-none');
        if (societeFields) societeFields.classList.add('d-none');

        if (selectedType === 'PERSONNE' && personneFields) {
            personneFields.classList.remove('d-none');
        } else if (selectedType === 'SOCIETE' && societeFields) {
            societeFields.classList.remove('d-none');
        }
    }

    if (roleSelect) roleSelect.addEventListener('change', toggleRoleFields);
    if (fournisseurTypeSelect) fournisseurTypeSelect.addEventListener('change', toggleFournisseurFields);
    toggleRoleFields();
    toggleFournisseurFields();

    const photoInput = document.getElementById('profile-photo-input');
    const avatarInitial = document.getElementById('avatar-initial');
    const avatarPreview = document.getElementById('avatar-preview');
    const uploadZone = document.getElementById('uploadZoneCreate');
    const uploadZoneText = document.getElementById('uploadZoneCreateText');
    const feedback = document.getElementById('photo-feedback-create');
    const photoFileMeta = document.getElementById('photo-file-meta-create');
    const photoResetWrap = document.getElementById('photo-reset-wrap-create');
    const photoResetBtn = document.getElementById('photo-reset-btn-create');
    const nameInput = document.querySelector('input[name*="[nom]"]');

    const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];
    const maxSizeBytes = 2 * 1024 * 1024;
    const defaultUploadText = '<span style="text-decoration:underline;">Cliquez ici</span> pour choisir une photo';
    let selectedPhotoFile = null;

    function showFeedback(type, message) {
        if (!feedback) return;
        feedback.className = `alert alert-${type} mt-3 mb-0 py-2 small`;
        feedback.textContent = message;
    }

    function clearFeedback() {
        if (!feedback) return;
        feedback.className = 'alert d-none mt-3 mb-0 py-2 small';
        feedback.textContent = '';
    }

    function setUploadZoneActive(isActive) {
        if (!uploadZone) return;
        uploadZone.classList.toggle('is-active', isActive);
    }

    function formatSize(bytes) {
        return `${(bytes / (1024 * 1024)).toFixed(1)} Mo`;
    }

    function resetPhotoSelection() {
        selectedPhotoFile = null;
        if (photoInput) photoInput.value = '';
        if (avatarPreview) avatarPreview.classList.add('d-none');
        if (avatarInitial) avatarInitial.classList.remove('d-none');
        if (uploadZoneText) uploadZoneText.innerHTML = defaultUploadText;
        if (photoFileMeta) photoFileMeta.textContent = 'Aucun fichier selectionne';
        if (photoResetWrap) photoResetWrap.classList.add('d-none');
        setUploadZoneActive(false);
    }

    function applyFileSelection(file) {
        if (!file) return;
        if (!allowedTypes.includes(file.type)) {
            showFeedback('danger', 'Format non supporte. Utilisez JPG, PNG ou WEBP.');
            resetPhotoSelection();
            return;
        }
        if (file.size > maxSizeBytes) {
            showFeedback('danger', `Le fichier est trop volumineux (${formatSize(file.size)}). Limite: 2 Mo.`);
            resetPhotoSelection();
            return;
        }

        clearFeedback();
        selectedPhotoFile = file;
        if (uploadZoneText) uploadZoneText.innerHTML = `<strong style="color:#198754;">${file.name.replace(/</g, '&lt;')}</strong>`;
        if (photoFileMeta) photoFileMeta.textContent = `${file.name} · ${formatSize(file.size)}`;
        if (photoResetWrap) photoResetWrap.classList.remove('d-none');
        setUploadZoneActive(true);

        const reader = new FileReader();
        reader.onload = function(event) {
            if (avatarPreview && event.target) {
                avatarPreview.src = event.target.result;
                avatarPreview.classList.remove('d-none');
            }
            if (avatarInitial) avatarInitial.classList.add('d-none');
        };
        reader.readAsDataURL(file);
    }

    if (photoInput) {
        photoInput.addEventListener('change', function () {
            const file = this.files && this.files[0] ? this.files[0] : null;
            if (file) applyFileSelection(file);
        });
    }

    if (uploadZone && photoInput) {
        uploadZone.addEventListener('click', function(event) {
            event.preventDefault();
            event.stopPropagation();
            photoInput.click();
        });
        uploadZone.addEventListener('keydown', function(event) {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                event.stopPropagation();
                photoInput.click();
            }
        });
        uploadZone.addEventListener('dragover', function(event) {
            event.preventDefault();
            event.stopPropagation();
            setUploadZoneActive(true);
        });
        uploadZone.addEventListener('dragleave', function(event) {
            event.preventDefault();
            event.stopPropagation();
            if (!selectedPhotoFile) setUploadZoneActive(false);
        });
        uploadZone.addEventListener('drop', function(event) {
            event.preventDefault();
            event.stopPropagation();
            const droppedFile = event.dataTransfer?.files?.[0] || null;
            if (droppedFile) applyFileSelection(droppedFile);
        });
    }

    if (photoResetBtn) {
        photoResetBtn.addEventListener('click', function() {
            clearFeedback();
            resetPhotoSelection();
        });
    }

    if (nameInput && avatarInitial) {
        nameInput.addEventListener('input', function() {
            const name = this.value.trim();
            if (name) {
                const parts = name.split(' ');
                const initials = parts.map(p => p.charAt(0).toUpperCase()).slice(0, 2).join('');
                avatarInitial.textContent = initials || '?';
            } else {
                avatarInitial.textContent = '?';
            }
        });
    }

    resetPhotoSelection();
});
</script>
{% endblock dashboard_content %}
