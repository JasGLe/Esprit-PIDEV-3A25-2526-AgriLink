{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Administration - Utilisateurs{% endblock %}

{% block dashboard_content %}
<style>
    .stat-card {
        border-radius: 16px;
        border: none;
        transition: all 0.3s ease;
        background: #fff;
        overflow: hidden;
    }
    .stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 24px rgba(0,0,0,0.1) !important;
    }
    .stat-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.3s ease;
    }
    .stat-card:hover .stat-icon {
        transform: scale(1.1);
    }
    .stat-value {
        font-size: 2rem;
        font-weight: 700;
        line-height: 1;
        color: #1a202c;
    }
    .stat-label {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #718096;
    }
    .filter-card {
        border-radius: 16px;
        border: none;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }
    .filter-card .form-label {
        color: rgba(255,255,255,0.9);
        font-weight: 500;
        font-size: 0.8125rem;
        margin-bottom: 0.5rem;
    }
    .filter-card .form-control,
    .filter-card .form-select {
        background: rgba(255,255,255,0.95);
        border: none;
        border-radius: 10px;
        padding: 0.65rem 1rem;
        font-size: 0.875rem;
    }
    .filter-card .form-control:focus,
    .filter-card .form-select:focus {
        background: #fff;
        box-shadow: 0 0 0 3px rgba(255,255,255,0.3);
    }
    .users-table-card {
        border-radius: 16px;
        border: none;
        overflow: hidden;
    }
    .table-header {
        background: linear-gradient(to right, #f8f9fa, #e9ecef);
        border-bottom: 2px solid #dee2e6;
    }
    .table-header th {
        font-weight: 600;
        font-size: 0.8125rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #495057;
        padding: 1rem 1.25rem;
        border: none;
    }
    .table > tbody > tr {
        transition: all 0.2s ease;
        border-bottom: 1px solid #f1f3f5;
    }
    .table > tbody > tr:hover {
        background: #f8f9fa;
        transform: scale(1.002);
    }
    .table > tbody > tr > td {
        padding: 1.25rem;
        vertical-align: middle;
        border: none;
    }
    .user-avatar {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        object-fit: cover;
        border: 2px solid #e9ecef;
    }
    .user-avatar-fallback {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 1rem;
        color: white;
    }
    .user-name {
        font-weight: 600;
        font-size: 0.9375rem;
        color: #2d3748;
        margin-bottom: 0.125rem;
    }
    .user-id {
        font-size: 0.75rem;
        color: #a0aec0;
    }
    .role-badge {
        padding: 0.4rem 0.875rem;
        border-radius: 8px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-block;
    }
    .status-badge {
        padding: 0.35rem 0.75rem;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
    }
    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }
    .action-btn {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e2e8f0;
        background: white;
        color: #64748b;
        transition: all 0.2s ease;
    }
    .action-btn:hover {
        background: #f1f5f9;
        border-color: #cbd5e1;
        color: #475569;
        transform: translateY(-2px);
    }
    .action-btn.btn-edit:hover {
        background: #dbeafe;
        border-color: #3b82f6;
        color: #3b82f6;
    }
    .action-btn.btn-delete:hover {
        background: #fee2e2;
        border-color: #ef4444;
        color: #ef4444;
    }
    .pagination-modern .page-link {
        border-radius: 8px;
        border: none;
        margin: 0 0.25rem;
        padding: 0.5rem 0.875rem;
        color: #64748b;
        font-weight: 500;
    }
    .pagination-modern .page-link:hover {
        background: #f1f5f9;
        color: #475569;
    }
    .pagination-modern .page-item.active .page-link {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }
    .search-icon {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        pointer-events: none;
    }
    .search-input {
        padding-left: 2.75rem !important;
    }
    .quick-action-btn {
        border-radius: 12px;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        font-size: 0.9375rem;
        transition: all 0.3s ease;
        border: none;
    }
    .quick-action-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 16px rgba(0,0,0,0.15);
    }
</style>

<div class="container-fluid py-4">

    {# Enhanced Page Header #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-2 fw-bold" style="color:#1a202c;">
                <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-2" style="display:inline-block;vertical-align:middle;">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                </svg>
                Gestion des utilisateurs
            </h1>
            <p class="text-muted mb-0">
                <span class="fw-semibold">{{ total }}</span> utilisateur{{ total != 1 ? 's' : '' }} enregistré{{ total != 1 ? 's' : '' }} sur AgriLink
            </p>
        </div>
        <div>
            <a href="{{ path('admin_users_create') }}" class="quick-action-btn btn btn-success">
                <svg class="me-2" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:inline-block;vertical-align:middle;">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
                Ajouter un utilisateur
            </a>
        </div>
    </div>

    {# Flash Messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : (label == 'error' ? 'danger' : 'info') }} alert-dismissible fade show mb-4" role="alert" style="border-radius:12px;border:none;">
                <div class="d-flex align-items-center">
                    {% if label == 'success' %}
                        <svg class="me-2 flex-shrink-0" width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                    {% elseif label == 'error' %}
                        <svg class="me-2 flex-shrink-0" width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                        </svg>
                    {% endif %}
                    <div>{{ message }}</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# Enhanced Statistics Cards #}
    <div class="row g-4 mb-5">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon me-3" style="background:linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                            <svg width="26" height="26" fill="none" stroke="white" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                            </svg>
                        </div>
                        <div>
                            <div class="stat-label mb-1">Total Utilisateurs</div>
                            <div class="stat-value">{{ stats.total }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon me-3" style="background:linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
                            <svg width="26" height="26" fill="none" stroke="white" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                        <div>
                            <div class="stat-label mb-1">Comptes Actifs</div>
                            <div class="stat-value text-success">{{ stats.active }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon me-3" style="background:linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                            <svg width="26" height="26" fill="none" stroke="white" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
                            </svg>
                        </div>
                        <div>
                            <div class="stat-label mb-1">Emails Vérifiés</div>
                            <div class="stat-value" style="color:#f5576c;">{{ stats.verified }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card stat-card shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="stat-icon me-3" style="background:linear-gradient(135deg, #ffa751 0%, #ffe259 100%);">
                            <svg width="26" height="26" fill="none" stroke="white" viewBox="0 0 24 24" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                            </svg>
                        </div>
                        <div>
                            <div class="stat-label mb-1">Abonnés AgriPlus</div>
                            <div class="stat-value" style="color:#ffa751;">{{ stats.agriplus }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Enhanced Filter Card #}
    <div class="card filter-card shadow-lg mb-4">
        <div class="card-body p-4">
            <form method="GET" action="{{ path('admin_users_list') }}" id="filter-form">
                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="filterRole" class="form-label">
                            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-1" style="display:inline-block;vertical-align:middle;">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                            </svg>
                            Filtrer par rôle
                        </label>
                        <select class="form-select" id="filterRole" name="role">
                            <option value="">Tous les rôles</option>
                            <option value="ADMIN" {{ roleFilter == 'ADMIN' ? 'selected' : '' }}>Admin</option>
                            <option value="AGRICULTEUR" {{ roleFilter == 'AGRICULTEUR' ? 'selected' : '' }}>Agriculteur</option>
                            <option value="AGRIPLUS" {{ roleFilter == 'AGRIPLUS' ? 'selected' : '' }}>AgriPlus</option>
                            <option value="FOURNISSEUR" {{ roleFilter == 'FOURNISSEUR' ? 'selected' : '' }}>Fournisseur</option>
                            <option value="USER" {{ roleFilter == 'USER' ? 'selected' : '' }}>Utilisateur</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6 col-lg-3">
                        <label for="filterStatus" class="form-label">
                            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-1" style="display:inline-block;vertical-align:middle;">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Filtrer par état
                        </label>
                        <select class="form-select" id="filterStatus" name="status">
                            <option value="">Tous les états</option>
                            <option value="active" {{ statusFilter == 'active' ? 'selected' : '' }}>Actif</option>
                            <option value="inactive" {{ statusFilter == 'inactive' ? 'selected' : '' }}>Inactif</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-12 col-lg-4">
                        <label for="searchUser" class="form-label">
                            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-1" style="display:inline-block;vertical-align:middle;">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                            </svg>
                            Rechercher
                        </label>
                        <div class="position-relative">
                            <svg class="search-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
                            </svg>
                            <input type="text" class="form-control search-input" id="searchUser" name="search"
                                   value="{{ search }}" placeholder="Nom, email, #ID..." autocomplete="off">
                        </div>
                    </div>

                    <div class="col-12 col-lg-2 d-flex gap-2">
                        <button type="submit" class="btn btn-light flex-grow-1" style="border-radius:10px;font-weight:600;">
                            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-1" style="display:inline-block;vertical-align:middle;">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
                            </svg>
                            Filtrer
                        </button>
                        {% if search or roleFilter or statusFilter %}
                            <button type="button" id="reset-btn" class="btn btn-outline-light" style="border-radius:10px;" onclick="window.location='{{ path('admin_users_list') }}';" title="Réinitialiser">
                                <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                </svg>
                            </button>
                        {% endif %}
                    </div>
                </div>
            </form>
        </div>
    </div>

    {# Enhanced Users Table #}
    <div class="card users-table-card shadow-sm">
        <div class="card-header bg-white border-bottom-0 p-4">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold" style="color:#2d3748;">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-2" style="display:inline-block;vertical-align:middle;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                    Liste des utilisateurs
                </h5>
                <span class="badge bg-light text-dark px-3 py-2" style="border-radius:10px;font-size:0.875rem;">
                    {{ total }} résultat{{ total != 1 ? 's' : '' }}
                </span>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table mb-0" id="users-table">
                <thead class="table-header">
                    <tr>
                        <th>
                            <a href="{{ path('admin_users_list', {search: search, role: roleFilter, status: statusFilter, orderBy: 'nom', orderDir: (orderBy == 'nom' and orderDir == 'ASC') ? 'DESC' : 'ASC', page: 1}) }}" class="text-decoration-none text-dark">
                                Utilisateur
                                {% if orderBy == 'nom' %}
                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20" class="ms-1" style="display:inline-block;vertical-align:middle;">
                                        <path fill-rule="evenodd" d="{{ orderDir == 'ASC' ? 'M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z' : 'M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z' }}" clip-rule="evenodd"/>
                                    </svg>
                                {% endif %}
                            </a>
                        </th>
                        <th>
                            <a href="{{ path('admin_users_list', {search: search, role: roleFilter, status: statusFilter, orderBy: 'email', orderDir: (orderBy == 'email' and orderDir == 'ASC') ? 'DESC' : 'ASC', page: 1}) }}" class="text-decoration-none text-dark">
                                Email
                                {% if orderBy == 'email' %}
                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20" class="ms-1" style="display:inline-block;vertical-align:middle;">
                                        <path fill-rule="evenodd" d="{{ orderDir == 'ASC' ? 'M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z' : 'M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z' }}" clip-rule="evenodd"/>
                                    </svg>
                                {% endif %}
                            </a>
                        </th>
                        <th>Rôle</th>
                        <th>
                            <a href="{{ path('admin_users_list', {search: search, role: roleFilter, status: statusFilter, orderBy: 'isActive', orderDir: (orderBy == 'isActive' and orderDir == 'ASC') ? 'DESC' : 'ASC', page: 1}) }}" class="text-decoration-none text-dark">
                                État
                                {% if orderBy == 'isActive' %}
                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20" class="ms-1" style="display:inline-block;vertical-align:middle;">
                                        <path fill-rule="evenodd" d="{{ orderDir == 'ASC' ? 'M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z' : 'M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z' }}" clip-rule="evenodd"/>
                                    </svg>
                                {% endif %}
                            </a>
                        </th>
                        <th>
                            <a href="{{ path('admin_users_list', {search: search, role: roleFilter, status: statusFilter, orderBy: 'createdAt', orderDir: (orderBy == 'createdAt' and orderDir == 'ASC') ? 'DESC' : 'ASC', page: 1}) }}" class="text-decoration-none text-dark">
                                Inscription
                                {% if orderBy == 'createdAt' %}
                                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20" class="ms-1" style="display:inline-block;vertical-align:middle;">
                                        <path fill-rule="evenodd" d="{{ orderDir == 'ASC' ? 'M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z' : 'M14.707 12.707a1 1 0 01-1.414 0L10 9.414l-3.293 3.293a1 1 0 01-1.414-1.414l4-4a1 1 0 011.414 0l4 4a1 1 0 010 1.414z' }}" clip-rule="evenodd"/>
                                    </svg>
                                {% endif %}
                            </a>
                        </th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody id="users-tbody">
                    {% if users is defined and users|length > 0 %}
                        {% for user in users %}
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        {% if user.photoProfil %}
                                            <img src="{{ asset('agrilink/uploads/' ~ user.photoProfil) }}" alt="{{ user.displayName }}" class="user-avatar me-3">
                                        {% else %}
                                            {% set colors = ['#667eea,#764ba2', '#11998e,#38ef7d', '#f093fb,#f5576c', '#ffa751,#ffe259', '#4facfe,#00f2fe'] %}
                                            {% set colorIndex = user.id % 5 %}
                                            {% set gradient = colors[colorIndex]|split(',') %}
                                            <div class="user-avatar-fallback me-3" style="background:linear-gradient(135deg, {{ gradient[0] }} 0%, {{ gradient[1] }} 100%);">
                                                {{ user.initials }}
                                            </div>
                                        {% endif %}
                                        <div>
                                            <div class="user-name">{{ user.displayName }}</div>
                                            <div class="user-id">#{{ user.id }}</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="mb-1" style="color:#2d3748;font-size:0.875rem;">{{ user.email }}</div>
                                    {% if user.emailVerified %}
                                        <span class="badge bg-success-subtle text-success" style="border-radius:6px;font-size:0.6875rem;padding:0.25rem 0.5rem;">
                                            <svg width="10" height="10" fill="currentColor" viewBox="0 0 20 20" class="me-1" style="display:inline-block;vertical-align:middle;">
                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                            </svg>
                                            Vérifié
                                        </span>
                                    {% else %}
                                        <span class="badge bg-warning-subtle text-warning" style="border-radius:6px;font-size:0.6875rem;padding:0.25rem 0.5rem;">
                                            <svg width="10" height="10" fill="currentColor" viewBox="0 0 20 20" class="me-1" style="display:inline-block;vertical-align:middle;">
                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9a1 1 0 000 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/>
                                            </svg>
                                            Non vérifié
                                        </span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if user.role == 'ADMIN' %}
                                        <span class="role-badge" style="background:#fee2e2;color:#991b1b;">
                                            <svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20" class="me-1" style="display:inline-block;vertical-align:middle;">
                                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9a1 1 0 000 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/>
                                            </svg>
                                            Admin
                                        </span>
                                    {% elseif user.role == 'AGRIPLUS' %}
                                        <span class="role-badge" style="background:#fef3c7;color:#92400e;">
                                            <svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20" class="me-1" style="display:inline-block;vertical-align:middle;">
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                                            </svg>
                                            AgriPlus
                                        </span>
                                    {% elseif user.role == 'FOURNISSEUR' %}
                                        <span class="role-badge" style="background:#dbeafe;color:#1e40af;">Fournisseur</span>
                                    {% elseif user.role == 'AGRICULTEUR' %}
                                        <span class="role-badge" style="background:#d1fae5;color:#065f46;">Agriculteur</span>
                                    {% else %}
                                        <span class="role-badge" style="background:#f3f4f6;color:#374151;">Utilisateur</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if user.isBanned is defined and user.isBanned %}
                                        <span class="status-badge" style="background:#fef3c7;color:#92400e;">
                                            <span class="status-dot" style="background:#f59e0b;"></span>
                                            Banni
                                        </span>
                                    {% elseif user.isActive %}
                                        <span class="status-badge" style="background:#d1fae5;color:#065f46;">
                                            <span class="status-dot" style="background:#10b981;"></span>
                                            Actif
                                        </span>
                                    {% else %}
                                        <span class="status-badge" style="background:#fee2e2;color:#991b1b;">
                                            <span class="status-dot" style="background:#ef4444;"></span>
                                            Inactif
                                        </span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div style="font-size:0.8125rem;color:#64748b;">
                                        <div class="mb-1">
                                            <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-1" style="display:inline-block;vertical-align:middle;">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                            </svg>
                                            {{ user.createdAt ? user.createdAt|date('d/m/Y') : 'N/A' }}
                                        </div>
                                        {% if user.lastLogin %}
                                            <div style="font-size:0.75rem;color:#94a3b8;">
                                                Connexion: {{ user.lastLogin|date('d/m/Y') }}
                                            </div>
                                        {% endif %}
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="{{ path('admin_users_edit', {id: user.id}) }}" class="action-btn btn-edit" title="Modifier">
                                            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                            </svg>
                                        </a>
                                        
                                        {% if user.id != app.user.id %}
                                            <form method="POST" action="{{ path('admin_users_toggle_status', {id: user.id}) }}" style="display:inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('toggle-status-' ~ user.id) }}">
                                                <button type="submit" class="action-btn" title="{{ user.isActive ? 'Désactiver' : 'Activer' }}" 
                                                        onclick="return confirm('Êtes-vous sûr de vouloir {{ user.isActive ? 'désactiver' : 'activer' }} cet utilisateur ?');">
                                                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        {% if user.isActive %}
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                        {% else %}
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                        {% endif %}
                                                    </svg>
                                                </button>
                                            </form>

                                            {% if user.isBanned is defined and user.isBanned %}
                                                <form method="POST" action="{{ path('admin_users_unban', {id: user.id}) }}" style="display:inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('unban-user-' ~ user.id) }}">
                                                    <button type="submit" class="action-btn" title="Débannir" style="color:#198754;"
                                                            onclick="return confirm('Débannir {{ user.displayName }} ?');">
                                                        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                                                        </svg>
                                                    </button>
                                                </form>
                                            {% else %}
                                                <form method="POST" action="{{ path('admin_users_ban', {id: user.id}) }}" style="display:inline;">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('ban-user-' ~ user.id) }}">
                                                    <input type="hidden" name="ban_reason" value="Violation des conditions d'utilisation">
                                                    <button type="submit" class="action-btn" title="Bannir" style="color:#dc3545;"
                                                            onclick="return confirm('Bannir {{ user.displayName }} ? L\'utilisateur ne pourra plus se connecter.');">
                                                        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                                                        </svg>
                                                    </button>
                                                </form>
                                            {% endif %}

                                            <form method="POST" action="{{ path('admin_users_delete', {id: user.id}) }}" style="display:inline;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete-user-' ~ user.id) }}">
                                                <button type="submit" class="action-btn btn-delete" title="Supprimer"
                                                        onclick="return confirm('ATTENTION : Cette action est irréversible ! Supprimer définitivement {{ user.displayName }} ?');">
                                                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                                    </svg>
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <svg width="64" height="64" fill="none" stroke="#cbd5e1" viewBox="0 0 24 24" class="mb-3">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                                </svg>
                                <p class="text-muted mb-0">Aucun utilisateur trouvé</p>
                                {% if search or roleFilter or statusFilter %}
                                    <a href="{{ path('admin_users_list') }}" class="btn btn-sm btn-outline-secondary mt-3" style="border-radius:8px;">Réinitialiser les filtres</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>

        {# Enhanced Pagination #}
        <div class="card-footer bg-white border-top py-3" id="pagination-container">
            {% if totalPages > 1 %}
            <nav>
                <ul class="pagination pagination-modern justify-content-center mb-0">
                        {% if page > 1 %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('admin_users_list', {search: search, role: roleFilter, status: statusFilter, orderBy: orderBy, orderDir: orderDir, page: page - 1}) }}">
                                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                                    </svg>
                                </a>
                            </li>
                        {% endif %}

                        {% for p in 1..totalPages %}
                            {% if p == 1 or p == totalPages or (p >= page - 2 and p <= page + 2) %}
                                <li class="page-item {{ p == page ? 'active' : '' }}">
                                    <a class="page-link" href="{{ path('admin_users_list', {search: search, role: roleFilter, status: statusFilter, orderBy: orderBy, orderDir: orderDir, page: p}) }}">{{ p }}</a>
                                </li>
                            {% elseif p == page - 3 or p == page + 3 %}
                                <li class="page-item disabled">
                                    <span class="page-link">...</span>
                                </li>
                            {% endif %}
                        {% endfor %}

                        {% if page < totalPages %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('admin_users_list', {search: search, role: roleFilter, status: statusFilter, orderBy: orderBy, orderDir: orderDir, page: page + 1}) }}">
                                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                                    </svg>
                                </a>
                            </li>
                        {% endif %}
                    </ul>
                </nav>
            {% endif %}
        </div>
    </div>

</div>

<script>
// AJAX Search functionality
let searchTimeout;
const searchInput = document.getElementById('searchUser');
const roleSelect = document.getElementById('filterRole');
const statusSelect = document.getElementById('filterStatus');
const filterForm = document.getElementById('filter-form');

// Add event listeners for real-time search
if (searchInput) {
    searchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
            performAjaxSearch();
        }, 500);
    });
}

// Add event listeners for filter changes
if (roleSelect) {
    roleSelect.addEventListener('change', performAjaxSearch);
}

if (statusSelect) {
    statusSelect.addEventListener('change', performAjaxSearch);
}

// Prevent form submission and use AJAX instead
if (filterForm) {
    filterForm.addEventListener('submit', function(e) {
        e.preventDefault();
        performAjaxSearch();
    });
}

function performAjaxSearch(page = 1) {
    const search = searchInput?.value || '';
    const role = roleSelect?.value || '';
    const status = statusSelect?.value || '';
    const orderBy = new URLSearchParams(window.location.search).get('orderBy') || 'createdAt';
    const orderDir = new URLSearchParams(window.location.search).get('orderDir') || 'DESC';

    const url = new URL('{{ path("admin_users_search_ajax") }}', window.location.origin);
    url.searchParams.append('page', page);
    url.searchParams.append('search', search);
    url.searchParams.append('role', role);
    url.searchParams.append('status', status);
    url.searchParams.append('orderBy', orderBy);
    url.searchParams.append('orderDir', orderDir);

    fetch(url, {
        headers: {
            'X-Requested-With': 'XMLHttpRequest'
        }
    })
    .then(response => {
        if (!response.ok) throw new Error('Network response was not ok');
        return response.json();
    })
    .then(data => {
        if (data.success) {
            updateUserTable(data.users);
            updatePagination(data.page, data.totalPages, search, role, status, orderBy, orderDir);
            updateResultCount(data.total);
        }
    })
    .catch(error => {
        console.error('Error during AJAX search:', error);
    });
}

function updateUserTable(users) {
    const tbody = document.getElementById('users-tbody');
    if (!tbody) return;

    if (users.length === 0) {
        tbody.innerHTML = `
            <tr>
                <td colspan="6" class="text-center py-5">
                    <svg width="64" height="64" fill="none" stroke="#cbd5e1" viewBox="0 0 24 24" class="mb-3">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                    </svg>
                    <p class="text-muted mb-0">Aucun utilisateur trouvé</p>
                </td>
            </tr>
        `;
        return;
    }

    const colors = ['#667eea,#764ba2', '#11998e,#38ef7d', '#f093fb,#f5576c', '#ffa751,#ffe259', '#4facfe,#00f2fe'];

    tbody.innerHTML = users.map(user => {
        const colorIndex = user.id % 5;
        const [color1, color2] = colors[colorIndex].split(',');

        const photoHtml = user.photoProfil
            ? `<img src="/agrilink/uploads/${user.photoProfil}" alt="${user.displayName}" class="user-avatar me-3">`
            : `<div class="user-avatar-fallback me-3" style="background:linear-gradient(135deg, ${color1} 0%, ${color2} 100%);">${user.initials}</div>`;

        const emailBadge = user.emailVerified
            ? '<span class="badge bg-success-subtle text-success" style="border-radius:6px;font-size:0.6875rem;padding:0.25rem 0.5rem;"><svg width="10" height="10" fill="currentColor" viewBox="0 0 20 20" class="me-1" style="display:inline-block;vertical-align:middle;"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Vérifié</span>'
            : '<span class="badge bg-warning-subtle text-warning" style="border-radius:6px;font-size:0.6875rem;padding:0.25rem 0.5rem;"><svg width="10" height="10" fill="currentColor" viewBox="0 0 20 20" class="me-1" style="display:inline-block;vertical-align:middle;"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9a1 1 0 000 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/></svg>Non vérifié</span>';

        const roleBadges = {
            'ADMIN': '<span class="role-badge" style="background:#fee2e2;color:#991b1b;"><svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20" class="me-1" style="display:inline-block;vertical-align:middle;"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM7 9a1 1 0 000 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/></svg>Admin</span>',
            'AGRIPLUS': '<span class="role-badge" style="background:#fef3c7;color:#92400e;"><svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20" class="me-1" style="display:inline-block;vertical-align:middle;"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>AgriPlus</span>',
            'FOURNISSEUR': '<span class="role-badge" style="background:#dbeafe;color:#1e40af;">Fournisseur</span>',
            'AGRICULTEUR': '<span class="role-badge" style="background:#d1fae5;color:#065f46;">Agriculteur</span>',
            'USER': '<span class="role-badge" style="background:#f3f4f6;color:#374151;">Utilisateur</span>'
        };
        const roleBadge = roleBadges[user.role] || roleBadges['USER'];

        const statusBadges = {
            'banned': '<span class="status-badge" style="background:#fef3c7;color:#92400e;"><span class="status-dot" style="background:#f59e0b;"></span>Banni</span>',
            'active': '<span class="status-badge" style="background:#d1fae5;color:#065f46;"><span class="status-dot" style="background:#10b981;"></span>Actif</span>',
            'inactive': '<span class="status-badge" style="background:#fee2e2;color:#991b1b;"><span class="status-dot" style="background:#ef4444;"></span>Inactif</span>'
        };
        const statusBadge = user.isBanned ? statusBadges['banned'] : (user.isActive ? statusBadges['active'] : statusBadges['inactive']);

        const lastLoginHtml = user.lastLogin ? `<div style="font-size:0.75rem;color:#94a3b8;">Connexion: ${user.lastLogin}</div>` : '';

        const editUrl = `{{ path('admin_users_edit', {'id': 'USERID'}) }}`.replace('USERID', user.id);

        return `
            <tr>
                <td>
                    <div class="d-flex align-items-center">
                        ${photoHtml}
                        <div>
                            <div class="user-name">${user.displayName}</div>
                            <div class="user-id">#${user.id}</div>
                        </div>
                    </div>
                </td>
                <td>
                    <div class="mb-1" style="color:#2d3748;font-size:0.875rem;">${user.email}</div>
                    ${emailBadge}
                </td>
                <td>
                    ${roleBadge}
                </td>
                <td>
                    ${statusBadge}
                </td>
                <td>
                    <div style="font-size:0.8125rem;color:#64748b;">
                        <div class="mb-1">
                            <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-1" style="display:inline-block;vertical-align:middle;">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            ${user.createdAt || 'N/A'}
                        </div>
                        ${lastLoginHtml}
                    </div>
                </td>
                <td>
                    <div class="d-flex justify-content-end gap-2">
                        <a href="${editUrl}" class="action-btn btn-edit" title="Modifier">
                            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                        </a>
                    </div>
                </td>
            </tr>
        `;
    }).join('');
}

function updatePagination(page, totalPages, search, role, status, orderBy, orderDir) {
    const container = document.getElementById('pagination-container');
    if (!container || totalPages <= 1) {
        container && (container.innerHTML = '');
        return;
    }

    let html = '<nav><ul class="pagination pagination-modern justify-content-center mb-0">';

    if (page > 1) {
        html += `<li class="page-item"><a class="page-link" href="#" onclick="performAjaxSearch(${page - 1}); return false;"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg></a></li>`;
    }

    for (let p = 1; p <= totalPages; p++) {
        if (p === 1 || p === totalPages || (p >= page - 2 && p <= page + 2)) {
            const active = p === page ? 'active' : '';
            html += `<li class="page-item ${active}"><a class="page-link" href="#" onclick="performAjaxSearch(${p}); return false;">${p}</a></li>`;
        } else if (p === page - 3 || p === page + 3) {
            html += '<li class="page-item disabled"><span class="page-link">...</span></li>';
        }
    }

    if (page < totalPages) {
        html += `<li class="page-item"><a class="page-link" href="#" onclick="performAjaxSearch(${page + 1}); return false;"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a></li>`;
    }

    html += '</ul></nav>';
    container.innerHTML = html;
}

function updateResultCount(total) {
    const badge = document.querySelector('.card-header .badge');
    if (badge) {
        const plural = total !== 1 ? 's' : '';
        badge.textContent = `${total} résultat${plural}`;
    }
}
</script>
{% endblock %}
