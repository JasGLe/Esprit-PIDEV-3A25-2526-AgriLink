    #desktop-sidebar, .d-lg-none, button, .btn, .nav-pills { display: none !important; }
    .dashboard-main-content { margin-left: 0 !important; }
    .dashboard-main { padding-top: 0 !important; }
    .chart-card, .sec-kpi-card { break-inside: avoid; }
}
</style>
{% endblock %}
