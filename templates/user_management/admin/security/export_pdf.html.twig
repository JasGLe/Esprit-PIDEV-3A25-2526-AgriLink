<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        body {
            font-family: 'DejaVu Sans', sans-serif;
            font-size: 10px;
            color: #1f2937;
            margin: 0;
            padding: 0;
        }

        .header {
            background: #7f1d1d;
            color: white;
            padding: 14px 18px;
            border-bottom: 4px solid #ef4444;
        }

        .header-table {
            width: 100%;
        }

        .logo {
            width: 50px;
        }

        .title {
            font-size: 16px;
            font-weight: bold;
            margin: 0;
            color: #ef4444;
        }

        .subtitle {
            font-size: 9px;
            color: #fecaca;
            margin: 2px 0 0 0;
        }

        .stats {
            margin: 12px 18px;
            padding: 0;
        }

        .stat {
            display: inline-block;
            background: #fee2e2;
            border: 1px solid #fecaca;
            padding: 5px 8px;
            margin-right: 6px;
            margin-bottom: 4px;
            border-radius: 4px;
            font-size: 8px;
            color: #991b1b;
            font-weight: 500;
        }

        .content {
            padding: 0 18px 18px 18px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
            font-size: 8px;
        }

        thead {
            background: #7f1d1d;
            color: white;
        }

        th {
            padding: 6px 8px;
            font-size: 8px;
            font-weight: bold;
            text-align: left;
            border: 1px solid #d1d5db;
        }

        td {
            padding: 6px 8px;
            border: 1px solid #e5e7eb;
            font-size: 8px;
        }

        tr.even {
            background: #fef2f2;
        }

        tr.odd {
            background: #ffffff;
        }

        .badge {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 10px;
            font-size: 8px;
            background: #fee2e2;
            color: #991b1b;
            font-weight: 500;
        }

        .section {
            margin-top: 12px;
            padding-top: 8px;
            border-top: 1px solid #e5e7eb;
        }

        .section-title {
            background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
            color: white;
            padding: 8px 10px;
            font-size: 10px;
            font-weight: bold;
            margin-bottom: 8px;
            border-radius: 4px;
        }

        .small {
            font-size: 8px;
            color: #6b7280;
        }

        .footer {
            margin-top: 14px;
            padding-top: 8px;
            border-top: 1px solid #e5e7eb;
            text-align: center;
            font-size: 7px;
            color: #9ca3af;
        }

        @media print {
            body { margin: 0; padding: 0; }
            .page { page-break-after: always; }
        }
    </style>
</head>
<body>

<div class="header">
    <table class="header-table">
        <tr>
            <td width="60">
                <p class="title">🔒 Rapport Sécurité</p>
            </td>
            <td>
                <p style="color: #fecaca; font-size: 9px; margin: 2px 0;">Centre de sécurité - Généré le {{ date|date('d/m/Y H:i') }}</p>
            </td>
            <td style="text-align: right; width: 100px;">
                <p class="subtitle" style="margin: 0;">AgriLink Security<br/>Report</p>
            </td>
        </tr>
    </table>
</div>

<div class="stats">
    <span class="stat">🔐 Connexions réussies: {{ stats30d.loginSuccess ?? 0 }}</span>
    <span class="stat">⚠️ Connexions échouées: {{ stats30d.loginFailed ?? 0 }}</span>
    <span class="stat">🔒 2FA: {{ stats30d.twoFaSuccess ?? 0 }}</span>
    <span class="stat">🚫 Verrouillés: {{ stats30d.accountLocked ?? 0 }}</span>
</div>

<div class="content">

<!-- 30 Days Statistics -->
<div class="section">
    <div class="section-title">📊 STATISTIQUES 30 DERNIERS JOURS</div>
    
    <table>
        <thead>
            <tr>
                <th>Événement</th>
                <th>Nombre</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Connexions réussies</td>
                <td style="text-align: center;">{{ stats30d.loginSuccess ?? 0 }}</td>
            </tr>
            <tr class="even">
                <td>Connexions échouées</td>
                <td style="text-align: center;">{{ stats30d.loginFailed ?? 0 }}</td>
            </tr>
            <tr>
                <td>2FA réussi</td>
                <td style="text-align: center;">{{ stats30d.twoFaSuccess ?? 0 }}</td>
            </tr>
            <tr class="even">
                <td>Comptes verrouillés</td>
                <td style="text-align: center;">{{ stats30d.accountLocked ?? 0 }}</td>
            </tr>
            <tr>
                <td>Mots de passe changés</td>
                <td style="text-align: center;">{{ stats30d.passwordChanged ?? 0 }}</td>
            </tr>
        </tbody>
    </table>
</div>

<!-- 24 Hours Statistics -->
<div class="section">
    <div class="section-title">⏱️ STATISTIQUES 24 HEURES</div>
    
    <table>
        <thead>
            <tr>
                <th>Événement</th>
                <th>Nombre</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Connexions réussies</td>
                <td style="text-align: center;">{{ stats24h.loginSuccess ?? 0 }}</td>
            </tr>
            <tr class="even">
                <td>Connexions échouées</td>
                <td style="text-align: center;">{{ stats24h.loginFailed ?? 0 }}</td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Account Overview -->
<div class="section">
    <div class="section-title">👥 APERÇU COMPTES</div>
    
    <table>
        <thead>
            <tr>
                <th>Statistique</th>
                <th>Nombre</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Total comptes</td>
                <td style="text-align: center;">{{ accountStats.total ?? 0 }}</td>
            </tr>
            <tr class="even">
                <td>Comptes actifs</td>
                <td style="text-align: center;">{{ accountStats.active ?? 0 }}</td>
            </tr>
            <tr>
                <td>Emails vérifiés</td>
                <td style="text-align: center;">{{ accountStats.verified ?? 0 }}</td>
            </tr>
            <tr class="even">
                <td>2FA activé</td>
                <td style="text-align: center;">{{ accountStats.twoFactorEnabled ?? 0 }}</td>
            </tr>
            <tr>
                <td>Comptes verrouillés actuellement</td>
                <td style="text-align: center;">{{ accountStats.lockedNow ?? 0 }}</td>
            </tr>
        </tbody>
    </table>
</div>

</div>

<div class="footer">
    AgriLink - Rapport de sécurité · Généré le {{ date|date('d/m/Y \\à H:i') }}
</div>

</body>
</html>
