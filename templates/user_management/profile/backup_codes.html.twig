{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Codes de secours - AgriLink{% endblock %}

{% block dashboard_content %}
<style>
    .backup-card {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
        overflow: hidden;
        margin-bottom: 1.25rem;
    }
    .backup-card-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #f0f4f0;
        background: #fafffe;
        display: flex; align-items: center; gap: .75rem;
    }
    .backup-card-body { padding: 1.5rem; }
    .code-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: .5rem;
    }
    .code-item {
        font-family: 'Courier New', Courier, monospace;
        font-size: 1rem;
        font-weight: 700;
        letter-spacing: .1em;
        padding: .625rem 1rem;
        border-radius: 8px;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #166534;
        text-align: center;
    }
</style>

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="{{ path('app_profile_security') }}"
       class="btn btn-light border rounded-circle p-0 d-flex align-items-center justify-content-center flex-shrink-0"
       style="width:2.25rem;height:2.25rem;" title="Retour">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
    </a>
    <div>
        <h1 class="h4 fw-bold mb-0">Codes de secours</h1>
        <p class="text-muted mb-0" style="font-size:.8rem;">
            <a href="{{ path('app_profile') }}" class="text-decoration-none text-muted">Profil</a>
            &rsaquo; <a href="{{ path('app_profile_security') }}" class="text-decoration-none text-muted">Sécurité</a>
            &rsaquo; Codes de secours
        </p>
    </div>
</div>

<div class="row g-4" style="max-width:800px;">
    <div class="col-lg-7">
        <div class="backup-card">
            <div class="backup-card-header">
                <div class="rounded-2 bg-success bg-opacity-10 d-flex align-items-center justify-content-center" style="width:2rem;height:2rem;">
                    <svg fill="none" stroke="#198754" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                    </svg>
                </div>
                <div class="flex-fill">
                    <span class="fw-semibold d-block" style="font-size:.9rem;">Vos codes de secours</span>
                    <span class="text-muted" style="font-size:.75rem;">Utilisez-les si vous n'avez pas accès à votre email</span>
                </div>
            </div>
            <div class="backup-card-body">
                {% if plainCodes %}
                    <div class="alert alert-warning d-flex gap-2 align-items-start py-2 px-3 mb-3" style="font-size:.8125rem; border-radius:8px; border:none;">
                        <svg fill="currentColor" viewBox="0 0 20 20" width="16" height="16" class="flex-shrink-0 mt-1">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                        </svg>
                        <div>
                            <strong>Sauvegardez ces codes maintenant !</strong>
                            <p class="mb-0 mt-1">Ces codes ne seront affichés qu'une seule fois. Notez-les dans un endroit sûr.</p>
                        </div>
                    </div>

                    <div class="code-grid mb-3">
                        {% for code in plainCodes %}
                            <div class="code-item">{{ code }}</div>
                        {% endfor %}
                    </div>

                    <button type="button" class="btn btn-outline-success btn-sm w-100" onclick="copyBackupCodes()">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14" class="me-1">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
                        </svg>
                        Copier tous les codes
                    </button>
                {% else %}
                    <div class="text-center py-3">
                        <p class="mb-1 fw-semibold" style="font-size:.9rem;">{{ remainingCount }} code(s) restant(s)</p>
                        <p class="text-muted mb-0" style="font-size:.8rem;">
                            Chaque code ne peut être utilisé qu'une seule fois.
                        </p>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Regenerate form #}
        <div class="backup-card">
            <div class="backup-card-body">
                <p class="text-muted mb-3" style="font-size:.8125rem;">
                    Générer de nouveaux codes invalidera tous les anciens codes.
                </p>
                <form method="post" action="{{ path('app_profile_regenerate_backup_codes') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('regenerate_backup_codes') }}">
                    <button type="submit" class="btn btn-outline-warning btn-sm w-100"
                            onclick="return confirm('Générer de nouveaux codes ? Les anciens codes seront invalidés.')">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14" class="me-1">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                        </svg>
                        Régénérer les codes de secours
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="backup-card">
            <div class="backup-card-header">
                <div class="rounded-2" style="width:2rem;height:2rem;background:#fff3cd;display:flex;align-items:center;justify-content:center;">
                    <svg fill="none" stroke="#856404" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <span class="fw-semibold" style="font-size:.9rem;">Comment utiliser</span>
            </div>
            <div class="backup-card-body">
                <ul class="list-unstyled mb-0" style="font-size:.8125rem;">
                    <li class="d-flex gap-2 mb-3">
                        <span class="badge bg-success rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:20px;height:20px;font-size:.7rem;">1</span>
                        <span>Lors de la vérification 2FA, entrez un code de secours au lieu du code OTP</span>
                    </li>
                    <li class="d-flex gap-2 mb-3">
                        <span class="badge bg-success rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:20px;height:20px;font-size:.7rem;">2</span>
                        <span>Chaque code ne peut être utilisé qu'une seule fois</span>
                    </li>
                    <li class="d-flex gap-2 mb-3">
                        <span class="badge bg-success rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:20px;height:20px;font-size:.7rem;">3</span>
                        <span>Régénérez de nouveaux codes quand il vous en reste peu</span>
                    </li>
                    <li class="d-flex gap-2">
                        <span class="badge bg-warning rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width:20px;height:20px;font-size:.7rem;">!</span>
                        <span>Conservez-les en lieu sûr (gestionnaire de mots de passe, coffre-fort)</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>

{% if plainCodes %}
<script>
function copyBackupCodes() {
    const codes = {{ plainCodes|json_encode|raw }};
    const text = 'AgriLink - Codes de secours 2FA\n' + codes.join('\n');
    navigator.clipboard.writeText(text).then(function() {
        const btn = event.target.closest('button');
        const orig = btn.innerHTML;
        btn.innerHTML = '<svg fill="currentColor" viewBox="0 0 20 20" width="14" height="14" class="me-1"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg> Copié !';
        btn.classList.replace('btn-outline-success', 'btn-success');
        btn.classList.add('text-white');
        setTimeout(function() { btn.innerHTML = orig; btn.classList.replace('btn-success', 'btn-outline-success'); btn.classList.remove('text-white'); }, 2000);
    });
}
</script>
{% endif %}
{% endblock %}
