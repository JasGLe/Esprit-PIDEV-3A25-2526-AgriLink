{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Mon profil - AgriLink{% endblock %}

{% block dashboard_content %}
    <link rel="stylesheet" href="{{ asset('css/profile-enhanced.css') }}">
    
    <div class="profile-container">
        {# Header avec titre et bouton de modification #}
        <div class="profile-header d-flex justify-content-between align-items-center">
            <div>
                <h1 class="profile-header-title">Mon profil</h1>
                <p class="mb-0 text-muted">Gérez vos informations personnelles et paramètres de compte</p>
            </div>
            <a href="{{ path('app_profile_edit') }}" class="profile-edit-button">
                <svg class="profile-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                Modifier
            </a>
        </div>

        <div class="row g-4">
            {# Colonne gauche: Avatar et infos de base (Hero Card) #}
            <div class="col-lg-4">
            {% embed 'components/_card.html.twig' %}
                {% block card_content %}
                    <div class="text-center">
                        <div class="mx-auto">
                            {{ include('components/_avatar.html.twig', {user: app.user, size: 'large'}) }}
                        </div>
                        <h3 class="mt-3 h5 fw-semibold">{{ app.user.displayName }}</h3>
                        <p class="small text-muted">{{ app.user.email }}</p>
                        <div class="mt-3 d-flex justify-content-center">
                            {{ include('components/_role_badge.html.twig', {role: app.user.roles|first}) }}
                        </div>
                        <div class="mt-3 pt-3 border-top">
                            <div class="d-flex align-items-center justify-content-center small text-muted">
                                <svg class="icon-sm me-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                Membre depuis {{ app.user.createdAt ? app.user.createdAt|date('d/m/Y') : 'N/A' }}
                            </div>
                        </div>
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed 'components/_card.html.twig' with {classes: 'mt-3'} %}
                {% block card_title %}Statut du compte{% endblock %}
                {% block card_content %}
                    <div class="vstack gap-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="small text-muted">Compte</span>
                            {% if app.user.isActive %}
                                <span class="badge bg-success-subtle text-success d-inline-flex align-items-center">
                                    <svg class="icon-xs me-1" fill="currentColor" viewBox="0 0 20 20" width="12" height="12">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                    </svg>
                                    Actif
                                </span>
                            {% else %}
                                <span class="badge bg-danger-subtle text-danger d-inline-flex align-items-center">
                                    <svg class="icon-xs me-1" fill="currentColor" viewBox="0 0 20 20" width="12" height="12">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                                    </svg>
                                    Inactif
                                </span>
                            {% endif %}
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="small text-muted">Email vérifié</span>
                            {% if app.user.emailVerified %}
                                <span class="badge bg-success-subtle text-success d-inline-flex align-items-center">
                                    <svg class="icon-xs me-1" fill="currentColor" viewBox="0 0 20 20" width="12" height="12">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                    </svg>
                                    Vérifié
                                </span>
                            {% else %}
                                <span class="badge bg-warning-subtle text-warning d-inline-flex align-items-center">
                                    <svg class="icon-xs me-1" fill="currentColor" viewBox="0 0 20 20" width="12" height="12">
                                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                                    </svg>
                                    Non vérifié
                                </span>
                            {% endif %}
                        </div>
                        {% if app.user.twoFactorEnabled %}
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="small text-muted">2FA</span>
                            <span class="badge bg-success-subtle text-success d-inline-flex align-items-center">
                                <svg class="icon-xs me-1" fill="currentColor" viewBox="0 0 20 20" width="12" height="12">
                                    <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                                </svg>
                                Activé
                            </span>
                        </div>
                        {% endif %}
                    </div>
                {% endblock %}
            {% endembed %}

            {# Lien vers les paramètres de sécurité #}
            {% embed 'components/_card.html.twig' with {classes: 'mt-3'} %}
                {% block card_content %}
                    <a href="{{ path('app_profile_security') }}" class="d-flex align-items-center justify-content-between text-decoration-none small fw-medium">
                        <span class="d-flex align-items-center text-primary">
                            <svg class="icon-sm me-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                            </svg>
                            Paramètres de sécurité
                        </span>
                        <svg class="icon-sm text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </a>
                {% endblock %}
            {% endembed %}
        </div>

        {# Colonne droite: Informations détaillées #}
        <div class="col-lg-8">
            {# Informations personnelles #}
            {% embed 'components/_card.html.twig' %}
                {% block card_title %}Informations personnelles{% endblock %}
                {% block card_content %}
                    <dl class="row g-0 mb-0">
                        <div class="col-12 py-3 border-bottom">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">Nom complet</dt>
                                <dd class="col-sm-8 mb-0 small">
                                    {{ app.user.nom ?: 'Non renseigné' }}
                                </dd>
                            </div>
                        </div>
                        <div class="col-12 py-3 border-bottom">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">Email</dt>
                                <dd class="col-sm-8 mb-0 small d-flex align-items-center">
                                    {{ app.user.email }}
                                    {% if app.user.emailVerified %}
                                        <svg class="icon-sm ms-2 text-success" fill="currentColor" viewBox="0 0 20 20" width="16" height="16">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                        </svg>
                                    {% endif %}
                                </dd>
                            </div>
                        </div>
                        <div class="col-12 py-3 border-bottom">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">Date de naissance</dt>
                                <dd class="col-sm-8 mb-0 small">
                                    {{ app.user.dateNaissance ? app.user.dateNaissance|date('d/m/Y') : 'Non renseigné' }}
                                </dd>
                            </div>
                        </div>
                        <div class="col-12 py-3">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">Rôle</dt>
                                <dd class="col-sm-8 mb-0 small">
                                    {{ app.user.roleBadge }}
                                </dd>
                            </div>
                        </div>
                    </dl>
                {% endblock %}
            {% endembed %}

            {# Informations de contact #}
            {% embed 'components/_card.html.twig' with {classes: 'mt-3'} %}
                {% block card_title %}Contact{% endblock %}
                {% block card_content %}
                    <dl class="row g-0 mb-0">
                        <div class="col-12 py-3">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">Téléphone</dt>
                                <dd class="col-sm-8 mb-0 small d-flex align-items-center">
                                    {{ app.user.telephone ?: 'Non renseigné' }}
                                    {% if app.user.telephone and app.user.phoneVerified %}
                                        <svg class="icon-sm ms-2 text-success" fill="currentColor" viewBox="0 0 20 20" width="16" height="16">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                        </svg>
                                    {% endif %}
                                </dd>
                            </div>
                        </div>
                    </dl>
                {% endblock %}
            {% endembed %}

            {# Localisation #}
            {% embed 'components/_card.html.twig' with {classes: 'mt-3'} %}
                {% block card_title %}Localisation{% endblock %}
                {% block card_content %}
                    <dl class="row g-0 mb-0">
                        <div class="col-12 py-3 border-bottom">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">Gouvernorat</dt>
                                <dd class="col-sm-8 mb-0 small">
                                    {{ app.user.gouvernant ?: 'Non renseigné' }}
                                </dd>
                            </div>
                        </div>
                        <div class="col-12 py-3 border-bottom">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">Ville</dt>
                                <dd class="col-sm-8 mb-0 small">
                                    {{ app.user.ville ?: 'Non renseigné' }}
                                </dd>
                            </div>
                        </div>
                        <div class="col-12 py-3">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">Code postal</dt>
                                <dd class="col-sm-8 mb-0 small">
                                    {{ app.user.codePostale ?: 'Non renseigné' }}
                                </dd>
                            </div>
                        </div>
                    </dl>
                {% endblock %}
            {% endembed %}

            {# Section spécifique Agriculteur #}
            {% if app.user.isAgriculteur or app.user.isAgriPlus %}
            {% embed 'components/_card.html.twig' with {classes: 'mt-3'} %}
                {% block card_title %}
                    <span class="d-flex align-items-center">
                        <svg class="icon-sm me-2 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Informations agriculteur
                    </span>
                {% endblock %}
                {% block card_content %}
                    <dl class="row g-0 mb-0">
                        <div class="col-12 py-3">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">Années d'expérience</dt>
                                <dd class="col-sm-8 mb-0 small">
                                    {% if app.user.agriculteurExpAnnee is not null %}
                                        {{ app.user.agriculteurExpAnnee }} an{% if app.user.agriculteurExpAnnee > 1 %}s{% endif %}
                                    {% else %}
                                        Non renseigné
                                    {% endif %}
                                </dd>
                            </div>
                        </div>
                    </dl>
                {% endblock %}
            {% endembed %}
            {% endif %}

            {# Section spécifique AgriPlus #}
            {% if app.user.isAgriPlus %}
            {% embed 'components/_card.html.twig' with {classes: 'mt-3'} %}
                {% block card_title %}
                    <span class="d-flex align-items-center">
                        <svg class="icon-sm me-2 text-warning" fill="currentColor" viewBox="0 0 20 20" width="20" height="20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                        Abonnement AgriPlus
                    </span>
                {% endblock %}
                {% block card_content %}
                    <dl class="row g-0 mb-0">
                        <div class="col-12 py-3 border-bottom">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">Plan d'abonnement</dt>
                                <dd class="col-sm-8 mb-0 small">
                                    {% set planColors = {
                                        'BASIC': 'bg-primary-subtle text-primary',
                                        'PREMIUM': 'bg-secondary-subtle text-secondary',
                                        'ENTERPRISE': 'bg-warning-subtle text-warning'
                                    } %}
                                    {% set planLabels = {
                                        'BASIC': 'Basic',
                                        'PREMIUM': 'Premium',
                                        'ENTERPRISE': 'Enterprise'
                                    } %}
                                    <span class="badge {{ planColors[app.user.agriplusAbonnement] ?? 'bg-secondary-subtle text-secondary' }}">
                                        {{ planLabels[app.user.agriplusAbonnement] ?? app.user.agriplusAbonnement ?? 'Non défini' }}
                                    </span>
                                </dd>
                            </div>
                        </div>
                        <div class="col-12 py-3">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">Date d'expiration</dt>
                                <dd class="col-sm-8 mb-0 small">
                                    {% if app.user.agriplusDateExpiration %}
                                        {% if app.user.hasValidAgriplusSubscription %}
                                            <span class="text-success">{{ app.user.agriplusDateExpiration|date('d/m/Y') }}</span>
                                            <span class="text-muted ms-2">(Actif)</span>
                                        {% else %}
                                            <span class="text-danger">{{ app.user.agriplusDateExpiration|date('d/m/Y') }}</span>
                                            <span class="text-danger ms-2">(Expiré)</span>
                                        {% endif %}
                                    {% else %}
                                        <span class="text-muted">Non définie</span>
                                    {% endif %}
                                </dd>
                            </div>
                        </div>
                    </dl>
                {% endblock %}
            {% endembed %}
            {% endif %}

            {# Section spécifique Fournisseur #}
            {% if app.user.isFournisseur %}
            {% embed 'components/_card.html.twig' with {classes: 'mt-3'} %}
                {% block card_title %}
                    <span class="d-flex align-items-center">
                        <svg class="icon-sm me-2 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                        Informations fournisseur
                    </span>
                {% endblock %}
                {% block card_content %}
                    <dl class="row g-0 mb-0">
                        <div class="col-12 py-3 border-bottom">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">Type de fournisseur</dt>
                                <dd class="col-sm-8 mb-0 small">
                                    {% if app.user.fournisseurTypeFournisseur == 'PERSONNE' %}
                                        Personne physique
                                    {% elseif app.user.fournisseurTypeFournisseur == 'SOCIETE' %}
                                        Société
                                    {% else %}
                                        Non renseigné
                                    {% endif %}
                                </dd>
                            </div>
                        </div>

                        {# Champs Personne Physique #}
                        {% if app.user.fournisseurTypeFournisseur == 'PERSONNE' %}
                        <div class="col-12 py-3">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">CIN</dt>
                                <dd class="col-sm-8 mb-0 small">
                                    {{ app.user.fournisseurCin ?: 'Non renseigné' }}
                                    <span class="ms-2 text-muted" style="font-size: 0.75rem;">(Non modifiable)</span>
                                </dd>
                            </div>
                        </div>
                        {% endif %}

                        {# Champs Société #}
                        {% if app.user.fournisseurTypeFournisseur == 'SOCIETE' %}
                        <div class="col-12 py-3 border-bottom">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">Raison sociale</dt>
                                <dd class="col-sm-8 mb-0 small">
                                    {{ app.user.fournisseurRaisonSocial ?: 'Non renseigné' }}
                                </dd>
                            </div>
                        </div>
                        <div class="col-12 py-3 border-bottom">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">N° Registre de commerce</dt>
                                <dd class="col-sm-8 mb-0 small">
                                    {{ app.user.fournisseurNumRegistre ?: 'Non renseigné' }}
                                    <span class="ms-2 text-muted" style="font-size: 0.75rem;">(Non modifiable)</span>
                                </dd>
                            </div>
                        </div>
                        <div class="col-12 py-3 border-bottom">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">Forme juridique</dt>
                                <dd class="col-sm-8 mb-0 small">
                                    {{ app.user.fournisseurFormeJuridique ?: 'Non renseigné' }}
                                </dd>
                            </div>
                        </div>
                        <div class="col-12 py-3 border-bottom">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">Capital social</dt>
                                <dd class="col-sm-8 mb-0 small">
                                    {% if app.user.fournisseurCapital %}
                                        {{ app.user.fournisseurCapital|number_format(2, ',', ' ') }} TND
                                    {% else %}
                                        Non renseigné
                                    {% endif %}
                                </dd>
                            </div>
                        </div>
                        {% endif %}

                        <div class="col-12 py-3">
                            <div class="row">
                                <dt class="col-sm-4 small fw-medium text-muted">Certifications</dt>
                                <dd class="col-sm-8 mb-0 small">
                                    {% if app.user.fournisseurCertifications %}
                                        <div style="white-space: pre-line;">{{ app.user.fournisseurCertifications }}</div>
                                    {% else %}
                                        <span class="text-muted fst-italic">Aucune certification renseignée</span>
                                    {% endif %}
                                </dd>
                            </div>
                        </div>
                    </dl>
                {% endblock %}
            {% endembed %}
            {% endif %}

            {# Dernière mise à jour #}
            <div class="text-end small text-muted mt-3">
                Dernière mise à jour : {{ app.user.updatedAt ? app.user.updatedAt|date('d/m/Y à H:i') : 'N/A' }}
            </div>
        </div>
    </div>
{% endblock %}
