{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Changer le mot de passe - AgriLink{% endblock %}

{% block dashboard_content %}
    <div class="mb-4">
        <div class="d-flex align-items-center gap-3">
            <a href="{{ path('app_profile_security') }}"
               class="btn btn-light border rounded-circle p-0 d-flex align-items-center justify-content-center flex-shrink-0"
               style="width:2.25rem;height:2.25rem;">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
            </a>
            <div>
                <h1 class="h4 fw-bold mb-0">Changer le mot de passe</h1>
                <p class="text-muted mb-0" style="font-size:.8rem;">
                    <a href="{{ path('app_profile') }}" class="text-decoration-none text-muted">Profil</a>
                    &rsaquo; <a href="{{ path('app_profile_security') }}" class="text-decoration-none text-muted">Sécurité</a>
                    &rsaquo; Mot de passe
                </p>
            </div>
        </div>
    </div>

    <div style="max-width: 900px;">
        <div class="row g-4">
            {# Colonne principale: Formulaire #}
            <div class="col-lg-8">
                {% embed 'components/_card.html.twig' %}
                    {% block card_content %}
                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                            <div class="vstack gap-4">
                                {# Mot de passe actuel #}
                                <div>
                                    {{ form_label(form.currentPassword) }}
                                    {{ form_widget(form.currentPassword) }}
                                    {{ form_errors(form.currentPassword) }}
                                </div>

                                <hr>

                                {# Nouveau mot de passe #}
                                <div>
                                    {{ form_label(form.newPassword.first) }}
                                    {{ form_widget(form.newPassword.first, {'attr': {'id': 'new-password-field'}}) }}
                                    {{ form_errors(form.newPassword.first) }}
                                    
                                    {# Indicateur de force du mot de passe #}
                                    <div class="mt-2">
                                        <div class="d-flex gap-1" style="height: 4px;">
                                            <div id="strength-1" class="flex-fill rounded bg-light"></div>
                                            <div id="strength-2" class="flex-fill rounded bg-light"></div>
                                            <div id="strength-3" class="flex-fill rounded bg-light"></div>
                                            <div id="strength-4" class="flex-fill rounded bg-light"></div>
                                        </div>
                                        <p id="strength-text" class="mt-1 small text-muted mb-0"></p>
                                    </div>
                                </div>

                                {# Confirmer le nouveau mot de passe #}
                                <div>
                                    {{ form_label(form.newPassword.second) }}
                                    {{ form_widget(form.newPassword.second) }}
                                    {{ form_errors(form.newPassword.second) }}
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-4 pt-4 border-top">
                                <a href="{{ path('app_profile') }}" class="btn btn-outline-secondary">
                                    Annuler
                                </a>
                                <button type="submit" class="btn btn-primary">
                                    Changer le mot de passe
                                </button>
                            </div>
                        {{ form_end(form) }}
                    {% endblock %}
                {% endembed %}
            </div>

            {# Colonne latérale: Exigences du mot de passe #}
            <div class="col-lg-4">
                {% embed 'components/_card.html.twig' %}
                    {% block card_title %}Exigences du mot de passe{% endblock %}
                    {% block card_content %}
                        <ul class="list-unstyled vstack gap-2 small">
                            <li id="req-length" class="d-flex align-items-center text-muted">
                                <svg class="req-icon me-2 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                    <circle cx="12" cy="12" r="10" stroke-width="2"/>
                                </svg>
                                Au moins 8 caractères
                            </li>
                            <li id="req-upper" class="d-flex align-items-center text-muted">
                                <svg class="req-icon me-2 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                    <circle cx="12" cy="12" r="10" stroke-width="2"/>
                                </svg>
                                Une lettre majuscule
                            </li>
                            <li id="req-lower" class="d-flex align-items-center text-muted">
                                <svg class="req-icon me-2 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                    <circle cx="12" cy="12" r="10" stroke-width="2"/>
                                </svg>
                                Une lettre minuscule
                            </li>
                            <li id="req-digit" class="d-flex align-items-center text-muted">
                                <svg class="req-icon me-2 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                    <circle cx="12" cy="12" r="10" stroke-width="2"/>
                                </svg>
                                Un chiffre
                            </li>
                            <li id="req-special" class="d-flex align-items-center text-muted">
                                <svg class="req-icon me-2 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                    <circle cx="12" cy="12" r="10" stroke-width="2"/>
                                </svg>
                                Un caractère spécial (!@#$%^&*...)
                            </li>
                        </ul>
                        
                        <div class="alert alert-warning d-flex mt-3 mb-0" role="alert">
                            <svg class="flex-shrink-0 me-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                            <small>
                                Après le changement de mot de passe, vous recevrez un email de confirmation.
                            </small>
                        </div>
                    {% endblock %}
                {% endembed %}
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@zxcvbn-ts/core@3/dist/zxcvbn-ts.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@zxcvbn-ts/language-common@3/dist/zxcvbn-ts.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@zxcvbn-ts/language-fr@3/dist/zxcvbn-ts.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const passwordField = document.getElementById('new-password-field');
            const strengthBars = [
                document.getElementById('strength-1'),
                document.getElementById('strength-2'),
                document.getElementById('strength-3'),
                document.getElementById('strength-4')
            ];
            const strengthText = document.getElementById('strength-text');

            const requirements = {
                length: { el: document.getElementById('req-length'), regex: /.{8,}/ },
                upper: { el: document.getElementById('req-upper'), regex: /[A-Z]/ },
                lower: { el: document.getElementById('req-lower'), regex: /[a-z]/ },
                digit: { el: document.getElementById('req-digit'), regex: /[0-9]/ },
                special: { el: document.getElementById('req-special'), regex: /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/ }
            };

            const checkIcon = '<svg class="req-icon me-2 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>';
            const circleIcon = '<svg class="req-icon me-2 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16"><circle cx="12" cy="12" r="10" stroke-width="2"/></svg>';

            function updateRequirement(req, passed) {
                const icon = req.el.querySelector('.req-icon');
                if (passed) {
                    req.el.classList.remove('text-muted');
                    req.el.classList.add('text-success');
                    icon.outerHTML = checkIcon;
                } else {
                    req.el.classList.remove('text-success');
                    req.el.classList.add('text-muted');
                    icon.outerHTML = circleIcon;
                }
            }

            function updateStrength(score) {
                const colors = ['bg-light', 'bg-danger', 'bg-warning', 'bg-info', 'bg-success'];
                const texts = ['', 'Très faible', 'Faible', 'Moyen', 'Fort'];
                const textColors = ['', 'text-danger', 'text-warning', 'text-info', 'text-success'];

                strengthBars.forEach(function(bar, index) {
                    bar.className = 'flex-fill rounded';
                    bar.classList.add(index < score ? colors[score] : 'bg-light');
                });

                strengthText.textContent = texts[score] || '';
                strengthText.className = 'mt-1 small mb-0 ' + (textColors[score] || 'text-muted');
            }

            // zxcvbn feedback translations
            var zxcvbnFeedback = {
                'Use a few words, avoid common phrases': 'Utilisez quelques mots, évitez les expressions courantes',
                'No need for symbols, digits, or uppercase letters': 'Pas besoin de symboles, chiffres ou majuscules',
                'Add another word or two. Uncommon words are better.': 'Ajoutez un ou deux mots. Les mots peu courants sont meilleurs.',
                'Straight rows of keys are easy to guess': 'Les lignes droites de touches sont faciles à deviner',
                'Short keyboard patterns are easy to guess': 'Les motifs courts au clavier sont faciles à deviner',
                'Use a longer keyboard pattern with more turns': 'Utilisez un motif clavier plus long avec plus de virages',
                'Repeats like "aaa" are easy to guess': 'Les répétitions comme "aaa" sont faciles à deviner',
                'Repeats like "abcabcabc" are only slightly harder to guess than "abc"': 'Les répétitions comme "abcabcabc" ne sont que légèrement plus difficiles à deviner',
                'Avoid repeated words and characters': 'Évitez les mots et caractères répétés',
                'Sequences like abc or 6543 are easy to guess': 'Les séquences comme abc ou 6543 sont faciles à deviner',
                'Avoid sequences': 'Évitez les séquences',
                'Recent years are easy to guess': 'Les années récentes sont faciles à deviner',
                'Avoid recent years': 'Évitez les années récentes',
                'Avoid years that are associated with you': 'Évitez les années associées à vous',
                'Dates are often easy to guess': 'Les dates sont souvent faciles à deviner',
                'Avoid dates and years that are associated with you': 'Évitez les dates et années associées à vous',
                'This is a top-10 common password': 'C\'est un des 10 mots de passe les plus courants',
                'This is a top-100 common password': 'C\'est un des 100 mots de passe les plus courants',
                'This is a very common password': 'C\'est un mot de passe très courant',
                'This is similar to a commonly used password': 'C\'est similaire à un mot de passe couramment utilisé',
                'A word by itself is easy to guess': 'Un mot seul est facile à deviner',
                'Names and surnames by themselves are easy to guess': 'Les noms et prénoms seuls sont faciles à deviner',
                'Common names and surnames are easy to guess': 'Les noms et prénoms courants sont faciles à deviner',
                'Capitalization doesn\'t help very much': 'Les majuscules n\'aident pas beaucoup',
                'All-uppercase is almost as easy to guess as all-lowercase': 'Tout en majuscules est presque aussi facile à deviner que tout en minuscules',
                'Reversed words aren\'t much harder to guess': 'Les mots inversés ne sont pas beaucoup plus difficiles à deviner',
                'Predictable substitutions like \'@\' instead of \'a\' don\'t help very much': 'Les substitutions prévisibles comme \'@\' au lieu de \'a\' n\'aident pas beaucoup',
            };

            function translateFeedback(msg) {
                return zxcvbnFeedback[msg] || msg;
            }

            if (passwordField) {
                passwordField.addEventListener('input', function() {
                    var password = this.value;

                    // Update requirement checks
                    for (var key in requirements) {
                        var req = requirements[key];
                        updateRequirement(req, req.regex.test(password));
                    }

                    if (!password) {
                        updateStrength(0);
                        strengthText.textContent = '';
                        return;
                    }

                    // Use zxcvbn if available, fallback to regex scoring
                    if (typeof zxcvbnts !== 'undefined' && zxcvbnts.core) {
                        var result = zxcvbnts.core.zxcvbn(password);
                        // zxcvbn returns 0-4, map to our 1-4 bar display
                        var barScore = Math.max(1, result.score);
                        updateStrength(barScore);

                        // Show zxcvbn feedback
                        var suggestions = [];
                        if (result.feedback && result.feedback.warning) {
                            suggestions.push(translateFeedback(result.feedback.warning));
                        }
                        if (result.feedback && result.feedback.suggestions) {
                            result.feedback.suggestions.forEach(function(s) {
                                suggestions.push(translateFeedback(s));
                            });
                        }
                        if (suggestions.length > 0) {
                            var texts = ['', 'Très faible', 'Faible', 'Moyen', 'Fort'];
                            var textColors = ['', 'text-danger', 'text-warning', 'text-info', 'text-success'];
                            strengthText.innerHTML = '<strong>' + texts[barScore] + '</strong> — ' + suggestions[0];
                            strengthText.className = 'mt-1 small mb-0 ' + (textColors[barScore] || 'text-muted');
                        }
                    } else {
                        // Fallback: regex-based scoring
                        var score = 0;
                        if (password.length >= 6) score++;
                        if (password.length >= 10) score++;
                        if (/[A-Z]/.test(password) && /[a-z]/.test(password)) score++;
                        if (/\d/.test(password) || /[^A-Za-z0-9]/.test(password)) score++;
                        updateStrength(password.length > 0 ? Math.max(1, score) : 0);
                    }
                });
            }
        });
    </script>
{% endblock %}
