{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Paramètres de sécurité - AgriLink{% endblock %}

{% block dashboard_content %}
<style>
    .sec-card {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
        overflow: hidden;
        margin-bottom: 1.25rem;
    }
    .sec-card-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #f0f4f0;
        background: #fafffe;
        display: flex; align-items: center; gap: .75rem;
    }
    .sec-card-header .sec-icon {
        width: 2rem; height: 2rem; border-radius: 8px;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
    .sec-card-body { padding: 1.5rem; }

    /* Toggle switch */
    .toggle-switch { position: relative; display: inline-block; width: 52px; height: 28px; }
    .toggle-switch input { opacity: 0; width: 0; height: 0; }
    .toggle-slider {
        position: absolute; inset: 0; background: #dee2e6;
        border-radius: 28px; cursor: pointer;
        transition: background .2s;
    }
    .toggle-slider:before {
        content: '';
        position: absolute; width: 22px; height: 22px;
        left: 3px; bottom: 3px;
        background: #fff; border-radius: 50%;
        transition: transform .2s;
        box-shadow: 0 1px 4px rgba(0,0,0,.2);
    }
    .toggle-switch input:checked + .toggle-slider { background: #198754; }
    .toggle-switch input:checked + .toggle-slider:before { transform: translateX(24px); }
    .toggle-switch input:focus + .toggle-slider { box-shadow: 0 0 0 3px rgba(25,135,84,.2); }

    /* Password strength pill */
    .strength-pill {
        display: inline-flex; align-items: center; gap: .375rem;
        padding: .2rem .6rem; border-radius: 50px; font-size: .75rem; font-weight: 600;
    }

    /* Event timeline */
    .event-row {
        display: flex; align-items: flex-start; gap: .875rem;
        padding: .75rem 0; border-bottom: 1px solid #f5f5f5;
    }
    .event-row:last-child { border-bottom: none; }
    .event-dot {
        width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center; margin-top: .1rem;
    }
    .event-dot.success { background: #d1e7dd; }
    .event-dot.danger  { background: #f8d7da; }
    .event-dot.warning { background: #fff3cd; }
    .event-dot.info    { background: #cff4fc; }
    .event-dot.muted   { background: #f0f0f0; }
    .event-meta { font-size: .75rem; color: #6c757d; margin-top: .2rem; }
    .event-type-badge {
        display: inline-block; padding: .15rem .5rem;
        border-radius: 4px; font-size: .7rem; font-weight: 600;
        text-transform: uppercase; letter-spacing: .04em;
    }

    /* Req list */
    .req-item { display: flex; align-items: center; gap: .5rem; font-size: .8125rem; padding: .3rem 0; }
    .req-item.ok   { color: #198754; }
    .req-item.pending { color: #6c757d; }
    .req-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .req-dot.ok { background: #198754; }
    .req-dot.pending { background: #dee2e6; }

    /* Status row */
    .stat-row {
        display: flex; justify-content: space-between; align-items: center;
        padding: .625rem 0; border-bottom: 1px solid #f5f5f5; font-size: .8125rem;
    }
    .stat-row:last-child { border-bottom: none; }
    .stat-label { color: #6c757d; font-weight: 500; }

    /* Password bars */
    .pw-bar-wrap { display: flex; gap: 3px; height: 5px; }
    .pw-bar { flex: 1; border-radius: 3px; background: #e9ecef; transition: background .3s; }
    .pw-bar.on-danger  { background: #dc3545; }
    .pw-bar.on-warning { background: #ffc107; }
    .pw-bar.on-info    { background: #0dcaf0; }
    .pw-bar.on-success { background: #198754; }
</style>

{# ── Page header ── #}
<div class="d-flex align-items-center gap-3 mb-4">
    <a href="{{ path('app_profile') }}"
       class="btn btn-light border rounded-circle p-0 d-flex align-items-center justify-content-center flex-shrink-0"
       style="width:2.25rem;height:2.25rem;" title="Retour au profil">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
    </a>
    <div>
        <h1 class="h4 fw-bold mb-0">Paramètres de sécurité</h1>
        <p class="text-muted mb-0" style="font-size:.8rem;">
            <a href="{{ path('app_profile') }}" class="text-decoration-none text-muted">Profil</a>
            &rsaquo; Sécurité
        </p>
    </div>
</div>

<div class="row g-4" style="max-width:980px;">

    {# ── Left column ── #}
    <div class="col-lg-7">

        {# ── Email verification banner ── #}
        {% if not app.user.emailVerified %}
        <div class="sec-card" style="border-color:#ffc107; border-width:1.5px;">
            <div class="sec-card-header" style="background:#fffdf0;">
                <div class="sec-icon" style="background:#fff3cd;">
                    <svg fill="none" stroke="#856404" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                </div>
                <div class="flex-fill">
                    <span class="fw-semibold d-block" style="font-size:.9rem;">Vérification de l'adresse email</span>
                    <span class="text-muted" style="font-size:.75rem;">Action requise pour sécuriser votre compte</span>
                </div>
                <span class="badge bg-warning text-dark" style="font-size:.7rem;">En attente</span>
            </div>
            <div class="sec-card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-sm-8">
                        <div class="d-flex align-items-start gap-2 mb-2">
                            <svg fill="currentColor" viewBox="0 0 20 20" width="16" height="16" class="text-warning flex-shrink-0 mt-1">
                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                            </svg>
                            <p class="mb-0" style="font-size:.8125rem; line-height:1.5;">
                                Votre adresse <strong>{{ app.user.email }}</strong> n'est pas encore vérifiée.
                                La vérification protège votre compte et active toutes les fonctionnalités.
                            </p>
                        </div>
                        <ul class="list-unstyled mb-0" style="font-size:.8rem;">
                            <li class="req-item ok"><span class="req-dot ok"></span>Récupération de compte en cas d'oubli de mot de passe</li>
                            <li class="req-item ok"><span class="req-dot ok"></span>Réception des alertes de sécurité</li>
                            <li class="req-item ok"><span class="req-dot ok"></span>Activation complète de la 2FA</li>
                        </ul>
                    </div>
                    <div class="col-sm-4 text-sm-center">
                        <a href="{{ path('app_verify_email', {'from': 'profile'}) }}"
                           class="btn btn-warning d-flex align-items-center justify-content-center gap-2 fw-semibold">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Vérifier maintenant
                        </a>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        {# ── 2FA ── #}
        <div class="sec-card">
            <div class="sec-card-header">
                <div class="sec-icon bg-success bg-opacity-10">
                    <svg fill="none" stroke="#198754" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                </div>
                <div class="flex-fill">
                    <span class="fw-semibold d-block" style="font-size:.9rem;">Double authentification (2FA)</span>
                    <span class="text-muted" style="font-size:.75rem;">Ajoutez une couche de sécurité supplémentaire</span>
                </div>
                {% if app.user.twoFactorEnabled %}
                    <span class="badge bg-success-subtle text-success" style="font-size:.7rem;">Activée</span>
                {% else %}
                    <span class="badge bg-secondary-subtle text-secondary" style="font-size:.7rem;">Désactivée</span>
                {% endif %}
            </div>
            <div class="sec-card-body">
                <div class="d-flex align-items-start gap-4">
                    <div class="flex-fill">
                        {% if app.user.twoFactorEnabled %}
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <svg fill="currentColor" viewBox="0 0 20 20" width="16" height="16" class="text-success flex-shrink-0">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                </svg>
                                <span class="fw-semibold text-success" style="font-size:.875rem;">Votre compte est protégé par la 2FA</span>
                            </div>
                            <p class="text-muted mb-0" style="font-size:.8125rem; line-height:1.5;">
                                À chaque connexion, un code à 6 chiffres sera envoyé à
                                <strong>{{ app.user.email }}</strong>.
                                Désactiver la 2FA réduit la sécurité de votre compte.
                            </p>
                        {% else %}
                            <p class="fw-medium mb-1" style="font-size:.875rem;">Pourquoi activer la 2FA ?</p>
                            <ul class="list-unstyled mb-0">
                                <li class="req-item ok"><span class="req-dot ok"></span>Protection contre le vol de mot de passe</li>
                                <li class="req-item ok"><span class="req-dot ok"></span>Code envoyé par email à chaque connexion</li>
                                <li class="req-item ok"><span class="req-dot ok"></span>Blocage des accès non autorisés</li>
                            </ul>
                        {% endif %}
                    </div>

                    {# Toggle form #}
                    <form method="post" action="{{ path('app_profile_toggle_2fa') }}" id="toggle2faForm">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_2fa') }}">
                        <label class="toggle-switch" title="{{ app.user.twoFactorEnabled ? 'Désactiver la 2FA' : 'Activer la 2FA' }}">
                            <input type="checkbox"
                                   id="twofa-toggle"
                                   {{ app.user.twoFactorEnabled ? 'checked' : '' }}
                                   onchange="confirmToggle2fa(this)">
                            <span class="toggle-slider"></span>
                        </label>
                    </form>
                </div>

                {% if app.user.twoFactorEnabled %}
                    <div class="alert alert-warning d-flex gap-2 align-items-start mt-3 mb-0 py-2 px-3"
                         style="font-size:.8rem; border-radius:8px; border:none;">
                        <svg fill="currentColor" viewBox="0 0 20 20" width="14" height="14" class="flex-shrink-0 mt-1">
                            <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                        </svg>
                        Désactiver la 2FA rendra votre compte moins sécurisé. Assurez-vous que votre mot de passe est fort.
                    </div>
                {% endif %}
            </div>
        </div>

        {# ── Change password ── #}
        <div class="sec-card">
            <div class="sec-card-header">
                <div class="sec-icon bg-warning bg-opacity-10">
                    <svg fill="none" stroke="#fd7e14" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                    </svg>
                </div>
                <div>
                    <span class="fw-semibold d-block" style="font-size:.9rem;">Mot de passe</span>
                    <span class="text-muted" style="font-size:.75rem;">Sécurisez l'accès à votre compte</span>
                </div>
            </div>
            <div class="sec-card-body">
                <div class="row g-3">
                    <div class="col-sm-8">
                        <p class="text-muted mb-3" style="font-size:.8125rem; line-height:1.5;">
                            Utilisez un mot de passe fort et unique. Un bon mot de passe contient des majuscules,
                            des chiffres et des caractères spéciaux.
                        </p>

                        <p class="mb-2 fw-medium" style="font-size:.8125rem;">Votre mot de passe doit contenir :</p>
                        <ul class="list-unstyled mb-0">
                            <li class="req-item pending" id="pw-req-len"><span class="req-dot pending"></span>Au moins 8 caractères</li>
                            <li class="req-item pending" id="pw-req-up"><span class="req-dot pending"></span>Une majuscule</li>
                            <li class="req-item pending" id="pw-req-lo"><span class="req-dot pending"></span>Une minuscule</li>
                            <li class="req-item pending" id="pw-req-num"><span class="req-dot pending"></span>Un chiffre</li>
                            <li class="req-item pending" id="pw-req-sp"><span class="req-dot pending"></span>Un caractère spécial (!@#$%…)</li>
                        </ul>
                    </div>
                    <div class="col-sm-4 d-flex align-items-center justify-content-center">
                        <a href="{{ path('app_profile_change_password') }}"
                           class="btn btn-outline-warning d-flex align-items-center gap-2 px-3">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                            </svg>
                            Changer
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# ── Phone verification ── #}
        <div class="sec-card">
            <div class="sec-card-header">
                <div class="sec-icon {% if app.user.phoneVerified %}bg-success bg-opacity-10{% else %}bg-info bg-opacity-10{% endif %}">
                    <svg fill="none" stroke="{% if app.user.phoneVerified %}#198754{% else %}#0dcaf0{% endif %}" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3 5a2 2 0 012-2h3.28a1 1 0 00.948.684l1.498 4.493a1 1 0 00.502.756l2.048 1.022a11.04 11.04 0 01-5.693 5.653l-1.022-2.047a1 1 0 00-.756-.502l-4.493-1.498a1 1 0 00-.684-.948V5z"/>
                    </svg>
                </div>
                <div class="flex-fill">
                    <span class="fw-semibold d-block" style="font-size:.9rem;">Vérification du téléphone</span>
                    <span class="text-muted" style="font-size:.75rem;">Recevez les codes de sécurité par SMS</span>
                </div>
                {% if app.user.phoneVerified %}
                    <span class="badge bg-success-subtle text-success" style="font-size:.7rem;">Vérifiée</span>
                {% else %}
                    <span class="badge bg-secondary-subtle text-secondary" style="font-size:.7rem;">Non vérifiée</span>
                {% endif %}
            </div>
            <div class="sec-card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-sm-8">
                        {% if app.user.phoneVerified %}
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <svg fill="currentColor" viewBox="0 0 20 20" width="16" height="16" class="text-success flex-shrink-0">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                </svg>
                                <span class="fw-semibold text-success" style="font-size:.875rem;">Votre numéro est vérifié</span>
                            </div>
                            <p class="text-muted mb-0" style="font-size:.8125rem; line-height:1.5;">
                                Votre numéro de téléphone <strong>{{ app.user.telephone }}</strong> est vérifiée.
                                Vous pouvez recevoir les codes de sécurité par SMS.
                            </p>
                        {% else %}
                            <p class="fw-medium mb-1" style="font-size:.875rem;">Pourquoi vérifier votre téléphone ?</p>
                            <ul class="list-unstyled mb-0">
                                <li class="req-item ok"><span class="req-dot ok"></span>Reçois les codes de sécurité par SMS</li>
                                <li class="req-item ok"><span class="req-dot ok"></span>Authentification à deux facteurs SMS</li>
                                <li class="req-item ok"><span class="req-dot ok"></span>Alerts de sécurité en temps réel</li>
                            </ul>
                        {% endif %}
                    </div>
                    <div class="col-sm-4 text-sm-center">
                        <a href="{{ path('app_profile_verify_phone') }}"
                           class="btn btn-{% if app.user.phoneVerified %}outline-success{% else %}info{% endif %} d-flex align-items-center justify-content-center gap-2 fw-semibold">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="{% if app.user.phoneVerified %}M13 10V3L4 14h7v7l9-11h-7z{% else %}M12 4v16m8-8H4{% endif %}"/>
                            </svg>
                            {% if app.user.phoneVerified %}Modifier{% else %}Vérifier{% endif %}
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# ── Recent activity ── #}
        <div class="sec-card">
            <div class="sec-card-header">
                <div class="sec-icon bg-primary bg-opacity-10">
                    <svg fill="none" stroke="#0d6efd" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                    </svg>
                </div>
                <div class="flex-fill">
                    <span class="fw-semibold d-block" style="font-size:.9rem;">Activité récente</span>
                    <span class="text-muted" style="font-size:.75rem;">Derniers événements de sécurité sur votre compte</span>
                </div>
                {% if recentEvents is not empty %}
                    <span class="badge bg-light text-muted border" style="font-size:.68rem;">{{ recentEvents|length }}</span>
                {% endif %}
            </div>
            <div class="sec-card-body p-0">
                {% if recentEvents is empty %}
                    <div class="text-center py-5 text-muted">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="36" height="36" class="mb-2 opacity-40 d-block mx-auto">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                        </svg>
                        <p class="mb-0 small fw-medium">Aucun événement enregistré</p>
                    </div>
                {% else %}
                    {% set labels = {
                        'LOGIN_SUCCESS'      : 'Connexion réussie',
                        'LOGIN_FAILED'       : 'Tentative de connexion échouée',
                        'ACCOUNT_LOCKED'     : 'Compte verrouillé',
                        '2FA_OTP_SENT'       : 'Code 2FA envoyé',
                        '2FA_SUCCESS'        : 'Vérification 2FA réussie',
                        '2FA_FAILED'         : 'Échec de vérification 2FA',
                        'PASSWORD_CHANGED'   : 'Mot de passe modifié',
                        'EMAIL_VERIFIED'     : 'Adresse email vérifiée',
                        'OAUTH_LOGIN'        : 'Connexion via OAuth',
                        'OAUTH_REGISTER'     : 'Inscription via OAuth',
                        'SESSION_REVOKED'    : 'Session révoquée',
                        'LOGOUT'             : 'Déconnexion',
                        'SUSPICIOUS_ACTIVITY': 'Activité suspecte détectée',
                        'ACCOUNT_BANNED'     : 'Compte banni',
                        'ACCOUNT_UNBANNED'   : 'Compte débanni',
                        'BACKUP_CODE_USED'   : 'Code de secours utilisé',
                        'EMAIL_CHANGE_REQUESTED': 'Changement d\'email demandé'
                    } %}
                    <ul class="list-unstyled mb-0">
                    {% for event in recentEvents %}
                        {% set type = event.eventType %}
                        {% set isDanger  = type in ['LOGIN_FAILED','ACCOUNT_LOCKED','2FA_FAILED','SUSPICIOUS_ACTIVITY'] %}
                        {% set isSuccess = type in ['LOGIN_SUCCESS','2FA_SUCCESS','EMAIL_VERIFIED','PASSWORD_CHANGED','OAUTH_LOGIN','OAUTH_REGISTER'] %}
                        {% set isWarning = type in ['2FA_OTP_SENT'] %}

                        {% if isDanger %}
                            {% set dotBg = '#f8d7da' %}{% set dotColor = '#dc3545' %}
                            {% set badgeBg = '#f8d7da' %}{% set badgeColor = '#58151c' %}{% set badgeText = 'Alerte' %}
                        {% elseif isSuccess %}
                            {% set dotBg = '#d1e7dd' %}{% set dotColor = '#198754' %}
                            {% set badgeBg = '#d1e7dd' %}{% set badgeColor = '#0a3622' %}{% set badgeText = 'OK' %}
                        {% elseif isWarning %}
                            {% set dotBg = '#fff3cd' %}{% set dotColor = '#856404' %}
                            {% set badgeBg = '#fff3cd' %}{% set badgeColor = '#664d03' %}{% set badgeText = 'Info' %}
                        {% else %}
                            {% set dotBg = '#f0f0f0' %}{% set dotColor = '#6c757d' %}
                            {% set badgeBg = '#f0f0f0' %}{% set badgeColor = '#555' %}{% set badgeText = 'Sys' %}
                        {% endif %}

                        <li class="d-flex align-items-center gap-3 px-4 py-3 border-bottom {{ loop.last ? 'border-0' : '' }}"
                            style="transition:background .15s;"
                            onmouseover="this.style.background='#f9fafb'"
                            onmouseout="this.style.background=''">
                            {# Colored dot #}
                            <div class="rounded-circle flex-shrink-0" style="width:9px;height:9px;background:{{ dotColor }};"></div>
                            {# Label only — no raw details #}
                            <span class="flex-fill small fw-medium text-dark">
                                {{ labels[type] ?? (type|replace({'_': ' '})|title) }}
                            </span>
                            {# Date #}
                            <small class="text-muted flex-shrink-0" style="font-size:.72rem;">
                                {{ event.createdAt ? event.createdAt|date('d/m/Y H:i') : '' }}
                            </small>
                            {# Status badge #}
                            <span class="flex-shrink-0" style="display:inline-block;padding:.15rem .45rem;border-radius:4px;font-size:.68rem;font-weight:600;background:{{ badgeBg }};color:{{ badgeColor }};">
                                {{ badgeText }}
                            </span>
                        </li>
                    {% endfor %}
                    </ul>
                {% endif %}
            </div>
        </div>

    </div>

    {# ── Right column ── #}
    <div class="col-lg-5">

        {# ── Account status ── #}
        <div class="sec-card">
            <div class="sec-card-header">
                <div class="sec-icon bg-info bg-opacity-10">
                    <svg fill="none" stroke="#0dcaf0" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                </div>
                <span class="fw-semibold" style="font-size:.9rem;">Statut du compte</span>
            </div>
            <div class="sec-card-body">
                <dl class="mb-0">
                    <div class="stat-row">
                        <span class="stat-label">Compte</span>
                        {% if app.user.isActive %}
                            <span class="badge bg-success-subtle text-success">Actif</span>
                        {% else %}
                            <span class="badge bg-danger-subtle text-danger">Inactif</span>
                        {% endif %}
                    </div>
                    <div class="stat-row">
                        <span class="stat-label">Email vérifié</span>
                        {% if app.user.emailVerified %}
                            <span class="badge bg-success-subtle text-success">Vérifié</span>
                        {% else %}
                            <span class="badge bg-warning-subtle text-warning">Non vérifié</span>
                        {% endif %}
                    </div>
                    <div class="stat-row">
                        <span class="stat-label">2FA</span>
                        {% if app.user.twoFactorEnabled %}
                            <span class="badge bg-success-subtle text-success">Activée</span>
                        {% else %}
                            <span class="badge bg-secondary-subtle text-secondary">Désactivée</span>
                        {% endif %}
                    </div>
                    <div class="stat-row">
                        <span class="stat-label">Tentatives échouées</span>
                        {% set attempts = app.user.failedLoginAttempts %}
                        <span class="badge {{ attempts >= 3 ? 'bg-danger-subtle text-danger' : (attempts > 0 ? 'bg-warning-subtle text-warning' : 'bg-success-subtle text-success') }}">
                            {{ attempts }}/5
                        </span>
                    </div>
                    <div class="stat-row">
                        <span class="stat-label">Verrou</span>
                        {% if app.user.isLockedOut %}
                            <span class="badge bg-danger-subtle text-danger d-flex align-items-center gap-1">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="12" height="12">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                                </svg>
                                Verrouillé
                            </span>
                        {% else %}
                            <span class="badge bg-success-subtle text-success">Déverrouillé</span>
                        {% endif %}
                    </div>
                    <div class="stat-row">
                        <span class="stat-label">Dernière connexion</span>
                        <span class="text-muted" style="font-size:.75rem;">
                            {{ app.user.lastLogin ? app.user.lastLogin|date('d/m/Y H:i') : '—' }}
                        </span>
                    </div>
                    <div class="stat-row">
                        <span class="stat-label">Membre depuis</span>
                        <span class="text-muted" style="font-size:.75rem;">
                            {{ app.user.createdAt ? app.user.createdAt|date('d/m/Y') : '—' }}
                        </span>
                    </div>
                </dl>
            </div>
        </div>

        {# ── Security tips ── #}
        <div class="sec-card">
            <div class="sec-card-header">
                <div class="sec-icon" style="background:#fff3cd;">
                    <svg fill="none" stroke="#856404" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
                    </svg>
                </div>
                <span class="fw-semibold" style="font-size:.9rem;">Conseils de sécurité</span>
            </div>
            <div class="sec-card-body">
                <ul class="list-unstyled mb-0">
                    <li class="req-item {{ app.user.twoFactorEnabled ? 'ok' : 'pending' }}">
                        <span class="req-dot {{ app.user.twoFactorEnabled ? 'ok' : 'pending' }}"></span>
                        Activez la double authentification
                    </li>
                    <li class="req-item {{ app.user.emailVerified ? 'ok' : 'pending' }}">
                        <span class="req-dot {{ app.user.emailVerified ? 'ok' : 'pending' }}"></span>
                        Vérifiez votre adresse email
                    </li>
                    <li class="req-item ok">
                        <span class="req-dot ok"></span>
                        Utilisez un mot de passe fort (8+ caractères)
                    </li>
                    <li class="req-item ok">
                        <span class="req-dot ok"></span>
                        Ne partagez jamais votre mot de passe
                    </li>
                    <li class="req-item ok">
                        <span class="req-dot ok"></span>
                        Vérifiez régulièrement l'activité du compte
                    </li>
                </ul>

                {% set secScore = 0 %}
                {% if app.user.twoFactorEnabled %}{% set secScore = secScore + 40 %}{% endif %}
                {% if app.user.emailVerified %}{% set secScore = secScore + 30 %}{% endif %}
                {% if app.user.isActive %}{% set secScore = secScore + 30 %}{% endif %}

                <div class="mt-3 pt-3 border-top">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="fw-medium" style="font-size:.8rem;">Score de sécurité</span>
                        <span class="fw-bold {{ secScore >= 70 ? 'text-success' : (secScore >= 40 ? 'text-warning' : 'text-danger') }}"
                              style="font-size:.8rem;">{{ secScore }}%</span>
                    </div>
                    <div class="progress" style="height:6px; border-radius:3px;">
                        <div class="progress-bar {{ secScore >= 70 ? 'bg-success' : (secScore >= 40 ? 'bg-warning' : 'bg-danger') }}"
                             role="progressbar"
                             style="width:{{ secScore }}%; transition:width .5s;"
                             aria-valuenow="{{ secScore }}" aria-valuemin="0" aria-valuemax="100">
                        </div>
                    </div>
                    <p class="text-muted mt-1 mb-0" style="font-size:.75rem;">
                        {% if secScore >= 70 %}Votre compte est bien protégé.
                        {% elseif secScore >= 40 %}Activez la 2FA pour renforcer la sécurité.
                        {% else %}Vérifiez votre email et activez la 2FA.{% endif %}
                    </p>
                </div>
            </div>
        </div>

        {# ── Backup codes (Feature 7) ── #}
        {% if app.user.twoFactorEnabled %}
        <div class="sec-card">
            <div class="sec-card-header">
                <div class="sec-icon bg-success bg-opacity-10">
                    <svg fill="none" stroke="#198754" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"/>
                    </svg>
                </div>
                <div class="flex-fill">
                    <span class="fw-semibold d-block" style="font-size:.9rem;">Codes de secours</span>
                    <span class="text-muted" style="font-size:.75rem;">Alternative si vous n'avez pas accès à votre email</span>
                </div>
                <span class="badge {{ backupCodesRemaining > 2 ? 'bg-success-subtle text-success' : (backupCodesRemaining > 0 ? 'bg-warning-subtle text-warning' : 'bg-danger-subtle text-danger') }}" style="font-size:.7rem;">
                    {{ backupCodesRemaining }} restant(s)
                </span>
            </div>
            <div class="sec-card-body">
                <p class="text-muted mb-3" style="font-size:.8125rem;">
                    Les codes de secours vous permettent de vous connecter si vous n'avez pas accès à votre email pour la 2FA.
                </p>
                <a href="{{ path('app_profile_backup_codes') }}"
                   class="btn btn-outline-success btn-sm w-100 d-flex align-items-center justify-content-center gap-2">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                    </svg>
                    Voir les codes de secours
                </a>
            </div>
        </div>
        {% endif %}

        {# ── Face Recognition ── #}
        {{ include('components/face_recognition_widget.html.twig', {
            widget_id: 'security-face-widget',
            csrf_key: 'face_enroll',
            enroll_endpoint: path('app_profile_face_enroll'),
            remove_endpoint: path('app_profile_face_remove'),
            status_endpoint: path('app_profile_face_status'),
            mode_status: faceStatus.enrolled ? 'active' : 'inactive',
            mode_status_text: faceStatus.enrolled ? 'Activée' : 'Non activée'
        }) }}

        {# ── Quick actions ── #}
        <div class="sec-card">
            <div class="sec-card-header">
                <div class="sec-icon bg-secondary bg-opacity-10">
                    <svg fill="none" stroke="#6c757d" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M13 10V3L4 14h7v7l9-11h-7z"/>
                    </svg>
                </div>
                <span class="fw-semibold" style="font-size:.9rem;">Actions rapides</span>
            </div>
            <div class="sec-card-body">
                <div class="d-grid gap-2">
                    <a href="{{ path('app_profile_change_password') }}"
                       class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2 text-start">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                        Changer le mot de passe
                    </a>
                    <a href="{{ path('app_profile_login_history') }}"
                       class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2 text-start">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Historique de connexion
                    </a>
                    <form method="post" action="{{ path('app_profile_revoke_all_sessions') }}" class="d-grid">
                        <input type="hidden" name="_token" value="{{ csrf_token('revoke_all_sessions') }}">
                        <button type="submit"
                                class="btn btn-outline-danger btn-sm d-flex align-items-center gap-2 text-start"
                                onclick="return confirm('Déconnecter tous les appareils ? Vous devrez vous reconnecter partout.')">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                            </svg>
                            Déconnecter tous les appareils
                        </button>
                    </form>
                    <a href="{{ path('app_profile_edit') }}"
                       class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2 text-start">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                        </svg>
                        Modifier le profil
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>

<script src="{{ asset('js/face-api.min.js') }}"></script>
<script src="{{ asset('js/face-recognition.js') }}"></script>
<script>
function confirmToggle2fa(checkbox) {
    const enabling = checkbox.checked;
    const msg = enabling
        ? 'Activer la double authentification ? Un code sera requis à chaque connexion.'
        : 'Désactiver la 2FA ? Votre compte sera moins sécurisé.';

    if (!confirm(msg)) {
        checkbox.checked = !checkbox.checked;
        return;
    }
    document.getElementById('toggle2faForm').submit();
}
</script>
{% endblock %}
