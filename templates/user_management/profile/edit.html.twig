{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Modifier mon profil - AgriLink{% endblock %}

{% block dashboard_content %}
    <div class="mb-4">
        <div class="d-flex align-items-center gap-3">
            <a href="{{ path('app_profile') }}" class="text-secondary">
                <svg class="icon-sm" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="20" height="20">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
            </a>
            <h1 class="h3 fw-bold mb-0">Modifier mon profil</h1>
        </div>
    </div>

    <div style="max-width: 900px;">
        {# Photo de profil - Separate form #}
        {% embed 'components/_card.html.twig' %}
            {% block card_title %}
                <div class="d-flex align-items-center justify-content-between">
                    <span>Photo de profil</span>
                    {% if app.user.photoProfil %}
                        <a href="{{ path('app_profile_delete_photo') }}" 
                           class="text-danger small fw-medium d-inline-flex align-items-center text-decoration-none"
                           onclick="return confirm('Êtes-vous sûr de vouloir supprimer votre photo de profil ?')">
                            <svg class="icon-sm me-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                            </svg>
                            Supprimer
                        </a>
                    {% endif %}
                </div>
            {% endblock %}
            {% block card_content %}
                <form method="post" action="{{ path('app_profile_edit') }}" enctype="multipart/form-data" novalidate>
                    <input type="hidden" name="_token" value="{{ csrf_token('profile_photo_upload') }}">
                    
                    <div class="vstack gap-4">
                        {# Current Photo Display with Enhanced Preview #}
                        <div class="row g-3 align-items-center">
                            <div class="col-auto">
                                <div id="currentAvatar">
                                    {{ include('components/_avatar.html.twig', {user: app.user, size: 'large'}) }}
                                </div>
                            </div>
                            <div class="col">
                                <h6 class="small fw-semibold mb-1">Photo actuelle</h6>
                                {% if app.user.photoProfil %}
                                    <p class="small text-muted mb-2">
                                        <svg class="icon-sm text-success me-1" fill="currentColor" viewBox="0 0 20 20" width="16" height="16">
                                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                        </svg>
                                        Photo de profil active
                                    </p>
                                    <p class="small text-muted mb-0" style="font-size: 0.75rem;">Téléchargez une nouvelle photo pour la remplacer</p>
                                {% else %}
                                    <p class="small text-muted mb-2">
                                        <svg class="icon-sm text-secondary me-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                        </svg>
                                        Aucune photo de profil
                                    </p>
                                    <p class="small text-muted mb-0" style="font-size: 0.75rem;">Ajoutez une photo pour personnaliser votre profil</p>
                                {% endif %}
                            </div>
                        </div>

                        {# Enhanced File Upload Zone #}
                        <div>
                            {{ form_label(form.profilePhoto, 'Nouvelle photo de profil') }}
                            
                            {# Direct file input with Bootstrap styling #}
                            <div class="mt-2">
                                {{ form_widget(form.profilePhoto, {
                                    'attr': {
                                        'class': 'form-control',
                                        'id': 'profilePhotoInput'
                                    }
                                }) }}
                            </div>
                            
                            <div class="mt-2 d-flex align-items-start">
                                <svg class="flex-shrink-0 text-info me-2 mt-1" fill="currentColor" viewBox="0 0 20 20" width="16" height="16">
                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                                </svg>
                                <p class="small text-muted mb-0">{{ form_help(form.profilePhoto) }}</p>
                            </div>
                            {{ form_errors(form.profilePhoto) }}
                        </div>

                        {# Save Photo Button #}
                        <div class="d-flex justify-content-end pt-3 border-top">
                            <button type="submit" name="photo_only" value="1" class="btn btn-primary">
                                <svg class="icon-sm me-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                                Enregistrer la photo
                            </button>
                        </div>
                    </div>
                </form>
            {% endblock %}
        {% endembed %}

        {# Main profile form #}
        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

        {# Informations personnelles #}
        {% embed 'components/_card.html.twig' with {classes: 'mt-3'} %}
            {% block card_title %}Informations personnelles{% endblock %}
            {% block card_content %}
                <div class="vstack gap-4">
                    <div>
                        {{ form_label(form.nom) }}
                        {{ form_widget(form.nom) }}
                        {{ form_errors(form.nom) }}
                    </div>

                    <div>
                        <label class="form-label">Adresse email</label>
                        <div class="d-flex align-items-center gap-2">
                            <input type="text" 
                                   value="{{ app.user.email }}" 
                                   disabled 
                                   class="form-control bg-light text-muted">
                            {% if app.user.emailVerified %}
                                <span class="badge bg-success-subtle text-success d-inline-flex align-items-center flex-shrink-0">
                                    <svg class="icon-xs me-1" fill="currentColor" viewBox="0 0 20 20" width="12" height="12">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                    </svg>
                                    Vérifié
                                </span>
                            {% endif %}
                        </div>
                        <p class="form-text small">
                            L'email ne peut pas être modifié ici. Contactez le support pour changer votre email.
                        </p>
                    </div>

                    <div>
                        {{ form_label(form.telephone) }}
                        {{ form_widget(form.telephone) }}
                        {{ form_errors(form.telephone) }}
                    </div>

                    <div>
                        {{ form_label(form.dateNaissance) }}
                        {{ form_widget(form.dateNaissance) }}
                        {{ form_errors(form.dateNaissance) }}
                    </div>
                </div>
            {% endblock %}
        {% endembed %}

        {# Localisation #}
        {% embed 'components/_card.html.twig' with {classes: 'mt-6'} %}
            {% block card_title %}Localisation{% endblock %}
            {% block card_content %}
                <div class="space-y-6">
                    <div>
                        {{ form_label(form.gouvernant) }}
                        {{ form_widget(form.gouvernant) }}
                        {{ form_errors(form.gouvernant) }}
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            {{ form_label(form.ville) }}
                            {{ form_widget(form.ville) }}
                            {{ form_errors(form.ville) }}
                        </div>

                        <div>
                            {{ form_label(form.codePostale) }}
                            {{ form_widget(form.codePostale) }}
                            {{ form_errors(form.codePostale) }}
                        </div>
                    </div>
                </div>
            {% endblock %}
        {% endembed %}

        {# Informations spécifiques Agriculteur #}
        {% if form.agriculteurExpAnnee is defined %}
        {% embed 'components/_card.html.twig' with {classes: 'mt-6'} %}
            {% block card_title %}
                <span class="flex items-center">
                    <svg class="h-5 w-5 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    Informations agriculteur
                </span>
            {% endblock %}
            {% block card_content %}
                <div class="space-y-6">
                    <div>
                        {{ form_label(form.agriculteurExpAnnee) }}
                        {{ form_widget(form.agriculteurExpAnnee) }}
                        {{ form_errors(form.agriculteurExpAnnee) }}
                        <p class="mt-1 text-xs text-gray-500">Indiquez le nombre d'années d'expérience en agriculture</p>
                    </div>
                </div>
            {% endblock %}
        {% endembed %}
        {% endif %}

        {# Informations spécifiques AgriPlus (lecture seule) #}
        {% if app.user.isAgriPlus %}
        {% embed 'components/_card.html.twig' with {classes: 'mt-6'} %}
            {% block card_title %}
                <span class="flex items-center">
                    <svg class="h-5 w-5 mr-2 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                    Abonnement AgriPlus
                </span>
            {% endblock %}
            {% block card_content %}
                <div class="bg-yellow-50 border border-yellow-200 rounded-md p-4">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                            </svg>
                        </div>
                        <div class="ml-3">
                            <h3 class="text-sm font-medium text-yellow-800">Informations d'abonnement</h3>
                            <div class="mt-2 text-sm text-yellow-700">
                                <p>Ces informations ne peuvent être modifiées que depuis la page de gestion de votre abonnement.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <dl class="mt-4 divide-y divide-gray-200">
                    <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4">
                        <dt class="text-sm font-medium text-gray-500">Plan actuel</dt>
                        <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                            {% set planLabels = {
                                'BASIC': 'Basic',
                                'PREMIUM': 'Premium',
                                'ENTERPRISE': 'Enterprise'
                            } %}
                            {{ planLabels[app.user.agriplusAbonnement] ?? app.user.agriplusAbonnement ?? 'Non défini' }}
                        </dd>
                    </div>
                    <div class="py-4 sm:grid sm:grid-cols-3 sm:gap-4">
                        <dt class="text-sm font-medium text-gray-500">Expiration</dt>
                        <dd class="mt-1 text-sm sm:mt-0 sm:col-span-2">
                            {% if app.user.agriplusDateExpiration %}
                                {% if app.user.hasValidAgriplusSubscription %}
                                    <span class="text-green-600">{{ app.user.agriplusDateExpiration|date('d/m/Y') }}</span>
                                {% else %}
                                    <span class="text-red-600">{{ app.user.agriplusDateExpiration|date('d/m/Y') }} (Expiré)</span>
                                {% endif %}
                            {% else %}
                                <span class="text-gray-400">Non définie</span>
                            {% endif %}
                        </dd>
                    </div>
                </dl>
            {% endblock %}
        {% endembed %}
        {% endif %}

        {# Informations spécifiques Fournisseur #}
        {% if app.user.isFournisseur %}
        {% embed 'components/_card.html.twig' with {classes: 'mt-6'} %}
            {% block card_title %}
                <span class="flex items-center">
                    <svg class="h-5 w-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                    Informations fournisseur
                </span>
            {% endblock %}
            {% block card_content %}
                {# Affichage en lecture seule des informations non modifiables #}
                <div class="mb-6 bg-gray-50 border border-gray-200 rounded-md p-4">
                    <p class="text-sm text-gray-600 mb-3">
                        <svg class="inline h-4 w-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                        </svg>
                        Les informations suivantes ne peuvent pas être modifiées :
                    </p>
                    <dl class="divide-y divide-gray-200">
                        <div class="py-2 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Type de fournisseur</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {% if app.user.fournisseurTypeFournisseur == 'PERSONNE' %}
                                    Personne physique
                                {% elseif app.user.fournisseurTypeFournisseur == 'SOCIETE' %}
                                    Société
                                {% else %}
                                    Non renseigné
                                {% endif %}
                            </dd>
                        </div>

                        {% if app.user.fournisseurTypeFournisseur == 'PERSONNE' %}
                        <div class="py-2 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">CIN</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.fournisseurCin ?: 'Non renseigné' }}
                            </dd>
                        </div>
                        {% endif %}

                        {% if app.user.fournisseurTypeFournisseur == 'SOCIETE' %}
                        <div class="py-2 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Raison sociale</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.fournisseurRaisonSocial ?: 'Non renseigné' }}
                            </dd>
                        </div>
                        <div class="py-2 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">N° Registre de commerce</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.fournisseurNumRegistre ?: 'Non renseigné' }}
                            </dd>
                        </div>
                        <div class="py-2 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Forme juridique</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.fournisseurFormeJuridique ?: 'Non renseigné' }}
                            </dd>
                        </div>
                        <div class="py-2 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Capital social</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {% if app.user.fournisseurCapital %}
                                    {{ app.user.fournisseurCapital|number_format(2, ',', ' ') }} TND
                                {% else %}
                                    Non renseigné
                                {% endif %}
                            </dd>
                        </div>
                        {% endif %}
                    </dl>
                </div>

                {# Champ modifiable : Certifications #}
                {% if form.fournisseurCertifications is defined %}
                <div class="space-y-6">
                    <div>
                        {{ form_label(form.fournisseurCertifications) }}
                        {{ form_widget(form.fournisseurCertifications) }}
                        {{ form_errors(form.fournisseurCertifications) }}
                        <p class="mt-1 text-xs text-gray-500">Listez vos certifications (Bio, ISO 9001, etc.)</p>
                    </div>
                </div>
                {% endif %}
            {% endblock %}
        {% endembed %}
        {% endif %}

        {# Boutons d'action #}
        <div class="mt-6 flex items-center justify-end space-x-3 pb-6">
            <a href="{{ path('app_profile') }}" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                Annuler
            </a>
            <button type="submit" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                Enregistrer les modifications
            </button>
        </div>
        
        {{ form_end(form) }}
    </div>
{% endblock %}
