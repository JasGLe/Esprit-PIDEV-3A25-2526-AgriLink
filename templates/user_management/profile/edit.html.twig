{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Modifier mon profil - AgriLink{% endblock %}

{% block dashboard_content %}
<style>
    .profile-edit-card {
        border: 1px solid #e9ecef;
        border-radius: 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
        background: #fff;
        overflow: hidden;
        margin-bottom: 1.25rem;
    }
    .profile-edit-card .card-header-section {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #f0f4f0;
        background: #fafffe;
        display: flex;
        align-items: center;
        gap: .75rem;
    }
    .profile-edit-card .card-header-section .section-icon {
        width: 2rem; height: 2rem;
        border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .profile-edit-card .card-body-section {
        padding: 1.5rem;
        position: relative;
    }
    .form-label {
        font-size: .8125rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: .35rem;
    }
    .form-control, .form-select {
        border-color: #dee2e6;
        border-radius: 8px;
        font-size: .875rem;
        padding: .5rem .875rem;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .form-control:focus, .form-select:focus {
        border-color: #198754;
        box-shadow: 0 0 0 3px rgba(25,135,84,.12);
    }
    .form-control.is-invalid:focus {
        box-shadow: 0 0 0 3px rgba(220,53,69,.12);
    }
    .avatar-upload-zone {
        border: 2px dashed #dee2e6;
        border-radius: 12px;
        padding: 1.5rem;
        text-align: center;
        cursor: pointer;
        transition: all .2s ease;
        position: relative;
        z-index: 10;
        user-select: none;
        display: block;
    }
    .avatar-upload-zone:hover {
        border-color: #198754;
        background: #f0fff4;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(25, 135, 84, 0.15);
    }
    .avatar-upload-zone:active {
        transform: translateY(0);
        box-shadow: 0 2px 6px rgba(25, 135, 84, 0.12);
    }
    .avatar-large {
        width: 90px; height: 90px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #e9ecef;
    }
    .avatar-initials-large {
        width: 90px; height: 90px;
        border-radius: 50%;
        background: linear-gradient(135deg, #198754, #20c997);
        color: #fff;
        font-size: 2rem;
        font-weight: 700;
        display: flex; align-items: center; justify-content: center;
    }
    .readonly-field {
        background: #f8f9fa;
        border-color: #e9ecef;
        color: #6c757d;
    }
    .info-row {
        display: flex; justify-content: space-between; align-items: center;
        padding: .625rem 0;
        border-bottom: 1px solid #f0f0f0;
        font-size: .8125rem;
    }
    .info-row:last-child { border-bottom: none; }
    .info-row dt { color: #6c757d; font-weight: 500; flex: 0 0 45%; }
    .info-row dd { text-align: right; font-weight: 500; color: #212529; margin: 0; }
    .completion-bar { height: 6px; border-radius: 3px; background: #e9ecef; overflow: hidden; }
    .completion-bar-fill { height: 100%; border-radius: 3px; background: linear-gradient(90deg, #198754, #20c997); transition: width .4s; }
    .save-bar {
        position: sticky; bottom: 0; z-index: 100;
        background: rgba(255,255,255,.95);
        backdrop-filter: blur(8px);
        border-top: 1px solid #e9ecef;
        padding: .875rem 1.5rem;
        margin: 0 -1rem;
        display: flex; align-items: center; justify-content: flex-end; gap: .75rem;
    }
</style>

{# Page header #}
<div class="d-flex align-items-center gap-3 mb-4">
    <a href="{{ path('app_profile') }}"
       class="btn btn-light border rounded-circle p-0 d-flex align-items-center justify-content-center flex-shrink-0"
       style="width:2.25rem;height:2.25rem;" title="Retour au profil">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
    </a>
    <div>
        <h1 class="h4 fw-bold mb-0">Modifier mon profil</h1>
        <p class="text-muted mb-0" style="font-size:.8rem;">
            <a href="{{ path('app_profile') }}" class="text-decoration-none text-muted">Profil</a>
            &rsaquo; Modifier
        </p>
    </div>
</div>

<div class="row g-4" style="max-width:980px;">

    {# ── Left column: avatar + account status ── #}
    <div class="col-lg-4">

        {# Avatar card #}
        <div class="profile-edit-card">
            <div class="card-header-section">
                <div class="section-icon bg-success bg-opacity-10">
                    <svg fill="none" stroke="#198754" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                </div>
                <span class="fw-semibold" style="font-size:.9rem;">Photo de profil</span>
            </div>
            <div class="card-body-section">
                {# Current avatar preview #}
                <div class="text-center mb-3">
                    <div id="avatarPreviewWrap" class="d-inline-block">
                        {{ include('components/_avatar.html.twig', {user: app.user, size: 'large'}) }}
                    </div>
                    <div class="mt-2">
                        <span class="fw-semibold d-block" style="font-size:.875rem;">{{ app.user.displayName }}</span>
                        <span id="photoStatusBadge">
                            {% if app.user.photoProfil %}
                                <span class="badge bg-success-subtle text-success mt-1" style="font-size:.7rem;">
                                    <svg fill="currentColor" viewBox="0 0 20 20" width="10" height="10">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                    </svg>
                                    Photo active
                                </span>
                            {% else %}
                                <span class="badge bg-secondary-subtle text-secondary mt-1" style="font-size:.7rem;">Aucune photo</span>
                            {% endif %}
                        </span>
                    </div>
                </div>

                {# Photo upload form #}
                <form method="post" action="{{ path('app_profile_edit') }}" enctype="multipart/form-data" id="photoUploadForm">
                    <input type="hidden" name="_token" value="{{ csrf_token('profile_photo_upload') }}">
                    <input type="hidden" name="photo_only" value="1">

                    {# Upload zone #}
                    <div class="avatar-upload-zone mb-2" id="uploadZone" role="button" tabindex="0" aria-label="Choisir une photo de profil">
                        <svg fill="none" stroke="#6c757d" viewBox="0 0 24 24" width="28" height="28" class="mb-2" id="uploadIcon">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                  d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
                        </svg>
                        <p class="mb-0 fw-medium" id="uploadZoneText" style="font-size:.8125rem; color:#495057;">
                            <span style="text-decoration:underline;">Cliquez ici</span> pour choisir une photo
                        </p>
                        <p class="mb-0 text-muted" style="font-size:.75rem;">PNG, JPG, WEBP · Max 2 Mo</p>
                    </div>
                    <input type="file" name="profile_edit_form[profilePhoto]" id="profilePhotoInput" class="d-none" accept="image/jpeg,image/png,image/webp">

                    {# Preview section (hidden until file chosen) #}
                    <div id="previewSection" class="d-none mt-3 p-3 bg-light rounded-2" style="text-align:center;">
                        <p class="text-muted small mb-2">Aperçu de votre nouvelle photo</p>
                        <img id="imagePreview" src="" alt="Aperçu" class="avatar-large mb-2" style="border:3px solid #198754; max-width:100%;">
                        <p id="previewFileName" class="text-muted small mb-0"></p>
                    </div>

                    {# Cancel selection (hidden until file chosen) #}
                    <div id="cancelSelectionWrap" class="d-none mb-2 text-center">
                        <button type="button" id="cancelSelectionBtn" class="btn btn-link btn-sm text-secondary p-0" style="font-size:.75rem;">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="12" height="12" class="me-1">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                            Annuler la sélection
                        </button>
                    </div>

                    <div id="saveButtonWrap" class="d-none d-grid gap-2">
                        <button type="submit" id="savePhotoBtn" class="btn btn-success btn-sm">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14" class="me-1">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                            </svg>
                            Enregistrer la photo
                        </button>
                    </div>
                </form>

                {# Delete photo form — separate, outside the upload form #}
                {% if app.user.photoProfil %}
                <form method="POST" action="{{ path('app_profile_delete_photo') }}" id="deletePhotoForm" class="mt-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('profile_photo_delete') }}">
                    <button type="submit"
                            class="btn btn-outline-danger btn-sm w-100"
                            onclick="return confirm('Êtes-vous sûr de vouloir supprimer votre photo de profil ?')">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14" class="me-1">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                        </svg>
                        Supprimer la photo
                    </button>
                </form>
                {% endif %}
            </div>
        </div>

        {# Account status card #}
        <div class="profile-edit-card">
            <div class="card-header-section">
                <div class="section-icon bg-primary bg-opacity-10">
                    <svg fill="none" stroke="#0d6efd" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                    </svg>
                </div>
                <span class="fw-semibold" style="font-size:.9rem;">Statut du compte</span>
            </div>
            <div class="card-body-section">
                <dl class="mb-0">
                    <div class="info-row">
                        <dt>Compte</dt>
                        <dd>
                            {% if app.user.isActive %}
                                <span class="badge bg-success-subtle text-success">Actif</span>
                            {% else %}
                                <span class="badge bg-danger-subtle text-danger">Inactif</span>
                            {% endif %}
                        </dd>
                    </div>
                    <div class="info-row">
                        <dt>Email vérifié</dt>
                        <dd>
                            {% if app.user.emailVerified %}
                                <span class="badge bg-success-subtle text-success">Vérifié</span>
                            {% else %}
                                <span class="badge bg-warning-subtle text-warning">Non vérifié</span>
                            {% endif %}
                        </dd>
                    </div>
                    <div class="info-row">
                        <dt>Double auth. (2FA)</dt>
                        <dd>
                            {% if app.user.twoFactorEnabled %}
                                <span class="badge bg-success-subtle text-success">Activée</span>
                            {% else %}
                                <span class="badge bg-secondary-subtle text-secondary">Désactivée</span>
                            {% endif %}
                        </dd>
                    </div>
                    <div class="info-row">
                        <dt>Rôle</dt>
                        <dd>{{ include('components/_role_badge.html.twig', {role: app.user.roles|first}) }}</dd>
                    </div>
                </dl>

                <div class="mt-3 pt-3 border-top">
                    <a href="{{ path('app_profile_security') }}"
                       class="d-flex align-items-center text-decoration-none text-primary small fw-medium gap-2">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                        </svg>
                        Paramètres de sécurité
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14" class="ms-auto text-muted">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>
                </div>
            </div>
        </div>

    </div>

    {# ── Right column: profile form ── #}
    <div class="col-lg-8">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'id': 'profileMainForm'}}) }}

        {# ── Personal information ── #}
        <div class="profile-edit-card">
            <div class="card-header-section">
                <div class="section-icon bg-success bg-opacity-10">
                    <svg fill="none" stroke="#198754" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                </div>
                <div>
                    <span class="fw-semibold d-block" style="font-size:.9rem;">Informations personnelles</span>
                    <span class="text-muted" style="font-size:.75rem;">Nom, contact, date de naissance</span>
                </div>
            </div>
            <div class="card-body-section">
                <div class="row g-3">
                    <div class="col-12">
                        {{ form_label(form.nom) }}
                        {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Votre nom complet'}}) }}
                        {{ form_errors(form.nom) }}
                    </div>

                    <div class="col-12">
                        <label class="form-label">Adresse email</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0">
                                <svg fill="none" stroke="#6c757d" viewBox="0 0 24 24" width="16" height="16">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                            </span>
                            <input type="text" value="{{ app.user.email }}" disabled
                                   class="form-control readonly-field border-start-0"
                                   style="border-radius:0 8px 8px 0;">
                            {% if app.user.emailVerified %}
                                <span class="input-group-text bg-success-subtle text-success border-0">
                                    <svg fill="currentColor" viewBox="0 0 20 20" width="14" height="14">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                    </svg>
                                </span>
                            {% endif %}
                        </div>
                        {% if app.user.pendingEmail %}
                            <div class="alert alert-info d-flex gap-2 align-items-start py-2 px-3 mt-2 mb-0" style="font-size:.8rem; border-radius:8px; border:none;">
                                <svg fill="currentColor" viewBox="0 0 20 20" width="14" height="14" class="flex-shrink-0 mt-1">
                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                                </svg>
                                <div>
                                    Changement d'email en attente vers <strong>{{ app.user.pendingEmail }}</strong>.
                                    <a href="{{ path('app_verify_email', {'from': 'profile'}) }}" class="fw-semibold text-decoration-none">Vérifier maintenant</a>
                                </div>
                            </div>
                        {% else %}
                            <div class="form-text">L'email ne peut pas être modifié ici. Contactez le support.</div>
                        {% endif %}
                    </div>

                    <div class="col-sm-6">
                        {{ form_label(form.telephone) }}
                        <div class="input-group">
                            <span class="input-group-text bg-light">
                                <svg fill="none" stroke="#6c757d" viewBox="0 0 24 24" width="16" height="16">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                </svg>
                            </span>
                            {{ form_widget(form.telephone, {'attr': {'class': 'form-control', 'placeholder': '+216 XX XXX XXX', 'style': 'border-radius:0 8px 8px 0;'}}) }}
                        </div>
                        {{ form_errors(form.telephone) }}
                    </div>

                    <div class="col-sm-6">
                        {{ form_label(form.dateNaissance) }}
                        {{ form_widget(form.dateNaissance, {'attr': {'class': 'form-control'}}) }}
                        {{ form_errors(form.dateNaissance) }}
                    </div>
                </div>
            </div>
        </div>

        {# ── Location ── #}
        <div class="profile-edit-card">
            <div class="card-header-section">
                <div class="section-icon bg-info bg-opacity-10">
                    <svg fill="none" stroke="#0dcaf0" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                </div>
                <div>
                    <span class="fw-semibold d-block" style="font-size:.9rem;">Localisation</span>
                    <span class="text-muted" style="font-size:.75rem;">Gouvernorat, ville, code postal</span>
                </div>
            </div>
            <div class="card-body-section">
                <div class="row g-3">
                    <div class="col-12">
                        {{ form_label(form.gouvernant) }}
                        {{ form_widget(form.gouvernant, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.gouvernant) }}
                    </div>
                    <div class="col-sm-8">
                        {{ form_label(form.ville) }}
                        {{ form_widget(form.ville, {'attr': {'class': 'form-control', 'placeholder': 'Votre ville'}}) }}
                        {{ form_errors(form.ville) }}
                    </div>
                    <div class="col-sm-4">
                        {{ form_label(form.codePostale) }}
                        {{ form_widget(form.codePostale, {'attr': {'class': 'form-control', 'placeholder': '1000'}}) }}
                        {{ form_errors(form.codePostale) }}
                    </div>
                </div>
            </div>
        </div>

        {# ── Agriculteur-specific ── #}
        {% if form.agriculteurExpAnnee is defined %}
        <div class="profile-edit-card">
            <div class="card-header-section">
                <div class="section-icon bg-success bg-opacity-10">
                    <svg fill="none" stroke="#198754" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <div>
                    <span class="fw-semibold d-block" style="font-size:.9rem;">Profil agriculteur</span>
                    <span class="text-muted" style="font-size:.75rem;">Expérience en agriculture</span>
                </div>
            </div>
            <div class="card-body-section">
                <div class="row g-3">
                    <div class="col-sm-6">
                        {{ form_label(form.agriculteurExpAnnee) }}
                        <div class="input-group">
                            {{ form_widget(form.agriculteurExpAnnee, {'attr': {'class': 'form-control', 'min': 0, 'max': 60, 'style': 'border-radius:8px 0 0 8px;'}}) }}
                            <span class="input-group-text bg-light text-muted" style="font-size:.8125rem;">ans</span>
                        </div>
                        {{ form_errors(form.agriculteurExpAnnee) }}
                        <div class="form-text">Entre 0 et 60 années d'expérience</div>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}

        {# ── AgriPlus subscription (read-only) ── #}
        {% if app.user.isAgriPlus %}
        <div class="profile-edit-card">
            <div class="card-header-section">
                <div class="section-icon bg-warning bg-opacity-10">
                    <svg fill="currentColor" stroke="none" viewBox="0 0 20 20" width="18" height="18" style="color:#fd7e14;">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                </div>
                <div>
                    <span class="fw-semibold d-block" style="font-size:.9rem;">Abonnement AgriPlus</span>
                    <span class="text-muted" style="font-size:.75rem;">Informations en lecture seule</span>
                </div>
            </div>
            <div class="card-body-section">
                <div class="alert alert-warning d-flex gap-2 align-items-start py-2 px-3" style="font-size:.8125rem; border-radius:8px;">
                    <svg fill="currentColor" viewBox="0 0 20 20" width="16" height="16" class="flex-shrink-0 mt-1">
                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                    </svg>
                    Ces informations sont gérées depuis votre espace abonnement.
                </div>
                <dl class="mb-0">
                    {% set planLabels = {'BASIC': 'Basic', 'PREMIUM': 'Premium', 'ENTERPRISE': 'Enterprise'} %}
                    {% set planColors = {'BASIC': 'bg-primary-subtle text-primary', 'PREMIUM': 'bg-secondary-subtle text-secondary', 'ENTERPRISE': 'bg-warning-subtle text-warning'} %}
                    <div class="info-row">
                        <dt>Plan actuel</dt>
                        <dd>
                            <span class="badge {{ planColors[app.user.agriplusAbonnement] ?? 'bg-secondary-subtle text-secondary' }}">
                                {{ planLabels[app.user.agriplusAbonnement] ?? app.user.agriplusAbonnement ?? 'Non défini' }}
                            </span>
                        </dd>
                    </div>
                    <div class="info-row">
                        <dt>Expiration</dt>
                        <dd>
                            {% if app.user.agriplusDateExpiration %}
                                {% if app.user.hasValidAgriplusSubscription %}
                                    <span class="text-success fw-medium">{{ app.user.agriplusDateExpiration|date('d/m/Y') }}</span>
                                {% else %}
                                    <span class="text-danger fw-medium">{{ app.user.agriplusDateExpiration|date('d/m/Y') }} (Expiré)</span>
                                {% endif %}
                            {% else %}
                                <span class="text-muted">Non définie</span>
                            {% endif %}
                        </dd>
                    </div>
                </dl>
            </div>
        </div>
        {% endif %}

        {# ── Fournisseur-specific ── #}
        {% if app.user.isFournisseur %}
        <div class="profile-edit-card">
            <div class="card-header-section">
                <div class="section-icon bg-primary bg-opacity-10">
                    <svg fill="none" stroke="#0d6efd" viewBox="0 0 24 24" width="18" height="18">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                    </svg>
                </div>
                <div>
                    <span class="fw-semibold d-block" style="font-size:.9rem;">Informations fournisseur</span>
                    <span class="text-muted" style="font-size:.75rem;">Données d'identification</span>
                </div>
            </div>
            <div class="card-body-section">
                {# Read-only identity fields #}
                <div class="p-3 mb-3 rounded-3" style="background:#f8f9fa; border:1px solid #e9ecef;">
                    <div class="d-flex gap-2 align-items-center mb-2">
                        <svg fill="currentColor" viewBox="0 0 20 20" width="14" height="14" class="text-secondary">
                            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
                        </svg>
                        <span class="text-muted fw-medium" style="font-size:.75rem; text-transform:uppercase; letter-spacing:.04em;">Informations non modifiables</span>
                    </div>
                    <dl class="mb-0">
                        <div class="info-row">
                            <dt>Type de fournisseur</dt>
                            <dd>
                                {% if app.user.fournisseurTypeFournisseur == 'PERSONNE' %}
                                    <span class="badge bg-info-subtle text-info">Personne physique</span>
                                {% elseif app.user.fournisseurTypeFournisseur == 'SOCIETE' %}
                                    <span class="badge bg-primary-subtle text-primary">Société</span>
                                {% else %}
                                    <span class="text-muted">Non renseigné</span>
                                {% endif %}
                            </dd>
                        </div>
                        {% if app.user.fournisseurTypeFournisseur == 'PERSONNE' %}
                            <div class="info-row">
                                <dt>CIN</dt>
                                <dd class="font-monospace">{{ app.user.fournisseurCin ?: '—' }}</dd>
                            </div>
                        {% endif %}
                        {% if app.user.fournisseurTypeFournisseur == 'SOCIETE' %}
                            <div class="info-row">
                                <dt>Raison sociale</dt>
                                <dd>{{ app.user.fournisseurRaisonSocial ?: '—' }}</dd>
                            </div>
                            <div class="info-row">
                                <dt>N° Registre de commerce</dt>
                                <dd class="font-monospace">{{ app.user.fournisseurNumRegistre ?: '—' }}</dd>
                            </div>
                            <div class="info-row">
                                <dt>Forme juridique</dt>
                                <dd>{{ app.user.fournisseurFormeJuridique ?: '—' }}</dd>
                            </div>
                            <div class="info-row">
                                <dt>Capital social</dt>
                                <dd>
                                    {% if app.user.fournisseurCapital %}
                                        {{ app.user.fournisseurCapital|number_format(2, ',', ' ') }} TND
                                    {% else %}—{% endif %}
                                </dd>
                            </div>
                        {% endif %}
                    </dl>
                </div>

                {# Editable: certifications #}
                {% if form.fournisseurCertifications is defined %}
                <div>
                    {{ form_label(form.fournisseurCertifications) }}
                    {{ form_widget(form.fournisseurCertifications, {
                        'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Ex : ISO 9001, Agriculture Bio, BRC Food...'}
                    }) }}
                    {{ form_errors(form.fournisseurCertifications) }}
                    <div class="form-text">Listez vos certifications (une par ligne ou séparées par des virgules)</div>
                </div>
                {% endif %}
            </div>
        </div>
        {% endif %}

        {# ── Sticky save bar ── #}
        <div class="save-bar">
            <a href="{{ path('app_profile') }}" class="btn btn-light border px-4">Annuler</a>
            <button type="submit" class="btn btn-success px-4 d-flex align-items-center gap-2">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                Enregistrer les modifications
            </button>
        </div>

        {# Mark profilePhoto as rendered to prevent form_end from rendering it #}
        {{ form_widget(form.profilePhoto, {'attr': {'class': 'd-none', 'disabled': 'disabled'}}) }}
        
        {{ form_end(form) }}
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const photoInput         = document.getElementById('profilePhotoInput');
    const uploadZone         = document.getElementById('uploadZone');
    const savePhotoBtn       = document.getElementById('savePhotoBtn');
    const cancelSelectionBtn = document.getElementById('cancelSelectionBtn');
    const previewSection     = document.getElementById('previewSection');
    const cancelSelectionWrap = document.getElementById('cancelSelectionWrap');
    const saveButtonWrap     = document.getElementById('saveButtonWrap');
    const uploadZoneText     = document.getElementById('uploadZoneText');
    const imagePreview       = document.getElementById('imagePreview');
    const previewFileName    = document.getElementById('previewFileName');

    if (!photoInput || !uploadZone) return;

    // Click on upload zone opens file picker
    uploadZone.addEventListener('click', function () {
        photoInput.click();
    });
    uploadZone.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { 
            e.preventDefault(); 
            photoInput.click(); 
        }
    });

    function applyFileSelection(file) {
        const reader = new FileReader();
        reader.onload = function (e) {
            if (imagePreview) {
                imagePreview.src = e.target.result;
            }
            if (previewFileName) {
                previewFileName.textContent = file.name.replace(/</g, '&lt;');
            }
        };
        reader.readAsDataURL(file);

        // Update upload zone text
        if (uploadZoneText) {
            uploadZoneText.innerHTML = '<strong style="color:#198754;">' +
                file.name.replace(/</g, '&lt;') + '</strong>';
        }
        uploadZone.style.borderColor = '#198754';
        uploadZone.style.background  = '#f0fff4';

        // Show preview and buttons
        if (previewSection) previewSection.classList.remove('d-none');
        if (cancelSelectionWrap) cancelSelectionWrap.classList.remove('d-none');
        if (saveButtonWrap) saveButtonWrap.classList.remove('d-none');
    }

    function resetSelection() {
        photoInput.value = '';
        if (imagePreview) imagePreview.src = '';
        if (previewFileName) previewFileName.textContent = '';
        if (uploadZoneText) {
            uploadZoneText.innerHTML = '<span style="text-decoration:underline;">Cliquez ici</span> pour choisir une photo';
        }
        uploadZone.style.borderColor = '';
        uploadZone.style.background  = '';
        
        // Hide preview and buttons
        if (previewSection) previewSection.classList.add('d-none');
        if (cancelSelectionWrap) cancelSelectionWrap.classList.add('d-none');
        if (saveButtonWrap) saveButtonWrap.classList.add('d-none');
    }

    photoInput.addEventListener('change', function () {
        if (this.files && this.files[0]) {
            applyFileSelection(this.files[0]);
        } else {
            resetSelection();
        }
    });

    if (cancelSelectionBtn) {
        cancelSelectionBtn.addEventListener('click', function(e) {
            e.preventDefault();
            resetSelection();
        });
    }

    // Drag-and-drop
    uploadZone.addEventListener('dragover', function (e) {
        e.preventDefault();
        this.style.borderColor = '#198754';
        this.style.background  = '#f0fff4';
    });
    uploadZone.addEventListener('dragleave', function () {
        if (!photoInput.files || !photoInput.files[0]) {
            this.style.borderColor = '';
            this.style.background  = '';
        }
    });
    uploadZone.addEventListener('drop', function (e) {
        e.preventDefault();
        const dt = e.dataTransfer;
        if (dt.files && dt.files[0]) {
            try {
                photoInput.files = dt.files;
                photoInput.dispatchEvent(new Event('change'));
            } catch (_) {
                applyFileSelection(dt.files[0]);
            }
        }
    });
});
</script>
{% endblock %}
