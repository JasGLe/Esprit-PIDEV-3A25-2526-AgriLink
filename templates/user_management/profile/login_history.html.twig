{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Historique de connexion - AgriLink{% endblock %}

{% block dashboard_content %}
<style>
    .history-card {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 12px;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
        overflow: hidden;
    }
    .history-card-header {
        padding: 1rem 1.5rem;
        border-bottom: 1px solid #f0f4f0;
        background: #fafffe;
        display: flex; align-items: center; gap: .75rem;
    }
    .history-row {
        display: flex; align-items: center; gap: 1rem;
        padding: .875rem 1.5rem;
        border-bottom: 1px solid #f5f5f5;
        transition: background .15s;
    }
    .history-row:last-child { border-bottom: none; }
    .history-row:hover { background: #f9fafb; }
    .history-dot {
        width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0;
    }
    .device-icon {
        width: 36px; height: 36px; border-radius: 8px;
        display: flex; align-items: center; justify-content: center; flex-shrink: 0;
    }
</style>

<div class="d-flex align-items-center gap-3 mb-4">
    <a href="{{ path('app_profile_security') }}"
       class="btn btn-light border rounded-circle p-0 d-flex align-items-center justify-content-center flex-shrink-0"
       style="width:2.25rem;height:2.25rem;" title="Retour">
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
    </a>
    <div>
        <h1 class="h4 fw-bold mb-0">Historique de connexion</h1>
        <p class="text-muted mb-0" style="font-size:.8rem;">
            <a href="{{ path('app_profile') }}" class="text-decoration-none text-muted">Profil</a>
            &rsaquo; <a href="{{ path('app_profile_security') }}" class="text-decoration-none text-muted">Sécurité</a>
            &rsaquo; Historique
        </p>
    </div>
</div>

<div style="max-width:800px;">
    <div class="history-card">
        <div class="history-card-header">
            <div class="rounded-2 bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width:2rem;height:2rem;">
                <svg fill="none" stroke="#0d6efd" viewBox="0 0 24 24" width="18" height="18">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div class="flex-fill">
                <span class="fw-semibold d-block" style="font-size:.9rem;">Dernières connexions</span>
                <span class="text-muted" style="font-size:.75rem;">{{ events|length }} événement(s) enregistré(s)</span>
            </div>
        </div>

        {% if events is empty %}
            <div class="text-center py-5 text-muted">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="36" height="36" class="mb-2 opacity-40 d-block mx-auto">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                          d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <p class="mb-0 small fw-medium">Aucun historique de connexion disponible</p>
            </div>
        {% else %}
            {% for event in events %}
                {% set details = event.details ? event.details|json_decode : {} %}
                {% set ip = details.ip_address ?? 'IP inconnue' %}
                {% set ua = details.user_agent ?? '' %}
                {% set type = event.eventType %}

                {# Parse device from user agent #}
                {% if 'Mobile' in ua or 'Android' in ua or 'iPhone' in ua %}
                    {% set deviceType = 'mobile' %}
                    {% set deviceLabel = 'Mobile' %}
                {% elseif 'Tablet' in ua or 'iPad' in ua %}
                    {% set deviceType = 'tablet' %}
                    {% set deviceLabel = 'Tablette' %}
                {% else %}
                    {% set deviceType = 'desktop' %}
                    {% set deviceLabel = 'Ordinateur' %}
                {% endif %}

                {# Parse browser #}
                {% if 'Chrome' in ua and 'Edg' not in ua %}
                    {% set browser = 'Chrome' %}
                {% elseif 'Firefox' in ua %}
                    {% set browser = 'Firefox' %}
                {% elseif 'Safari' in ua and 'Chrome' not in ua %}
                    {% set browser = 'Safari' %}
                {% elseif 'Edg' in ua %}
                    {% set browser = 'Edge' %}
                {% else %}
                    {% set browser = 'Navigateur' %}
                {% endif %}

                {% if type == 'LOGIN_SUCCESS' %}
                    {% set statusColor = '#198754' %}
                    {% set statusBg = '#d1e7dd' %}
                    {% set statusLabel = 'Réussie' %}
                    {% set iconBg = '#d1e7dd' %}
                {% elseif type == 'LOGIN_FAILED' %}
                    {% set statusColor = '#dc3545' %}
                    {% set statusBg = '#f8d7da' %}
                    {% set statusLabel = 'Échouée' %}
                    {% set iconBg = '#f8d7da' %}
                {% elseif type == 'ACCOUNT_LOCKED' %}
                    {% set statusColor = '#856404' %}
                    {% set statusBg = '#fff3cd' %}
                    {% set statusLabel = 'Verrouillé' %}
                    {% set iconBg = '#fff3cd' %}
                {% elseif type == 'OAUTH_LOGIN' %}
                    {% set statusColor = '#0d6efd' %}
                    {% set statusBg = '#cfe2ff' %}
                    {% set statusLabel = 'OAuth' %}
                    {% set iconBg = '#cfe2ff' %}
                {% else %}
                    {% set statusColor = '#6c757d' %}
                    {% set statusBg = '#f0f0f0' %}
                    {% set statusLabel = type %}
                    {% set iconBg = '#f0f0f0' %}
                {% endif %}

                <div class="history-row">
                    <div class="device-icon" style="background:{{ iconBg }};">
                        {% if deviceType == 'mobile' %}
                            <svg fill="none" stroke="{{ statusColor }}" viewBox="0 0 24 24" width="18" height="18">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                            </svg>
                        {% else %}
                            <svg fill="none" stroke="{{ statusColor }}" viewBox="0 0 24 24" width="18" height="18">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                            </svg>
                        {% endif %}
                    </div>

                    <div class="flex-fill">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="fw-semibold" style="font-size:.85rem;">{{ browser }} - {{ deviceLabel }}</span>
                            <span class="badge" style="background:{{ statusBg }};color:{{ statusColor }};font-size:.68rem;font-weight:600;">{{ statusLabel }}</span>
                        </div>
                        <div class="d-flex align-items-center gap-3" style="font-size:.75rem;color:#6c757d;">
                            <span>{{ ip }}</span>
                            <span>{{ event.createdAt ? event.createdAt|date('d/m/Y H:i') : '' }}</span>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
</div>
{% endblock %}
