{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Tableau de bord - AgriLink{% endblock %}
{% block page_title %}Mon espace{% endblock %}

{% block role_specific_navigation %}
    <hr class="my-3 border-secondary">
    <div class="px-3 py-2 small fw-semibold text-muted text-uppercase">
        Explorer
    </div>
    
    <a href="#" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-dark">
        <svg class="me-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        Marketplace
    </a>

    <a href="#" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-dark">
        <svg class="me-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        Communauté
    </a>

    <a href="#" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-dark">
        <svg class="me-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        Ressources
    </a>
{% endblock %}

{% block mobile_sidebar %}
    {{ block('sidebar_navigation') }}
{% endblock %}

{% block dashboard_content %}

{# ── Welcome Banner ── #}
<div class="ag-welcome-banner ag-animate-fade-up mb-4" style="background:linear-gradient(135deg,#374151 0%,#4b5563 60%,#6b7280 100%);">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <p class="mb-1" style="color:rgba(255,255,255,.6);font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">Mon espace</p>
            <h2 class="h4 fw-bold mb-1" style="color:#fff;">Bienvenue sur AgriLink, {{ app.user.displayName }} ! 👋</h2>
            <p class="mb-0" style="color:rgba(255,255,255,.7);font-size:0.85rem;">Découvrez notre plateforme et commencez votre parcours agricole.</p>
        </div>
        <a href="{{ path('app_profile_edit') }}" class="btn btn-sm fw-semibold" style="background:#fff;color:#374151;border-radius:8px;">
            Compléter mon profil →
        </a>
    </div>
</div>

{# ── Profile Completion Widget ── #}
<div class="mb-4 ag-animate-fade-up ag-delay-1">
    {% include 'components/profile_completion_simple.html.twig' %}
</div>

{# ── Quick Stat Cards ── #}
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-lg-4 ag-animate-fade-up ag-delay-1">
        <div class="ag-stat-card">
            <div class="ag-stat-body d-flex align-items-start gap-3">
                <div class="ag-stat-icon" style="background:rgba(107,114,128,.1);">
                    <svg width="22" height="22" fill="none" stroke="#6b7280" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                </div>
                <div>
                    <p class="text-muted small fw-semibold mb-1" style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.04em;">Profil complété</p>
                    <p class="fw-bold mb-0" style="font-size:1.5rem;color:#111827;">--%</p>
                </div>
            </div>
            <div class="ag-stat-footer">
                <a href="{{ path('app_profile_edit') }}" class="small fw-semibold text-decoration-none text-primary">Compléter →</a>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4 ag-animate-fade-up ag-delay-2">
        <div class="ag-stat-card">
            <div class="ag-stat-body d-flex align-items-start gap-3">
                <div class="ag-stat-icon" style="background:rgba(37,99,235,.1);">
                    <svg width="22" height="22" fill="none" stroke="#2563eb" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                </div>
                <div>
                    <p class="text-muted small fw-semibold mb-1" style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.04em;">Activité</p>
                    <p class="fw-bold mb-0" style="font-size:1.5rem;color:#111827;">Nouveau</p>
                </div>
            </div>
            <div class="ag-stat-footer">
                <span class="small text-muted">Membre depuis {{ app.user.createdAt ? app.user.createdAt|date('M Y') : 'récemment' }}</span>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-lg-4 ag-animate-fade-up ag-delay-3">
        <div class="ag-stat-card">
            <div class="ag-stat-body d-flex align-items-start gap-3">
                <div class="ag-stat-icon" style="background:rgba(22,163,74,.1);">
                    <svg width="22" height="22" fill="none" stroke="#16a34a" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
                </div>
                <div>
                    <p class="text-muted small fw-semibold mb-1" style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.04em;">Notifications</p>
                    <p class="fw-bold mb-0" style="font-size:1.5rem;color:#111827;">--</p>
                </div>
            </div>
            <div class="ag-stat-footer">
                <span class="small text-muted">Non lues</span>
            </div>
        </div>
    </div>
</div>

    {# Main content grid #}
    <div class="row g-4">
        {# Getting Started #}
        <div class="col-12 col-lg-6">
        {% embed 'components/_card.html.twig' %}
            {% block card_title %}🚀 Premiers pas sur AgriLink{% endblock %}
            {% block card_content %}
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-start">
                        <div class="flex-shrink-0">
                            <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 32px; height: 32px; background-color: #dcfce7;">
                                <svg class="w-4 h-4 text-success" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                </svg>
                            </div>
                        </div>
                        <div class="ms-3">
                            <p class="small fw-medium text-dark mb-0">Créer votre compte</p>
                            <p class="small text-muted mb-0">Inscription terminée ✓</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start">
                        <div class="flex-shrink-0">
                            <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 32px; height: 32px; background-color: #f3f4f6;">
                                <span class="small fw-medium text-muted">2</span>
                            </div>
                        </div>
                        <div class="ms-3">
                            <p class="small fw-medium text-dark mb-0">Compléter votre profil</p>
                            <p class="small text-muted mb-0">Ajoutez vos informations</p>
                            <a href="{{ path('app_profile_edit') }}" class="small text-primary text-decoration-none">Compléter maintenant →</a>
                        </div>
                    </div>

                    <div class="d-flex align-items-start">
                        <div class="flex-shrink-0">
                            <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 32px; height: 32px; background-color: #f3f4f6;">
                                <span class="small fw-medium text-muted">3</span>
                            </div>
                        </div>
                        <div class="ms-3">
                            <p class="small fw-medium text-dark mb-0">Choisir votre rôle</p>
                            <p class="small text-muted mb-0">Agriculteur, Fournisseur ou AgriPlus</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start">
                        <div class="flex-shrink-0">
                            <div class="d-flex align-items-center justify-content-center rounded-circle" style="width: 32px; height: 32px; background-color: #f3f4f6;">
                                <span class="small fw-medium text-muted">4</span>
                            </div>
                        </div>
                        <div class="ms-3">
                            <p class="small fw-medium text-dark mb-0">Explorer la plateforme</p>
                            <p class="small text-muted mb-0">Découvrez toutes les fonctionnalités</p>
                        </div>
                    </div>
                </div>
            {% endblock %}
        {% endembed %}
        </div>

        {# Upgrade Options #}
        <div class="col-12 col-lg-6">
        {% embed 'components/_card.html.twig' %}
            {% block card_title %}Évoluez avec AgriLink{% endblock %}
            {% block card_content %}
                <div class="d-flex flex-column gap-3">
                    <a href="#" class="p-3 rounded border border-light-subtle text-decoration-none">
                        <div class="d-flex align-items-center">
                            <div class="d-flex align-items-center justify-content-center rounded" style="width: 48px; height: 48px; background-color: #dcfce7; margin-right: 1rem;">
                                <span class="fs-3">🌱</span>
                            </div>
                            <div>
                                <p class="small fw-semibold text-dark mb-0">Devenir Agriculteur</p>
                                <p class="small text-muted mb-0">Gérez votre exploitation et vos cultures</p>
                            </div>
                        </div>
                    </a>

                    <a href="#" class="p-3 rounded border border-light-subtle text-decoration-none">
                        <div class="d-flex align-items-center">
                            <div class="d-flex align-items-center justify-content-center rounded" style="width: 48px; height: 48px; background-color: #dbeafe; margin-right: 1rem;">
                                <span class="fs-3">🏢</span>
                            </div>
                            <div>
                                <p class="small fw-semibold text-dark mb-0">Devenir Fournisseur</p>
                                <p class="small text-muted mb-0">Vendez vos produits aux agriculteurs</p>
                            </div>
                        </div>
                    </a>

                    <a href="#" class="p-3 rounded border border-light-subtle text-decoration-none">
                        <div class="d-flex align-items-center">
                            <div class="d-flex align-items-center justify-content-center rounded" style="width: 48px; height: 48px; background-color: #fef08a; margin-right: 1rem;">
                                <span class="fs-3">⭐</span>
                            </div>
                            <div>
                                <p class="small fw-semibold text-dark mb-0">Passer à AgriPlus</p>
                                <p class="small text-muted mb-0">Accédez aux fonctionnalités premium</p>
                            </div>
                        </div>
                    </a>
                </div>
            {% endblock %}
        {% endembed %}
        </div>
    </div>

    {# Welcome Info #}
    <div class="mt-4">
        {% embed 'components/_card.html.twig' %}
            {% block card_title %}À propos d'AgriLink{% endblock %}
            {% block card_content %}
                <div>
                    <p class="text-dark">
                        AgriLink est une plateforme dédiée à la communauté agricole tunisienne. 
                        Nous connectons agriculteurs, fournisseurs et experts pour une agriculture plus efficace et durable.
                    </p>
                    <ul class="mt-3 list-unstyled d-flex flex-column gap-2">
                        <li class="d-flex align-items-start">
                            <span class="text-primary me-2">✓</span>
                            <span class="text-dark">Marketplace pour acheter et vendre des produits agricoles</span>
                        </li>
                        <li class="d-flex align-items-start">
                            <span class="text-primary me-2">✓</span>
                            <span class="text-dark">Outils de gestion pour votre exploitation</span>
                        </li>
                        <li class="d-flex align-items-start">
                            <span class="text-primary me-2">✓</span>
                            <span class="text-dark">Communauté d'experts et de passionnés</span>
                        </li>
                        <li class="d-flex align-items-start">
                            <span class="text-primary me-2">✓</span>
                            <span class="text-dark">Conseils personnalisés avec AgriPlus</span>
                        </li>
                    </ul>
                </div>
            {% endblock %}
        {% endembed %}
    </div>
{% endblock %}
