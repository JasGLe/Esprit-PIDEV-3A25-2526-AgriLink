<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <style>
        body {
            font-family: 'DejaVu Sans', sans-serif;
            font-size: 10px;
            color: #1f2937;
            margin: 0;
            padding: 0;
        }

        .header {
            background: #0f172a;
            color: white;
            padding: 14px 18px;
            border-bottom: 4px solid #22c55e;
        }

        .header-table {
            width: 100%;
        }

        .logo {
            width: 50px;
        }

        .title {
            font-size: 16px;
            font-weight: bold;
            margin: 0;
            color: #22c55e;
        }

        .subtitle {
            font-size: 9px;
            color: #cbd5e1;
            margin: 2px 0 0 0;
        }

        .stats {
            margin: 12px 18px;
            padding: 0;
        }

        .stat {
            display: inline-block;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            padding: 5px 8px;
            margin-right: 6px;
            margin-bottom: 4px;
            border-radius: 4px;
            font-size: 8px;
            color: #166534;
            font-weight: 500;
        }

        .content {
            padding: 0 18px 18px 18px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 8px;
            font-size: 8px;
        }

        thead {
            background: #374151;
            color: white;
        }

        th {
            padding: 6px 8px;
            font-size: 8px;
            font-weight: bold;
            text-align: left;
            border: 1px solid #d1d5db;
        }

        td {
            padding: 6px 8px;
            border: 1px solid #e5e7eb;
            font-size: 8px;
        }

        tr.even {
            background: #f9fafb;
        }

        tr.odd {
            background: #ffffff;
        }

        .badge {
            display: inline-block;
            padding: 2px 6px;
            border-radius: 10px;
            font-size: 8px;
            background: #dcfce7;
            color: #166534;
            font-weight: 500;
        }

        .section {
            margin-top: 12px;
            padding-top: 8px;
            border-top: 1px solid #e5e7eb;
        }

        .section-title {
            background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
            color: white;
            padding: 8px 10px;
            font-size: 10px;
            font-weight: bold;
            margin-bottom: 8px;
            border-radius: 4px;
        }

        .small {
            font-size: 8px;
            color: #6b7280;
        }

        .footer {
            margin-top: 14px;
            padding-top: 8px;
            border-top: 1px solid #e5e7eb;
            text-align: center;
            font-size: 7px;
            color: #9ca3af;
        }

        @media print {
            body { margin: 0; padding: 0; }
            .page { page-break-after: always; }
        }
    </style>
</head>
<body>

<div class="header">
    <table class="header-table">
        <tr>
            <td width="60">
                <p class="title">📊 Rapport Tableau de Bord</p>
            </td>
            <td>
                <p style="color: #cbd5e1; font-size: 9px; margin: 2px 0;">Statistiques administrateur - Généré le {{ date|date('d/m/Y H:i') }}</p>
            </td>
            <td style="text-align: right; width: 100px;">
                <p class="subtitle" style="margin: 0;">AgriLink Admin<br/>Dashboard</p>
            </td>
        </tr>
    </table>
</div>

<div class="stats">
    <span class="stat">👥 Total: {{ stats.total ?? 0 }}</span>
    <span class="stat">🌾 Agriculteurs: {{ stats.by_role.ROLE_AGRICULTEUR ?? 0 }}</span>
    <span class="stat">🏪 Fournisseurs: {{ stats.by_role.ROLE_FOURNISSEUR ?? 0 }}</span>
    <span class="stat">⭐ AgriPlus: {{ stats.by_role.ROLE_AGRIPLUS ?? 0 }}</span>
</div>

<div class="content">

<!-- User Statistics -->
<div class="section">
    <div class="section-title">📊 STATISTIQUES UTILISATEURS</div>
    
    <table>
        <thead>
            <tr>
                <th>Catégorie</th>
                <th>Nombre</th>
                <th>Pourcentage</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Agriculteurs</td>
                <td style="text-align: center;">{{ stats.by_role.ROLE_AGRICULTEUR ?? 0 }}</td>
                <td style="text-align: right;">{{ stats.total > 0 ? ((stats.by_role.ROLE_AGRICULTEUR ?? 0) / stats.total * 100)|round(1) : 0 }}%</td>
            </tr>
            <tr class="even">
                <td>Fournisseurs</td>
                <td style="text-align: center;">{{ stats.by_role.ROLE_FOURNISSEUR ?? 0 }}</td>
                <td style="text-align: right;">{{ stats.total > 0 ? ((stats.by_role.ROLE_FOURNISSEUR ?? 0) / stats.total * 100)|round(1) : 0 }}%</td>
            </tr>
            <tr>
                <td>AgriPlus</td>
                <td style="text-align: center;">{{ stats.by_role.ROLE_AGRIPLUS ?? 0 }}</td>
                <td style="text-align: right;">{{ stats.total > 0 ? ((stats.by_role.ROLE_AGRIPLUS ?? 0) / stats.total * 100)|round(1) : 0 }}%</td>
            </tr>
            <tr class="even">
                <td>Utilisateurs standard</td>
                <td style="text-align: center;">{{ stats.by_role.ROLE_USER ?? 0 }}</td>
                <td style="text-align: right;">{{ stats.total > 0 ? ((stats.by_role.ROLE_USER ?? 0) / stats.total * 100)|round(1) : 0 }}%</td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Security Statistics -->
<div class="section">
    <div class="section-title">🔒 SÉCURITÉ (30 DERNIERS JOURS)</div>
    
    <table>
        <thead>
            <tr>
                <th>Événement</th>
                <th>Nombre</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Connexions réussies</td>
                <td style="text-align: center;">{{ securityStats.loginSuccess ?? 0 }}</td>
            </tr>
            <tr class="even">
                <td>Connexions échouées</td>
                <td style="text-align: center;">{{ securityStats.loginFailed ?? 0 }}</td>
            </tr>
            <tr>
                <td>Comptes verrouillés</td>
                <td style="text-align: center;">{{ securityStats.accountLocked ?? 0 }}</td>
            </tr>
            <tr class="even">
                <td>Changements de mot de passe</td>
                <td style="text-align: center;">{{ securityStats.passwordChanged ?? 0 }}</td>
            </tr>
            <tr>
                <td>2FA réussi</td>
                <td style="text-align: center;">{{ securityStats.twoFaSuccess ?? 0 }}</td>
            </tr>
        </tbody>
    </table>
</div>

<!-- Growth -->
<div class="section">
    <div class="section-title">📈 CROISSANCE</div>
    
    <table>
        <thead>
            <tr>
                <th>Métrique</th>
                <th>Valeur</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>Taux croissance (30j)</td>
                <td style="text-align: center; font-weight: bold; color: #22c55e;">{{ growthRate|round(1) }}%</td>
            </tr>
            <tr class="even">
                <td>Inscriptions (7j)</td>
                <td style="text-align: center;">{{ recentUsers|length }}</td>
            </tr>
        </tbody>
    </table>
</div>

</div>

<div class="footer">
    AgriLink - Rapport de tableau de bord administrateur · Généré le {{ date|date('d/m/Y \\à H:i') }}
</div>

</body>
</html>
