{% extends 'layouts/app.html.twig' %}

{% block title %}Tableau de bord - AgriLink{% endblock %}

{% block page_content %}
    <div class="mb-4">
        <h1 class="fs-3 fw-bold text-dark">Tableau de bord</h1>
        <p class="mt-1 text-muted small">Bienvenue sur votre espace AgriLink, {{ app.user.displayName }} !</p>
    </div>

    <div class="row g-4">
        {# Card: Profil #}
        <div class="col-12 col-sm-6 col-lg-4">
            {% embed 'components/_card.html.twig' %}
                {% block card_title %}Mon profil{% endblock %}
                {% block card_content %}
                    <div class="d-flex align-items-center gap-3 mb-3">
                        {{ include('components/_avatar.html.twig', {user: app.user, size: 'large'}) }}
                        <div>
                            <p class="fs-5 fw-semibold text-dark mb-0">{{ app.user.displayName }}</p>
                            <p class="text-muted small mb-1">{{ app.user.email }}</p>
                            {{ include('components/_role_badge.html.twig', {role: app.user.roles|first}) }}
                        </div>
                    </div>
                    <div class="mt-3">
                        <a href="{{ path('app_profile') }}" class="text-primary text-decoration-none small fw-medium">
                            Voir mon profil →
                        </a>
                    </div>
                {% endblock %}
            {% endembed %}
        </div>

        {# Card: Statistiques #}
        <div class="col-12 col-sm-6 col-lg-4">
            {% embed 'components/_card.html.twig' %}
                {% block card_title %}Activité{% endblock %}
                {% block card_content %}
                    <div class="text-center py-5">
                        <p class="text-muted small">Vos statistiques apparaîtront ici.</p>
                    </div>
                {% endblock %}
            {% endembed %}
        </div>

        {# Card: Actions rapides #}
        <div class="col-12 col-sm-6 col-lg-4">
            {% embed 'components/_card.html.twig' %}
                {% block card_title %}Actions rapides{% endblock %}
                {% block card_content %}
                    <div class="d-flex flex-column gap-2">
                        <a href="{{ path('app_profile_edit') }}" class="d-block px-3 py-2 text-dark text-decoration-none rounded hover-bg-light small">
                            ✏️ Modifier mon profil
                        </a>
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('admin_dashboard') }}" class="d-block px-3 py-2 text-dark text-decoration-none rounded hover-bg-light small">
                                👥 Administration
                            </a>
                        {% endif %}
                    </div>
                {% endblock %}
            {% endembed %}
        </div>
    </div>

    {# Informations additionnelles #}
    <div class="mt-4">
        {% embed 'components/_card.html.twig' %}
            {% block card_title %}Bienvenue sur AgriLink Module 1 : Users & Auth{% endblock %}
            {% block card_content %}
                <div>
                    <p class="text-dark">
                        Ce module de base vous permet de gérer votre compte utilisateur et vos informations personnelles.
                    </p>
                    <ul class="list-unstyled mt-3 d-flex flex-column gap-2">
                        <li class="d-flex align-items-start">
                            <span class="text-primary me-2">✓</span>
                            <span class="text-dark">Authentification sécurisée avec "Se souvenir de moi"</span>
                        </li>
                        <li class="d-flex align-items-start">
                            <span class="text-primary me-2">✓</span>
                            <span class="text-dark">Gestion de profil avec photo personnalisée</span>
                        </li>
                        <li class="d-flex align-items-start">
                            <span class="text-primary me-2">✓</span>
                            <span class="text-dark">Interface moderne avec Bootstrap 5</span>
                        </li>
                        {% if is_granted('ROLE_ADMIN') %}
                            <li class="d-flex align-items-start">
                                <span class="text-primary me-2">✓</span>
                                <span class="text-dark">Administration complète des utilisateurs</span>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            {% endblock %}
        {% endembed %}
    </div>
{% endblock %}
