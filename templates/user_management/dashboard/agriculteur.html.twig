{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Tableau de bord Agriculteur - AgriLink{% endblock %}
{% block page_title %}Mon exploitation{% endblock %}

{% block role_specific_navigation %}
    <hr class="my-3 border-secondary">
    <div class="px-3 py-2 small fw-semibold text-muted text-uppercase" style="font-size:0.65rem;letter-spacing:0.07em;">
        Mon exploitation
    </div>

    <a href="#" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-dark text-decoration-none mb-1">
        <svg class="me-3" style="width:1.15rem;height:1.15rem;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Mes parcelles
    </a>
    <a href="{{ path('activite_list') }}" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-dark text-decoration-none mb-1">
        <svg class="me-3" style="width:1.15rem;height:1.15rem;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
        </svg>
        Activités
    </a>
    <a href="{{ path('evenement_list') }}" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-dark text-decoration-none mb-1">
        <svg class="me-3" style="width:1.15rem;height:1.15rem;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Événements
    </a>
    <hr class="my-3 border-secondary">
    <div class="px-3 py-2 small fw-semibold text-muted text-uppercase" style="font-size:0.65rem;letter-spacing:0.07em;">
        Marketplace
    </div>
    <a href="{{ path('marketplace_index') }}" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-dark text-decoration-none mb-1">
        <svg class="me-3" style="width:1.15rem;height:1.15rem;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        Produits disponibles
    </a>
    <a href="{{ path('mes_commandes_index') }}" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-dark text-decoration-none mb-1">
        <svg class="me-3" style="width:1.15rem;height:1.15rem;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
        </svg>
        Mes commandes
    </a>
    <a href="{{ path('sales_stats_index') }}" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-dark text-decoration-none mb-1">
        <svg class="me-3" style="width:1.15rem;height:1.15rem;flex-shrink:0;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3v18h18M7 14l3-3 3 2 5-6" />
        </svg>
        Statistiques ventes
    </a>
{% endblock %}

{% block dashboard_content %}

{# ── Welcome Banner ── #}
<div class="ag-welcome-banner ag-animate-fade-up mb-4" style="background:linear-gradient(135deg,#166534 0%,#16a34a 60%,#0d9488 100%);">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <p class="mb-1" style="color:rgba(255,255,255,.6);font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">Bonjour</p>
            <h2 class="h4 fw-bold mb-1" style="color:#fff;">{{ app.user.displayName }} 🌾</h2>
            <p class="mb-0" style="color:rgba(255,255,255,.7);font-size:0.85rem;">
                Gérez votre exploitation et découvrez les meilleures offres.
                {% if app.user.agriculteurExpAnnee %}
                    &middot; <span style="color:rgba(255,255,255,.9);font-weight:600;">{{ app.user.agriculteurExpAnnee }} ans d'expérience</span>
                {% endif %}
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('activite_list') }}" class="btn btn-sm fw-medium" style="background:rgba(255,255,255,.15);color:#fff;border:1px solid rgba(255,255,255,.25);border-radius:8px;">
                Mes activités
            </a>
            <a href="{{ path('calendar_index') }}" class="btn btn-sm fw-semibold" style="background:#fff;color:#16a34a;border-radius:8px;">
                Calendrier
            </a>
        </div>
    </div>
</div>

{# ── Level & Badges ── #}
<div class="mb-3 ag-animate-fade-up ag-delay-1">
    {% include 'components/user_level_widget.html.twig' %}
</div>

{# ── Profile Completion ── #}
<div class="mb-4 ag-animate-fade-up ag-delay-1">
    {% include 'components/profile_completion_simple.html.twig' %}
</div>

{# ── Quick Navigation Cards ── #}
<div class="row g-3 mb-4 ag-animate-fade-up ag-delay-2">
    <div class="col-12 col-md-6">
        <a href="{{ path('activite_list') }}" class="ag-action-item text-decoration-none h-100" style="padding:1.1rem 1.25rem;">
            <div class="ag-action-icon" style="background:rgba(34,197,94,.12);width:52px;height:52px;font-size:1.4rem;">🌾</div>
            <div class="flex-fill">
                <p class="fw-bold text-dark mb-0">Activités agricoles</p>
                <p class="text-muted small mb-0">Gérer et planifier vos activités</p>
            </div>
            <svg class="ag-action-chevron" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
    </div>
    <div class="col-12 col-md-6">
        <a href="{{ path('evenement_list') }}" class="ag-action-item text-decoration-none h-100" style="padding:1.1rem 1.25rem;">
            <div class="ag-action-icon" style="background:rgba(59,130,246,.12);width:52px;height:52px;font-size:1.4rem;">📅</div>
            <div class="flex-fill">
                <p class="fw-bold text-dark mb-0">Événements</p>
                <p class="text-muted small mb-0">Découvrir les événements agricoles</p>
            </div>
            <svg class="ag-action-chevron" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
    </div>
</div>

{# ── Stat Cards ── #}
<div class="row g-3 mb-4">

    {# Parcelles #}
    <div class="col-12 col-sm-6 col-lg-3 ag-animate-fade-up ag-delay-1">
        <div class="ag-stat-card">
            <div class="ag-stat-body d-flex align-items-start gap-3">
                <div class="ag-stat-icon" style="background:linear-gradient(135deg,rgba(22,163,74,.14),rgba(34,197,94,.07));">
                    <svg width="22" height="22" fill="none" stroke="#16a34a" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
                </div>
                <div>
                    <p class="text-muted small fw-semibold mb-1" style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.04em;">Mes parcelles</p>
                    <p class="fw-bold mb-0" style="font-size:1.5rem;color:#111827;">--</p>
                </div>
            </div>
            <div class="ag-stat-footer">
                <a href="#" class="small fw-semibold text-decoration-none" style="color:#16a34a;">Gérer →</a>
            </div>
        </div>
    </div>

    {# Événements #}
    <div class="col-12 col-sm-6 col-lg-3 ag-animate-fade-up ag-delay-2">
        <div class="ag-stat-card">
            <div class="ag-stat-body d-flex align-items-start gap-3">
                <div class="ag-stat-icon" style="background:linear-gradient(135deg,rgba(245,158,11,.14),rgba(252,211,77,.07));">
                    <span style="font-size:1.3rem;">📅</span>
                </div>
                <div>
                    <p class="text-muted small fw-semibold mb-1" style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.04em;">Mes événements</p>
                    <p class="fw-bold mb-0" style="font-size:1.5rem;color:#111827;">{{ myEvenementsCount|default(0) }}</p>
                </div>
            </div>
            <div class="ag-stat-footer">
                <button
                    class="btn btn-link p-0 small fw-semibold text-decoration-none mes-evenements-trigger"
                    style="color:#d97706;"
                    type="button"
                    data-bs-toggle="modal"
                    data-bs-target="#mesEvenementsModal"
                >
                    Voir mes événements <span id="mes-evenements-arrow" class="mes-evenements-arrow">↓</span>
                </button>
            </div>
        </div>
    </div>

    {# Boutique #}
    <div class="col-12 col-sm-6 col-lg-3 ag-animate-fade-up ag-delay-3">
        <div class="ag-stat-card">
            <div class="ag-stat-body d-flex align-items-start gap-3">
                <div class="ag-stat-icon" style="background:linear-gradient(135deg,rgba(249,115,22,.14),rgba(245,158,11,.07));">
                    <svg width="22" height="22" fill="none" stroke="#ea580c" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7h18l-1.5 9a2 2 0 01-2 1.7H6.5a2 2 0 01-2-1.7L3 7zm4-3h10l1 3H6l1-3zM9 11v4m6-4v4"/></svg>
                </div>
                <div>
                    <p class="text-muted small fw-semibold mb-1" style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.04em;">Ma boutique</p>
                    <p class="fw-bold mb-0" style="font-size:1.5rem;color:#111827;">Produits</p>
                </div>
            </div>
            <div class="ag-stat-footer">
                <a href="{{ path('boutique_index') }}" class="small fw-semibold text-decoration-none" style="color:#ea580c;">Ouvrir →</a>
            </div>
        </div>
    </div>

    {# Météo #}
    <div class="col-12 col-sm-6 col-lg-3 ag-animate-fade-up ag-delay-4">
        <div class="ag-weather-card">
            <div class="ag-stat-body d-flex align-items-start gap-3">
                <div class="ag-stat-icon" style="background:rgba(255,255,255,.18);">
                    {% set weatherEmoji = '🌤️' %}
                    {% if weatherIcon is defined and weatherIcon %}
                        {% if weatherIcon starts with '01' %}{% set weatherEmoji = '☀️' %}
                        {% elseif weatherIcon starts with '02' %}{% set weatherEmoji = '⛅' %}
                        {% elseif weatherIcon starts with '03' or weatherIcon starts with '04' %}{% set weatherEmoji = '☁️' %}
                        {% elseif weatherIcon starts with '09' or weatherIcon starts with '10' %}{% set weatherEmoji = '🌧️' %}
                        {% elseif weatherIcon starts with '11' %}{% set weatherEmoji = '⛈️' %}
                        {% elseif weatherIcon starts with '13' %}{% set weatherEmoji = '❄️' %}
                        {% endif %}
                    {% endif %}
                    <span style="font-size:1.4rem;">{{ weatherEmoji }}</span>
                </div>
                <div>
                    <p class="fw-semibold mb-1" style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.04em;color:rgba(255,255,255,.7);">Météo</p>
                    <p class="fw-bold mb-0" style="font-size:1.5rem;color:#fff;">
                        {% if temperature is defined and temperature is not null %}
                            {{ temperature|round }}°C
                        {% else %}
                            --°C
                        {% endif %}
                    </p>
                    {% if weatherDescription is defined and weatherDescription %}
                        <p class="mb-0" style="font-size:0.75rem;color:rgba(255,255,255,.75);">{{ weatherDescription }}</p>
                    {% endif %}
                </div>
            </div>
            <div class="ag-stat-footer">
                <a href="{{ path('weather_index') }}" class="small fw-semibold text-decoration-none" style="color:rgba(255,255,255,.9);">
                    {{ userCity|default('Non défini') }} →
                </a>
            </div>
        </div>
    </div>

    {# ── Section Équipements & Maintenances ── #}
    <h5 class="fw-bold mt-4 mb-3">⚙️ Mes Équipements & Maintenances</h5>

    {# KPI Cards — 4 cards #}
    <div class="row g-3 mb-4">

        {# Card 1 — Total Équipements #}
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius:12px;overflow:hidden">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3">
                        <span style="font-size:2.2rem">🚜</span>
                        <div>
                            <div class="fw-bold text-success lh-1" style="font-size:2rem">{{ totalEquipements|default(0) }}</div>
                            <div class="small text-muted mt-1">équipements enregistrés</div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light p-3">
                    <a href="{{ path('equipement_index') }}" class="small fw-medium text-success text-decoration-none">Gérer →</a>
                </div>
            </div>
        </div>

        {# Card 2 — Statuts équipements #}
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius:12px;overflow:hidden">
                <div class="card-body p-4">
                    <div class="small fw-semibold text-muted mb-3 text-uppercase" style="letter-spacing:.06em;font-size:.68rem">Statuts équipements</div>
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="d-flex align-items-center gap-2" style="font-size:.82rem">
                                <span style="width:9px;height:9px;border-radius:50%;background:#198754;display:inline-block;flex-shrink:0"></span>
                                Actif
                            </span>
                            <span class="fw-bold text-success">{{ equipementsParStatut['Actif']|default(0) }}</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="d-flex align-items-center gap-2" style="font-size:.82rem">
                                <span style="width:9px;height:9px;border-radius:50%;background:#ffc107;display:inline-block;flex-shrink:0"></span>
                                En maintenance
                            </span>
                            <span class="fw-bold" style="color:#b45309">{{ equipementsParStatut['En maintenance']|default(0) }}</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="d-flex align-items-center gap-2" style="font-size:.82rem">
                                <span style="width:9px;height:9px;border-radius:50%;background:#dc3545;display:inline-block;flex-shrink:0"></span>
                                En panne
                            </span>
                            <span class="fw-bold text-danger">{{ equipementsParStatut['En panne']|default(0) }}</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="d-flex align-items-center gap-2" style="font-size:.82rem">
                                <span style="width:9px;height:9px;border-radius:50%;background:#6c757d;display:inline-block;flex-shrink:0"></span>
                                Hors service
                            </span>
                            <span class="fw-bold text-secondary">{{ equipementsParStatut['Hors service']|default(0) }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Card 3 — Maintenances #}
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius:12px;overflow:hidden">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <span style="font-size:2.2rem">🔧</span>
                        <div>
                            <div class="fw-bold text-dark lh-1" style="font-size:2rem">{{ totalMaintenances|default(0) }}</div>
                            <div class="small text-muted mt-1">maintenances</div>
                        </div>
                    </div>
                    <div>
                        {% if maintenancesEnRetard|default(0) > 0 %}
                            <span class="badge rounded-pill bg-danger" style="font-size:.73rem">⚠ {{ maintenancesEnRetard }} en retard</span>
                        {% else %}
                            <span class="badge rounded-pill bg-success-subtle text-success" style="font-size:.73rem">✓ À jour</span>
                        {% endif %}
                    </div>
                </div>
                <div class="card-footer bg-light p-3">
                    <a href="{{ path('maintenance_index') }}" class="small fw-medium text-success text-decoration-none">Voir →</a>
                </div>
            </div>
        </div>

        {# Card 4 — Coût total maintenances #}
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm h-100" style="border-radius:12px;overflow:hidden">
                <div class="card-body p-4">
                    <div class="small fw-semibold text-muted mb-2 text-uppercase" style="letter-spacing:.06em;font-size:.68rem">Coût total maintenances</div>
                    {% if coutTotalMaintenances|default(0) > 0 %}
                        <div class="fw-bold text-success mt-1" style="font-size:1.25rem;line-height:1.2">
                            {{ coutTotalMaintenances|number_format(2, ',', ' ') }}
                            <span style="font-size:.75rem;background:#d1fae5;color:#065f46;padding:.15rem .4rem;border-radius:4px;vertical-align:middle">TND</span>
                        </div>
                        <div class="small text-muted mt-1">coût total des maintenances</div>
                    {% else %}
                        <div class="text-muted small mt-3">Aucun coût enregistré</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Row 2 — Carte Leaflet + Prochaines maintenances #}
    <div class="row g-4 mb-4">

        {# Carte Leaflet — col-lg-7 #}
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm h-100" style="border-radius:12px;overflow:hidden">
                <div class="card-body p-4">
                    <h6 class="fw-semibold mb-3 text-dark">📍 Localisation de mes équipements</h6>
                    {% if equipementsGeo|default([])|length > 0 %}
                        <div id="dashEquipMap" style="height:280px;border-radius:12px;border:1px solid #e5e7eb;z-index:0"></div>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            <span class="badge rounded-pill" style="background:#19875422;color:#198754;font-size:.7rem">● Actif</span>
                            <span class="badge rounded-pill" style="background:#ffc10722;color:#b45309;font-size:.7rem">● En maintenance</span>
                            <span class="badge rounded-pill" style="background:#dc354522;color:#dc3545;font-size:.7rem">● En panne</span>
                            <span class="badge rounded-pill" style="background:#6f42c122;color:#6f42c1;font-size:.7rem">● Hors service</span>
                        </div>
                    {% else %}
                        <div class="text-center py-5">
                            <div style="font-size:2.5rem;opacity:.3">📍</div>
                            <div class="small text-muted mt-2">Aucun équipement localisé</div>
                            <div class="small text-muted">Ajoutez une position depuis la fiche équipement</div>
                            <a href="{{ path('equipement_index') }}" class="btn btn-outline-success btn-sm mt-3">Gérer mes équipements</a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Prochaines maintenances — col-lg-5 #}
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm h-100" style="border-radius:12px;overflow:hidden">
                <div class="card-body p-4">
                    <h6 class="fw-semibold mb-3 text-dark">🔧 Prochaines maintenances planifiées</h6>
                    {% set prochaines = prochainesMaintenances|default([]) %}
                    {% if prochaines|length > 0 %}
                        {% for m in prochaines %}
                            {% set equip = equipMap[m.equipementId]|default(null) %}
                            {% set jours = ((m.datePlanifiee|date('U') - "now"|date('U')) / 86400)|round(0, 'ceil') %}
                            <div class="{% if not loop.last %}pb-3 mb-3 border-bottom{% endif %}">
                                <div class="d-flex align-items-start justify-content-between gap-2">
                                    <div class="flex-fill" style="min-width:0">
                                        {% if equip %}
                                            <a href="{{ path('equipement_show', {'id': equip.id}) }}"
                                               class="fw-semibold text-success text-decoration-none small d-block text-truncate">
                                                {{ equip.nom }}
                                            </a>
                                        {% else %}
                                            <span class="fw-semibold small text-muted">Équipement #{{ m.equipementId }}</span>
                                        {% endif %}
                                        <div class="small text-muted mt-1">
                                            📅 {{ m.datePlanifiee ? m.datePlanifiee|date('d/m/Y') : '—' }}
                                        </div>
                                    </div>
                                    <div class="d-flex flex-column align-items-end gap-1 flex-shrink-0">
                                        <span class="badge rounded-pill"
                                              style="font-size:.65rem;background:{{ m.type == 'Préventive' ? '#dbeafe' : '#fce7f3' }};color:{{ m.type == 'Préventive' ? '#1e40af' : '#9d174d' }}">
                                            {{ m.type }}
                                        </span>
                                        {% if jours <= 2 %}
                                            <span class="badge bg-danger rounded-pill" style="font-size:.65rem">Urgent — {{ jours }}j</span>
                                        {% elseif jours <= 7 %}
