{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Tableau de bord Agriculteur - AgriLink{% endblock %}
{% block page_title %}Mon exploitation{% endblock %}

{% block role_badge %}
    <span class="badge rounded-pill bg-success-subtle text-success d-inline-flex align-items-center px-3 py-1">
        🌱 Agriculteur
    </span>
{% endblock %}

{% block role_specific_navigation %}
    <hr class="my-3 border-secondary">
    <div class="px-3 py-2 small fw-semibold text-muted text-uppercase">
        Mon exploitation
    </div>
    
    <a href="#" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-dark">
        <svg class="me-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        Mes parcelles
    </a>

    <a href="#" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-dark">
        <svg class="me-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
        </svg>
        Mes cultures
    </a>

    <a href="#" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-dark">
        <svg class="me-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        Mes commandes
    </a>

    <a href="#" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-dark">
        <svg class="me-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Calendrier agricole
    </a>

    <hr class="my-3 border-secondary">
    <div class="px-3 py-2 small fw-semibold text-muted text-uppercase">
        Marketplace
    </div>

    <a href="#" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-dark">
        <svg class="me-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        Produits disponibles
    </a>

    <a href="#" class="d-flex align-items-center px-3 py-2 small fw-medium rounded text-dark">
        <svg class="me-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        Fournisseurs
    </a>
{% endblock %}

{% block mobile_sidebar %}
    {{ block('sidebar_navigation') }}
{% endblock %}

{% block dashboard_content %}
    {# Welcome section #}
    <div class="mb-4">
        <h2 class="fs-3 fw-bold text-dark">Bienvenue, {{ app.user.displayName }} ! 🌾</h2>
        <p class="mt-1 small text-muted">
            Gérez votre exploitation et découvrez les meilleures offres pour vos cultures.
            {% if app.user.agriculteurExpAnnee %}
                <span class="text-success fw-medium">{{ app.user.agriculteurExpAnnee }} ans d'expérience</span>
            {% endif %}
        </p>
    </div>

    {# Quick Stats #}
    <div class="row g-4 mb-4">
        {# Parcelles #}
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="d-flex align-items-center justify-content-center rounded" style="width: 48px; height: 48px; background-color: #dcfce7;">
                                <svg class="w-6 h-6 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
                                </svg>
                            </div>
                        </div>
                        <div class="ms-3 flex-grow-1">
                            <dl>
                                <dt class="small fw-medium text-muted text-truncate">Mes parcelles</dt>
                                <dd class="fs-5 fw-semibold text-dark mb-0">--</dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light p-3">
                    <a href="#" class="small fw-medium text-success text-decoration-none">Gérer →</a>
                </div>
            </div>
        </div>

        {# Cultures actives #}
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="d-flex align-items-center justify-content-center rounded" style="width: 48px; height: 48px; background-color: #fef08a;">
                                <span class="fs-5">🌻</span>
                            </div>
                        </div>
                        <div class="ms-3 flex-grow-1">
                            <dl>
                                <dt class="small fw-medium text-muted text-truncate">Cultures actives</dt>
                                <dd class="fs-5 fw-semibold text-dark mb-0">--</dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light p-3">
                    <span class="small text-muted">En cours de croissance</span>
                </div>
            </div>
        </div>

        {# Commandes en cours #}
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="d-flex align-items-center justify-content-center rounded" style="width: 48px; height: 48px; background-color: #dbeafe;">
                                <svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                </svg>
                            </div>
                        </div>
                        <div class="ms-3 flex-grow-1">
                            <dl>
                                <dt class="small fw-medium text-muted text-truncate">Commandes</dt>
                                <dd class="fs-5 fw-semibold text-dark mb-0">--</dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light p-3">
                    <a href="#" class="small fw-medium text-primary text-decoration-none">Voir tout →</a>
                </div>
            </div>
        </div>

        {# Météo #}
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <div class="d-flex align-items-center justify-content-center rounded" style="width: 48px; height: 48px; background-color: #e0f2fe;">
                                <span class="fs-5">☀️</span>
                            </div>
                        </div>
                        <div class="ms-3 flex-grow-1">
                            <dl>
                                <dt class="small fw-medium text-muted text-truncate">Météo</dt>
                                <dd class="fs-5 fw-semibold text-dark mb-0">--°C</dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light p-3">
                    <span class="small text-muted">{{ app.user.ville|default('Non défini') }}</span>
                </div>
            </div>
        </div>
    </div>

    {# Main content grid #}
    <div class="row g-4">
        {# Quick Actions #}
        <div class="col-12 col-lg-6">
        {% embed 'components/_card.html.twig' %}
            {% block card_title %}Actions rapides{% endblock %}
            {% block card_content %}
                <div class="d-flex flex-column gap-2">
                    <a href="#" class="d-flex align-items-center p-3 rounded border border-light-subtle text-decoration-none">
                        <div class="d-flex align-items-center justify-content-center rounded" style="width: 40px; height: 40px; background-color: #dcfce7; margin-right: 1rem;">
                            <svg class="w-5 h-5 text-success" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                            </svg>
                        </div>
                        <div>
                            <p class="small fw-medium text-dark mb-0">Ajouter une parcelle</p>
                            <p class="small text-muted mb-0">Enregistrez une nouvelle zone de culture</p>
                        </div>
                    </a>

                    <a href="#" class="d-flex align-items-center p-3 rounded border border-light-subtle text-decoration-none">
                        <div class="d-flex align-items-center justify-content-center rounded" style="width: 40px; height: 40px; background-color: #dbeafe; margin-right: 1rem;">
                            <svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                        </div>
                        <div>
                            <p class="small fw-medium text-dark mb-0">Commander des fournitures</p>
                            <p class="small text-muted mb-0">Parcourir le catalogue fournisseurs</p>
                        </div>
                    </a>

                    <a href="#" class="d-flex align-items-center p-3 rounded border border-light-subtle text-decoration-none">
                        <div class="d-flex align-items-center justify-content-center rounded" style="width: 40px; height: 40px; background-color: #e9d5ff; margin-right: 1rem;">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #7c3aed;">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                        </div>
                        <div>
                            <p class="small fw-medium text-dark mb-0">Planifier une tâche</p>
                            <p class="small text-muted mb-0">Ajouter au calendrier agricole</p>
                        </div>
                    </a>
                </div>
            {% endblock %}
        {% endembed %}
        </div>

        {# Calendar Preview #}
        <div class="col-12 col-lg-6">
        {% embed 'components/_card.html.twig' %}
            {% block card_title %}Calendrier agricole{% endblock %}
            {% block card_content %}
                <div class="text-center py-5">
                    <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-3" style="width: 64px; height: 64px; background-color: #f3f4f6;">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="color: #9ca3af;">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                        </svg>
                    </div>
                    <p class="text-muted small mb-3">Aucune tâche programmée pour aujourd'hui</p>
                    <a href="#" class="btn btn-success btn-sm">Voir le calendrier</a>
                </div>
            {% endblock %}
        {% endembed %}
        </div>
    </div>

    {# AgriPlus Promo #}
    <div class="mt-4">
        <div class="rounded-3 shadow-lg overflow-hidden" style="background: linear-gradient(to right, #16a34a, #15803d);">
            <div class="px-4 px-sm-5 py-5">
                <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between">
                    <div class="text-center text-sm-start mb-3 mb-sm-0">
                        <h3 class="h5 fw-bold text-white mb-1">Passez à AgriPlus ! 🌟</h3>
                        <p class="mb-0" style="color: #dcfce7;">Accédez à des fonctionnalités avancées et des conseils personnalisés pour votre exploitation.</p>
                    </div>
                    <a href="#" class="btn btn-light text-success fw-medium text-decoration-none">Découvrir AgriPlus</a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
