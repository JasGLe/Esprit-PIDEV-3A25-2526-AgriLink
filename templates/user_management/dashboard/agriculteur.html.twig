    {% if equipementsGeo|default([])|length > 0 %}
    {# Leaflet chargé uniquement si des équipements géolocalisés existent #}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
    <script>
    (function () {
        var geoData = {{ equipementsGeo|json_encode|raw }};

        var map = L.map('dashEquipMap');

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        var statusColors = {
            'Actif'          : '#198754',
            'En maintenance' : '#ffc107',
            'En panne'       : '#dc3545',
            'Hors service'   : '#6f42c1'
        };

        var bounds = [];

        geoData.forEach(function (eq) {
            var color = statusColors[eq.statut] || '#6c757d';
            var marker = L.circleMarker([eq.lat, eq.lng], {
                radius       : 9,
                fillColor    : color,
                color        : '#fff',
                weight       : 2,
                opacity      : 1,
                fillOpacity  : 0.9
            }).addTo(map);

            marker.bindPopup(
                '<div style="min-width:140px">'
                + '<strong style="color:#1a1a2e">' + eq.nom + '</strong>'
                + '<div style="font-size:.8rem;color:#6c757d;margin:.2rem 0">' + (eq.type || '') + '</div>'
                + '<span style="background:' + color + '22;color:' + color + ';font-size:.7rem;padding:.1rem .4rem;border-radius:4px">' + eq.statut + '</span>'
                + '<div style="margin-top:.5rem"><a href="' + eq.url + '" style="color:#198754;font-size:.8rem;font-weight:600">Voir la fiche →</a></div>'
                + '</div>'
            );

            bounds.push([eq.lat, eq.lng]);
        });

        if (bounds.length === 1) {
            map.setView(bounds[0], 13);
        } else if (bounds.length > 1) {
            map.fitBounds(bounds, { padding: [20, 20] });
        }
    })();
    </script>
    {% endif %}
<script>
document.addEventListener('DOMContentLoaded', function () {
    const modal = document.getElementById('mesEvenementsModal');
    const arrow = document.getElementById('mes-evenements-arrow');
    if (!modal || !arrow) return;
    modal.addEventListener('show.bs.modal',   () => arrow.classList.add('is-open'));
    modal.addEventListener('hidden.bs.modal', () => arrow.classList.remove('is-open'));
});
</script>
