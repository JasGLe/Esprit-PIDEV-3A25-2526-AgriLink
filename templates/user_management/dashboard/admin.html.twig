{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Tableau de bord Admin - AgriLink{% endblock %}
{% block page_title %}Administration{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
/* Local overrides for admin dashboard */
.ag-kpi-bg-danger  { background: linear-gradient(135deg, #fff5f5 0%, #fff 100%); }
.ag-kpi-bg-success { background: linear-gradient(135deg, #f0fdf4 0%, #fff 100%); }
.ag-kpi-bg-primary { background: linear-gradient(135deg, #eff6ff 0%, #fff 100%); }
.ag-kpi-bg-amber   { background: linear-gradient(135deg, #fffbeb 0%, #fff 100%); }
</style>
{% endblock %}

{% block dashboard_content %}

{# ── Welcome Banner ── #}
<div class="ag-welcome-admin ag-welcome-banner ag-animate-fade-up mb-4 rounded-3 p-4" style="background:linear-gradient(135deg,#1e293b 0%,#334155 80%,#1e3a5f 100%);">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <p class="mb-1" style="color:rgba(255,255,255,.55);font-size:0.78rem;font-weight:600;text-transform:uppercase;letter-spacing:0.05em;">Tableau de bord</p>
            <h2 class="h4 fw-bold mb-1" style="color:#fff;">Bienvenue, {{ app.user.displayName }} 👋</h2>
            <p class="mb-0" style="color:rgba(255,255,255,.65);font-size:0.85rem;">Plateforme AgriLink — vue d'ensemble de la gestion</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="{{ path('admin_security_logs') }}" class="btn btn-sm fw-medium" style="background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.18);border-radius:8px;">
                <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-1"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                Sécurité
            </a>
            <button type="button" class="btn btn-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#exportModal" style="background:#fff;color:#1e293b;border-radius:8px;">
                <svg width="13" height="13" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-1"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Exporter
            </button>
        </div>
    </div>
</div>

{# ── KPI Cards ── #}
<div class="row g-3 mb-4">

    {# Total Users #}
    <div class="col-12 col-sm-6 col-xl-3 ag-animate-fade-up ag-delay-1">
        <div class="ag-kpi-card kpi-danger ag-kpi-bg-danger h-100">
            <div class="p-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="ag-kpi-icon icon-danger">
                        <svg class="text-danger" width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                    </div>
                    <div class="flex-fill">
                        <p class="ag-kpi-label mb-1">Total Utilisateurs</p>
                        <div class="ag-kpi-value">{{ stats.total ?? 0 }}</div>
                        {% if growthRate > 0 %}
                            <span class="ag-kpi-trend up">↑ +{{ growthRate|round(1) }}% ce mois</span>
                        {% elseif growthRate < 0 %}
                            <span class="ag-kpi-trend down">↓ {{ growthRate|round(1) }}% ce mois</span>
                        {% else %}
                            <span class="ag-kpi-trend flat">Stable ce mois</span>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="ag-kpi-footer">
                <span class="small text-muted">Tous les comptes</span>
                <a href="{{ path('admin_users_list') }}" class="small fw-semibold text-decoration-none" style="color:#dc2626;">Gérer →</a>
            </div>
        </div>
    </div>

    {# Agriculteurs #}
    <div class="col-12 col-sm-6 col-xl-3 ag-animate-fade-up ag-delay-2">
        <div class="ag-kpi-card kpi-success ag-kpi-bg-success h-100">
            <div class="p-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="ag-kpi-icon icon-success">
                        <svg class="text-success" width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22V12m0 0C12 7 7 4 3 5c0 5 3 9 9 7m0 0c0-5 5-8 9-7-1 5-4 8-9 7"/></svg>
                    </div>
                    <div class="flex-fill">
                        <p class="ag-kpi-label mb-1">Agriculteurs</p>
                        <div class="ag-kpi-value">{{ stats.by_role.ROLE_AGRICULTEUR ?? 0 }}</div>
                        <span class="ag-kpi-trend flat">{{ stats.total > 0 ? ((stats.by_role.ROLE_AGRICULTEUR ?? 0) / stats.total * 100)|round(1) : 0 }}% du total</span>
                    </div>
                </div>
            </div>
            <div class="ag-kpi-footer">
                <span class="ag-badge" style="background:rgba(22,163,74,.1);color:#16a34a;border-color:rgba(22,163,74,.2);">Actifs ce mois</span>
            </div>
        </div>
    </div>

    {# Fournisseurs #}
    <div class="col-12 col-sm-6 col-xl-3 ag-animate-fade-up ag-delay-3">
        <div class="ag-kpi-card kpi-primary ag-kpi-bg-primary h-100">
            <div class="p-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="ag-kpi-icon icon-primary">
                        <svg class="text-primary" width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                    </div>
                    <div class="flex-fill">
                        <p class="ag-kpi-label mb-1">Fournisseurs</p>
                        <div class="ag-kpi-value">{{ stats.by_role.ROLE_FOURNISSEUR ?? 0 }}</div>
                        <span class="ag-kpi-trend flat">{{ stats.total > 0 ? ((stats.by_role.ROLE_FOURNISSEUR ?? 0) / stats.total * 100)|round(1) : 0 }}% du total</span>
                    </div>
                </div>
            </div>
            <div class="ag-kpi-footer">
                <span class="ag-badge" style="background:rgba(37,99,235,.1);color:#2563eb;border-color:rgba(37,99,235,.2);">Vérifiés</span>
            </div>
        </div>
    </div>

    {# AgriPlus #}
    <div class="col-12 col-sm-6 col-xl-3 ag-animate-fade-up ag-delay-4">
        <div class="ag-kpi-card kpi-amber ag-kpi-bg-amber h-100">
            <div class="p-4">
                <div class="d-flex align-items-start gap-3">
                    <div class="ag-kpi-icon icon-amber">
                        <svg style="color:#d97706;" width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                    </div>
                    <div class="flex-fill">
                        <p class="ag-kpi-label mb-1">Abonnés AgriPlus</p>
                        <div class="ag-kpi-value">{{ stats.by_role.ROLE_AGRIPLUS ?? 0 }}</div>
                        <span class="ag-kpi-trend flat">{{ stats.total > 0 ? ((stats.by_role.ROLE_AGRIPLUS ?? 0) / stats.total * 100)|round(1) : 0 }}% du total</span>
                    </div>
                </div>
            </div>
            <div class="ag-kpi-footer">
                <span class="ag-badge" style="background:rgba(217,119,6,.1);color:#d97706;border-color:rgba(217,119,6,.2);">Premium actifs</span>
            </div>
        </div>
    </div>

</div>

{# ── Charts Row ── #}
<div class="row g-3 mb-4">

    {# Role Donut #}
    <div class="col-12 col-lg-5 ag-animate-fade-up ag-delay-2">
        <div class="ag-chart-card h-100">
            <div class="ag-chart-header">
                <p class="ag-chart-title">Répartition des utilisateurs</p>
                <p class="ag-chart-sub">Distribution par rôle sur la plateforme</p>
            </div>
            <div class="ag-chart-body">
                <div style="position:relative;height:220px;width:100%;">
                    <canvas id="roleDistChart"></canvas>
                </div>
                <div class="row g-2 mt-3">
                    <div class="col-6 d-flex align-items-center gap-2">
                        <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#16a34a;flex-shrink:0;"></span>
                        <small class="text-muted" style="font-size:0.75rem;">Agriculteurs ({{ stats.by_role.ROLE_AGRICULTEUR ?? 0 }})</small>
                    </div>
                    <div class="col-6 d-flex align-items-center gap-2">
                        <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#2563eb;flex-shrink:0;"></span>
                        <small class="text-muted" style="font-size:0.75rem;">Fournisseurs ({{ stats.by_role.ROLE_FOURNISSEUR ?? 0 }})</small>
                    </div>
                    <div class="col-6 d-flex align-items-center gap-2">
                        <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#f59e0b;flex-shrink:0;"></span>
                        <small class="text-muted" style="font-size:0.75rem;">AgriPlus ({{ stats.by_role.ROLE_AGRIPLUS ?? 0 }})</small>
                    </div>
                    <div class="col-6 d-flex align-items-center gap-2">
                        <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:#9ca3af;flex-shrink:0;"></span>
                        <small class="text-muted" style="font-size:0.75rem;">Utilisateurs ({{ stats.by_role.ROLE_USER ?? 0 }})</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Security Bar #}
    <div class="col-12 col-lg-7 ag-animate-fade-up ag-delay-3">
        <div class="ag-chart-card h-100">
            <div class="ag-chart-header">
                <p class="ag-chart-title">Aperçu de sécurité</p>
                <p class="ag-chart-sub">Activité de connexion — 30 derniers jours</p>
            </div>
            <div class="ag-chart-body">
                <div style="position:relative;height:260px;width:100%;">
                    <canvas id="securityOverviewChart"></canvas>
                </div>
            </div>
        </div>
    </div>

</div>

{# ── Actions & Recent Users ── #}
<div class="row g-3 mb-4">

    {# Quick Actions #}
    <div class="col-12 col-lg-5 ag-animate-fade-up ag-delay-2">
        <div class="ag-card h-100">
            <div class="ag-card-header">
                <div>
                    <p class="ag-card-title">⚡ Actions Rapides</p>
                    <p class="ag-card-subtitle">Accès aux fonctions d'administration</p>
                </div>
            </div>
            <div class="ag-card-body d-flex flex-column gap-2">

                <a href="{{ path('admin_users_list') }}" class="ag-action-item text-decoration-none">
                    <div class="ag-action-icon" style="background:rgba(239,68,68,.1);">
                        <svg style="color:#ef4444;" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                    </div>
                    <div class="flex-fill">
                        <p class="small fw-semibold text-dark mb-0">Gérer les utilisateurs</p>
                        <p class="text-muted mb-0" style="font-size:0.775rem;">Ajouter, modifier ou supprimer des comptes</p>
                    </div>
                    <svg class="ag-action-chevron" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>

                <a href="{{ path('admin_security_logs') }}" class="ag-action-item text-decoration-none">
                    <div class="ag-action-icon" style="background:rgba(220,53,69,.1);">
                        <svg style="color:#dc3545;" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    </div>
                    <div class="flex-fill">
                        <p class="small fw-semibold text-dark mb-0">Centre de Sécurité</p>
                        <p class="text-muted mb-0" style="font-size:0.775rem;">Surveillance et alertes de sécurité</p>
                    </div>
                    <svg class="ag-action-chevron" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </a>

                <button type="button" class="ag-action-item border-0 w-100 text-start" data-bs-toggle="modal" data-bs-target="#exportModal">
                    <div class="ag-action-icon" style="background:rgba(59,130,246,.1);">
                        <svg style="color:#3b82f6;" width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    </div>
                    <div class="flex-fill">
                        <p class="small fw-semibold text-dark mb-0">Générer un rapport</p>
                        <p class="text-muted mb-0" style="font-size:0.775rem;">Exporter les statistiques en PDF ou Excel</p>
                    </div>
                    <svg class="ag-action-chevron" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </button>

            </div>
        </div>
    </div>

    {# Recent Registrations #}
    <div class="col-12 col-lg-7 ag-animate-fade-up ag-delay-3">
        <div class="ag-card h-100">
            <div class="ag-card-header">
                <div>
                    <p class="ag-card-title">Nouvelles inscriptions</p>
                    <p class="ag-card-subtitle">7 derniers jours</p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    {% if growthRate > 0 %}
                        <span class="ag-badge" style="background:rgba(22,163,74,.1);color:#16a34a;border-color:rgba(22,163,74,.2);">+{{ growthRate|round(1) }}%</span>
                    {% elseif growthRate < 0 %}
                        <span class="ag-badge" style="background:rgba(220,38,38,.1);color:#dc2626;border-color:rgba(220,38,38,.2);">{{ growthRate|round(1) }}%</span>
                    {% endif %}
                    <span class="ag-badge" style="background:var(--ag-gray-100);color:var(--ag-gray-600);border-color:var(--ag-gray-200);">{{ recentUsers|length }} nouveau(x)</span>
                </div>
            </div>

            {# Mini progress bars #}
            <div class="px-4 py-3 border-bottom" style="background:#fafbfc;">
                {% set total = stats.total > 0 ? stats.total : 1 %}
                <div class="row g-3">
                    <div class="col-4">
                        <div class="d-flex justify-content-between mb-1">
                            <small class="text-muted" style="font-size:0.7rem;">Agriculteurs</small>
                            <small class="fw-semibold text-success" style="font-size:0.7rem;">{{ stats.by_role.ROLE_AGRICULTEUR ?? 0 }}</small>
                        </div>
                        <div class="ag-progress-bar">
                            <div class="ag-progress-fill" style="background:#16a34a;width:{{ ((stats.by_role.ROLE_AGRICULTEUR ?? 0) / total * 100)|round }}%;"></div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="d-flex justify-content-between mb-1">
                            <small class="text-muted" style="font-size:0.7rem;">Fournisseurs</small>
                            <small class="fw-semibold text-primary" style="font-size:0.7rem;">{{ stats.by_role.ROLE_FOURNISSEUR ?? 0 }}</small>
                        </div>
                        <div class="ag-progress-bar">
                            <div class="ag-progress-fill" style="background:#2563eb;width:{{ ((stats.by_role.ROLE_FOURNISSEUR ?? 0) / total * 100)|round }}%;"></div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="d-flex justify-content-between mb-1">
                            <small class="text-muted" style="font-size:0.7rem;">AgriPlus</small>
                            <small class="fw-semibold" style="font-size:0.7rem;color:#d97706;">{{ stats.by_role.ROLE_AGRIPLUS ?? 0 }}</small>
                        </div>
                        <div class="ag-progress-bar">
                            <div class="ag-progress-fill" style="background:#f59e0b;width:{{ ((stats.by_role.ROLE_AGRIPLUS ?? 0) / total * 100)|round }}%;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div style="max-height:280px;overflow-y:auto;">
                {% if recentUsers|length > 0 %}
                    {% for user in recentUsers %}
                        {% set userRole = 'ROLE_USER' %}
                        {% if 'ROLE_ADMIN' in user.roles %}{% set userRole = 'ROLE_ADMIN' %}
                        {% elseif 'ROLE_AGRIPLUS' in user.roles %}{% set userRole = 'ROLE_AGRIPLUS' %}
                        {% elseif 'ROLE_FOURNISSEUR' in user.roles %}{% set userRole = 'ROLE_FOURNISSEUR' %}
                        {% elseif 'ROLE_AGRICULTEUR' in user.roles %}{% set userRole = 'ROLE_AGRICULTEUR' %}
                        {% endif %}
                        {% set roleColor = {'ROLE_AGRICULTEUR':'#16a34a','ROLE_FOURNISSEUR':'#2563eb','ROLE_AGRIPLUS':'#f59e0b','ROLE_ADMIN':'#dc2626','ROLE_USER':'#6b7280'} %}
                        {% set roleLabel = {'ROLE_AGRICULTEUR':'Agriculteur','ROLE_FOURNISSEUR':'Fournisseur','ROLE_AGRIPLUS':'AgriPlus','ROLE_ADMIN':'Admin','ROLE_USER':'Utilisateur'} %}
                        <div class="ag-user-row">
                            <div class="ag-user-avatar" style="background:{{ roleColor[userRole] ?? '#6b7280' }};">
                                {{ user.displayName|slice(0,1)|upper }}
                            </div>
                            <div class="flex-fill text-truncate">
                                <span class="small fw-semibold text-dark">{{ user.displayName }}</span>
                                <span class="d-block text-muted" style="font-size:0.72rem;">{{ user.email }}</span>
                            </div>
                            <span class="ag-badge flex-shrink-0" style="font-size:0.65rem;background:{{ roleColor[userRole] ?? '#6b7280' }}1a;color:{{ roleColor[userRole] ?? '#6b7280' }};border-color:{{ roleColor[userRole] ?? '#6b7280' }}33;">
                                {{ roleLabel[userRole] ?? 'Utilisateur' }}
                            </span>
                            <small class="text-muted flex-shrink-0" style="font-size:0.7rem;">{{ user.createdAt ? user.createdAt|date('d/m') : '' }}</small>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="d-flex flex-column align-items-center justify-content-center py-5 text-muted">
                        <svg width="36" height="36" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="mb-2 opacity-30"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
                        <p class="small fw-medium mb-0">Aucune inscription récente</p>
                        <p class="text-muted" style="font-size:0.75rem;">Les 7 derniers jours</p>
                    </div>
                {% endif %}
            </div>

            {% if recentUsers|length > 0 %}
            <div class="ag-card-footer">
                <a href="{{ path('admin_users_list') }}" class="small fw-semibold text-decoration-none" style="color:#16a34a;">Voir tous les utilisateurs →</a>
            </div>
            {% endif %}
        </div>
    </div>

</div>

{# ── Export Modal ── #}
<div class="modal fade" id="exportModal" tabindex="-1" aria-labelledby="exportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg" style="border-radius:1rem;overflow:hidden;">
            <div class="modal-header border-0 pb-0 px-4 pt-4">
                <h5 class="modal-title fw-bold" id="exportModalLabel">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="me-2 text-primary"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    Générer un rapport
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body px-4 pb-4">
                {# Stats preview #}
                <div class="rounded-3 p-4 mb-4" style="background:#f8fafc;border:1px solid #e2e8f0;">
                    <h6 class="fw-bold text-dark mb-3 small">Aperçu du rapport — Plateforme AgriLink</h6>
                    <div class="row g-3">
                        <div class="col-6 col-md-3 text-center">
                            <div class="fw-bold fs-4" style="color:#dc2626;">{{ stats.total ?? 0 }}</div>
                            <div class="text-muted small">Total utilisateurs</div>
                        </div>
                        <div class="col-6 col-md-3 text-center">
                            <div class="fw-bold fs-4" style="color:#16a34a;">{{ stats.by_role.ROLE_AGRICULTEUR ?? 0 }}</div>
                            <div class="text-muted small">Agriculteurs</div>
                        </div>
                        <div class="col-6 col-md-3 text-center">
                            <div class="fw-bold fs-4 text-primary">{{ stats.by_role.ROLE_FOURNISSEUR ?? 0 }}</div>
                            <div class="text-muted small">Fournisseurs</div>
                        </div>
                        <div class="col-6 col-md-3 text-center">
                            <div class="fw-bold fs-4" style="color:#d97706;">{{ stats.by_role.ROLE_AGRIPLUS ?? 0 }}</div>
                            <div class="text-muted small">AgriPlus</div>
                        </div>
                    </div>
                    <hr class="my-3">
                    <div class="row g-3">
                        <div class="col-6 col-md-3 text-center">
                            <div class="fw-bold fs-5 text-dark">{{ securityStats.loginSuccess ?? 0 }}</div>
                            <div class="text-muted small">Connexions réussies (30j)</div>
                        </div>
                        <div class="col-6 col-md-3 text-center">
                            <div class="fw-bold fs-5 {{ (securityStats.loginFailed ?? 0) > 5 ? 'text-warning' : 'text-dark' }}">{{ securityStats.loginFailed ?? 0 }}</div>
                            <div class="text-muted small">Échecs connexion (30j)</div>
                        </div>
                        <div class="col-6 col-md-3 text-center">
                            <div class="fw-bold fs-5 {{ (securityStats.accountLocked ?? 0) > 0 ? 'text-danger' : 'text-dark' }}">{{ securityStats.accountLocked ?? 0 }}</div>
                            <div class="text-muted small">Comptes verrouillés (30j)</div>
                        </div>
                        <div class="col-6 col-md-3 text-center">
                            <div class="fw-bold fs-5 text-dark">{{ recentUsers|length }}</div>
                            <div class="text-muted small">Inscriptions (7j)</div>
                        </div>
                    </div>
                </div>
                <p class="text-muted small mb-4">Choisissez le format d'export. Le rapport inclut les statistiques utilisateurs, les données de sécurité et les inscriptions récentes.</p>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="ag-export-option export-pdf" onclick="exportPDF()">
                            <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-2" style="width:52px;height:52px;background:rgba(220,53,69,.1);">
                                <svg style="color:#dc3545;" width="26" height="26" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                            </div>
                            <div class="fw-semibold text-dark small">Export PDF</div>
                            <div class="text-muted" style="font-size:0.73rem;">Rapport imprimable avec graphiques</div>
                        </div>
                    </div>
                    <div class="col-12 col-md-6">
                        <div class="ag-export-option export-excel" onclick="exportExcel()">
                            <div class="d-flex align-items-center justify-content-center rounded-circle mx-auto mb-2" style="width:52px;height:52px;background:rgba(25,135,84,.1);">
                                <svg style="color:#198754;" width="26" height="26" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
                            </div>
                            <div class="fw-semibold text-dark small">Export Excel / CSV</div>
                            <div class="text-muted" style="font-size:0.73rem;">Données brutes tabulaires</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
function handleAdminPageLoad() {
    requestAnimationFrame(() => requestAnimationFrame(initializeAdminCharts));
}
document.addEventListener('DOMContentLoaded', handleAdminPageLoad);
document.addEventListener('turbo:load', handleAdminPageLoad);

function initializeAdminCharts() {
    try {
        // Role Distribution Donut
        const roleCtx = document.getElementById('roleDistChart');
        if (roleCtx && typeof Chart !== 'undefined') {
            if (window._roleDistChart) window._roleDistChart.destroy();
            window._roleDistChart = new Chart(roleCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Agriculteurs', 'Fournisseurs', 'AgriPlus', 'Utilisateurs'],
                    datasets: [{
                        data: [
                            {{ stats.by_role.ROLE_AGRICULTEUR ?? 0 }},
                            {{ stats.by_role.ROLE_FOURNISSEUR ?? 0 }},
                            {{ stats.by_role.ROLE_AGRIPLUS ?? 0 }},
                            {{ stats.by_role.ROLE_USER ?? 0 }}
                        ],
                        backgroundColor: ['#16a34a','#2563eb','#f59e0b','#9ca3af'],
                        borderWidth: 3,
                        borderColor: '#ffffff',
                        hoverOffset: 10
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '65%',
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: ctx => ` ${ctx.label}: ${ctx.parsed} utilisateurs` } }
                    }
                }
            });
        }

        // Security Overview Bar
        const secCtx = document.getElementById('securityOverviewChart');
        if (secCtx && typeof Chart !== 'undefined') {
            if (window._securityChart) window._securityChart.destroy();
            window._securityChart = new Chart(secCtx, {
                type: 'bar',
                data: {
                    labels: ['Connexions\nréussies', 'Connexions\néchouées', 'Verrouillages', 'Chgt. mdp', '2FA réussi'],
                    datasets: [{
                        label: '30 derniers jours',
                        data: [
                            {{ securityStats.loginSuccess ?? 0 }},
                            {{ securityStats.loginFailed ?? 0 }},
                            {{ securityStats.accountLocked ?? 0 }},
                            {{ securityStats.passwordChanged ?? 0 }},
                            {{ securityStats.twoFaSuccess ?? 0 }}
                        ],
                        backgroundColor: [
                            'rgba(22,163,74,0.8)',
                            'rgba(220,38,38,0.8)',
                            'rgba(249,115,22,0.8)',
                            'rgba(14,165,233,0.8)',
                            'rgba(139,92,246,0.8)'
                        ],
                        borderColor: ['#16a34a','#dc2626','#f97316','#0ea5e9','#8b5cf6'],
                        borderWidth: 0,
                        borderRadius: 8,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { stepSize: 1, font: { size: 11 }, color: '#9ca3af' },
                            grid: { color: 'rgba(0,0,0,0.04)', drawBorder: false }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { size: 11 }, color: '#9ca3af' }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: { callbacks: { label: ctx => ` ${ctx.parsed.y} événements` } }
                    }
                }
            });
        }
    } catch (error) {
        console.error('Error initializing admin charts:', error);
    }
}

function exportPDF()   { window.location.href = '{{ path('admin_export_pdf') }}'; }
function exportExcel() { window.location.href = '{{ path('admin_export_excel') }}'; }
</script>
<style>
@media print {
    #desktop-sidebar, .mobile-header, .d-lg-none, button, .btn, #exportModal { display: none !important; }
    .dashboard-main-content { margin-left: 0 !important; }
    body { background: white !important; }
    .ag-kpi-card, .ag-chart-card, .ag-card { break-inside: avoid; box-shadow: none !important; border: 1px solid #ccc !important; }
}
</style>
{% endblock %}
