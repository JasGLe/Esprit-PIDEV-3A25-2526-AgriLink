{% extends 'base.html.twig' %}

{% block title %}Vérification - AgriLink{% endblock %}

{% block body %}
{{ include('components/_auth_background.html.twig') }}

<style>
    .auth-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 4px 24px rgba(0,0,0,.08), 0 1px 4px rgba(0,0,0,.04);
        padding: 2.5rem 2rem;
    }
    .email-icon-wrap {
        width: 72px; height: 72px; border-radius: 50%;
        background: linear-gradient(135deg, #ffc107, #fd7e14);
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 1.25rem;
        box-shadow: 0 4px 16px rgba(255,193,7,.35);
    }
    .phone-icon-wrap {
        width: 72px; height: 72px; border-radius: 50%;
        background: linear-gradient(135deg, #22c55e, #16a34a);
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto 1.25rem;
        box-shadow: 0 4px 16px rgba(34, 197, 94, .35);
    }
    .email-address-pill {
        display: inline-flex; align-items: center; gap: .375rem;
        background: #f0fff4; border: 1px solid #b7ebc8;
        border-radius: 50px; padding: .3rem .875rem;
        font-size: .8125rem; font-weight: 600; color: #166534;
        max-width: 100%; overflow: hidden; text-overflow: ellipsis;
    }
    .phone-number-pill {
        display: inline-flex; align-items: center; gap: .375rem;
        background: #f0fdf4; border: 1px solid #86efac;
        border-radius: 50px; padding: .3rem .875rem;
        font-size: .8125rem; font-weight: 600; color: #15803d;
        max-width: 100%; overflow: hidden; text-overflow: ellipsis;
    }
    .otp-input {
        width: 13rem;
        border: 2px solid #dee2e6;
        border-radius: 12px;
        font-size: 2rem; font-family: monospace; font-weight: 700;
        text-align: center; letter-spacing: .6em;
        padding: .625rem 1rem;
        transition: border-color .15s, box-shadow .15s;
    }
    .otp-input:focus {
        border-color: #ffc107;
        box-shadow: 0 0 0 4px rgba(255,193,7,.2);
        outline: none;
    }
    .otp-input.is-valid { border-color: #198754; }
    .otp-input.is-invalid { border-color: #dc3545; }
    .timer-badge {
        display: inline-flex; align-items: center; gap: .5rem;
        padding: .4rem .875rem; border-radius: 50px;
        font-size: .8125rem; font-weight: 600; transition: all .3s;
    }
    .timer-badge.ok     { background: #d1e7dd; color: #0a3622; }
    .timer-badge.warn   { background: #fff3cd; color: #664d03; }
    .timer-badge.danger { background: #f8d7da; color: #58151c; }
    .btn-verify {
        border-radius: 10px; padding: .7rem 1.5rem; font-weight: 600;
        background: linear-gradient(135deg, #ffc107, #fd7e14);
        border: none; color: #1a1a1a;
        transition: opacity .15s, transform .1s;
    }
    .btn-verify:hover  { opacity: .9; transform: translateY(-1px); color:#000; }
    .btn-verify:active { transform: none; }
    .btn-verify:disabled { opacity: .55; transform: none; }
    .btn-verify-sms {
        border-radius: 10px; padding: .7rem 1.5rem; font-weight: 600;
        background: linear-gradient(135deg, #22c55e, #16a34a);
        border: none; color: #fff;
        transition: opacity .15s, transform .1s;
    }
    .btn-verify-sms:hover  { opacity: .9; transform: translateY(-1px); }
    .btn-verify-sms:active { transform: none; }
    .btn-verify-sms:disabled { opacity: .55; transform: none; }
    .skip-link {
        font-size: .8125rem; color: #6c757d;
        text-decoration: none; transition: color .15s;
    }
    .skip-link:hover { color: #495057; }
    .alert-auth { border-radius: 10px; border: none; font-size: .875rem; }
    
    /* Verification method selector */
    .verification-methods {
        display: flex;
        gap: 1rem;
        margin-bottom: 2rem;
    }
    
    .method-btn {
        flex: 1;
        padding: 1.25rem;
        border: 2px solid #e5e7eb;
        border-radius: 12px;
        background: #f9fafb;
        cursor: pointer;
        transition: all 0.3s ease;
        text-align: center;
    }
    
    .method-btn:hover {
        border-color: #ffc107;
        background: #fffbf0;
    }
    
    .method-btn.active {
        border-color: #ffc107;
        background: #fff9f0;
    }
    
    .method-icon {
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
    }
    
    .method-label {
        font-weight: 600;
        font-size: 0.9rem;
        color: #111827;
    }
    
    /* Content sections */
    .verification-content {
        display: none;
        animation: fadeIn 0.3s ease-in;
    }
    
    .verification-content.active {
        display: block;
    }
    
    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .phone-input-field {
        width: 100%;
        padding: 0.625rem 1rem;
        border: 2px solid #dee2e6;
        border-radius: 12px;
        font-size: 0.95rem;
        transition: border-color .15s, box-shadow .15s;
    }

    .phone-input-field:focus {
        border-color: #22c55e;
        box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.1);
        outline: none;
    }

    .form-hint {
        font-size: 0.75rem;
        color: #6b7280;
        margin-top: 0.25rem;
    }

    /* Method selection section - always visible by default, hidden when method chosen */
    #methodSelection {
        display: block;
    }

    #methodSelection.hidden {
        display: none;
    }
</style>

<div class="min-vh-100 d-flex align-items-center justify-content-center py-5 px-3">
    <div class="w-100" style="max-width: 420px;">

        {# Logo #}
        <div class="text-center mb-4">
            <a href="{{ path('app_home') }}">
                <img src="{{ asset('logo_with_text.png') }}" alt="AgriLink" class="logo logo-header">
            </a>
        </div>

        <div class="auth-card">
            {# Flash messages #}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-auth d-flex align-items-start gap-2 mb-3" role="alert">
                        <svg fill="currentColor" viewBox="0 0 20 20" width="16" height="16" class="flex-shrink-0 mt-1">
                            {% if label == 'success' %}
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                            {% else %}
                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                            {% endif %}
                        </svg>
                        <span>{{ message }}</span>
                    </div>
                {% endfor %}
            {% endfor %}

            {# Method Selection Section #}
            <div id="methodSelection">
                <div class="text-center mb-4">
                    <h2 class="h5 fw-bold mb-2">Choisir une méthode de vérification</h2>
                    <p class="text-muted small">Sélectionnez comment vous souhaitez vérifier votre compte</p>
                </div>

                <div class="verification-methods">
                    <button type="button" class="method-btn active" data-method="email" onclick="selectMethod('email')">
                        <div class="method-icon">📧</div>
                        <div class="method-label">Par Email</div>
                    </button>
                    <button type="button" class="method-btn" data-method="sms" onclick="selectMethod('sms')">
                        <div class="method-icon">📱</div>
                        <div class="method-label">Par SMS</div>
                    </button>
                </div>

                <button type="button" 
                        class="btn btn-outline-secondary w-100"
                        style="border-radius:10px;"
                        onclick="skipVerification()">
                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16" class="me-2">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Vérifier plus tard
                </button>
            </div>

            {# EMAIL VERIFICATION CONTENT #}
            <div id="emailContent" class="verification-content active">
                {# Header #}
                <div class="text-center mb-4">
                    <div class="email-icon-wrap">
                        <svg fill="none" stroke="#fff" viewBox="0 0 24 24" width="32" height="32">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <h2 class="h5 fw-bold mb-2">Vérifiez votre adresse email</h2>
                    <p class="text-muted small mb-2">Un code à 6 chiffres a été envoyé à</p>
                    <span class="email-address-pill">
                        <svg fill="currentColor" viewBox="0 0 20 20" width="12" height="12">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                        {{ user.email }}
                    </span>
                </div>

                {# Timer #}
                <div class="text-center mb-3">
                    {% if timeRemaining > 0 %}
                        <span id="timer-badge"
                              class="timer-badge {{ timeRemaining > 60 ? 'ok' : (timeRemaining > 0 ? 'warn' : 'danger') }}">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <span id="timer-text">Valide {{ (timeRemaining / 60)|round(0, 'ceil') }} min</span>
                        </span>
                    {% else %}
                        <span class="timer-badge danger">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="14" height="14">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Code expiré — demandez-en un nouveau
                        </span>
                    {% endif %}
                </div>

                {# OTP form #}
                <form method="post" action="{{ path('app_verify_email') }}" id="verify-form">
                    <div class="d-flex flex-column align-items-center mb-4">
                        <label for="verification_code" class="form-label fw-semibold mb-3 text-center" style="font-size:.9rem;">
                            Entrez le code à 6 chiffres
                        </label>
                        <input type="text"
                               name="verification_code"
                               id="verification_code"
                               maxlength="6"
                               pattern="[0-9]{6}"
                               inputmode="numeric"
                               autocomplete="one-time-code"
                               required
                               class="otp-input"
                               placeholder="——————"
                               autofocus
                               {% if timeRemaining <= 0 %}disabled{% endif %}>
                        <div id="otp-feedback" class="form-text mt-2 text-center" style="min-height:1.2em;"></div>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit"
                                id="submit-btn"
                                class="btn btn-verify"
                                {% if timeRemaining <= 0 %}disabled{% endif %}>
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16" class="me-2">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            Vérifier mon email
                        </button>
                    </div>
                </form>

                {# Resend #}
                <div class="d-grid gap-2 mb-3">
                    {% if canResend %}
                        <form method="post" action="{{ path('app_resend_verification') }}">
                            <button type="submit"
                                    class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2"
                                    style="border-radius:10px;">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                                </svg>
                                Renvoyer le code
                            </button>
                        </form>
                    {% else %}
                        <button type="button"
                                id="resend-disabled"
                                disabled
                                class="btn btn-outline-secondary d-flex align-items-center justify-content-center gap-2"
                                style="border-radius:10px;"
                                data-wait="{{ resendWaitSeconds }}">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <span id="resend-countdown">Renvoyer dans {{ resendWaitSeconds }}s</span>
                        </button>
                    {% endif %}
                </div>

                <div class="pt-3 border-top">
                    <button type="button"
                            class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2"
                            style="border-radius:10px; font-size:.875rem;"
                            onclick="goBackToMethods()">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                        </svg>
                        Changer de méthode
                    </button>
                </div>

                {# Help #}
                <div class="mt-3 p-3 rounded-3 text-muted" style="background:#f8f9fa; font-size:.775rem;">
                    <strong>Pas reçu le code ?</strong>
                    Vérifiez vos spams · Le code est valable 15 minutes · Assurez-vous que l'email est correct.
                </div>
            </div>

            {# SMS VERIFICATION CONTENT #}
            <div id="smsContent" class="verification-content">
                {# Header #}
                <div class="text-center mb-4">
                    <div class="phone-icon-wrap">
                        <svg fill="none" stroke="#fff" viewBox="0 0 24 24" width="32" height="32">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                        </svg>
                    </div>
                    <h2 class="h5 fw-bold mb-2">Vérifiez votre téléphone</h2>
                    <p class="text-muted small mb-2">Entrez votre numéro pour recevoir un code</p>
                </div>

                {# Phone Input Step #}
                <form id="smsPhoneForm">
                    <div class="d-flex flex-column align-items-center mb-4">
                        <label for="phone" class="form-label fw-semibold mb-3 text-center" style="font-size:.9rem;">
                            Numéro de téléphone
                        </label>
                        <input type="tel"
                               name="phone"
                               id="phone"
                               class="phone-input-field"
                               placeholder="98765432 ou +21698765432"
                               value="{{ phone }}"
                               required>
                        <div class="form-hint">Format: 8 chiffres (ex: 98765432) ou numéro international (+216XXXXXXXX)</div>
                    </div>

                    <div class="d-grid mb-3">
                        <button type="button"
                                class="btn btn-verify-sms"
                                onclick="sendSmsOtp()">
                            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16" class="me-2">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 19l9 2-9-18-9 18 9-2m0 0v-8m0 8l-6-4m6 4l6-4"/>
                            </svg>
                            Envoyer le code
                        </button>
                    </div>
                </form>

                {# SMS Code Verification Step #}
                <div id="smsCodeStep" style="display: none;">
                    <div id="smsLoadingState" style="text-align: center; margin: 2rem 0; display: none;">
                        <div class="spinner-border text-success" role="status" style="width: 2rem; height: 2rem;">
                            <span class="visually-hidden">Chargement...</span>
                        </div>
                        <p class="text-muted mt-2">Envoi du code...</p>
                    </div>

                    <div id="smsErrorMessage" style="display: none; padding: 0.75rem; background: #f8d7da; color: #58151c; border-radius: 0.375rem; margin-bottom: 1rem;">
                        <p id="smsErrorText" style="margin: 0;"></p>
                    </div>

                    <form id="smsVerifyForm">
                        <div class="d-flex flex-column align-items-center mb-4">
                            <label for="smsCode" class="form-label fw-semibold mb-3 text-center" style="font-size:.9rem;">
                                Entrez le code à 6 chiffres
                            </label>
                            <input type="text"
                                   name="code"
                                   id="smsCode"
                                   maxlength="6"
                                   pattern="[0-9]{6}"
                                   inputmode="numeric"
                                   class="otp-input"
                                   placeholder="——————"
                                   autocomplete="off">
                            <div id="smsCodExpiration" class="form-text mt-2 text-center" style="min-height:1.2em;"></div>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="button"
                                    class="btn btn-verify-sms"
                                    onclick="verifySmsCode()">
                                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16" class="me-2">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                Vérifier le code
                            </button>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="button"
                                    id="resendSmsBtn"
                                    class="btn btn-outline-secondary"
                                    style="border-radius:10px;"
                                    onclick="resendSmsOtp()"
                                    disabled>
                                Renvoyer le code (60s)
                            </button>
                        </div>

                        <div id="smsMaskedDisplay" style="text-align: center; margin: 1.5rem 0; display: none;">
                            <p style="font-size: 0.875rem; color: #4b5563; margin: 0;">
                                Code envoyé au numéro: <strong id="maskedPhoneDisplay"></strong>
                            </p>
                        </div>
                    </form>
                </div>

                <div class="pt-3 border-top">
                    <button type="button"
                            class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-2"
                            style="border-radius:10px; font-size:.875rem;"
                            onclick="goBackToMethods()">
                        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" width="16" height="16">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                        </svg>
                        Changer de méthode
                    </button>
                </div>

                {# Help #}
                <div class="mt-3 p-3 rounded-3 text-muted" style="background:#f8f9fa; font-size:.775rem;">
                    <strong>Pas reçu le SMS ?</strong>
                    Vérifiez votre numéro · Le code est valable 10 minutes · Assurez-vous que le numéro est correct.
                </div>
            </div>
        </div>
    </div>
</div>

<script>
let currentMethod = 'email';
let smsState = {
    phoneSent: false,
    expirationTime: null,
    expirationTimeout: null,
    resendCooldownTimeout: null,
    maxAttempts: 3,
    remainingAttempts: 3
};
let emailTimeRemaining = {{ timeRemaining }};
let emailResendWait = {{ resendWaitSeconds }};

// Switch between methods
function selectMethod(method) {
    currentMethod = method;
    document.querySelectorAll('.method-btn').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-method') === method);
    });
    
    document.querySelectorAll('.verification-content').forEach(content => {
        content.classList.remove('active');
    });
    
    // Hide method selection and show chosen method
    document.getElementById('methodSelection').classList.add('hidden');
    
    if (method === 'email') {
        document.getElementById('emailContent').classList.add('active');
    } else {
        document.getElementById('smsContent').classList.add('active');
    }
}

// Go back to method selection
function goBackToMethods() {
    currentMethod = null;
    document.querySelectorAll('.method-btn').forEach(btn => {
        btn.classList.remove('active');
    });
    document.getElementById('methodSelection').classList.remove('hidden');
    document.querySelectorAll('.verification-content').forEach(content => {
        content.classList.remove('active');
    });
    document.getElementById('smsPhoneForm').style.display = 'block';
    document.getElementById('smsCodeStep').style.display = 'none';
    document.getElementById('smsCode').value = '';
}

// Skip verification
function skipVerification() {
    window.location.href = '{{ path('app_skip_phone_verification') }}';
}

// Email verification - Timer
function tickEmailExpiry() {
    if (emailTimeRemaining <= 0) {
        const badge = document.getElementById('timer-badge');
        if (badge) {
            badge.className = 'timer-badge danger';
            badge.querySelector('#timer-text').textContent = 'Code expiré — demandez-en un nouveau';
        }
        const btn = document.getElementById('submit-btn');
        const inp = document.getElementById('verification_code');
        if (btn) btn.disabled = true;
        if (inp) { inp.disabled = true; inp.classList.add('is-invalid'); }
        return;
    }
    emailTimeRemaining--;
    const m = Math.floor(emailTimeRemaining / 60);
    const s = emailTimeRemaining % 60;
    const label = m > 0 ? `Valide ${m}:${String(s).padStart(2,'0')}` : `Valide ${s}s`;
    const txt = document.getElementById('timer-text');
    if (txt) txt.textContent = label;
    const badge = document.getElementById('timer-badge');
    if (badge) {
        badge.className = 'timer-badge ' + (emailTimeRemaining > 60 ? 'ok' : emailTimeRemaining > 30 ? 'warn' : 'danger');
    }
}
if (emailTimeRemaining > 0) setInterval(tickEmailExpiry, 1000);

// Email verification - Resend countdown
function tickEmailResend() {
    if (emailResendWait <= 0) { return; }
    emailResendWait--;
    const el = document.getElementById('resend-countdown');
    if (el) el.textContent = `Renvoyer dans ${emailResendWait}s`;
}
if (emailResendWait > 0) setInterval(tickEmailResend, 1000);

// Email verification - OTP input UX
document.addEventListener('DOMContentLoaded', function () {
    const inp = document.getElementById('verification_code');
    const fb  = document.getElementById('otp-feedback');
    if (!inp) return;

    inp.addEventListener('input', function () {
        this.value = this.value.replace(/\D/g, '');
        const n = this.value.length;
        if (n > 0 && n < 6) {
            this.classList.remove('is-valid','is-invalid');
            fb.textContent = `${6-n} chiffre${6-n>1?'s':''} restant${6-n>1?'s':''}`;
            fb.className = 'form-text mt-2 text-center text-muted';
        } else if (n === 6) {
            this.classList.add('is-valid');
            this.classList.remove('is-invalid');
            fb.textContent = '✓ Code complet';
            fb.className = 'form-text mt-2 text-center text-success';
            setTimeout(() => document.getElementById('verify-form').submit(), 150);
        } else {
            this.classList.remove('is-valid','is-invalid');
            fb.textContent = '';
        }
    });
});

// SMS Functions
async function sendSmsOtp() {
    const phone = document.getElementById('phone').value.trim();
    const errorDiv = document.getElementById('smsErrorMessage');
    
    if (!phone) {
        showSmsError('Veuillez entrer votre numéro de téléphone');
        return;
    }

    try {
        showSmsLoading(true);
        hideSmsError();

        const response = await fetch('{{ path("app_send_phone_otp") }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({ phone: phone })
        });

        let data;
        try {
            data = await response.json();
        } catch (parseError) {
            console.error('JSON Parse Error:', parseError);
            showSmsError('Erreur serveur. Veuillez réessayer plus tard.');
            return;
        }

        if (!response.ok) {
            showSmsError(data.message || 'Erreur lors de l\'envoi du code');
            return;
        }

        // Success
        smsState.phoneSent = true;
        smsState.expirationTime = Date.now() + (data.expires_in * 1000);

        // Switch to code input step
        document.getElementById('smsPhoneForm').style.display = 'none';
        document.getElementById('smsCodeStep').style.display = 'block';
        document.getElementById('smsMaskedDisplay').style.display = 'block';
        document.getElementById('maskedPhoneDisplay').textContent = data.phone;

        // Start countdowns
        startSmsExpirationCountdown();
        startSmsResendCooldown();

        // Focus on code input
        document.getElementById('smsCode').focus();
    } catch (error) {
        console.error('Error:', error);
        showSmsError('Erreur réseau. Veuillez réessayer.');
    } finally {
        showSmsLoading(false);
    }
}

async function verifySmsCode() {
    const code = document.getElementById('smsCode').value.trim();

    if (!code || code.length !== 6) {
        showSmsError('Veuillez entrer un code de 6 chiffres');
        return;
    }

    try {
        showSmsLoading(true);
        hideSmsError();

        const response = await fetch('{{ path("app_verify_phone_code") }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({ code: code })
        });

        let data;
        try {
            data = await response.json();
        } catch (parseError) {
            console.error('JSON Parse Error:', parseError);
            showSmsError('Erreur serveur. Veuillez réessayer plus tard.');
            return;
        }

        if (!response.ok) {
            if (data.expired) {
                resetSmsToPhoneInput();
                showSmsError(data.message);
            } else {
                smsState.remainingAttempts = data.remaining_attempts || 0;
                showSmsError(data.message);
            }
            return;
        }

        // Success - redirect
        setTimeout(() => {
            window.location.href = data.redirect || '{{ path("app_dashboard") }}';
        }, 1000);
    } catch (error) {
        console.error('Error:', error);
        showSmsError('Erreur réseau. Veuillez réessayer.');
    } finally {
        showSmsLoading(false);
    }
}

async function resendSmsOtp() {
    const resendBtn = document.getElementById('resendSmsBtn');
    if (resendBtn.disabled) return;

    const phone = document.getElementById('phone').value.trim();

    try {
        showSmsLoading(true);
        hideSmsError();

        const response = await fetch('{{ path("app_send_phone_otp") }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: new URLSearchParams({ phone: phone })
        });

        let data;
        try {
            data = await response.json();
        } catch (parseError) {
            console.error('JSON Parse Error:', parseError);
            showSmsError('Erreur serveur. Veuillez réessayer plus tard.');
            return;
        }

        if (!response.ok) {
            showSmsError(data.message || 'Erreur lors du renvoi du code');
            return;
        }

        smsState.expirationTime = Date.now() + (data.expires_in * 1000);
        document.getElementById('smsCode').value = '';
        startSmsExpirationCountdown();
        startSmsResendCooldown();
        document.getElementById('smsCode').focus();
    } catch (error) {
        console.error('Error:', error);
        showSmsError('Erreur réseau. Veuillez réessayer.');
    } finally {
        showSmsLoading(false);
    }
}

// SMS Helper Functions
function showSmsError(message) {
    const errorDiv = document.getElementById('smsErrorMessage');
    const errorText = document.getElementById('smsErrorText');
    if (errorDiv && errorText) {
        errorText.textContent = message;
        errorDiv.style.display = 'block';
    }
}

function hideSmsError() {
    const errorDiv = document.getElementById('smsErrorMessage');
    if (errorDiv) {
        errorDiv.style.display = 'none';
    }
}

function showSmsLoading(show) {
    const loadingDiv = document.getElementById('smsLoadingState');
    if (loadingDiv) {
        loadingDiv.style.display = show ? 'block' : 'none';
    }
}

function startSmsExpirationCountdown() {
    if (smsState.expirationTimeout) {
        clearInterval(smsState.expirationTimeout);
    }

    updateSmsExpirationDisplay();

    smsState.expirationTimeout = setInterval(() => {
        updateSmsExpirationDisplay();
    }, 1000);
}

function updateSmsExpirationDisplay() {
    const now = Date.now();
    const remaining = Math.max(0, Math.floor((smsState.expirationTime - now) / 1000));
    const text = document.getElementById('smsCodExpiration');
    if (text) {
        text.textContent = `Code expire dans ${remaining}s`;
    }

    if (remaining === 0) {
        clearInterval(smsState.expirationTimeout);
        resetSmsToPhoneInput();
        showSmsError('Le code a expiré. Veuillez en demander un nouveau.');
    }
}

function startSmsResendCooldown() {
    const resendBtn = document.getElementById('resendSmsBtn');
    resendBtn.disabled = true;

    if (smsState.resendCooldownTimeout) {
        clearInterval(smsState.resendCooldownTimeout);
    }

    let cooldown = 60;
    updateSmsResendButton(cooldown);

    smsState.resendCooldownTimeout = setInterval(() => {
        cooldown--;

        if (cooldown <= 0) {
            clearInterval(smsState.resendCooldownTimeout);
            resendBtn.disabled = false;
            resendBtn.textContent = 'Renvoyer le code';
        } else {
            updateSmsResendButton(cooldown);
        }
    }, 1000);
}

function updateSmsResendButton(seconds) {
    document.getElementById('resendSmsBtn').textContent = `Renvoyer le code (${seconds}s)`;
}

function resetSmsToPhoneInput() {
    document.getElementById('smsPhoneForm').style.display = 'block';
    document.getElementById('smsCodeStep').style.display = 'none';
    document.getElementById('smsCode').value = '';
    document.getElementById('phone').focus();
}

// SMS input validation
document.addEventListener('DOMContentLoaded', function () {
    const inp = document.getElementById('smsCode');
    if (!inp) return;

    inp.addEventListener('input', function () {
        this.value = this.value.replace(/\D/g, '');
    });
});
</script>
