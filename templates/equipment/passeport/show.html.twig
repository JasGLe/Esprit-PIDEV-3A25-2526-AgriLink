<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Passeport — {{ equipement.nom }}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f0f4f0; font-family: 'Segoe UI', sans-serif; }

        .passeport {
            max-width: 680px;
            margin: 2rem auto;
            background: #fff;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 8px 40px rgba(0,0,0,0.12);
        }

        /* ── En-tête vert style document officiel ── */
        .passeport-header {
            background: linear-gradient(135deg, #1a6b3a, #198754);
            color: white;
            padding: 2rem;
            position: relative;
        }
        .passeport-header::after {
            content: 'AGRILINK';
            position: absolute;
            right: 1.5rem;
            top: 50%;
            transform: translateY(-50%);
            font-size: 3.5rem;
            font-weight: 900;
            opacity: 0.08;
            letter-spacing: .1em;
        }
        .passeport-title {
            font-size: .7rem;
            letter-spacing: .2em;
            text-transform: uppercase;
            opacity: .75;
            margin-bottom: .3rem;
        }
        .passeport-nom {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: .2rem;
        }
        .passeport-code {
            font-family: monospace;
            font-size: .9rem;
            opacity: .8;
            background: rgba(255,255,255,0.15);
            padding: .2rem .6rem;
            border-radius: 6px;
            display: inline-block;
        }

        /* ── Photo + QR ── */
        .passeport-media {
            display: flex;
            gap: 1rem;
            padding: 1.5rem 2rem;
            background: #f8fdf9;
            border-bottom: 1px solid #e9f5ee;
        }
        .passeport-photo {
            width: 130px;
            height: 130px;
            border-radius: 12px;
            object-fit: cover;
            border: 3px solid #198754;
            flex-shrink: 0;
        }
        .passeport-photo-placeholder {
            width: 130px;
            height: 130px;
            border-radius: 12px;
            background: #e9f5ee;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3.5rem;
            flex-shrink: 0;
            border: 3px solid #c3e6cb;
        }
        .passeport-qr {
            width: 130px;
            height: 130px;
            border-radius: 12px;
            border: 3px solid #198754;
            flex-shrink: 0;
            margin-left: auto;
        }
        .passeport-qr-label {
            font-size: .65rem;
            color: #6c757d;
            text-align: center;
            margin-top: .3rem;
        }

        /* ── Indicateur de santé ── */
        .sante-card {
            margin: 1.5rem 2rem;
            border-radius: 14px;
            padding: 1rem 1.2rem;
            border: 2px solid;
        }
        .sante-label {
            font-size: .7rem;
            text-transform: uppercase;
            letter-spacing: .1em;
            font-weight: 700;
            opacity: .7;
        }
        .sante-titre {
            font-size: 1.3rem;
            font-weight: 700;
        }
        .sante-barre-bg {
            background: rgba(0,0,0,0.08);
            border-radius: 99px;
            height: 8px;
            margin-top: .5rem;
        }
        .sante-barre-fill {
            height: 8px;
            border-radius: 99px;
            transition: width .5s;
        }

        /* ── Sections ── */
        .passeport-section {
            padding: 1rem 2rem;
            border-bottom: 1px solid #f0f4f0;
        }
        .section-title {
            font-size: .7rem;
            text-transform: uppercase;
            letter-spacing: .15em;
            color: #198754;
            font-weight: 700;
            margin-bottom: .8rem;
        }
        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: .6rem 1rem;
        }
        .info-label {
            font-size: .7rem;
            color: #6c757d;
            text-transform: uppercase;
            letter-spacing: .05em;
            font-weight: 600;
        }
        .info-value {
            font-size: .95rem;
            font-weight: 600;
            color: #1a1a2e;
        }

        /* ── Badge statut ── */
        .badge-actif         { background: #d1e7dd; color: #0a3622; }
        .badge-en-panne      { background: #f8d7da; color: #58151c; }
        .badge-en-maintenance{ background: #fff3cd; color: #664d03; }
        .badge-hors-service  { background: #e2e3e5; color: #41464b; }

        /* ── Historique maintenances ── */
        .maintenance-item {
            display: flex;
            align-items: center;
            gap: .8rem;
            padding: .5rem 0;
            border-bottom: 1px solid #f0f4f0;
        }
        .maintenance-item:last-child { border-bottom: none; }
        .maintenance-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        /* ── Footer ── */
        .passeport-footer {
            background: #1a6b3a;
            color: rgba(255,255,255,0.7);
            text-align: center;
            padding: .8rem;
            font-size: .75rem;
        }
        .passeport-footer strong { color: #fff; }

        @media (max-width: 480px) {
            .passeport { margin: 0; border-radius: 0; }
            .info-grid { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body>

<div class="passeport">

    {# ── En-tête ── #}
    <div class="passeport-header">
        <div class="passeport-title">🌿 Passeport Numérique · AgriLink</div>
        <div class="passeport-nom">{{ equipement.nom }}</div>
        <div class="mt-1">
            <span class="passeport-code">{{ equipement.codePasseport }}</span>
        </div>
    </div>

    {# ── Photo + QR ── #}
    <div class="passeport-media">
        {# Photo équipement #}
        {% if equipement.imageUrl %}
            {# uploads_base_url = /uploads (symfony serve) — |split('/')|last extrait le nom de fichier quel que soit le format stocké en DB #}
            <img src="{{ uploads_base_url }}/equipements/{{ equipement.imageUrl|split('/')|last }}"
                 alt="{{ equipement.nom }}"
                 class="passeport-photo">
        {% else %}
            <div class="passeport-photo-placeholder">🚜</div>
        {% endif %}

        {# Infos centrales #}
        <div class="flex-fill">
            {% set statut = equipement.statut %}
            {% set badgeClass = statut == 'Actif' ? 'badge-actif' :
               (statut == 'En panne' ? 'badge-en-panne' :
               (statut == 'En maintenance' ? 'badge-en-maintenance' : 'badge-hors-service')) %}
            <span class="badge {{ badgeClass }} px-3 py-1 rounded-pill mb-2 d-inline-block">
                {{ equipement.statut ?? 'N/A' }}
            </span>
            <div class="info-label">Type</div>
            <div class="info-value mb-1">{{ equipement.type ?? '—' }}</div>
            <div class="info-label">Catégorie</div>
            <div class="info-value">{{ equipement.categorie ?? '—' }}</div>
        </div>

        {# QR Code #}
        <div class="text-center">
            <img src="{{ qrUrl }}" alt="QR Code" class="passeport-qr">
            <div class="passeport-qr-label">Scanner pour accéder</div>
        </div>
    </div>

    {# ── Indicateur de santé ── #}
    <div class="sante-card" style="border-color: {{ sante.color }}; background: {{ sante.color }}12;">
        <div class="sante-label">Indicateur de santé</div>
        <div class="d-flex align-items-center gap-2">
            <span style="font-size:1.5rem">{{ sante.emoji }}</span>
            <div>
                <div class="sante-titre" style="color: {{ sante.color }}">{{ sante.label }}</div>
                <div style="font-size:.8rem; color:#555">{{ sante.message }}</div>
            </div>
            <div class="ms-auto fw-bold" style="color: {{ sante.color }}; font-size:1.3rem">
                {{ sante.score }}%
            </div>
        </div>
        <div class="sante-barre-bg mt-2">
            <div class="sante-barre-fill" style="width:{{ sante.score }}%; background:{{ sante.color }}"></div>
        </div>
    </div>

    {# ── Carte d'identité technique ── #}
    <div class="passeport-section">
        <div class="section-title">📋 Carte d'identité technique</div>
        <div class="info-grid">
            <div>
                <div class="info-label">Marque</div>
                <div class="info-value">{{ equipement.marque ?? '—' }}</div>
            </div>
            <div>
                <div class="info-label">Modèle</div>
                <div class="info-value">{{ equipement.modele ?? '—' }}</div>
            </div>
            <div>
                <div class="info-label">Date d'acquisition</div>
                <div class="info-value">
                    {{ equipement.dateAcquisition ? equipement.dateAcquisition|date('d/m/Y') : '—' }}
                </div>
            </div>
            <div>
                <div class="info-label">Enregistré le</div>
                <div class="info-value">
                    {{ equipement.dateCreation ? equipement.dateCreation|date('d/m/Y') : '—' }}
                </div>
            </div>
            {% if equipement.description %}
            <div style="grid-column: span 2">
                <div class="info-label">Description</div>
                <div class="info-value" style="font-weight:400; font-size:.9rem">
                    {{ equipement.description }}
                </div>
            </div>
            {% endif %}
        </div>
    </div>

    {# ── Données véhicule ── #}
    {% if equipement.isVehicule() %}
    <div class="passeport-section">
        <div class="section-title">🚗 Données véhicule</div>
        <div class="info-grid">
            <div>
                <div class="info-label">Kilométrage actuel</div>
                <div class="info-value">
                    {{ equipement.kilometrageActuel is not null
                        ? equipement.kilometrageActuel|number_format(0, ',', ' ') ~ ' km'
                        : '—' }}
                </div>
            </div>
            <div>
                <div class="info-label">Seuil maintenance (km)</div>
                <div class="info-value">
                    {{ equipement.seuilKmMaintenance is not null
                        ? equipement.seuilKmMaintenance|number_format(0, ',', ' ') ~ ' km'
                        : '—' }}
                </div>
            </div>
            <div>
                <div class="info-label">Heures d'utilisation</div>
                <div class="info-value">
                    {{ equipement.heuresUtilisation is not null
                        ? equipement.heuresUtilisation ~ ' h'
                        : '—' }}
                </div>
            </div>
            <div>
                <div class="info-label">Seuil maintenance (h)</div>
                <div class="info-value">
                    {{ equipement.seuilHeuresMaintenance is not null
                        ? equipement.seuilHeuresMaintenance ~ ' h'
                        : '—' }}
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {# ── Historique maintenances ── #}
    <div class="passeport-section">
        <div class="section-title">🔧 Dernières maintenances</div>
        {% if maintenances is empty %}
            <p class="text-muted small mb-0">Aucune maintenance enregistrée.</p>
        {% else %}
            {% for m in maintenances %}
                {% set dotColor = m.statut == 'Terminée' ? '#198754' :
                   (m.statut == 'En cours' ? '#ffc107' :
                   (m.statut == 'Annulée' ? '#6c757d' : '#0d6efd')) %}
                <div class="maintenance-item">
                    <div class="maintenance-dot" style="background: {{ dotColor }}"></div>
                    <div class="flex-fill">
                        <div style="font-size:.85rem; font-weight:600">
                            {{ m.type }} — {{ m.categorie }}
                        </div>
                        <div style="font-size:.75rem; color:#6c757d">
                            {{ m.datePlanifiee ? m.datePlanifiee|date('d/m/Y') : '—' }}
                            {% if m.isEnRetard() %}
                                <span style="color:#dc3545; font-weight:600"> · En retard</span>
                            {% endif %}
                        </div>
                    </div>
                    <span class="badge rounded-pill"
                          style="background:{{ dotColor }}20; color:{{ dotColor }}; font-size:.7rem">
                        {{ m.statut }}
                    </span>
                </div>
            {% endfor %}
        {% endif %}
    </div>

    {# ── Footer ── #}
    <div class="passeport-footer">
        Document généré par <strong>AgriLink</strong> ·
        Code : <strong>{{ equipement.codePasseport }}</strong> ·
        {{ "now"|date("d/m/Y") }}
    </div>

</div>

</body>
</html>