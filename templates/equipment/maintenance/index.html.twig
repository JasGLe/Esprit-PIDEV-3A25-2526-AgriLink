{% extends 'layouts/dashboard_layout.html.twig' %}

{% block page_title %}Mes Maintenances{% endblock %}

{% block stylesheets %}
<style>
/* ════════════════════════════════
   KPI CARDS
════════════════════════════════ */
.kpi-card {
    border-radius: 14px;
    border: none;
    box-shadow: 0 2px 14px rgba(0,0,0,.07);
    transition: transform .2s ease, box-shadow .2s ease;
    overflow: hidden;
}
.kpi-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.12); }
.kpi-icon {
    width: 52px; height: 52px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.45rem; flex-shrink: 0;
}
.kpi-retard-active { background: linear-gradient(135deg, #fff1f2, #fff); }

/* ════════════════════════════════
   FILTRE
════════════════════════════════ */
.filter-card {
    border-radius: 14px;
    border: 1px solid #e2f0ea;
    box-shadow: 0 1px 8px rgba(25,135,84,.06);
}

/* ════════════════════════════════
   MAINTENANCE CARDS
════════════════════════════════ */
.card-maintenance {
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 1px 8px rgba(0,0,0,.06);
    transition: all .25s ease;
    overflow: hidden;
}
.card-maintenance:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,.13);
}

/* Header */
.maint-header {
    background: #fff;
    padding: .85rem 1rem;
    border-bottom: 1px solid #e9ecef;
}

/* Equipment strip */
.maint-equip {
    background: #f8fafc;
    border-bottom: 1px solid #e9ecef;
    padding: .6rem 1rem;
    font-size: .88rem;
}
.maint-equip a { color: #198754; font-weight: 600; text-decoration: none; }
.maint-equip a:hover { text-decoration: underline; }

/* Info grid */
.maint-body {
    padding: .85rem 1rem;
}
.info-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: .6rem .75rem;
}
.info-cell .ic-label {
    font-size: .72rem; color: #94a3b8;
    text-transform: uppercase; letter-spacing: .04em;
    margin-bottom: .18rem;
}
.ic-val {
    font-size: .88rem; font-weight: 600; color: #1e293b;
}
.ic-val.ic-empty     { color: #94a3b8; font-weight: 400; font-style: italic; }
.ic-val.ic-retard    { color: #dc3545; }
.ic-val.ic-ok        { color: #198754; }
.ic-val.ic-cost      { color: #198754; font-size: .95rem; }
.ic-val.ic-cost-none { color: #94a3b8; font-weight: 400; font-style: italic; font-size: .83rem; }

/* Description */
.maint-desc {
    background: #f0fdf4;
    border-left: 3px solid #198754;
    padding: .5rem .85rem;
    margin: .75rem 1rem 0;
    border-radius: 0 6px 6px 0;
    font-size: .85rem; font-style: italic; color: #374151;
    line-height: 1.45;
}

/* Footer */
.maint-footer {
    background: #f8fffe;
    border-top: 1px solid #e9ecef;
    padding: .6rem 1rem;
    display: flex; gap: .5rem; justify-content: flex-end;
    align-items: center;
}

/* ── Badges ── */
.bdg {
    display: inline-flex; align-items: center;
    padding: .22em .65em; border-radius: 20px;
    font-size: .72rem; font-weight: 600; line-height: 1.4;
    white-space: nowrap;
}
.bdg-prev     { background: #dbeafe; color: #1e40af; }
.bdg-corr     { background: #fce7f3; color: #9d174d; }
.bdg-plan     { background: #e0e7ff; color: #3730a3; }
.bdg-encours  { background: #fef3c7; color: #92400e; }
.bdg-term     { background: #d1fae5; color: #065f46; }
.bdg-annul    { background: #f3f4f6; color: #6b7280; }
.bdg-retard   { background: #fee2e2; color: #991b1b; font-weight: 700; }
.bdg-ontime   { background: #d1fae5; color: #065f46; }

/* ════════════════════════════════
   PAGINATION (vert AgriLink)
════════════════════════════════ */
.pagination .page-item.active .page-link   { background-color: #198754; border-color: #198754; color: #fff; }
.pagination .page-item .page-link          { color: #198754; }
.pagination .page-item .page-link:hover    { background: #d1e7dd; border-color: #198754; color: #198754; }
.pagination .page-item.disabled .page-link { color: #6c757d; }
</style>
{% endblock %}

{% block dashboard_content %}

    {# ── Breadcrumb ── #}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('equipement_index') }}">Équipements</a></li>
            <li class="breadcrumb-item active">Maintenances</li>
        </ol>
    </nav>

    {# ── Header ── #}
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-0">🔧 Mes Maintenances</h2>
            <span class="text-muted small">
                {{ maintenances.getTotalItemCount() }} résultat(s)
                {% if search or statut or type %}
                    <span class="text-secondary">— filtrés sur {{ kpiTotal }} au total</span>
                {% endif %}
            </span>
        </div>
        <a href="{{ path('maintenance_new') }}" class="btn btn-success px-4">
            + Planifier une maintenance
        </a>
    </div>

    {# ════════════════════════════════
       KPIs
    ════════════════════════════════ #}
    <div class="row g-3 mb-4">

        <div class="col-sm-4">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="kpi-icon" style="background:#d1fae5">🔧</div>
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing:.04em">Total</div>
                        <div class="fs-2 fw-bold" style="color:#198754;line-height:1.1">{{ kpiTotal }}</div>
                        <div class="text-muted" style="font-size:.75rem">maintenances</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-4">
            <div class="card kpi-card h-100 {{ kpiRetard > 0 ? 'kpi-retard-active' : '' }}">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="kpi-icon" style="background:{{ kpiRetard > 0 ? '#fee2e2' : '#d1fae5' }}">⚠️</div>
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing:.04em">En retard</div>
                        <div class="fs-2 fw-bold" style="color:{{ kpiRetard > 0 ? '#dc3545' : '#198754' }};line-height:1.1">{{ kpiRetard }}</div>
                        <div class="text-muted" style="font-size:.75rem">{{ kpiRetard > 0 ? 'action requise' : 'tout est à jour' }}</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-4">
            <div class="card kpi-card h-100">
                <div class="card-body d-flex align-items-center gap-3 py-3">
                    <div class="kpi-icon" style="background:#dbeafe">💰</div>
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase" style="letter-spacing:.04em">Coût total</div>
                        {% if kpiCout > 0 %}
                            <div class="fw-bold" style="color:#198754;line-height:1.1;font-size:1.35rem">
                                {{ kpiCout|number_format(2, ',', ' ') }} TND
                            </div>
                        {% else %}
                            <div class="text-muted fst-italic" style="font-size:.85rem;margin-top:.2rem">
                                Aucun coût enregistré
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

    </div>

    {# ════════════════════════════════
       FILTRES — auto-submit JS
    ════════════════════════════════ #}
    <div class="card filter-card shadow-sm mb-4">
        <div class="card-body py-3">
            <form method="get" action="{{ path('maintenance_index') }}" id="filter-form">
                <div class="row g-2 align-items-end">

                    <div class="col-md-5">
                        <label class="form-label fw-semibold small mb-1">Recherche</label>
                        <input type="text" id="filter-search" name="search" value="{{ search }}"
                               class="form-control"
                               placeholder="Description, technicien, catégorie…"
                               autocomplete="off">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold small mb-1">Statut</label>
                        <select id="filter-statut" name="statut" class="form-select">
                            <option value="">Tous les statuts</option>
                            {% for val in ['Planifiée','En cours','Terminée','Annulée'] %}
                                <option value="{{ val }}" {{ statut == val ? 'selected' : '' }}>{{ val }}</option>
                            {% endfor %}
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold small mb-1">Type</label>
                        <select id="filter-type" name="type" class="form-select">
                            <option value="">Tous</option>
                            <option value="Préventive" {{ type == 'Préventive' ? 'selected' : '' }}>Préventive</option>
                            <option value="Corrective" {{ type == 'Corrective' ? 'selected' : '' }}>Corrective</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        {% if search or statut or type %}
                            <a href="{{ path('maintenance_index') }}"
                               class="btn btn-outline-secondary btn-sm w-100"
                               title="Réinitialiser les filtres">✕ Réinitialiser</a>
                        {% endif %}
                    </div>

                </div>
            </form>
        </div>
    </div>

    {# ════════════════════════════════
       CONTENU
    ════════════════════════════════ #}
    {% if maintenances.getTotalItemCount() == 0 %}

        <div class="text-center py-5 text-muted">
            <div style="font-size:3.5rem">🔧</div>
            {% if search or statut or type %}
                <p class="mt-2 fw-semibold">Aucune maintenance ne correspond à vos filtres.</p>
                <a href="{{ path('maintenance_index') }}" class="btn btn-outline-secondary mt-2">Réinitialiser les filtres</a>
            {% else %}
                <p class="mt-2">Aucune maintenance planifiée pour l'instant.</p>
                <a href="{{ path('maintenance_new') }}" class="btn btn-success mt-2">Planifier maintenant</a>
            {% endif %}
        </div>

    {% else %}

        <div class="row g-3">
            {% for m in maintenances %}
                {% set eq         = equipMap[m.equipementId] ?? null %}
                {% set enRetard   = m.isEnRetard() %}
                {% set isTerminee = m.statut == 'Terminée' %}
                {% set isAnnulee  = m.statut == 'Annulée' %}

                {# Couleur de la bordure top #}
                {% if isTerminee %}
                    {% set topColor = '#6c757d' %}
                {% elseif isAnnulee %}
                    {% set topColor = '#adb5bd' %}
                {% elseif enRetard %}
                    {% set topColor = '#dc3545' %}
                {% else %}
                    {% set topColor = '#198754' %}
                {% endif %}

                {# Classe badge statut #}
                {% if m.statut == 'Planifiée' %}   {% set bdgStatut = 'bdg-plan' %}
                {% elseif m.statut == 'En cours' %} {% set bdgStatut = 'bdg-encours' %}
                {% elseif m.statut == 'Terminée' %} {% set bdgStatut = 'bdg-term' %}
                {% else %}                          {% set bdgStatut = 'bdg-annul' %}
                {% endif %}

                <div class="col-md-6">
                    <div class="card card-maintenance h-100">

                        {# ── Header ── #}
                        <div class="maint-header" style="border-top: 3px solid {{ topColor }}">
                            <div class="d-flex align-items-center flex-wrap gap-1">

                                {# Badge type #}
                                <span class="bdg {{ m.type == 'Préventive' ? 'bdg-prev' : 'bdg-corr' }}">
                                    {{ m.type }}
                                </span>

                                {# Badge statut #}
                                <span class="bdg {{ bdgStatut }}">{{ m.statut }}</span>

                                {# Badge retard / délais — poussé à droite #}
                                <span class="ms-auto">
                                    {% if enRetard %}
                                        <span class="bdg bdg-retard">⚠ En retard</span>
                                    {% elseif not isTerminee and not isAnnulee %}
                                        <span class="bdg bdg-ontime">✓ Dans les délais</span>
                                    {% endif %}
                                </span>

                            </div>
                        </div>

                        {# ── Bande équipement ── #}
                        <div class="maint-equip">
                            🔧 Équipement :
                            {% if eq %}
                                <a href="{{ path('equipement_show', {id: eq.id}) }}">{{ eq.nom }}</a>
                                <span class="text-muted ms-1">· {{ eq.type }}</span>
                            {% else %}
                                <span class="text-muted fst-italic">Inconnu</span>
                            {% endif %}
                        </div>

                        {# ── Grille infos ── #}
                        <div class="maint-body">
                            <div class="info-grid">

                                {# Date planifiée #}
                                <div class="info-cell">
                                    <div class="ic-label">📅 Date planifiée</div>
                                    <div class="ic-val {{ enRetard ? 'ic-retard' : '' }}">
                                        {{ m.datePlanifiee ? m.datePlanifiee|date('d/m/Y') : '—' }}
                                        {% if enRetard %}&nbsp;⚠{% endif %}
                                    </div>
                                </div>

                                {# Date réalisée #}
                                <div class="info-cell">
                                    <div class="ic-label">✅ Date réalisée</div>
                                    <div class="ic-val {{ m.dateReelle ? 'ic-ok' : 'ic-empty' }}">
                                        {{ m.dateReelle ? m.dateReelle|date('d/m/Y') : '—' }}
                                    </div>
                                </div>

                                {# Catégorie #}
                                <div class="info-cell">
                                    <div class="ic-label">🗂 Catégorie</div>
                                    <div class="ic-val {{ not m.categorie ? 'ic-empty' : '' }}">
                                        {{ m.categorie ?? '—' }}
                                    </div>
                                </div>

                                {# Technicien #}
                                <div class="info-cell">
                                    <div class="ic-label">👷 Technicien</div>
                                    <div class="ic-val {{ not m.technicien ? 'ic-empty' : '' }}">
                                        {{ m.technicien ?? 'Non assigné' }}
                                    </div>
                                </div>

                                {# Coût — pleine largeur #}
                                <div class="info-cell" style="grid-column: 1 / -1">
                                    <div class="ic-label">💰 Coût</div>
                                    {% if m.cout and m.cout > 0 %}
                                        <div class="ic-val ic-cost">
                                            {{ m.cout|number_format(2, ',', ' ') }}
                                            <span class="badge ms-1"
                                                  style="background:#d1fae5;color:#065f46;font-size:.72rem;font-weight:600;padding:.2em .6em;border-radius:10px">
                                                TND
                                            </span>
                                        </div>
                                    {% else %}
                                        <div class="ic-val ic-cost-none">Non renseigné</div>
                                    {% endif %}
                                </div>

                            </div>{# /info-grid #}

                            {# Description #}
                            {% if m.description %}
                                <div class="maint-desc" title="{{ m.description }}">
                                    {{ m.description|length > 100
                                        ? m.description|slice(0,100) ~ '…'
                                        : m.description }}
                                </div>
                            {% endif %}

                        </div>{# /maint-body #}

                        {# ── Footer actions ── #}
                        <div class="maint-footer">
                            <a href="{{ path('maintenance_show', {id: m.id}) }}"
                               class="btn btn-sm btn-outline-success">Voir</a>
                            <a href="{{ path('maintenance_edit', {id: m.id}) }}"
                               class="btn btn-sm btn-outline-secondary">✏️ Modifier</a>
                            <form method="post"
                                  action="{{ path('maintenance_delete', {id: m.id}) }}"
                                  onsubmit="return confirm('Supprimer cette maintenance ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ m.id) }}">
                                <button class="btn btn-sm btn-outline-danger" type="submit">🗑</button>
                            </form>
                        </div>

                    </div>{# /card-maintenance #}
                </div>

            {% endfor %}
        </div>

        {# ── Pagination ── #}
        {% if maintenances.pageCount > 1 %}
        <div class="d-flex justify-content-center mt-4">
            {{ knp_pagination_render(maintenances, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig') }}
        </div>
        {% endif %}

    {% endif %}

{# ════════════════════════════════
   JS — Filtres auto-submit
════════════════════════════════ #}
<script>
(function () {
    var form   = document.getElementById('filter-form');
    var search = document.getElementById('filter-search');
    var statut = document.getElementById('filter-statut');
    var type   = document.getElementById('filter-type');
    if (!form) return;

    var debounceTimer = null;
    if (search) {
        search.addEventListener('input', function () {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(function () { form.submit(); }, 800);
        });
        search.addEventListener('keydown', function (e) {
            if (e.key === 'Enter') {
                clearTimeout(debounceTimer);
                e.preventDefault();
                form.submit();
            }
        });
    }

    if (statut) { statut.addEventListener('change', function () { form.submit(); }); }
    if (type)   { type.addEventListener('change',   function () { form.submit(); }); }
})();
</script>

{% endblock %}
