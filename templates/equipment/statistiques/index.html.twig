{% extends 'layouts/dashboard_layout.html.twig' %}

{% block page_title %}Statistiques Équipements{% endblock %}

{% block stylesheets %}
<meta http-equiv="Cache-Control" content="no-store">
<style>
    .stat-card       { border-radius: 12px; border: none; }
    .stat-number     { font-size: 2.2rem; font-weight: 700; }
    .stat-label      { font-size: .85rem; color: #6c757d; }
    .chart-container { position: relative; height: 260px; }
</style>
{% endblock %}

{% block dashboard_content %}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-0">📊 Statistiques</h2>
        <span class="text-muted">Vue d'ensemble de vos équipements et maintenances</span>
    </div>
</div>

{# ── KPI Cards ── #}
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card stat-card shadow-sm h-100 border-start border-success border-4">
            <div class="card-body">
                <div class="stat-number text-success">{{ totalEquipements }}</div>
                <div class="stat-label">Équipements total</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card shadow-sm h-100 border-start border-primary border-4">
            <div class="card-body">
                <div class="stat-number text-primary">{{ totalMaintenances }}</div>
                <div class="stat-label">Maintenances total</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card shadow-sm h-100 border-start border-warning border-4">
            <div class="card-body">
                <div class="stat-number text-warning">{{ equipParStatut['En maintenance'] ?? 0 }}</div>
                <div class="stat-label">En maintenance</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card shadow-sm h-100 border-start border-danger border-4">
            <div class="card-body">
                <div class="stat-number text-danger">{{ mainEnRetard }}</div>
                <div class="stat-label">Maintenances en retard</div>
            </div>
        </div>
    </div>
</div>

{# ── Graphiques ligne 1 ── #}
<div class="row g-4 mb-4">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">🚜 Équipements par statut</div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="chartEquipStatut"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">📦 Par catégorie</div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="chartEquipCategorie"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">🔧 Maintenances par type</div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="chartMainType"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

{# ── Graphiques ligne 2 ── #}
<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">📊 Équipements par type</div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="chartEquipType"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">📋 Maintenances par statut</div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="chartMainStatut"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

{# ── Line chart ── #}
<div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">📈 Évolution des maintenances (12 derniers mois)</div>
    <div class="card-body">
        <div class="chart-container" style="height:300px">
            <canvas id="chartMainMois"></canvas>
        </div>
    </div>
</div>

{# ── Export PDF ── #}
<div class="d-flex justify-content-end mb-4">
    <a href="{{ path('equipement_stats_pdf') }}" class="btn btn-success">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-file-earmark-pdf me-1" viewBox="0 0 16 16">
            <path d="M14 14V4.5L9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2M9.5 3A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/>
            <path d="M4.603 14.087a.8.8 0 0 1-.438-.42c-.195-.388-.13-.776.08-1.102.198-.307.526-.568.897-.787a7.7 7.7 0 0 1 1.482-.645 20 20 0 0 0 1.062-2.227 7.3 7.3 0 0 1-.43-1.295c-.086-.4-.119-.796-.046-1.136.075-.354.274-.672.65-.823.192-.077.4-.12.602-.077a.7.7 0 0 1 .477.365c.088.164.12.356.127.538.007.188-.012.396-.047.614-.084.51-.27 1.134-.52 1.794a11 11 0 0 0 .98 1.686 5.8 5.8 0 0 1 1.334.05c.364.066.734.195.96.465.12.144.193.32.2.518.007.192-.047.382-.138.563a1.04 1.04 0 0 1-.354.416.86.86 0 0 1-.51.138c-.331-.014-.654-.196-.933-.417a5.7 5.7 0 0 1-.911-.95 11.7 11.7 0 0 0-1.997.406 11.3 11.3 0 0 1-1.02 1.51c-.292.35-.609.656-.927.787a.8.8 0 0 1-.58.029m1.379-1.901q-.25.115-.459.238c-.328.194-.541.383-.647.547-.094.145-.096.25-.04.361q.016.032.026.044l.035-.012c.137-.056.355-.235.635-.572a8 8 0 0 0 .45-.606m1.64-1.33a13 13 0 0 1 1.01-.193 12 12 0 0 1-.51-.858 21 21 0 0 1-.5 1.05zm2.446.45q.226.245.435.41c.24.19.407.253.498.256a.1.1 0 0 0 .07-.015.3.3 0 0 0 .094-.125.44.44 0 0 0 .059-.2.1.1 0 0 0-.026-.063c-.052-.062-.2-.152-.518-.209a4 4 0 0 0-.612-.053zM8.078 7.8a7 7 0 0 0 .2-.828q.046-.282.038-.465a.6.6 0 0 0-.032-.198.5.5 0 0 0-.145.04c-.087.035-.158.106-.196.283-.04.192-.03.469.046.822q.036.167.09.346z"/>
        </svg>
        Exporter PDF
    </a>
</div>

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script>
var _chartData = {
    equipStatutLabels:     {{ equipParStatutLabels|json_encode|raw }},
    equipStatutValeurs:    {{ equipParStatutValeurs|json_encode|raw }},
    equipCategorieLabels:  {{ equipParCategorieLabels|json_encode|raw }},
    equipCategorieValeurs: {{ equipParCategorieValeurs|json_encode|raw }},
    equipTypeLabels:       {{ equipParTypeLabels|json_encode|raw }},
    equipTypeValeurs:      {{ equipParTypeValeurs|json_encode|raw }},
    mainStatutLabels:      {{ mainParStatutLabels|json_encode|raw }},
    mainStatutValeurs:     {{ mainParStatutValeurs|json_encode|raw }},
    mainTypeLabels:        {{ mainParTypeLabels|json_encode|raw }},
    mainTypeValeurs:       {{ mainParTypeValeurs|json_encode|raw }},
    mainMoisLabels:        {{ mainParMoisLabels|json_encode|raw }},
    mainMoisValeurs:       {{ mainParMoisValeurs|json_encode|raw }}
};

function _destroyChart(id) {
    var c = Chart.getChart(id);
    if (c) c.destroy();
}

function _initCharts() {
    if (typeof Chart === 'undefined') {
        setTimeout(_initCharts, 100);
        return;
    }

    ['chartEquipStatut','chartEquipCategorie','chartMainType',
     'chartEquipType','chartMainStatut','chartMainMois'].forEach(_destroyChart);

    var C = {
        g: '#198754', b: '#0d6efd', y: '#ffc107',
        r: '#dc3545', gr: '#6c757d', t: '#20c997', o: '#fd7e14'
    };

    new Chart(document.getElementById('chartEquipStatut'), {
        type: 'pie',
        data: { labels: _chartData.equipStatutLabels, datasets: [{ data: _chartData.equipStatutValeurs, backgroundColor: [C.g, C.r, C.y, C.gr] }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
    });

    new Chart(document.getElementById('chartEquipCategorie'), {
        type: 'doughnut',
        data: { labels: _chartData.equipCategorieLabels, datasets: [{ data: _chartData.equipCategorieValeurs, backgroundColor: [C.b, C.t] }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
    });

    new Chart(document.getElementById('chartMainType'), {
        type: 'doughnut',
        data: { labels: _chartData.mainTypeLabels, datasets: [{ data: _chartData.mainTypeValeurs, backgroundColor: [C.b, C.o] }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
    });

    new Chart(document.getElementById('chartEquipType'), {
        type: 'bar',
        data: { labels: _chartData.equipTypeLabels, datasets: [{ label: 'Nb équipements', data: _chartData.equipTypeValeurs, backgroundColor: C.g, borderRadius: 6 }] },
        options: { responsive: true, maintainAspectRatio: false, indexAxis: 'y', plugins: { legend: { display: false } }, scales: { x: { beginAtZero: true, ticks: { stepSize: 1 } } } }
    });

    new Chart(document.getElementById('chartMainStatut'), {
        type: 'bar',
        data: { labels: _chartData.mainStatutLabels, datasets: [{ label: 'Nb maintenances', data: _chartData.mainStatutValeurs, backgroundColor: [C.b, C.y, C.g, C.gr], borderRadius: 6 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
    });

    new Chart(document.getElementById('chartMainMois'), {
        type: 'line',
        data: { labels: _chartData.mainMoisLabels, datasets: [{ label: 'Maintenances', data: _chartData.mainMoisValeurs, borderColor: C.g, backgroundColor: 'rgba(25,135,84,0.1)', borderWidth: 2, pointRadius: 4, fill: true, tension: 0.3 }] },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } } }
    });
}

document.addEventListener('DOMContentLoaded', _initCharts);
window.addEventListener('pageshow', function(e) { _initCharts(); });
window.addEventListener('focus', function() { _initCharts(); });
</script>
{% endblock %}