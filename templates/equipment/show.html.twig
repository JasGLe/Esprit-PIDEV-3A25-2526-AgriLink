{% extends 'layouts/dashboard_layout.html.twig' %}

{% block page_title %}{{ equipement.nom }}{% endblock %}

{% block stylesheets %}
{% if equipement.latitude is not null and equipement.longitude is not null %}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
{% endif %}
<style>
    .info-label { font-size: .8rem; color: #6c757d; text-transform: uppercase; letter-spacing: .05em; font-weight: 600; }
    .info-value { font-size: 1rem; font-weight: 500; }
    .badge-vehicule { background: #fff3cd; color: #856404; border: 1px solid #ffc107; }
    #map-show { height: 380px; border-radius: 8px; }
</style>
{% endblock %}

{% block dashboard_content %}

    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('equipement_index') }}">Équipements</a></li>
            <li class="breadcrumb-item active">{{ equipement.nom }}</li>
        </ol>
    </nav>

    {# ── Header ── #}
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">{{ equipement.nom }}</h2>
            <span class="badge bg-secondary me-1">{{ equipement.type }}</span>
            <span class="badge bg-light text-dark border">{{ equipement.categorie }}</span>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a href="{{ path('equipement_edit', {id: equipement.id}) }}" class="btn btn-outline-primary">✏️ Modifier</a>
            {% if equipement.latitude is not null and equipement.longitude is not null %}
            <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#modalCarteEquipement">
                📍 Voir sur la carte
            </button>
            {% endif %}
            <form method="post" action="{{ path('equipement_delete', {id: equipement.id}) }}"
                  onsubmit="return confirm('Supprimer définitivement cet équipement ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ equipement.id) }}">
                <button class="btn btn-outline-danger">🗑 Supprimer</button>
            </form>
        </div>
    </div>

    <div class="row g-4">

        {# ── Image ── #}
        {% if equipement.imageUrl %}
        <div class="col-md-4">
            <img src="{{ uploads_base_url }}/{{ equipement.imageUrl }}"
                 alt="{{ equipement.nom }}"
                 class="img-fluid rounded shadow-sm w-100"
                 style="max-height:280px; object-fit:cover">
        </div>
        {% endif %}

        {# ── Infos générales ── #}
        <div class="{{ equipement.imageUrl ? 'col-md-8' : 'col-12' }}">
            <div class="card shadow-sm mb-3">
                <div class="card-header fw-semibold bg-white">Informations générales</div>
                <div class="card-body row g-3">

                    <div class="col-md-6">
                        <div class="info-label">Statut</div>
                        <div class="info-value">
                            {% set couleur = {
                                'Actif':          'success',
                                'En panne':       'danger',
                                'En maintenance': 'warning',
                                'Hors service':   'secondary'
                            } %}
                            <span class="badge bg-{{ couleur[equipement.statut] ?? 'secondary' }}">
                                {{ equipement.statut ?? 'N/A' }}
                            </span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-label">Marque / Modèle</div>
                        <div class="info-value">{{ equipement.marque ?? '—' }} {{ equipement.modele ?? '' }}</div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-label">Date d'acquisition</div>
                        <div class="info-value">
                            {{ equipement.dateAcquisition ? equipement.dateAcquisition|date('d/m/Y') : '—' }}
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="info-label">Enregistré le</div>
                        <div class="info-value">
                            {{ equipement.dateCreation ? equipement.dateCreation|date('d/m/Y à H:i') : '—' }}
                        </div>
                    </div>

                    {% if equipement.description %}
                    <div class="col-12">
                        <div class="info-label">Description</div>
                        <div class="info-value">{{ equipement.description }}</div>
                    </div>
                    {% endif %}


                </div>
            </div>
        </div>
    </div>

    {# ── Section véhicule (affichée uniquement si véhicule motorisé) ── #}
    {% if equipement.isVehicule() %}
    <div class="card shadow-sm mb-4 border-warning">
        <div class="card-header fw-semibold bg-white">
            🚗 Détails véhicule
            <span class="badge badge-vehicule ms-2">Véhicule Motorisé</span>
        </div>
        <div class="card-body row g-3">

            <div class="col-md-4">
                <div class="info-label">Kilométrage actuel</div>
                <div class="info-value">
                    {{ equipement.kilometrageActuel is not null
                        ? equipement.kilometrageActuel|number_format(0, ',', ' ') ~ ' km'
                        : '—' }}
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-label">Km à la dernière maintenance</div>
                <div class="info-value">
                    {{ equipement.kilometrageDerniereMaintenance is not null
                        ? equipement.kilometrageDerniereMaintenance|number_format(0, ',', ' ') ~ ' km'
                        : '—' }}
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-label">Seuil maintenance (km)</div>
                <div class="info-value">
                    {{ equipement.seuilKmMaintenance is not null
                        ? equipement.seuilKmMaintenance|number_format(0, ',', ' ') ~ ' km'
                        : '—' }}
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-label">Heures d'utilisation</div>
                <div class="info-value">
                    {{ equipement.heuresUtilisation is not null
                        ? equipement.heuresUtilisation ~ ' h'
                        : '—' }}
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-label">Heures à la dernière maintenance</div>
                <div class="info-value">
                    {{ equipement.heuresDerniereMaintenance is not null
                        ? equipement.heuresDerniereMaintenance ~ ' h'
                        : '—' }}
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-label">Seuil maintenance (heures)</div>
                <div class="info-value">
                    {{ equipement.seuilHeuresMaintenance is not null
                        ? equipement.seuilHeuresMaintenance ~ ' h'
                        : '—' }}
                </div>
            </div>

        </div>
    </div>
    {% endif %}

    {# ── Maintenance générale ── #}
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-semibold bg-white">🔧 Maintenance</div>
        <div class="card-body row g-3">
            <div class="col-md-4">
                <div class="info-label">Seuil (jours)</div>
                <div class="info-value">
                    {{ equipement.seuilJoursMaintenance ? equipement.seuilJoursMaintenance ~ ' jours' : '—' }}
                </div>
            </div>
            <div class="col-md-4">
                <div class="info-label">Dernière maintenance</div>
                <div class="info-value">
                    {{ equipement.dateDerniereMaintenance
                        ? equipement.dateDerniereMaintenance|date('d/m/Y')
                        : '—' }}
                </div>
            </div>
        </div>
    </div>

   {# ── Passeport Numérique ── #}
<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold bg-white">📱 Passeport Numérique</div>
    <div class="card-body text-center">
        <img src="{{ path('passeport_qr', {id: equipement.id}) }}"
             alt="QR Code"
             style="width:180px; height:180px; border-radius:12px; border:3px solid #198754"
             onload="this.nextElementSibling.style.display='none'"
             onerror="this.style.display='none'">
        <p class="text-muted small mt-2 mb-0">
            Scannez pour accéder au passeport numérique
        </p>
    </div>
</div>
    {# ── Maintenances de cet équipement ── #}
{% set maintenances = equipement.id ? app.request.attributes.get('maintenances', []) : [] %}

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold bg-white d-flex justify-content-between align-items-center">
        🔧 Maintenances
        <a href="{{ path('maintenance_new_for_equipement', {equipementId: equipement.id}) }}"
           class="btn btn-sm btn-outline-success">+ Planifier</a>
    </div>
    <div class="card-body p-0">
        {# On passe les maintenances depuis le controller show de l'équipement #}
        <p class="text-muted p-3 mb-0">
            <a href="{{ path('maintenance_index') }}">Voir toutes les maintenances →</a>

        </p>
    </div>
</div>
    
    {# ── Modal carte équipement ── #}
    {% if equipement.latitude is not null and equipement.longitude is not null %}
    {% set couleurStatutMap = {
        'Actif':          '#198754',
        'En maintenance': '#ffc107',
        'En panne':       '#dc3545',
        'Hors service':   '#6f42c1'
    } %}
    {% set markerColor = couleurStatutMap[equipement.statut] ?? '#6c757d' %}
    <div class="modal fade" id="modalCarteEquipement" tabindex="-1" aria-labelledby="modalCarteEquipementLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalCarteEquipementLabel">📍 {{ equipement.nom }} — Position</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body p-2">
                    <div id="map-show"></div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
    <script>
    (function () {
        var lat    = {{ equipement.latitude }};
        var lng    = {{ equipement.longitude }};
        var color  = {{ markerColor|json_encode|raw }};
        var nom    = {{ equipement.nom|json_encode|raw }};
        var statut = {{ (equipement.statut ?? '')|json_encode|raw }};
        var mapInit = false;

        var modalEl = document.getElementById('modalCarteEquipement');
        modalEl.addEventListener('shown.bs.modal', function () {
            if (mapInit) return;
            mapInit = true;

            var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="38" viewBox="0 0 28 38"><path d="M14 0C6.27 0 0 6.27 0 14c0 9.6 14 24 14 24s14-14.4 14-24C28 6.27 21.73 0 14 0z" fill="' + color + '"/><circle cx="14" cy="14" r="6" fill="#fff" opacity=".9"/></svg>';
            var icon = L.divIcon({ html: svg, className: '', iconSize: [28, 38], iconAnchor: [14, 38], popupAnchor: [0, -38] });

            var map = L.map('map-show').setView([lat, lng], 14);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
                maxZoom: 19
            }).addTo(map);

            L.marker([lat, lng], { icon: icon })
                .addTo(map)
                .bindPopup('<strong>' + nom + '</strong><br><span class="badge" style="background:' + color + ';color:#fff">' + statut + '</span>')
                .openPopup();
        });
    })();
    </script>
    {% endif %}

    <a href="{{ path('equipement_index') }}" class="btn btn-outline-secondary">← Retour à la liste</a>
    <a href="{{ path('passeport_show_by_id', {id: equipement.id}) }}"
   class="btn btn-outline-success"
   target="_blank">
    📱 Voir le passeport
</a>

{% endblock %}