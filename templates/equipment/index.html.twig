{% extends 'base.html.twig' %}

{% block title %}Mes Équipements — AgriLink{% endblock %}

{% block stylesheets %}
<style>
    .badge-statut-actif         { background-color: #198754; }
    .badge-statut-en-panne      { background-color: #dc3545; }
    .badge-statut-en-maintenance{ background-color: #ffc107; color: #000; }
    .badge-statut-hors-service  { background-color: #6c757d; }
    .card-equipement:hover      { box-shadow: 0 4px 16px rgba(0,0,0,0.10); transform: translateY(-2px); transition: all .2s; }
    .card-equipement            { transition: all .2s; }
    .img-equipement             { width: 100%; height: 180px; object-fit: cover; border-radius: 8px 8px 0 0; }
    .img-placeholder            { width: 100%; height: 180px; background: #e9ecef; border-radius: 8px 8px 0 0; display: flex; align-items: center; justify-content: center; color: #adb5bd; font-size: 3rem; }
</style>
{% endblock %}

{% block body %}
<div class="container py-4">

    {# ── Flashs ── #}
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'success' ? 'success' : 'danger' }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {# ── Header ── #}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">🚜 Mes Équipements</h2>
            <span class="text-muted">{{ equipements|length }} équipement(s) enregistré(s)</span>
        </div>
        <a href="{{ path('equipement_new') }}" class="btn btn-success">
            + Ajouter un équipement
        </a>
    </div>

    {# ── Barre de recherche ── #}
    <div class="mb-3">
        <input type="search"
               id="recherche-equipement"
               class="form-control"
               placeholder="Rechercher par nom, type, marque ou statut..."
               autocomplete="off">
    </div>

    {# ── Filtre rapide par statut ── #}
    <div class="d-flex gap-2 mb-4 flex-wrap">
        <button class="btn btn-sm btn-outline-secondary filtre-btn active" data-filtre="tous">Tous</button>
        <button class="btn btn-sm btn-outline-success  filtre-btn" data-filtre="Actif">Actif</button>
        <button class="btn btn-sm btn-outline-danger   filtre-btn" data-filtre="En panne">En panne</button>
        <button class="btn btn-sm btn-outline-warning  filtre-btn" data-filtre="En maintenance">En maintenance</button>
        <button class="btn btn-sm btn-outline-secondary filtre-btn" data-filtre="Hors service">Hors service</button>
    </div>

    {# ── Grille ── #}
    {% if equipements is empty %}
        <div class="text-center py-5 text-muted">
            <div style="font-size:4rem">🌾</div>
            <p class="mt-2">Aucun équipement enregistré pour le moment.</p>
            <a href="{{ path('equipement_new') }}" class="btn btn-success mt-2">Ajouter mon premier équipement</a>
        </div>
    {% else %}
        <div class="row g-3" id="grille-equipements">
            {% for eq in equipements %}
                <div class="col-sm-6 col-lg-4 equipement-card"
                     data-statut="{{ eq.statut }}"
                     data-search="{{ (eq.nom ~ ' ' ~ eq.type ~ ' ' ~ (eq.marque ?? '') ~ ' ' ~ (eq.statut ?? ''))|lower }}">
                    <div class="card card-equipement h-100 border-0 shadow-sm">

                        {# Image #}
                        {% if eq.imageUrl %}
                            <img src="{{ asset(eq.imageUrl) }}" alt="{{ eq.nom }}" class="img-equipement">
                        {% else %}
                            <div class="img-placeholder">🚜</div>
                        {% endif %}

                        <div class="card-body">
                            {# Badge statut #}
                            <span class="badge badge-statut-{{ eq.statut|lower|replace({' ': '-'}) }} mb-2">
                                {{ eq.statut }}
                            </span>

                            {# Badge catégorie #}
                            <span class="badge bg-light text-dark border mb-2">{{ eq.categorie }}</span>

                            <h5 class="card-title fw-bold mb-1">{{ eq.nom }}</h5>
                            <p class="text-muted small mb-1">{{ eq.type }} — {{ eq.marque ?? 'N/A' }} {{ eq.modele ?? '' }}</p>

                            {% if eq.dateAcquisition %}
                                <p class="text-muted small mb-2">
                                    Acquis le {{ eq.dateAcquisition|date('d/m/Y') }}
                                </p>
                            {% endif %}

                            {# Kilométrage si véhicule #}
                            {% if eq.isVehicule() and eq.kilometrageActuel is not null %}
                                <div class="alert alert-light py-1 px-2 small mb-2">
                                    🛞 {{ eq.kilometrageActuel|number_format(0, ',', ' ') }} km
                                </div>
                            {% endif %}
                        </div>

                        {# Actions #}
                        <div class="card-footer bg-transparent border-0 d-flex gap-2 pb-3">
                            <a href="{{ path('equipement_show', {id: eq.id}) }}"
                               class="btn btn-sm btn-outline-primary flex-fill">Voir</a>
                            <a href="{{ path('equipement_edit', {id: eq.id}) }}"
                               class="btn btn-sm btn-outline-secondary flex-fill">Modifier</a>
                            <form method="post"
                                  action="{{ path('equipement_delete', {id: eq.id}) }}"
                                  onsubmit="return confirm('Supprimer cet équipement ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ eq.id) }}">
                                <button class="btn btn-sm btn-outline-danger">🗑</button>
                            </form>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>

<script>
let filtreStatut = 'tous';
let filtreTexte  = '';

function applyFilters() {
    document.querySelectorAll('.equipement-card').forEach(card => {
        const matchStatut = filtreStatut === 'tous' || card.dataset.statut === filtreStatut;
        const matchTexte  = filtreTexte === '' || (card.dataset.search ?? '').includes(filtreTexte);
        card.style.display = matchStatut && matchTexte ? '' : 'none';
    });
}

document.querySelectorAll('.filtre-btn').forEach(btn => {
    btn.addEventListener('click', function () {
        document.querySelectorAll('.filtre-btn').forEach(b => b.classList.remove('active'));
        this.classList.add('active');
        filtreStatut = this.dataset.filtre;
        applyFilters();
    });
});

document.getElementById('recherche-equipement').addEventListener('input', function () {
    filtreTexte = this.value.trim().toLowerCase();
    applyFilters();
});
</script>
{% endblock %}