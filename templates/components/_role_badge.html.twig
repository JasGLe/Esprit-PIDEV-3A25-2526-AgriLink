{# Role Badge Component
   Usage: {{ include('components/_role_badge.html.twig', {role: 'ROLE_ADMIN'}) }}
#}

{% set badgeClasses = {
    'ROLE_ADMIN': 'bg-red-100 text-red-800',
    'ROLE_AGRIPLUS': 'bg-yellow-100 text-yellow-800',
    'ROLE_FOURNISSEUR': 'bg-blue-100 text-blue-800',
    'ROLE_FOURNISSEUR_SOCIETE': 'bg-blue-100 text-blue-800',
    'ROLE_FOURNISSEUR_PERSONNE': 'bg-blue-100 text-blue-800',
    'ROLE_AGRICULTEUR': 'bg-green-100 text-green-800',
} %}

{% set badgeTexts = {
    'ROLE_ADMIN': 'Administrateur',
    'ROLE_AGRIPLUS': 'AgriPlus',
    'ROLE_FOURNISSEUR': 'Fournisseur',
    'ROLE_FOURNISSEUR_SOCIETE': 'Fournisseur Société',
    'ROLE_FOURNISSEUR_PERSONNE': 'Fournisseur Personne',
    'ROLE_AGRICULTEUR': 'Agriculteur',
} %}

{% set badgeIcons = {
    'ROLE_ADMIN': '🛡️',
    'ROLE_AGRIPLUS': '⭐',
    'ROLE_FOURNISSEUR': '🏢',
    'ROLE_FOURNISSEUR_SOCIETE': '🏭',
    'ROLE_FOURNISSEUR_PERSONNE': '🏪',
    'ROLE_AGRICULTEUR': '🌱',
} %}

<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ badgeClasses[role]|default('bg-gray-100 text-gray-800') }}">
    {{ badgeIcons[role]|default('👤') }} {{ badgeTexts[role]|default('Utilisateur') }}
</span>
