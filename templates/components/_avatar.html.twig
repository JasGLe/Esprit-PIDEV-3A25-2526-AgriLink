{# Avatar Component
   Usage: {{ include('components/_avatar.html.twig', {
       user: user,
       size: 'large'  (small, medium, large)
   }) }}
#}

{% set sizes = {
    'small': 'avatar-sm',
    'medium': 'avatar-md',
    'large': 'avatar-lg',
} %}

{% set sizeClass = sizes[size|default('medium')] %}
{% set displayName = user and user.nom ? user.nom : 'Utilisateur' %}
{% set initials = '?' %}

{% if user and user.nom %}
    {% set names = user.nom|split(' ')|filter(name => name is not empty) %}
    {% if names|length > 0 %}
        {% set initials = names[0]|first|upper ~ (names|length > 1 ? names[1]|first|upper : '') %}
    {% endif %}
{% endif %}

<div class="position-relative d-inline-block {{ classes|default('') }}">
    {% if user and user.photoProfil %}
        {# Handle different path formats in database:
           - New format: profiles/filename.jpg
           - Old format 1: agrilink/uploads/profiles/filename.jpg
           - Old format 2: /agrilink/uploads/profiles/filename.jpg
        #}
        {% set photoPath = user.photoProfil %}
        {% if photoPath starts with '/agrilink/' %}
            {# Already has leading slash #}
            {% set finalPath = photoPath %}
        {% elseif photoPath starts with 'agrilink/' %}
            {# Add leading slash #}
            {% set finalPath = '/' ~ photoPath %}
        {% else %}
            {# Relative path - add base URL #}
            {% set finalPath = '/agrilink/uploads/' ~ photoPath %}
        {% endif %}
        
        <img src="{{ finalPath }}" 
             alt="{{ displayName }}" 
             class="avatar {{ sizeClass }} border border-2 border-gray-200"
             onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
        {# Fallback if image fails to load #}
        <div class="avatar {{ sizeClass }} bg-success text-white fw-semibold d-none">
            {{ initials }}
        </div>
    {% else %}
        <div class="avatar {{ sizeClass }} bg-success text-white fw-semibold">
            {{ initials }}
        </div>
    {% endif %}
</div>
