{% set currentLocale = app.request.locale|default('fr') %}
{% set redirectUrl = app.request.uri %}
{% set isMarketplacePath = app.request.pathInfo starts with '/marketplace'
    or app.request.pathInfo starts with '/mes-commandes'
    or app.request.pathInfo starts with '/mes-locations'
    or app.request.pathInfo starts with '/boutique' %}

{% if isMarketplacePath %}
<div class="position-fixed top-0 end-0 p-3" style="z-index: 1200;" data-no-auto-translate>
    <div class="dropdown">
        <button class="btn btn-sm btn-dark dropdown-toggle d-inline-flex align-items-center gap-2 shadow"
                type="button"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                title="{{ 'language.switcher_title'|trans }}">
            <span aria-hidden="true">🌐</span>
            <span class="text-uppercase">{{ currentLocale }}</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li>
                <a class="dropdown-item d-flex justify-content-between align-items-center {{ currentLocale == 'fr' ? 'active' : '' }}"
                   href="{{ path('app_change_locale', { locale: 'fr', redirect: redirectUrl }) }}">
                    <span>{{ 'language.french'|trans }}</span>
                    <small class="text-muted">FR</small>
                </a>
            </li>
            <li>
                <a class="dropdown-item d-flex justify-content-between align-items-center {{ currentLocale == 'en' ? 'active' : '' }}"
                   href="{{ path('app_change_locale', { locale: 'en', redirect: redirectUrl }) }}">
                    <span>{{ 'language.english'|trans }}</span>
                    <small class="text-muted">EN</small>
                </a>
            </li>
            <li>
                <a class="dropdown-item d-flex justify-content-between align-items-center {{ currentLocale == 'ar' ? 'active' : '' }}"
                   href="{{ path('app_change_locale', { locale: 'ar', redirect: redirectUrl }) }}">
                    <span>{{ 'language.arabic'|trans }}</span>
                    <small class="text-muted">AR</small>
                </a>
            </li>
        </ul>
    </div>
</div>
{% endif %}
