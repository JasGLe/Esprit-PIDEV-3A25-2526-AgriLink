{# Modal pour la génération d'affiche avec spinner et compteur #}
<div data-controller="poster-generator"
     data-poster-generator-event-id-value="{{ eventId|default(0) }}"
     data-poster-generator-poll-interval-value="2000"
     data-poster-generator-max-wait-time-value="40000">
     
    <button type="button" 
            class="btn btn-outline-primary btn-sm" 
            data-bs-toggle="modal" 
            data-bs-target="#posterModal{{ eventId|default('') }}"
            data-action="poster-generator#handleGenerateClick"
            title="Générer une affiche IA pour cet événement">
        🤖 Générer affiche IA
    </button>

    {# Modal #}
    <div class="modal fade" id="posterModal{{ eventId|default('') }}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content bg-light shadow-lg">
                <div class="modal-header border-0 bg-white pb-2 pt-3 ps-4 pe-4">
                    <h5 class="modal-title fw-bold text-dark">🤖 Générer une affiche IA</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body text-center py-4 bg-white">
                    {# Spinner #}
                    <div data-poster-generator-target="spinner" class="d-none">
                        <div class="spinner-border text-primary mb-4" role="status" style="width: 4rem; height: 4rem;">
                            <span class="visually-hidden">Chargement...</span>
                        </div>
                        <p class="text-dark mb-3 fw-semibold">Génération en cours...</p>
                        <p class="text-secondary small">
                            ⏱️ Cela peut prendre jusqu'à 40 secondes
                        </p>
                    </div>

                    {# Compteur #}
                    <div data-poster-generator-target="counter" class="d-none">
                        <div class="countdown" style="font-size: 2.5rem; font-weight: bold; color: #0d6efd; margin-top: 1rem;">
                            0s / ~30s
                        </div>
                        <div class="progress mt-4" style="height: 6px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" 
                                 style="width: 100%;" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    {# Image générée #}
                    <div data-poster-generator-target="image" class="d-none">
                        <img src="" alt="Affiche générée" class="img-fluid rounded shadow" style="max-height: 450px; max-width: 100%; border: 2px solid #dee2e6;">
                        <div class="mt-4 mb-2">
                            <p class="text-success fw-bold mb-3">✅ Affiche générée avec succès en 2s</p>
                            <button type="button" class="btn btn-primary btn-lg">
                                ⬇️ Télécharger
                            </button>
                        </div>
                    </div>

                    {# Erreur #}
                    <div data-poster-generator-target="error" class="alert alert-danger d-none mt-3" role="alert">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

