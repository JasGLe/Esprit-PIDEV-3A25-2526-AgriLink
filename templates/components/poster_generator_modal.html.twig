{# Modal pour la génération d'affiche avec spinner et compteur #}
<div data-controller="poster-generator"
     data-poster-generator-event-id-value="{{ eventId|default(0) }}"
     data-poster-generator-poll-interval-value="2000"
     data-poster-generator-max-wait-time-value="40000">
     
    <button type="button" 
            class="btn btn-outline-primary btn-sm" 
            data-bs-toggle="modal" 
            data-bs-target="#posterModal{{ eventId|default('') }}"
            data-action="poster-generator#handleGenerateClick"
            title="Générer une affiche IA pour cet événement">
        🤖 Générer affiche IA
    </button>

    {# Modal #}
    <div class="modal fade" id="posterModal{{ eventId|default('') }}" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title">Générer une affiche IA</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body text-center py-5">
                    {# Spinner #}
                    <div data-poster-generator-target="spinner" class="d-none">
                        <div class="spinner-border text-primary mb-3" role="status" style="width: 3rem; height: 3rem;">
                            <span class="visually-hidden">Chargement...</span>
                        </div>
                        <p class="text-muted mb-2">Génération en cours...</p>
                        <p class="text-muted small">
                            Cela peut prendre jusqu'à 40 secondes
                        </p>
                    </div>

                    {# Compteur #}
                    <div data-poster-generator-target="counter" class="d-none">
                        <div class="countdown" style="font-size: 2rem; font-weight: bold; color: #0d6efd; margin-top: 1rem;">
                            0s / ~30s
                        </div>
                        <div class="progress mt-3" style="height: 4px;">
                            <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" 
                                 style="width: 100%;" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    {# Image générée #}
                    <div data-poster-generator-target="image" class="d-none">
                        <img src="" alt="Affiche générée" class="img-fluid rounded" style="max-height: 400px; max-width: 100%;">
                        <div class="mt-3">
                            <button type="button" class="btn btn-primary btn-sm">
                                ⬇️ Télécharger
                            </button>
                        </div>
                    </div>

                    {# Erreur #}
                    <div data-poster-generator-target="error" class="alert alert-danger d-none mt-3" role="alert">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

