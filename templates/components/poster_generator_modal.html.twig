{# Poster generator – owner-only. Uses a pure Stimulus-driven overlay, no Bootstrap modal. #}
<div data-controller="poster-generator"
     data-poster-generator-event-id-value="{{ eventId|default(0) }}"
     data-poster-generator-titre-value="{{ evenement.titre|default('')|e('html_attr') }}"
     data-poster-generator-date-value="{{ evenement.dateEvenement is defined and evenement.dateEvenement ? evenement.dateEvenement|date('d/m/Y') : '' }}"
     data-poster-generator-lieu-value="{{ evenement.lieu|default('')|e('html_attr') }}"
     data-poster-generator-type-value="{{ evenement.typeEvenement|default('')|e('html_attr') }}">

    {# Trigger button #}
    <button type="button"
            class="btn btn-outline-success btn-sm"
            data-action="click->poster-generator#openModal"
            title="Générer une affiche avec l'IA">
        🤖 Affiche IA
    </button>

    {# Full-screen overlay (hidden by default, shown by Stimulus) #}
    <div data-poster-generator-target="overlay"
         style="display:none; position:fixed; inset:0; z-index:9999; background:rgba(0,0,0,0.55); backdrop-filter:blur(3px); align-items:center; justify-content:center;">

        <div style="background:#fff; border-radius:16px; width:min(680px,92vw); max-height:90vh; overflow-y:auto; box-shadow:0 20px 60px rgba(0,0,0,0.35); display:flex; flex-direction:column;">

            {# Modal header #}
            <div style="background:linear-gradient(135deg,#14532d 0%,#22c55e 100%); border-radius:16px 16px 0 0; padding:20px 24px; display:flex; align-items:flex-start; justify-content:space-between; flex-shrink:0;">
                <div>
                    <div style="font-weight:700; font-size:1.1rem; color:#fff;">🤖 Génération d'affiche IA</div>
                    <div style="font-size:0.83rem; color:rgba(255,255,255,0.65); margin-top:3px;">{{ evenement.titre|default('Événement') }}</div>
                </div>
                <button type="button"
                        data-action="click->poster-generator#closeModal"
                        style="background:rgba(255,255,255,0.15); border:none; border-radius:50%; width:32px; height:32px; color:#fff; font-size:1.1rem; cursor:pointer; display:flex; align-items:center; justify-content:center; flex-shrink:0;"
                        aria-label="Fermer">✕</button>
            </div>

            {# Modal body #}
            <div style="padding:28px 24px; flex:1;">

                {# State: initial #}
                <div data-poster-generator-target="stateInitial" style="text-align:center; padding:12px 0;">
                    <div style="font-size:3rem; margin-bottom:12px;">🖼️</div>
                    <div style="font-weight:600; font-size:1rem; color:#1e293b; margin-bottom:8px;">Créer une affiche pour cet événement</div>
                    <div style="font-size:0.85rem; color:#64748b; margin-bottom:24px; line-height:1.5;">
                        L'IA génère une affiche avec titre, date, lieu et type en texte lisible. La 1<sup>re</sup> image peut arriver vite (cache) ; une nouvelle version prend souvent 45–90&nbsp;s.
                    </div>
                    <button type="button"
                            class="btn btn-success px-5"
                            data-action="click->poster-generator#generate">
                        ✨ Générer l'affiche
                    </button>
                </div>

                {# State: loading #}
                <div data-poster-generator-target="stateLoading" style="display:none; text-align:center; padding:12px 0;">
                    <div style="display:inline-block; width:52px; height:52px; border:4px solid #e2e8f0; border-top-color:#22c55e; border-radius:50%; animation:pg-spin 0.8s linear infinite; margin-bottom:16px;"></div>
                    <div style="font-weight:600; color:#1e293b; margin-bottom:6px;">Génération en cours…</div>
                    <div style="font-size:0.83rem; color:#64748b; margin-bottom:16px;">Prévoir jusqu’à ~75&nbsp;s (le délai dépend du service d’images).</div>
                    <div style="background:#e2e8f0; border-radius:4px; height:6px; overflow:hidden; max-width:300px; margin:0 auto;">
                        <div data-poster-generator-target="progressBar"
                             style="height:100%; width:5%; background:#22c55e; border-radius:4px; transition:width 0.8s ease;"></div>
                    </div>
                    <div data-poster-generator-target="timerLabel" style="font-size:0.8rem; color:#94a3b8; margin-top:8px;">0s</div>
                </div>

                {# State: result #}
                <div data-poster-generator-target="stateResult" style="display:none;">
                    <div style="text-align:center; margin-bottom:16px;">
                        <img data-poster-generator-target="posterImage"
                             src=""
                             alt="Affiche générée"
                             style="max-width:100%; max-height:400px; border-radius:10px; box-shadow:0 4px 20px rgba(0,0,0,0.12); border:1px solid #e2e8f0;">
                    </div>
                    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; padding-top:14px; border-top:1px solid #e2e8f0;">
                        <span data-poster-generator-target="successLabel" style="font-size:0.85rem; color:#16a34a; font-weight:600;"></span>
                        <div style="display:flex; gap:8px;">
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    data-action="click->poster-generator#regenerate">🔄 Régénérer</button>
                            <button type="button" class="btn btn-success btn-sm"
                                    data-action="click->poster-generator#download">⬇️ Télécharger</button>
                        </div>
                    </div>
                </div>

                {# State: error #}
                <div data-poster-generator-target="stateError" style="display:none;">
                    <div style="background:#fef2f2; border:1px solid #fecaca; border-radius:10px; padding:16px; display:flex; gap:12px; margin-bottom:16px;">
                        <span style="font-size:1.3rem; flex-shrink:0;">⚠️</span>
                        <div>
                            <div style="font-weight:600; color:#991b1b; margin-bottom:4px;">Erreur de génération</div>
                            <div data-poster-generator-target="errorLabel" style="font-size:0.85rem; color:#7f1d1d;"></div>
                        </div>
                    </div>
                    <div style="text-align:center;">
                        <button type="button" class="btn btn-outline-success btn-sm"
                                data-action="click->poster-generator#regenerate">Réessayer</button>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <style>
        @keyframes pg-spin { to { transform: rotate(360deg); } }
    </style>
</div>
