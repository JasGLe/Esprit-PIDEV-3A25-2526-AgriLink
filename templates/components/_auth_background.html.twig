{# 
  Reusable gradient mesh background component for authentication screens
  Creates a subtle, minimalistic design with curved forms and gradient mesh
#}
<div class="fixed inset-0 -z-10 overflow-hidden bg-gradient-to-br from-primary-50 via-white to-blue-50">
    {# Curved gradient shapes - positioned absolutely for organic feel #}
    
    {# Top-left curved gradient blob #}
    <div class="absolute -top-24 -left-24 w-96 h-96 bg-gradient-to-br from-primary-100/60 to-primary-50/40 rounded-full blur-3xl opacity-70"></div>
    
    {# Top-right curved gradient blob #}
    <div class="absolute -top-32 -right-32 w-[500px] h-[500px] bg-gradient-to-bl from-blue-100/50 to-transparent rounded-full blur-3xl opacity-60"></div>
    
    {# Bottom-left curved form #}
    <div class="absolute -bottom-20 -left-20 w-80 h-80 bg-gradient-to-tr from-primary-100/50 to-transparent rounded-full blur-2xl opacity-50"></div>
    
    {# Bottom-right curved gradient #}
    <div class="absolute -bottom-32 -right-16 w-96 h-96 bg-gradient-to-tl from-blue-100/60 to-primary-50/40 rounded-full blur-3xl opacity-60"></div>
    
    {# Center subtle accent #}
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gradient-radial from-primary-50/30 to-transparent rounded-full blur-3xl opacity-40"></div>
    
    {# SVG Pattern Overlay for subtle texture #}
    <svg class="absolute inset-0 w-full h-full opacity-[0.03]" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <pattern id="grid" width="32" height="32" patternUnits="userSpaceOnUse">
                <circle cx="16" cy="16" r="1" fill="currentColor" class="text-primary-600"/>
            </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid)"/>
    </svg>
    
    {# Curved lines decoration #}
    <svg class="absolute inset-0 w-full h-full opacity-10" xmlns="http://www.w3.org/2000/svg">
        <defs>
            <linearGradient id="curveGradient1" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" style="stop-color:rgb(34, 197, 94);stop-opacity:0.3" />
                <stop offset="100%" style="stop-color:rgb(59, 130, 246);stop-opacity:0.1" />
            </linearGradient>
            <linearGradient id="curveGradient2" x1="100%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" style="stop-color:rgb(59, 130, 246);stop-opacity:0.3" />
                <stop offset="100%" style="stop-color:rgb(34, 197, 94);stop-opacity:0.1" />
            </linearGradient>
        </defs>
        
        {# Smooth curved lines flowing across the background #}
        <path d="M-100,200 Q400,100 900,300 T1900,200" stroke="url(#curveGradient1)" stroke-width="2" fill="none" opacity="0.4"/>
        <path d="M-100,400 Q400,300 900,500 T1900,400" stroke="url(#curveGradient1)" stroke-width="1.5" fill="none" opacity="0.3"/>
        <path d="M1900,300 Q1400,400 900,200 T-100,300" stroke="url(#curveGradient2)" stroke-width="2" fill="none" opacity="0.4"/>
        <path d="M1900,600 Q1400,700 900,500 T-100,600" stroke="url(#curveGradient2)" stroke-width="1.5" fill="none" opacity="0.3"/>
    </svg>
</div>
