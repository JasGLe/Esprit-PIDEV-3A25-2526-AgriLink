{# ── User Level & Badge Widget ── #}
<div id="user-level-widget" class="user-level-widget">
    <div class="ulw-header-bar">
        <h3 class="ulw-title">🎮 Gamification</h3>
        <button type="button" id="ulw-minimize-btn" class="ulw-minimize-btn" title="Réduire/Agrandir" style="cursor:pointer;background:none;border:none;padding:0;color:#6b7280;font-size:1.1rem;display:flex;align-items:center;justify-content:center;width:24px;height:24px;">
            <svg id="ulw-minimize-icon" class="ulw-minimize-icon" style="width:1.2rem;height:1.2rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
    </div>

    <div id="ulw-skeleton" class="ulw-skeleton">
        <div class="ulw-skeleton-bar" style="width:60%;height:18px;border-radius:6px;background:#e5e7eb;margin-bottom:10px;"></div>
        <div class="ulw-skeleton-bar" style="width:100%;height:10px;border-radius:6px;background:#e5e7eb;margin-bottom:8px;"></div>
        <div class="ulw-skeleton-bar" style="width:40%;height:14px;border-radius:6px;background:#e5e7eb;"></div>
    </div>

    <div id="ulw-content" style="display:none;"></div>

    {# Minimized view with level info #}
    <div id="ulw-minimized-info" class="ulw-minimized-info" style="display:none;">
        <div class="ulw-mini-level" id="ulw-mini-level"></div>
        <div class="ulw-mini-stats" id="ulw-mini-stats"></div>
    </div>

</div>

<style>
.user-level-widget {
    background: #fff;
    border-radius: 14px;
    border: 1px solid #e5e7eb;
    padding: 1.1rem 1.25rem;
    box-shadow: 0 1px 4px rgba(0,0,0,.06);
    transition: all 0.25s ease;
}

.user-level-widget.minimized {
    padding: 0.75rem 1.25rem;
}

.user-level-widget.minimized #ulw-skeleton,
.user-level-widget.minimized #ulw-content {
    display: none !important;
}

.user-level-widget.minimized #ulw-minimized-info {
    display: block !important;
}

.ulw-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
    gap: 0.5rem;
}

.user-level-widget.minimized .ulw-header-bar {
    margin-bottom: 0.5rem;
}

.ulw-title {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: #374151;
    flex: 1;
}

.ulw-minimize-btn {
    transition: all 0.2s ease;
    color: #6b7280;
    padding: 0.35rem;
    border-radius: 0.35rem;
}

.ulw-minimize-btn:hover {
    color: #374151;
    transform: scale(1.1);
    background: rgba(107, 114, 128, 0.08);
}

.user-level-widget.minimized .ulw-minimize-btn {
    background: linear-gradient(135deg, rgba(22, 163, 74, 0.08) 0%, rgba(22, 163, 74, 0.04) 100%);
    color: #16a34a;
}

.user-level-widget.minimized .ulw-minimize-icon {
    transform: rotate(45deg);
}

.ulw-skeleton { animation: ulw-pulse 1.4s ease-in-out infinite; }
@keyframes ulw-pulse { 0%,100%{opacity:1} 50%{opacity:.45} }

/* Minimized info styles */
.ulw-minimized-info {
    display: none;
}

.ulw-mini-level {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0;
    margin-bottom: 0.4rem;
}

.ulw-mini-level-icon {
    font-size: 1.25rem;
}

.ulw-mini-level-content {
    flex: 1;
}

.ulw-mini-level-label {
    font-size: 0.7rem;
    color: #6b7280;
    font-weight: 500;
    margin: 0;
}

.ulw-mini-level-value {
    font-size: 0.85rem;
    font-weight: 700;
    color: #374151;
    margin: 0;
    line-height: 1.2;
}

.ulw-mini-stats {
    display: flex;
    gap: 0.5rem;
    font-size: 0.7rem;
    color: #6b7280;
    padding-top: 0.4rem;
    border-top: 1px solid #f3f4f6;
}

.ulw-mini-stat {
    flex: 1;
    text-align: center;
}

.ulw-mini-stat-value {
    font-weight: 700;
    color: #374151;
    font-size: 0.8rem;
    display: block;
}

.ulw-skeleton { animation: ulw-pulse 1.4s ease-in-out infinite; }
@keyframes ulw-pulse { 0%,100%{opacity:1} 50%{opacity:.45} }

.ulw-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:.75rem; }
.ulw-level-pill {
    display:inline-flex; align-items:center; gap:.35rem;
    padding:.28rem .75rem; border-radius:999px;
    font-size:.78rem; font-weight:700; letter-spacing:.02em;
}
.ulw-header-right { display:flex; align-items:center; gap:.6rem; }
.ulw-points { font-size:.82rem; color:#6b7280; font-weight:500; }
.ulw-achievements-btn {
    display:inline-flex; align-items:center; gap:.25rem;
    padding:.22rem .65rem; border-radius:999px; font-size:.72rem; font-weight:600;
    background:#f0fdf4; color:#16a34a; border:1px solid #bbf7d0;
    cursor:pointer; text-decoration:none; transition:background .15s;
}
.ulw-achievements-btn:hover { background:#dcfce7; color:#15803d; }

.ulw-progress-wrap { margin-bottom:.65rem; }
.ulw-progress-label { display:flex; justify-content:space-between; font-size:.72rem; color:#6b7280; margin-bottom:.3rem; }
.ulw-progress-track { height:8px; border-radius:999px; background:#f3f4f6; overflow:hidden; }
.ulw-progress-fill { height:100%; border-radius:999px; background:linear-gradient(90deg,#16a34a,#4ade80); transition:width .8s ease; }

.ulw-section-title { font-size:.7rem; font-weight:700; color:#6b7280; margin-bottom:.4rem; text-transform:uppercase; letter-spacing:.06em; }
.ulw-badges { display:flex; flex-wrap:wrap; gap:.35rem; margin-bottom:.65rem; }
.ulw-badge {
    display:inline-flex; align-items:center; gap:.22rem;
    padding:.2rem .6rem; border-radius:999px; font-size:.73rem; font-weight:600;
    background:#f0fdf4; color:#15803d; border:1px solid #bbf7d0; cursor:default;
}
.ulw-badge:hover { background:#dcfce7; }

/* Tips for next badges */
.ulw-tips { display:flex; flex-direction:column; gap:.35rem; margin-bottom:.65rem; }
.ulw-tip {
    display:flex; align-items:flex-start; gap:.5rem;
    padding:.45rem .6rem; border-radius:8px;
    background:#f9fafb; border:1px solid #f3f4f6; font-size:.73rem;
}
.ulw-tip-icon { font-size:.9rem; flex-shrink:0; margin-top:.05rem; }
.ulw-tip-body { flex:1; }
.ulw-tip-label { font-weight:700; color:#374151; display:block; margin-bottom:.1rem; }
.ulw-tip-text  { color:#6b7280; line-height:1.4; }

.ulw-login-row { display:flex; align-items:center; gap:.4rem; margin-top:.6rem; padding-top:.6rem; border-top:1px solid #f3f4f6; font-size:.74rem; color:#6b7280; }
.ulw-login-row strong { color:#374151; }
</style>

<script>
(function () {
    const LEVEL_COLORS = {
        1: { bg:'#f0fdf4', text:'#16a34a', bar:'linear-gradient(90deg,#4ade80,#86efac)' },
        2: { bg:'#f0fdf4', text:'#15803d', bar:'linear-gradient(90deg,#22c55e,#4ade80)' },
        3: { bg:'#fefce8', text:'#a16207', bar:'linear-gradient(90deg,#eab308,#fde047)' },
        4: { bg:'#fff7ed', text:'#c2410c', bar:'linear-gradient(90deg,#f97316,#fb923c)' },
        5: { bg:'#eff6ff', text:'#1d4ed8', bar:'linear-gradient(90deg,#3b82f6,#60a5fa)' },
        6: { bg:'#f5f3ff', text:'#7c3aed', bar:'linear-gradient(90deg,#8b5cf6,#a78bfa)' },
        7: { bg:'#fff1f2', text:'#be123c', bar:'linear-gradient(90deg,#f43f5e,#fb7185)' },
    };

    // Initialize minimize functionality
    function initializeMinimizeButton() {
        const widget = document.getElementById('user-level-widget');
        const minimizeBtn = document.getElementById('ulw-minimize-btn');
        const storageKey = 'ulw-minimized';

        // Check if widget was previously minimized
        const wasMinimized = localStorage.getItem(storageKey) === 'true';
        if (wasMinimized) {
            widget.classList.add('minimized');
        }

        // Toggle minimize state
        minimizeBtn.addEventListener('click', function (e) {
            e.preventDefault();
            widget.classList.toggle('minimized');
            localStorage.setItem(storageKey, widget.classList.contains('minimized').toString());
        });
    }

    async function loadGamification() {
        try {
            const res = await fetch('{{ path('app_notifications_gamification') }}');
            if (!res.ok) throw new Error('fetch failed');
            window._ulwData = await res.json();
            render(window._ulwData);
        } catch (e) {
            document.getElementById('ulw-skeleton').innerHTML =
                '<p style="font-size:.8rem;color:#9ca3af;margin:0">Niveau non disponible</p>';
        }
    }

    function render(data) {
        const { points, loginCount, level, badges, nextBadges } = data;
        const col = LEVEL_COLORS[level.number] || LEVEL_COLORS[1];

        const badgesHtml = badges.length
            ? badges.map(b => `<span class="ulw-badge" title="${b.description}">${b.icon} ${b.label}</span>`).join('')
            : '<span style="font-size:.75rem;color:#9ca3af">Aucun badge encore — commencez !</span>';

        const tipsHtml = nextBadges.length
            ? nextBadges.map(b => `
                <div class="ulw-tip">
                    <span class="ulw-tip-icon">🔒</span>
                    <div class="ulw-tip-body">
                        <span class="ulw-tip-label">${b.icon} ${b.label}</span>
                        <span class="ulw-tip-text">${b.tip}</span>
                    </div>
                </div>`).join('')
            : '';

        const progressLabel = level.number < 7
            ? `Niv. ${level.number + 1} dans ${level.points_to_next} pts`
            : '🏆 Niveau maximum !';

        const fanStatus = loginCount < 100
            ? `encore <strong>${100 - loginCount}</strong> connexion${(100 - loginCount) > 1 ? 's' : ''} pour le badge Fan ❤️`
            : '<strong style="color:#16a34a">Badge Fan ❤️ débloqué !</strong>';

        document.getElementById('ulw-content').innerHTML = `
            <div class="ulw-header">
                <span class="ulw-level-pill" style="background:${col.bg};color:${col.text}">
                    ${level.icon} Niv.${level.number} — ${level.label}
                </span>
                <div class="ulw-header-right">
                    <span class="ulw-points">${points} pts</span>
                    <button class="ulw-achievements-btn" onclick="openAchievementsPanel()" type="button">🏆 Succès</button>
                </div>
            </div>

            <div class="ulw-progress-wrap">
                <div class="ulw-progress-label">
                    <span>Vers le prochain niveau</span>
                    <span>${progressLabel}</span>
                </div>
                <div class="ulw-progress-track">
                    <div class="ulw-progress-fill" style="width:${level.progress}%;background:${col.bar}"></div>
                </div>
            </div>

            ${badges.length ? `<div class="ulw-section-title">Badges obtenus (${badges.length})</div>` : ''}
            <div class="ulw-badges">${badgesHtml}</div>

            ${tipsHtml ? `<div class="ulw-section-title">Comment débloquer les prochains</div><div class="ulw-tips">${tipsHtml}</div>` : ''}

            <div class="ulw-login-row">
                📅 <strong>${loginCount}</strong> connexion${loginCount > 1 ? 's' : ''} — ${fanStatus}
            </div>
        `;

        document.getElementById('ulw-skeleton').style.display = 'none';
        document.getElementById('ulw-content').style.display  = 'block';

        // Render minimized view
        renderMinimizedInfo(data);
    }

    function renderMinimizedInfo(data) {
        const { points, loginCount, level, badges } = data;
        const col = LEVEL_COLORS[level.number] || LEVEL_COLORS[1];

        // Level display
        const miniLevelHtml = `
            <div class="ulw-mini-level-icon">${level.icon}</div>
            <div class="ulw-mini-level-content">
                <p class="ulw-mini-level-label">Niveau ${level.number}</p>
                <p class="ulw-mini-level-value" style="color:${col.text}">${level.label}</p>
            </div>
        `;

        // Brief stats
        const miniStatsHtml = `
            <div class="ulw-mini-stat">
                <span class="ulw-mini-stat-value">${points}</span>
                Points
            </div>
            <div class="ulw-mini-stat">
                <span class="ulw-mini-stat-value">${badges.length}</span>
                Badges
            </div>
            <div class="ulw-mini-stat">
                <span class="ulw-mini-stat-value">${loginCount}</span>
                Visites
            </div>
        `;

        document.getElementById('ulw-mini-level').innerHTML = miniLevelHtml;
        document.getElementById('ulw-mini-stats').innerHTML = miniStatsHtml;
    }

    // Initialize minimize button first
    initializeMinimizeButton();
    
    // Load gamification data
    loadGamification();
})();
</script>
