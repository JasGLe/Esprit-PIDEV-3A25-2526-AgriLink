{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Tableau de bord - AgriLink{% endblock %}
{% block page_title %}Mon espace{% endblock %}

{% block role_badge %}
    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
        👤 Utilisateur
    </span>
{% endblock %}

{% block role_specific_navigation %}
    <hr class="my-3 border-gray-200">
    <div class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
        Explorer
    </div>
    
    <a href="#" class="flex items-center px-3 py-2 text-sm font-medium rounded-md text-gray-700 hover:bg-gray-100">
        <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        Marketplace
    </a>

    <a href="#" class="flex items-center px-3 py-2 text-sm font-medium rounded-md text-gray-700 hover:bg-gray-100">
        <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        Communauté
    </a>

    <a href="#" class="flex items-center px-3 py-2 text-sm font-medium rounded-md text-gray-700 hover:bg-gray-100">
        <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        Ressources
    </a>
{% endblock %}

{% block mobile_sidebar %}
    {{ block('sidebar_navigation') }}
{% endblock %}

{% block dashboard_content %}
    {# Welcome section #}
    <div class="mb-8">
        <h2 class="text-2xl font-bold text-gray-900">Bienvenue sur AgriLink, {{ app.user.displayName }} ! 👋</h2>
        <p class="mt-1 text-sm text-gray-600">
            Découvrez notre plateforme et commencez votre parcours agricole.
        </p>
    </div>

    {# Quick Stats #}
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 mb-8">
        {# Profile Completion #}
        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-12 h-12 bg-gray-100 rounded-lg flex items-center justify-center">
                            <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </div>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Profil complété</dt>
                            <dd class="text-lg font-semibold text-gray-900">--%</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <a href="{{ path('app_profile_edit') }}" class="text-sm font-medium text-primary-600 hover:text-primary-700">Compléter →</a>
            </div>
        </div>

        {# Activity #}
        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg>
                        </div>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Activité</dt>
                            <dd class="text-lg font-semibold text-gray-900">Nouveau</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <span class="text-sm text-gray-500">Membre depuis {{ app.user.createdAt ? app.user.createdAt|date('M Y') : 'récemment' }}</span>
            </div>
        </div>

        {# Notifications #}
        <div class="bg-white overflow-hidden shadow rounded-lg">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                            </svg>
                        </div>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Notifications</dt>
                            <dd class="text-lg font-semibold text-gray-900">--</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <span class="text-sm text-gray-500">Non lues</span>
            </div>
        </div>
    </div>

    {# Main content grid #}
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        {# Getting Started #}
        {% embed 'components/_card.html.twig' %}
            {% block card_title %}🚀 Premiers pas sur AgriLink{% endblock %}
            {% block card_content %}
                <div class="space-y-4">
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <div class="w-8 h-8 bg-green-100 rounded-full flex items-center justify-center">
                                <svg class="w-4 h-4 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                                </svg>
                            </div>
                        </div>
                        <div class="ml-4">
                            <p class="text-sm font-medium text-gray-900">Créer votre compte</p>
                            <p class="text-sm text-gray-500">Inscription terminée ✓</p>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <div class="w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center">
                                <span class="text-sm font-medium text-gray-600">2</span>
                            </div>
                        </div>
                        <div class="ml-4">
                            <p class="text-sm font-medium text-gray-900">Compléter votre profil</p>
                            <p class="text-sm text-gray-500">Ajoutez vos informations</p>
                            <a href="{{ path('app_profile_edit') }}" class="text-sm text-primary-600 hover:text-primary-700">Compléter maintenant →</a>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <div class="w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center">
                                <span class="text-sm font-medium text-gray-600">3</span>
                            </div>
                        </div>
                        <div class="ml-4">
                            <p class="text-sm font-medium text-gray-900">Choisir votre rôle</p>
                            <p class="text-sm text-gray-500">Agriculteur, Fournisseur ou AgriPlus</p>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <div class="w-8 h-8 bg-gray-100 rounded-full flex items-center justify-center">
                                <span class="text-sm font-medium text-gray-600">4</span>
                            </div>
                        </div>
                        <div class="ml-4">
                            <p class="text-sm font-medium text-gray-900">Explorer la plateforme</p>
                            <p class="text-sm text-gray-500">Découvrez toutes les fonctionnalités</p>
                        </div>
                    </div>
                </div>
            {% endblock %}
        {% endembed %}

        {# Upgrade Options #}
        {% embed 'components/_card.html.twig' %}
            {% block card_title %}Évoluez avec AgriLink{% endblock %}
            {% block card_content %}
                <div class="space-y-4">
                    <a href="#" class="block p-4 rounded-lg border border-gray-200 hover:border-green-300 hover:bg-green-50 transition-colors">
                        <div class="flex items-center">
                            <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center mr-4">
                                <span class="text-2xl">🌱</span>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-gray-900">Devenir Agriculteur</p>
                                <p class="text-xs text-gray-500">Gérez votre exploitation et vos cultures</p>
                            </div>
                        </div>
                    </a>

                    <a href="#" class="block p-4 rounded-lg border border-gray-200 hover:border-blue-300 hover:bg-blue-50 transition-colors">
                        <div class="flex items-center">
                            <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center mr-4">
                                <span class="text-2xl">🏢</span>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-gray-900">Devenir Fournisseur</p>
                                <p class="text-xs text-gray-500">Vendez vos produits aux agriculteurs</p>
                            </div>
                        </div>
                    </a>

                    <a href="#" class="block p-4 rounded-lg border border-gray-200 hover:border-yellow-300 hover:bg-yellow-50 transition-colors">
                        <div class="flex items-center">
                            <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center mr-4">
                                <span class="text-2xl">⭐</span>
                            </div>
                            <div>
                                <p class="text-sm font-semibold text-gray-900">Passer à AgriPlus</p>
                                <p class="text-xs text-gray-500">Accédez aux fonctionnalités premium</p>
                            </div>
                        </div>
                    </a>
                </div>
            {% endblock %}
        {% endembed %}
    </div>

    {# Welcome Info #}
    <div class="mt-8">
        {% embed 'components/_card.html.twig' %}
            {% block card_title %}À propos d'AgriLink{% endblock %}
            {% block card_content %}
                <div class="prose prose-sm max-w-none">
                    <p class="text-gray-700">
                        AgriLink est une plateforme dédiée à la communauté agricole tunisienne. 
                        Nous connectons agriculteurs, fournisseurs et experts pour une agriculture plus efficace et durable.
                    </p>
                    <ul class="mt-4 space-y-2">
                        <li class="flex items-start">
                            <span class="text-primary-600 mr-2">✓</span>
                            <span class="text-gray-700">Marketplace pour acheter et vendre des produits agricoles</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-primary-600 mr-2">✓</span>
                            <span class="text-gray-700">Outils de gestion pour votre exploitation</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-primary-600 mr-2">✓</span>
                            <span class="text-gray-700">Communauté d'experts et de passionnés</span>
                        </li>
                        <li class="flex items-start">
                            <span class="text-primary-600 mr-2">✓</span>
                            <span class="text-gray-700">Conseils personnalisés avec AgriPlus</span>
                        </li>
                    </ul>
                </div>
            {% endblock %}
        {% endembed %}
    </div>
{% endblock %}
