{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Tableau de bord AgriPlus - AgriLink{% endblock %}
{% block page_title %}Espace AgriPlus{% endblock %}

{% block role_badge %}
    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
        ⭐ AgriPlus
        {% if app.user.agriplusAbonnement %}
            - {{ app.user.agriplusAbonnement }}
        {% endif %}
    </span>
{% endblock %}

{% block role_specific_navigation %}
    <hr class="my-3 border-gray-200">
    <div class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
        Fonctionnalités Premium
    </div>
    
    <a href="#" class="flex items-center px-3 py-2 text-sm font-medium rounded-md text-gray-700 hover:bg-gray-100">
        <svg class="mr-3 h-5 w-5 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
        </svg>
        Conseils personnalisés
    </a>

    <a href="#" class="flex items-center px-3 py-2 text-sm font-medium rounded-md text-gray-700 hover:bg-gray-100">
        <svg class="mr-3 h-5 w-5 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        Analyses avancées
    </a>

    <a href="#" class="flex items-center px-3 py-2 text-sm font-medium rounded-md text-gray-700 hover:bg-gray-100">
        <svg class="mr-3 h-5 w-5 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
        </svg>
        Prévisions météo
    </a>

    <a href="#" class="flex items-center px-3 py-2 text-sm font-medium rounded-md text-gray-700 hover:bg-gray-100">
        <svg class="mr-3 h-5 w-5 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        Support prioritaire
    </a>

    <hr class="my-3 border-gray-200">
    <div class="px-3 py-2 text-xs font-semibold text-gray-500 uppercase tracking-wider">
        Mon abonnement
    </div>

    <a href="#" class="flex items-center px-3 py-2 text-sm font-medium rounded-md text-gray-700 hover:bg-gray-100">
        <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
        </svg>
        Gérer l'abonnement
    </a>

    <a href="#" class="flex items-center px-3 py-2 text-sm font-medium rounded-md text-gray-700 hover:bg-gray-100">
        <svg class="mr-3 h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Factures
    </a>
{% endblock %}

{% block mobile_sidebar %}
    {{ block('sidebar_navigation') }}
{% endblock %}

{% block dashboard_content %}
    {# Welcome section #}
    <div class="mb-8">
        <h2 class="text-2xl font-bold text-gray-900">Bienvenue, {{ app.user.displayName }} ! ⭐</h2>
        <p class="mt-1 text-sm text-gray-600">
            Profitez de toutes les fonctionnalités premium d'AgriPlus.
        </p>
    </div>

    {# Subscription Info Banner #}
    <div class="mb-8 bg-gradient-to-r from-yellow-400 to-orange-500 rounded-xl shadow-lg overflow-hidden">
        <div class="px-6 py-6">
            <div class="flex flex-col sm:flex-row items-center justify-between">
                <div class="flex items-center mb-4 sm:mb-0">
                    <div class="w-16 h-16 bg-white bg-opacity-20 rounded-full flex items-center justify-center mr-4">
                        <span class="text-3xl">⭐</span>
                    </div>
                    <div class="text-white">
                        <h3 class="text-lg font-bold">
                            Abonnement {{ app.user.agriplusAbonnement|default('Premium') }}
                        </h3>
                        {% if app.user.agriplusDateExpiration %}
                            <p class="text-yellow-100 text-sm">
                                Expire le {{ app.user.agriplusDateExpiration|date('d/m/Y') }}
                            </p>
                        {% else %}
                            <p class="text-yellow-100 text-sm">Abonnement actif</p>
                        {% endif %}
                    </div>
                </div>
                <div class="flex space-x-3">
                    <a href="#" class="inline-flex items-center px-4 py-2 border border-white border-opacity-30 text-sm font-medium rounded-md text-white hover:bg-white hover:bg-opacity-10 transition-colors">
                        Gérer
                    </a>
                    {% if app.user.agriplusAbonnement != 'ENTERPRISE' %}
                        <a href="#" class="inline-flex items-center px-4 py-2 bg-white text-sm font-medium rounded-md text-yellow-600 hover:bg-yellow-50 transition-colors">
                            Upgrader
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {# Quick Stats #}
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4 mb-8">
        {# AI Recommendations #}
        <div class="bg-white overflow-hidden shadow rounded-lg border-l-4 border-yellow-400">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center">
                            <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                            </svg>
                        </div>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Recommandations IA</dt>
                            <dd class="text-lg font-semibold text-gray-900">--</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <a href="#" class="text-sm font-medium text-yellow-600 hover:text-yellow-700">Voir →</a>
            </div>
        </div>

        {# Weather Alerts #}
        <div class="bg-white overflow-hidden shadow rounded-lg border-l-4 border-blue-400">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
                            </svg>
                        </div>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Alertes météo</dt>
                            <dd class="text-lg font-semibold text-gray-900">--</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <span class="text-sm text-gray-500">Cette semaine</span>
            </div>
        </div>

        {# Market Trends #}
        <div class="bg-white overflow-hidden shadow rounded-lg border-l-4 border-green-400">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                            </svg>
                        </div>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Tendances marché</dt>
                            <dd class="text-lg font-semibold text-green-600">+12%</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <a href="#" class="text-sm font-medium text-green-600 hover:text-green-700">Analyser →</a>
            </div>
        </div>

        {# Support Tickets #}
        <div class="bg-white overflow-hidden shadow rounded-lg border-l-4 border-purple-400">
            <div class="p-5">
                <div class="flex items-center">
                    <div class="flex-shrink-0">
                        <div class="w-12 h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                            </svg>
                        </div>
                    </div>
                    <div class="ml-5 w-0 flex-1">
                        <dl>
                            <dt class="text-sm font-medium text-gray-500 truncate">Support prioritaire</dt>
                            <dd class="text-lg font-semibold text-gray-900">Actif</dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-5 py-3">
                <a href="#" class="text-sm font-medium text-purple-600 hover:text-purple-700">Contacter →</a>
            </div>
        </div>
    </div>

    {# Main content grid #}
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        {# AI Recommendations #}
        {% embed 'components/_card.html.twig' %}
            {% block card_title %}
                <div class="flex items-center">
                    <span class="mr-2">🤖</span> Recommandations IA
                </div>
            {% endblock %}
            {% block card_content %}
                <div class="space-y-4">
                    <div class="p-4 bg-yellow-50 rounded-lg border border-yellow-200">
                        <div class="flex items-start">
                            <div class="flex-shrink-0">
                                <span class="text-xl">💡</span>
                            </div>
                            <div class="ml-3">
                                <p class="text-sm font-medium text-yellow-800">Conseil du jour</p>
                                <p class="text-sm text-yellow-700 mt-1">
                                    Basé sur les conditions météo prévues, c'est le moment idéal pour planifier vos semis de printemps.
                                </p>
                            </div>
                        </div>
                    </div>

                    <div class="p-4 bg-green-50 rounded-lg border border-green-200">
                        <div class="flex items-start">
                            <div class="flex-shrink-0">
                                <span class="text-xl">📈</span>
                            </div>
                            <div class="ml-3">
                                <p class="text-sm font-medium text-green-800">Opportunité marché</p>
                                <p class="text-sm text-green-700 mt-1">
                                    Les prix des céréales sont en hausse. Considérez la vente de votre stock.
                                </p>
                            </div>
                        </div>
                    </div>

                    <a href="#" class="block text-center text-sm font-medium text-yellow-600 hover:text-yellow-700 mt-4">
                        Voir toutes les recommandations →
                    </a>
                </div>
            {% endblock %}
        {% endembed %}

        {# Premium Features #}
        {% embed 'components/_card.html.twig' %}
            {% block card_title %}
                <div class="flex items-center">
                    <span class="mr-2">✨</span> Fonctionnalités Premium
                </div>
            {% endblock %}
            {% block card_content %}
                <div class="space-y-3">
                    <a href="#" class="flex items-center p-3 rounded-lg border border-gray-200 hover:bg-yellow-50 hover:border-yellow-200 transition-colors">
                        <div class="w-10 h-10 bg-yellow-100 rounded-lg flex items-center justify-center mr-4">
                            <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-gray-900">Analyses avancées</p>
                            <p class="text-xs text-gray-500">Rapports détaillés et prévisions</p>
                        </div>
                    </a>

                    <a href="#" class="flex items-center p-3 rounded-lg border border-gray-200 hover:bg-yellow-50 hover:border-yellow-200 transition-colors">
                        <div class="w-10 h-10 bg-blue-100 rounded-lg flex items-center justify-center mr-4">
                            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-gray-900">Météo premium</p>
                            <p class="text-xs text-gray-500">Prévisions 14 jours + alertes</p>
                        </div>
                    </a>

                    <a href="#" class="flex items-center p-3 rounded-lg border border-gray-200 hover:bg-yellow-50 hover:border-yellow-200 transition-colors">
                        <div class="w-10 h-10 bg-green-100 rounded-lg flex items-center justify-center mr-4">
                            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-gray-900">Communauté exclusive</p>
                            <p class="text-xs text-gray-500">Forums et événements VIP</p>
                        </div>
                    </a>
                </div>
            {% endblock %}
        {% endembed %}
    </div>

    {# Weather Widget #}
    <div class="mt-8">
        {% embed 'components/_card.html.twig' %}
            {% block card_title %}
                <div class="flex items-center justify-between">
                    <div class="flex items-center">
                        <span class="mr-2">🌤️</span> Prévisions météo - {{ app.user.ville|default('Votre région') }}
                    </div>
                    <span class="text-xs font-normal text-yellow-600 bg-yellow-100 px-2 py-1 rounded-full">Premium</span>
                </div>
            {% endblock %}
            {% block card_content %}
                <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-4">
                    {% for i in 1..7 %}
                    <div class="text-center p-3 rounded-lg {{ i == 1 ? 'bg-blue-50 border border-blue-200' : 'bg-gray-50' }}">
                        <p class="text-xs font-medium text-gray-500 mb-2">
                            {% if i == 1 %}Aujourd'hui{% else %}+{{ i-1 }} jour{% endif %}
                        </p>
                        <div class="text-2xl mb-2">
                            {% set weathers = ['☀️', '⛅', '🌤️', '🌧️', '⛈️', '🌦️', '☁️'] %}
                            {{ weathers[random(6)] }}
                        </div>
                        <p class="text-sm font-semibold text-gray-900">--°C</p>
                        <p class="text-xs text-gray-500">--°C</p>
                    </div>
                    {% endfor %}
                </div>
            {% endblock %}
        {% endembed %}
    </div>
{% endblock %}
