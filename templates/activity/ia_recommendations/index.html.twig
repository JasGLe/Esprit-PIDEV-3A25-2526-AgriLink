{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Recommandations IA — vos activités{% endblock %}
{% block page_title %}Recommandations IA{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .reco-ia-wrap { max-width: 920px; margin: 0 auto; }
        .reco-hero {
            background: linear-gradient(135deg, #14532d 0%, #22c55e 100%);
            color: #fff;
            border-radius: 16px;
            padding: 1.75rem 1.5rem;
            margin-bottom: 1.5rem;
            box-shadow: 0 12px 40px rgba(20, 83, 45, 0.25);
        }
        .reco-hero h1 { font-size: 1.35rem; font-weight: 700; margin: 0 0 .5rem; }
        .reco-hero p { margin: 0; opacity: .92; font-size: .95rem; line-height: 1.55; }
        .reco-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: .75rem;
            margin-bottom: 1.5rem;
        }
        .reco-stat {
            background: #ecfdf5;
            border: 1px solid #bbf7d0;
            border-radius: 12px;
            padding: .85rem 1rem;
            text-align: center;
        }
        .reco-stat .num { font-size: 1.5rem; font-weight: 700; color: #166534; line-height: 1.2; }
        .reco-stat .lbl { font-size: .75rem; color: #15803d; text-transform: uppercase; letter-spacing: .04em; margin-top: .25rem; }
        .reco-card {
            background: #fff;
            border-radius: 14px;
            padding: 1.25rem 1.35rem;
            margin-bottom: 1rem;
            box-shadow: 0 2px 12px rgba(0,0,0,.06);
            border-left: 4px solid #22c55e;
        }
        .reco-card.critical { border-left-color: #dc2626; }
        .reco-card.warn { border-left-color: #ca8a04; }
        .reco-card.ok-soft { border-left-color: #16a34a; background: #f0fdf4; }
        .reco-card h2 {
            font-size: 1rem;
            font-weight: 600;
            color: #0f172a;
            margin: 0 0 .75rem;
            display: flex;
            align-items: center;
            gap: .5rem;
        }
        .reco-card p { margin: 0 0 .5rem; color: #475569; font-size: .95rem; line-height: 1.55; }
        .reco-card p:last-child { margin-bottom: 0; }
        .reco-actions .row-action {
            display: flex;
            gap: .75rem;
            padding: .65rem 0;
            border-bottom: 1px solid #f1f5f9;
            align-items: flex-start;
        }
        .reco-actions .row-action:last-child { border-bottom: none; }
        .reco-actions .idx {
            flex-shrink: 0;
            width: 28px; height: 28px;
            border-radius: 50%;
            background: #22c55e;
            color: #fff;
            font-size: .8rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-top: 2px;
        }
        .reco-badge {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
            padding: .4rem .85rem;
            border-radius: 999px;
            font-size: .8rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }
        .reco-badge.warn { background: #fef9c3; color: #854d0e; }
        .reco-badge.ok { background: #dcfce7; color: #166534; }
        .reco-empty {
            text-align: center;
            padding: 2.5rem 1.25rem;
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            border-radius: 16px;
        }
        .reco-empty .icon { font-size: 2.75rem; margin-bottom: .75rem; }
        .reco-foot {
            font-size: .8rem;
            color: #64748b;
            margin-top: 1.5rem;
            padding: 1rem;
            background: #f8fafc;
            border-radius: 10px;
            border: 1px solid #e2e8f0;
        }
    </style>
{% endblock %}

{% block dashboard_content %}
    <div class="reco-ia-wrap">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <a href="{{ path('activite_list') }}" class="btn btn-outline-secondary btn-sm">← Retour aux activités</a>
        </div>

        <header class="reco-hero">
            <h1>🤖 Bonjour {{ recoUserDisplayName|e }}</h1>
            <p>
                Cette page analyse <strong>vos activités agricoles</strong> déjà planifiées sur les
                <strong>{{ nextDays }} prochains jours</strong> et vous propose des <strong>pistes concrètes</strong>
                adaptées à votre situation (coûts, durées, enchaînement des travaux). L’objectif est de vous aider à
                prioriser ce qui mérite un coup d’œil dans <strong>votre calendrier</strong>, pas un diagnostic officiel.
            </p>
        </header>

        <div class="reco-stats">
            <div class="reco-stat">
                <div class="num">{{ plannedActivitiesCount }}</div>
                <div class="lbl">Activités planifiées (fenêtre {{ nextDays }} j.)</div>
            </div>
            <div class="reco-stat">
                <div class="num">{{ anomalyGroupsCount }}</div>
                <div class="lbl">Lots avec alertes détectées</div>
            </div>
            <div class="reco-stat">
                <div class="num">{% if recommendations.status == 'ok' %}OK{% else %}IA{% endif %}</div>
                <div class="lbl">{% if recommendations.status == 'ok' %}Rien d’urgent{% else %}Analyse + conseils{% endif %}</div>
            </div>
        </div>

        {% if recommendations.status == 'ok' %}
            <div class="reco-empty">
                <div class="icon" aria-hidden="true">✅</div>
                <h2 class="h5 fw-bold text-success mb-2">Tout semble cohérent sur cette période</h2>
                <p class="text-muted mb-0" style="max-width: 32rem; margin: 0 auto;">
                    Aucune incohérence majeure n’a été repérée sur <strong>vos</strong> activités des prochains jours.
                    Vous pouvez continuer à enregistrer et ajuster vos interventions dans la liste des activités.
                </p>
            </div>

        {% elseif recommendations.status == 'anomalies_found' and recommendations.recommendations %}
            <span class="reco-badge warn">
                <span aria-hidden="true">⚠️</span>
                {{ recommendations.anomalies_count }} alerte{{ recommendations.anomalies_count > 1 ? 's' : '' }} — voici ce qui peut vous concerner en premier
            </span>

            {% if recommendations.recommendations.anomalies_critique %}
                <div class="reco-card critical">
                    <h2><span aria-hidden="true">🔴</span> À traiter en priorité</h2>
                    {% for anomaly in recommendations.recommendations.anomalies_critique %}
                        <p>{{ anomaly }}</p>
                    {% endfor %}
                </div>
            {% endif %}

            {% if recommendations.recommendations.anomalies_mineures %}
                <div class="reco-card warn">
                    <h2><span aria-hidden="true">🟡</span> Points à surveiller</h2>
                    {% for anomaly in recommendations.recommendations.anomalies_mineures %}
                        <p>{{ anomaly }}</p>
                    {% endfor %}
                </div>
            {% endif %}

            {% if recommendations.recommendations.recommandations %}
                <div class="reco-card ok-soft">
                    <h2><span aria-hidden="true">💡</span> Idées d’actions pour vous</h2>
                    <p class="small text-muted mb-3">Propositions à adapter à votre parcelle, météo et matériel — ce sont des aides à la décision.</p>
                    <div class="reco-actions">
                        {% for action in recommendations.recommendations.recommandations %}
                            <div class="row-action">
                                <span class="idx">{{ loop.index }}</span>
                                <div class="text-dark small" style="line-height: 1.5;">{{ action }}</div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if recommendations.recommendations.resume %}
                <div class="reco-card">
                    <h2><span aria-hidden="true">📋</span> Synthèse</h2>
                    <p>{{ recommendations.recommendations.resume }}</p>
                </div>
            {% endif %}

        {% else %}
            <div class="reco-card critical">
                <h2><span aria-hidden="true">⚠️</span> {{ recommendations.message }}</h2>
                {% if recommendations.error %}
                    <p>{{ recommendations.error }}</p>
                {% endif %}
            </div>
        {% endif %}

        <p class="reco-foot mb-0">
            Les suggestions sont générées automatiquement à partir <strong>de vos données d’activités</strong> dans AgriLink.
            En cas de doute (phyto, irrigation, assurance), croisez toujours avec un conseiller ou la réglementation en vigueur.
        </p>
    </div>
{% endblock %}
