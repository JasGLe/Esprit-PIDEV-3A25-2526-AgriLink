<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Extrait d'activité</title>
    <style>
        body {
            font-family: DejaVu Sans, Arial, sans-serif;
            color: #111827;
            margin: 0;
            padding: 28px;
            background: #f3f4f6;
        }

        .sheet {
            background: #ffffff;
            border: 1px solid #d1d5db;
            border-radius: 14px;
            padding: 0;
            overflow: hidden;
        }

        .header {
            background: #ecfdf5;
            border-bottom: 1px solid #bbf7d0;
            padding: 22px 24px;
            text-align: center;
        }

        .logo {
            width: 160px;
            height: auto;
            margin-bottom: 8px;
        }

        .header-title {
            color: #166534;
            font-size: 24px;
            font-weight: 700;
            margin: 0;
            letter-spacing: 0.01em;
        }

        .header-subtitle {
            color: #4b5563;
            margin-top: 6px;
            font-size: 13px;
        }

        .content {
            padding: 26px 24px;
        }

        .section-title {
            font-size: 18px;
            color: #0f766e;
            font-weight: 700;
            margin-bottom: 16px;
            padding-bottom: 8px;
            border-bottom: 2px solid #10b981;
        }

        .info-box {
            border: 1px solid #dbeafe;
            background: #eff6ff;
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 18px;
        }

        .label {
            text-transform: uppercase;
            letter-spacing: .08em;
            font-size: 11px;
            color: #6b7280;
            margin-bottom: 4px;
        }

        .value {
            font-size: 15px;
            font-weight: 700;
            color: #111827;
        }

        .grid {
            width: 100%;
            border-collapse: collapse;
            margin-top: 14px;
        }

        .grid td {
            width: 50%;
            padding: 10px 0;
            vertical-align: top;
        }

        .status-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .status-en-cours {
            background: #dcfce7;
            color: #166534;
        }

        .status-planifie {
            background: #dbeafe;
            color: #1e40af;
        }

        .status-termine {
            background: #e0e7ff;
            color: #4338ca;
        }

        .footer {
            margin-top: 26px;
            font-size: 12px;
            color: #6b7280;
            border-top: 1px solid #e5e7eb;
            padding-top: 14px;
            text-align: center;
        }

        .summary-box {
            background: #fef3c7;
            border: 1px solid #fde68a;
            border-radius: 10px;
            padding: 14px;
            margin-top: 18px;
        }

        .summary-label {
            font-size: 12px;
            color: #92400e;
            text-transform: uppercase;
            font-weight: 700;
        }

        .summary-value {
            font-size: 20px;
            color: #78350f;
            font-weight: 700;
            margin-top: 4px;
        }
    </style>
</head>
<body>
    <div class="sheet">
        <div class="header">
            {% if logoDataUri %}
                <img src="{{ logoDataUri }}" alt="AgriLink" class="logo">
            {% endif %}
            <h1 class="header-title">Extrait d'Activité Agricole</h1>
            <div class="header-subtitle">Document généré le {{ generatedAt|date('d/m/Y à H:i') }}</div>
        </div>

        <div class="content">
            <div class="section-title">Informations générales</div>

            <div class="info-box">
                <div class="label">Titre de l'activité</div>
                <div class="value">{{ activite.titre }}</div>
            </div>

            <table class="grid">
                <tr>
                    <td>
                        <div class="label">Type d'activité</div>
                        <div class="value">{{ activite.typeActivite }}</div>
                    </td>
                    <td>
                        <div class="label">Statut</div>
                        <div>
                            <span class="status-badge status-{{ activite.statut|lower|replace({' ': '-', 'é': 'e'}) }}">
                                {{ activite.statut }}
                            </span>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td>
                        <div class="label">Date de début</div>
                        <div class="value">{{ activite.dateDebut|date('d/m/Y à H:i') }}</div>
                    </td>
                    <td>
                        <div class="label">Date de fin</div>
                        <div class="value">
                            {% if activite.dateFin %}
                                {{ activite.dateFin|date('d/m/Y à H:i') }}
                            {% else %}
                                <em style="color: #9ca3af;">Non renseignée</em>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                <tr>
                    <td colspan="2">
                        <div class="label">Référence</div>
                        <div class="value">ACT-{{ activite.id }}-{{ generatedAt|date('Ymd') }}</div>
                    </td>
                </tr>
            </table>

            {% if activite.coutEstime %}
                <div class="summary-box">
                    <div class="summary-label">Coût estimé</div>
                    <div class="summary-value">{{ activite.coutEstime }} DT</div>
                </div>
            {% endif %}

            <div class="section-title" style="margin-top: 26px;">Durée de l'activité</div>
            
            <table class="grid">
                <tr>
                    <td>
                        <div class="label">Début</div>
                        <div class="value">{{ activite.dateDebut|date('d/m/Y') }}</div>
                    </td>
                    <td>
                        <div class="label">Fin</div>
                        <div class="value">
                            {% if activite.dateFin %}
                                {{ activite.dateFin|date('d/m/Y') }}
                            {% else %}
                                En cours
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% if activite.dateFin %}
                    <tr>
                        <td colspan="2">
                            <div class="label">Durée totale</div>
                            <div class="value">
                                {% set diff = activite.dateDebut.diff(activite.dateFin) %}
                                {{ diff.days }} jour(s)
                            </div>
                        </td>
                    </tr>
                {% endif %}
            </table>

            <div class="footer">
                Extrait généré automatiquement par AgriLink<br>
                Ce document certifie les informations relatives à l'activité agricole référencée ci-dessus.
            </div>
        </div>
    </div>
</body>
</html>
