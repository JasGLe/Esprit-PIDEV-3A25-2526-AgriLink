{% extends 'base.html.twig' %}

{% block title %}Recommandations IA - Détecteur D'Anomalies{% endblock %}

{% block content %}
<div class="container mt-5">
    <!-- Header Section -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="d-flex align-items-center gap-3">
                <div class="p-3 bg-warning bg-opacity-10 rounded">
                    <i class="fas fa-robot fa-2x text-warning"></i>
                </div>
                <div>
                    <h1 class="mb-1">🚨 Détecteur d'Anomalies</h1>
                    <p class="text-muted">Analyse IA des 10 prochains jours - {{ nextDays }} jours</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Status Messages -->
    <div class="row mb-4">
        <div class="col-md-12">
            {% if recommendations.status == 'ok' %}
                <div class="alert alert-success border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-check-circle me-3 fa-lg"></i>
                        <div>
                            <h4 class="mb-0">{{ recommendations.message }}</h4>
                        </div>
                    </div>
                </div>
            {% elseif recommendations.status == 'anomalies_found' %}
                <div class="alert alert-danger border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-exclamation-triangle me-3 fa-lg"></i>
                        <div>
                            <h4 class="mb-1">{{ recommendations.message }}</h4>
                            <small>{{ recommendations.anomalies_count }} anomalie(s) détectée(s)</small>
                        </div>
                    </div>
                </div>
            {% elseif recommendations.status == 'error' %}
                <div class="alert alert-warning border-0 shadow-sm" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-info-circle me-3 fa-lg"></i>
                        <div>
                            <h4 class="mb-0">{{ recommendations.message }}</h4>
                            {% if recommendations.error %}
                                <small class="text-muted">{{ recommendations.error }}</small>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    <!-- Recommendations IA Section -->
    {% if recommendations.status == 'anomalies_found' and recommendations.recommendations %}
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-gradient" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <h5 class="mb-0 text-white">
                            <i class="fas fa-lightbulb me-2"></i>Recommandations d'IA
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- Anomalies Critiques -->
                        {% if recommendations.recommendations.anomalies_critique %}
                            <div class="mb-4">
                                <h6 class="text-danger mb-3">
                                    <i class="fas fa-fire me-2"></i>Problèmes Critiques
                                </h6>
                                <ul class="list-group list-group-flush">
                                    {% for anomaly in recommendations.recommendations.anomalies_critique %}
                                        <li class="list-group-item border-start border-4 border-danger">
                                            <div class="d-flex align-items-start">
                                                <i class="fas fa-times-circle text-danger me-2 mt-1"></i>
                                                <div>
                                                    <p class="mb-0">{{ anomaly }}</p>
                                                </div>
                                            </div>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        <!-- Anomalies Mineures -->
                        {% if recommendations.recommendations.anomalies_mineures %}
                            <div class="mb-4">
                                <h6 class="text-warning mb-3">
                                    <i class="fas fa-exclamation-circle me-2"></i>Points d'Attention
                                </h6>
                                <ul class="list-group list-group-flush">
                                    {% for anomaly in recommendations.recommendations.anomalies_mineures %}
                                        <li class="list-group-item border-start border-4 border-warning">
                                            <div class="d-flex align-items-start">
                                                <i class="fas fa-info-circle text-warning me-2 mt-1"></i>
                                                <div>
                                                    <p class="mb-0">{{ anomaly }}</p>
                                                </div>
                                            </div>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        <!-- Recommandations d'Action -->
                        {% if recommendations.recommendations.recommandations %}
                            <div class="mb-3">
                                <h6 class="text-success mb-3">
                                    <i class="fas fa-check-double me-2"></i>Actions Recommandées
                                </h6>
                                <ul class="list-group list-group-flush">
                                    {% for action in recommendations.recommendations.recommandations %}
                                        <li class="list-group-item border-start border-4 border-success">
                                            <div class="d-flex align-items-start">
                                                <i class="fas fa-arrow-right text-success me-2 mt-1"></i>
                                                <div>
                                                    <p class="mb-0">{{ action }}</p>
                                                </div>
                                            </div>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        {% endif %}

                        <!-- Résumé Général -->
                        {% if recommendations.recommendations.resume %}
                            <div class="alert alert-info border-0 mt-4">
                                <h6 class="text-info mb-2">
                                    <i class="fas fa-book me-2"></i>Résumé
                                </h6>
                                <p class="mb-0">{{ recommendations.recommendations.resume }}</p>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <!-- Anomalies Détectées Section -->
    {% if anomalies and anomalies is not empty %}
        <div class="row mb-4">
            <div class="col-md-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="fas fa-bug me-2 text-danger"></i>Détails des Anomalies ({{ anomalies|length }})
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            {% for item in anomalies %}
                                {% set activity = item.activity %}
                                {% set issues = item.issues %}
                                <div class="col-md-6 mb-3">
                                    <div class="card border-danger border-1">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start mb-2">
                                                <div>
                                                    <h6 class="mb-1">{{ activity.titre }}</h6>
                                                    <small class="text-muted">
                                                        <i class="fas fa-tag me-1"></i>{{ activity.typeActivite }}
                                                    </small>
                                                </div>
                                                <span class="badge bg-danger rounded-pill">{{ issues|length }}</span>
                                            </div>

                                            <div class="mb-2">
                                                <small class="text-muted">
                                                    <i class="fas fa-calendar me-1"></i>{{ activity.dateDebut|date('d/m/Y H:i') }}
                                                </small>
                                                {% if activity.dateFin %}
                                                    <small class="text-muted ms-2">
                                                        à {{ activity.dateFin|date('H:i') }}
                                                    </small>
                                                {% endif %}
                                            </div>

                                            {% if activity.coutEstime %}
                                                <div class="mb-3">
                                                    <small class="text-muted">
                                                        <i class="fas fa-money-bill-wave me-1"></i>{{ activity.coutEstime }} DT
                                                    </small>
                                                </div>
                                            {% endif %}

                                            <div class="issues-list">
                                                {% for issue in issues %}
                                                    <div class="alert alert-sm mb-2 p-2 {% if issue.severity == 'error' %}alert-danger{% else %}alert-warning{% endif %}" role="alert">
                                                        <small>
                                                            <strong>{{ issue.type }}:</strong><br>
                                                            {{ issue.message }}
                                                        </small>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <!-- Action Buttons -->
    <div class="row mb-4">
        <div class="col-md-12 text-center">
            <a href="{{ path('activite_list') }}" class="btn btn-outline-secondary me-2">
                <i class="fas fa-arrow-left me-2"></i>Retour aux Activités
            </a>
            <a href="{{ path('activite_new') }}" class="btn btn-outline-primary">
                <i class="fas fa-plus me-2"></i>Ajouter une Activité
            </a>
        </div>
    </div>
</div>

<style>
.alert-sm {
    font-size: 0.875rem;
}

.card {
    transition: transform 0.2s, box-shadow 0.2s;
}

.card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1) !important;
}

.bg-gradient {
    background-size: 200% 200%;
    animation: gradient 3s ease infinite;
}

@keyframes gradient {
    0% {
        background-position: 0% 50%;
    }
    50% {
        background-position: 100% 50%;
    }
    100% {
        background-position: 0% 50%;
    }
}
</style>
{% endblock %}
