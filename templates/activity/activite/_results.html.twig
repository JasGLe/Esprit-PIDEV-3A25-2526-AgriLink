{% if activites is empty %}
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <div class="display-6 mb-3">🌾</div>
            <h3 class="h5 fw-bold text-dark mb-2">Aucune activité</h3>
            <p class="text-muted mb-4">Aucune activité ne correspond aux critères saisis.</p>
            <a href="{{ path('activite_new', {'redirect': app.request.uri}) }}" class="btn btn-success">Créer une activité</a>
        </div>
    </div>
{% else %}
    <div class="row g-3">
        {% for activite in activites %}
            {% set canManage = is_granted('ROLE_ADMIN') or (app.user and activite.idAgriculteur == app.user.id) %}
            <div class="col-12">
                <div class="card border-0 shadow-sm h-100 activity-record-card" style="border-left: 4px solid #16a34a !important;">
                    <div class="card-body p-3 p-lg-4">
                        <div class="d-flex flex-column flex-lg-row gap-3 align-items-lg-start">
                            <div class="flex-grow-1">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <h3 class="h5 fw-bold text-dark mb-0">{{ activite.titre }}</h3>
                                    <span class="badge text-bg-success">{{ activite.statut }}</span>
                                    <span class="badge text-bg-light text-dark border">{{ activite.typeActivite }}</span>
                                </div>
                                <div class="d-flex flex-wrap gap-2 text-muted small">
                                    <span class="px-2 py-1 rounded-2 bg-light border"><strong class="text-dark">Début:</strong> {{ activite.dateDebut|date('d/m/Y H:i') }}</span>
                                    {% if activite.dateFin %}<span class="px-2 py-1 rounded-2 bg-light border"><strong class="text-dark">Fin:</strong> {{ activite.dateFin|date('d/m/Y H:i') }}</span>{% endif %}
                                    {% if activite.coutEstime %}<span class="px-2 py-1 rounded-2 bg-light border"><strong class="text-dark">Coût:</strong> {{ activite.coutEstime }} DT</span>{% endif %}
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 ms-lg-auto">
                                <a href="{{ path('activite_show', {'id': activite.id}) }}" class="btn btn-outline-success btn-sm">Voir</a>
                                {% if canManage %}
                                    <a href="{{ path('activite_edit', {'id': activite.id}) }}" class="btn btn-success btn-sm">Modifier</a>
                                    <form method="post" action="{{ path('activite_delete', {'id': activite.id}) }}" onsubmit="return confirm('Supprimer cette activité ?');" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ activite.id) }}">
                                        <input type="hidden" name="redirect" value="{{ app.request.uri }}">
                                        <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
