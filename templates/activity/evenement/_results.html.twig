{% if evenements is empty %}
    <div class="card border-0 shadow-sm">
        <div class="card-body text-center py-5">
            <div class="display-6 mb-3">📅</div>
            <h3 class="h5 fw-bold text-dark mb-2">Aucun événement</h3>
            <p class="text-muted mb-4">Aucun événement ne correspond aux critères saisis.</p>
            <a href="{{ path('evenement_new') }}" class="btn btn-success">Créer un événement</a>
        </div>
    </div>
{% else %}
    <div class="row g-3">
        {% for evenement in evenements %}
            {% set canManage = is_granted('ROLE_ADMIN') or (app.user and evenement.idOrganisateur == app.user.id) %}
            <div class="col-12">
                <div class="card border-0 shadow-sm h-100 activity-record-card" style="border-left: 4px solid #2563eb !important;">
                    <div class="card-body p-3 p-lg-4">
                        <div class="d-flex flex-column flex-lg-row gap-3 align-items-lg-start">
                            <div class="flex-grow-1">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <h3 class="h5 fw-bold text-dark mb-0">{{ evenement.titre }}</h3>
                                    <span class="badge text-bg-light text-dark border">{{ evenement.typeEvenement }}</span>
                                </div>
                                {% if evenement.description %}
                                    <p class="text-muted mb-3">{{ evenement.description }}</p>
                                {% endif %}
                                <div class="d-flex flex-wrap gap-2 text-muted small">
                                    <span class="px-2 py-1 rounded-2 bg-light border"><strong class="text-dark">Date:</strong> {{ evenement.dateEvenement|date('d/m/Y H:i') }}</span>
                                    <span class="px-2 py-1 rounded-2 bg-light border"><strong class="text-dark">Lieu:</strong> {{ evenement.lieu }}</span>
                                </div>
                            </div>
                            <div class="d-flex flex-wrap gap-2 ms-lg-auto">
                                <a href="{{ path('evenement_show', {'id': evenement.id}) }}" class="btn btn-outline-success btn-sm">Voir</a>
                                {% if canManage %}
                                    <a href="{{ path('evenement_edit', {'id': evenement.id}) }}" class="btn btn-success btn-sm">Modifier</a>
                                    <form method="post" action="{{ path('evenement_delete', {'id': evenement.id}) }}" onsubmit="return confirm('Supprimer cet événement ?');" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
                                        <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
