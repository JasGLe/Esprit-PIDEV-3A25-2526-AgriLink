{% extends 'layouts/dashboard_layout.html.twig' %}

{% form_theme form with ['bootstrap_5_layout.html.twig', 'activity/form_theme_custom.html.twig'] %}

{% block dashboard_content %}
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <a href="{{ evenement is defined and evenement.id ? path('evenement_show', {'id': evenement.id}) : path('evenement_list') }}" class="btn btn-outline-secondary">← Retour</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    {% for message in app.flashes('info') %}
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    {% for message in app.flashes('warning') %}
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}

    {# Global form errors alert #}
    {% if form.vars.submitted and not form.vars.valid %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <div class="d-flex align-items-start">
                <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                <div>
                    <h5 class="alert-heading mb-2">Vérifiez les champs</h5>
                    <ul class="mb-0 ps-3">
                        {% set shown_fields = [] %}
                        {% for child in form %}
                            {% if child.vars.errors|length > 0 and child.vars.name not in shown_fields %}
                                {% set first_error = child.vars.errors|first %}
                                <li><strong>{{ child.vars.label|default(child.vars.name) }}:</strong> {{ first_error.message }}</li>
                                {% set shown_fields = shown_fields|merge([child.vars.name]) %}
                            {% endif %}
                        {% endfor %}
                        {% for error in form.vars.errors %}
                            <li>{{ error.message }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endif %}

    <div class="card border-0 shadow-sm overflow-hidden">
        <div class="card-header bg-primary bg-opacity-10 border-0 p-4">
            <h2 class="h5 fw-bold text-dark mb-1">Informations de l'événement</h2>
            <p class="text-muted small mb-0">Les champs marqués d'un <span class="text-danger">*</span> sont obligatoires.</p>
        </div>
        <div class="card-body p-4 p-lg-5">
            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                <div class="row g-3">
                    <div class="col-12 col-lg-6">{{ form_row(form.titre) }}</div>
                    <div class="col-12 col-lg-6">{{ form_row(form.typeEvenement) }}</div>
                    <div class="col-12">{{ form_row(form.description) }}</div>
                    <div class="col-12 col-lg-6">{{ form_row(form.dateEvenement) }}</div>
                    <div class="col-12 col-lg-6">{{ form_row(form.lieu) }}</div>
                    {% if form.idOrganisateur is defined %}
                        <div class="col-12 col-lg-6">{{ form_row(form.idOrganisateur) }}</div>
                    {% endif %}
                </div>
                <div class="d-flex flex-wrap gap-2 justify-content-end mt-4 pt-2 border-top">
                    <button type="submit" class="btn btn-success px-4">
                        <i class="bi bi-check-circle me-2"></i>Enregistrer
                    </button>
                    <a href="{{ evenement is defined and evenement.id ? path('evenement_show', {'id': evenement.id}) : path('evenement_list') }}" class="btn btn-outline-secondary px-4">Annuler</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}