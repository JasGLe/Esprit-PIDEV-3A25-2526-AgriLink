{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Événements - AgriLink{% endblock %}
{% block page_title %}Événements{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/bootstrap-custom2.css') }}">
{% endblock %}

{% block dashboard_content %}
    <section class="activity-theme activity-theme--evenement">
    <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3 mb-4">
        <div>
            <h2 class="fs-3 fw-bold text-dark mb-1">Événements</h2>
            <p class="text-muted mb-0">Gérez vos événements et leurs invitations.</p>
        </div>
        <a href="{{ path('evenement_new') }}" class="btn btn-success px-4">
            <span class="me-2">➕</span>
            Nouvel événement
        </a>
    </div>

    <form id="evenement-filters" method="get" class="card border-0 shadow-sm mb-4" autocomplete="off">
        <div class="card-body p-3 p-lg-4">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-7">
                    <label for="q" class="form-label fw-semibold mb-1">Rechercher par nom</label>
                    <input id="q" name="q" type="text" class="form-control" placeholder="Ex: Salon agricole 2026" value="{{ filters.q|default('') }}">
                </div>
                <div class="col-12 col-lg-3">
                    <label for="type" class="form-label fw-semibold mb-1">Filtrer par type</label>
                    <select id="type" name="type" class="form-select">
                        <option value="">Tous les types</option>
                        {% for option in typeOptions %}
                            <option value="{{ option }}" {{ filters.type|default('') == option ? 'selected' : '' }}>{{ option }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
        </div>
    </form>

    <div id="evenement-content">
        {% include 'activity/evenement/_content.html.twig' with {
            evenements: evenements,
            stats: stats
        } only %}
    </div>

    <script>
        (() => {
            const form = document.getElementById('evenement-filters');
            const content = document.getElementById('evenement-content');
            if (!form || !content) {
                return;
            }

            let debounceTimer = null;
            let requestCounter = 0;

            const fetchResults = () => {
                requestCounter += 1;
                const currentRequest = requestCounter;
                const params = new URLSearchParams(new FormData(form));
                const url = `${window.location.pathname}?${params.toString()}`;

                fetch(url, {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then((response) => response.text())
                    .then((html) => {
                        if (currentRequest !== requestCounter) {
                            return;
                        }
                        content.innerHTML = html;
                    });
            };

            form.addEventListener('input', (event) => {
                if (event.target && event.target.name === 'q') {
                    window.clearTimeout(debounceTimer);
                    debounceTimer = window.setTimeout(fetchResults, 220);
                }
            });

            form.addEventListener('change', fetchResults);
            form.addEventListener('submit', (event) => event.preventDefault());
        })();
    </script>
    </section>
{% endblock %}