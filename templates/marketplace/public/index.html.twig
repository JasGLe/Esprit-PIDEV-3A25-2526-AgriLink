{% extends 'base.html.twig' %}

{% block title %}Marketplace — AgriLink{% endblock %}
{% block body_class %}marketplace-tropical{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/marketplace-front.css') }}">
    <style>
        body.marketplace-tropical {
            --tropical-bg-image: url("{{ asset('images/marketplace/marketplace-background.jpg') }}");
        }
    </style>
{% endblock %}

{% block body %}

{# ── Navigation (transparent + lime CTA, reference layout) ── #}
<header class="tropical-header">
    <nav class="navbar navbar-expand-lg navbar-dark tropical-nav py-2">
        <div class="container-fluid px-2 px-md-3 tropical-page-gutter">
            <a class="navbar-brand tropical-brand" href="{{ path('marketplace_index') }}">
                <img src="{{ asset('logo_without_text.png') }}" alt="" width="34" height="34" class="rounded-circle me-2">
                AgriLink
            </a>
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#tropicalNav" aria-controls="tropicalNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="tropicalNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 align-items-lg-center gap-lg-1">
                    <li class="nav-item"><a class="nav-link tropical-nav-link" href="#hero">Accueil</a></li>
                    <li class="nav-item"><a class="nav-link tropical-nav-link" href="#about">À propos</a></li>
                    <li class="nav-item"><a class="nav-link tropical-nav-link" href="#produits">Produits</a></li>
                    <li class="nav-item"><a class="nav-link tropical-nav-link" href="#stats">Chiffres</a></li>
                </ul>
                <div class="d-flex flex-wrap align-items-center gap-2 gap-lg-3 ms-lg-3 tropical-nav-end">
                    {# Ordre : recherche (gauche du groupe) → panier (libellé + badge) → compte → tableau de bord #}
                    <form method="get" action="{{ path('marketplace_index') }}" class="tropical-nav-search-form" id="tropicalNavSearchForm" role="search">
                        <input type="hidden" name="cat" value="{{ filter_cat }}">
                        <input type="hidden" name="region" value="{{ filter_region }}">
                        <input type="hidden" name="sort" value="{{ filter_sort }}">
                        <label class="visually-hidden" for="tropicalNavSearchInput">Rechercher par nom ou numéro de produit</label>
                        <input type="search" name="q" id="tropicalNavSearchInput" class="form-control tropical-nav-search-input" value="{{ filter_q }}" placeholder="Nom du produit ou n° (ID)…" title="Recherche par nom de produit ou par identifiant numérique du produit" autocomplete="off" maxlength="120">
                        <button type="submit" class="tropical-nav-search-btn" id="tropicalNavSearch" title="Rechercher" aria-label="Rechercher">
                            <i class="bi bi-search" aria-hidden="true"></i>
                        </button>
                    </form>
                    {% if is_granted('ROLE_USER') %}
                        <div class="dropdown tropical-cart-dropdown-wrap">
                            <button type="button" class="tropical-nav-cart tropical-nav-cart--trigger tropical-cart-dropdown-toggle text-decoration-none border-0 bg-transparent p-0" id="marketplaceCartDropdown" data-bs-toggle="dropdown" data-bs-display="static" data-bs-auto-close="outside" aria-expanded="false" title="Aperçu du panier" aria-haspopup="true" data-cart-apercu-url="{{ path('marketplace_panier_apercu') }}">
                                <span class="tropical-nav-cart__icon-wrap">
                                    <i class="bi bi-bag tropical-nav-cart__icon" aria-hidden="true"></i>
                                    <span class="tropical-nav-cart__badge js-marketplace-cart-badge{{ panier_count > 0 ? '' : ' d-none' }}" aria-hidden="{{ panier_count > 0 ? 'false' : 'true' }}">{{ panier_count > 0 ? panier_count : 0 }}</span>
                                </span>
                                <span class="tropical-nav-cart__label d-sm-none">Panier</span>
                                <span class="tropical-nav-cart__label d-none d-sm-inline">Panier</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end tropical-cart-dropdown p-0" id="marketplaceCartPanel" aria-labelledby="marketplaceCartDropdown" data-panier-quantite-url="{{ path('marketplace_panier_ligne_quantite') }}" data-panier-quantite-token="{{ csrf_token('panier_quantite') }}" data-panier-supprimer-url="{{ path('marketplace_panier_ligne_supprimer') }}" data-panier-supprimer-token="{{ csrf_token('panier_supprimer') }}">
                                <div class="tropical-cart-modal__sheet tropical-cart-dropdown__sheet">
                                    <div class="tropical-cart-modal__header align-items-start">
                                        <h2 class="tropical-cart-modal__title mb-0" id="marketplaceCartPanelTitle">
                                            <span class="tropical-cart-modal__title-row">
                                                <i class="bi bi-bag tropical-cart-modal__title-icon" aria-hidden="true"></i>
                                                <span>Mon panier</span>
                                                <span class="tropical-cart-modal__count js-marketplace-cart-modal-count">({{ panier_count }})</span>
                                            </span>
                                        </h2>
                                        <button type="button" class="btn tropical-cart-modal__btn-close js-marketplace-cart-close-dropdown" aria-label="Fermer">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                    <div class="tropical-cart-modal__body">
                                        <div class="tropical-cart-modal__loading js-marketplace-cart-preview-loading text-center py-4 d-none" aria-live="polite">
                                            <div class="spinner-border tropical-cart-modal__spinner" role="status" style="width: 2rem; height: 2rem;"><span class="visually-hidden">Chargement…</span></div>
                                            <p class="small tropical-cart-modal__muted mt-2 mb-0">Chargement…</p>
                                        </div>
                                        <div class="js-marketplace-cart-preview-main">
                                            <div class="js-marketplace-cart-preview-empty tropical-cart-modal__empty text-center py-3 px-2 d-none">
                                                <div class="tropical-cart-modal__empty-icon mx-auto mb-2" aria-hidden="true">
                                                    <i class="bi bi-bag"></i>
                                                </div>
                                                <p class="tropical-cart-modal__empty-title mb-2">Votre panier est vide</p>
                                                <p class="tropical-cart-modal__empty-lead small mb-3">Explorez nos produits frais et ajoutez vos coups de cœur ici.</p>
                                                <button type="button" class="btn tropical-cart-modal__cta-explore js-marketplace-cart-explore-products">
                                                    <i class="bi bi-flower2 me-2" aria-hidden="true"></i>Explorer les produits
                                                </button>
                                            </div>
                                            <div class="js-marketplace-cart-preview-list d-none">
                                                <ul class="list-unstyled mb-0 tropical-cart-modal__lines js-marketplace-cart-lines"></ul>
                                                <div class="tropical-cart-modal__subtotal d-flex justify-content-between align-items-center mt-2 pt-3 border-top border-secondary border-opacity-25">
                                                    <span class="small text-white-50">Sous-total</span>
                                                    <strong class="tropical-cart-modal__subtotal-val js-marketplace-cart-subtotal">0,000 DT</strong>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tropical-cart-modal__footer flex-column gap-2 border-0 pt-0 pb-3 px-3">
                                        <a href="{{ path('marketplace_panier_index') }}" class="btn tropical-cart-modal__cta-full w-100">Voir le panier complet</a>
                                        <button type="button" class="btn tropical-cart-modal__btn-secondary w-100 js-marketplace-cart-close-dropdown">Continuer les achats</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="tropical-nav-cart text-decoration-none" title="Connexion requise pour le panier">
                            <span class="tropical-nav-cart__icon-wrap">
                                <i class="bi bi-bag tropical-nav-cart__icon" aria-hidden="true"></i>
                            </span>
                            <span class="tropical-nav-cart__label d-sm-none">Panier</span>
                            <span class="tropical-nav-cart__label d-none d-sm-inline">Panier</span>
                        </a>
                    {% endif %}
                    <a class="tropical-nav-user" href="{{ is_granted('ROLE_USER') ? path('app_dashboard') : path('app_login') }}" title="{{ is_granted('ROLE_USER') ? 'Tableau de bord' : 'Connexion' }}">
                        <i class="bi bi-person"></i>
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>

{% for message in app.flashes('success') %}
    <div class="container-fluid px-2 px-md-3 tropical-page-gutter pt-2">
        <div class="alert alert-success alert-dismissible fade show mb-0 tropical-flash" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    </div>
{% endfor %}
{# Confirmation de commande : modale (numéro = valeur enregistrée en base, identique à « Mes commandes ») #}
{% for message in app.flashes('error') %}
    <div class="container-fluid px-2 px-md-3 tropical-page-gutter pt-2">
        <div class="alert alert-danger alert-dismissible fade show mb-0 tropical-flash" role="alert">
            {{ message }}
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    </div>
{% endfor %}

{# ── Hero (centered headline, reference copy style) ── #}
<section id="hero" class="tropical-hero text-center">
    <div class="container px-2 px-md-3 py-0">
        <p class="tropical-hero__kicker mb-2 mb-lg-2">AgriLink · Le marché agricole</p>
        <h1 class="tropical-hero__title mx-auto mb-2 mb-lg-3">
            Créez un intérieur tropical chez vous avec des produits frais et locaux.
        </h1>
        <p class="tropical-hero__lead mx-auto mb-0 tropical-hero__lead--spaced">
            Parcourez les annonces publiées par les agriculteurs tunisiens : fruits, légumes, graines et équipements — livrés directement depuis la ferme.
        </p>
    </div>
</section>

{# ── Filters toolbar (server-side query preserved) ── #}
{% set qp = query_params %}
<section class="tropical-toolbar py-1 tropical-toolbar--compact">
    <div class="container-fluid px-2 px-md-3 tropical-page-gutter">
        <div class="d-flex flex-column flex-xl-row align-items-stretch align-items-xl-center justify-content-between gap-1 gap-xl-2 mb-1">
            <div class="d-flex flex-wrap gap-1 justify-content-start">
                <a href="{{ path('marketplace_index', qp|merge({cat: 'all'})) }}" class="tropical-pill {{ filter_cat == 'all' ? 'is-active' : '' }}"><i class="bi bi-grid-2x2"></i> Tout</a>
                <a href="{{ path('marketplace_index', qp|merge({cat: 'legume'})) }}" class="tropical-pill {{ filter_cat == 'legume' ? 'is-active' : '' }}"><i class="bi bi-flower2"></i> Légumes</a>
                <a href="{{ path('marketplace_index', qp|merge({cat: 'fruit'})) }}" class="tropical-pill {{ filter_cat == 'fruit' ? 'is-active' : '' }}"><i class="bi bi-apple"></i> Fruits</a>
                <a href="{{ path('marketplace_index', qp|merge({cat: 'graines'})) }}" class="tropical-pill {{ filter_cat == 'graines' ? 'is-active' : '' }}"><i class="bi bi-globe2"></i> Graines</a>
                <a href="{{ path('marketplace_index', qp|merge({cat: 'equipement'})) }}" class="tropical-pill {{ filter_cat == 'equipement' ? 'is-active' : '' }}"><i class="bi bi-truck-front"></i> Équipements</a>
            </div>
            <div class="tropical-toolbar-controls">
                <form method="get" action="{{ path('marketplace_index') }}" class="tropical-filter-form tropical-filter-form--inline" id="marketplace-filter-form">
                    <input type="hidden" name="cat" value="{{ filter_cat }}">
                    {% if filter_q != '' %}
                        <input type="hidden" name="q" value="{{ filter_q }}">
                    {% endif %}
                    <div class="tropical-filter-field">
                        <label class="tropical-filter-label tropical-filter-label--inline" for="marketplace-region-select">Région</label>
                        <select name="region"
                                id="marketplace-region-select"
                                class="form-select form-select-sm tropical-select tropical-filter-select tropical-filter-select--fit"
                                title="Filtre par gouvernorat — modifiable à tout moment"
                                onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()">
                            <option value="" {{ filter_region == '' ? 'selected' : '' }}>Toutes les régions</option>
                            {% for r in tunisia_regions %}
                                <option value="{{ r }}" {{ filter_region == r ? 'selected' : '' }}>{{ r }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="tropical-filter-field">
                        <label class="tropical-filter-label tropical-filter-label--inline" for="marketplace-sort-select">Tri</label>
                        <select name="sort"
                                id="marketplace-sort-select"
                                class="form-select form-select-sm tropical-select tropical-filter-select tropical-filter-select--fit"
                                onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()">
                            <option value="price_asc" {{ filter_sort == 'price_asc' ? 'selected' : '' }}>Prix croissant</option>
                            <option value="price_desc" {{ filter_sort == 'price_desc' ? 'selected' : '' }}>Prix décroissant</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-sm tropical-filter-submit d-none" tabindex="-1" aria-hidden="true">Appliquer</button>
                </form>
                <div class="tropical-toolbar-reset-wrap">
                    <a href="{{ path('marketplace_index') }}" class="tropical-link-reset tropical-link-reset--orange"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> Réinitialiser</a>
                </div>
            </div>
        </div>
        <p class="small tropical-muted mb-0 tropical-toolbar-meta text-start">
            <i class="bi bi-box-seam me-1 tropical-lime"></i>
            <strong class="text-white" id="marketplaceLiveCount">{{ produits|length }}</strong> produit{{ produits|length > 1 ? 's' : '' }} disponible{{ produits|length > 1 ? 's' : '' }}
        </p>
    </div>
</section>

{# ── Products (horizontal scroll mobile / grid desktop) — data: même requête contrôleur ── #}
<section id="produits" class="tropical-products-section py-3 py-md-4">
    <div class="container-fluid px-2 px-md-3 tropical-page-gutter">
        <h2 class="tropical-section-title text-start mb-1">Meilleure sélection</h2>
        <p class="tropical-muted mb-3 small">Produits actifs issus de <strong class="text-white">Ma boutique</strong> des agriculteurs</p>

        {% if produits is empty %}
            <div class="tropical-empty text-center py-5 rounded-4">
                <i class="bi bi-inboxes display-4 tropical-lime mb-3 d-block"></i>
                <p class="tropical-muted mb-3">Aucun produit ne correspond à vos filtres.</p>
                <a href="{{ path('marketplace_index') }}" class="btn tropical-btn-register">Réinitialiser</a>
            </div>
        {% else %}
            <div class="tropical-products-wrap" id="marketplaceProductsWrap">
                {% for p in produits %}
                    <div class="tropical-card-shell"
                         data-product-id="{{ p.id }}"
                         data-product-name="{{ (p.nom|default(''))|lower|e('html_attr') }}"
                         data-product-search="{{ ((p.nom|default('')) ~ ' #' ~ p.id ~ ' ' ~ p.id)|lower|e('html_attr') }}">
                        {% include 'marketplace/public/_product_card_tropical.html.twig' with { p: p, vendeurs: vendeurs } %}
                    </div>
                {% endfor %}
            </div>
            <div class="tropical-empty text-center py-5 rounded-4 d-none" id="marketplaceLiveEmpty">
                <i class="bi bi-search display-4 tropical-lime mb-3 d-block"></i>
                <p class="tropical-muted mb-3">Aucun produit ne correspond à votre recherche.</p>
                <a href="{{ path('marketplace_index') }}" class="btn tropical-btn-register">Réinitialiser</a>
            </div>
        {% endif %}
    </div>
</section>

{# ── About ── #}
<section id="about" class="tropical-about py-5">
    <div class="container px-2 px-md-3">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <p class="tropical-about__kicker mb-2">À propos d’AgriLink</p>
                <h2 class="tropical-about__title mb-4">Une plateforme pensée pour les agriculteurs et leurs clients.</h2>
                <p class="tropical-muted mb-4">
                    Chaque fiche produit est publiée par un agriculteur depuis son espace <strong class="text-white">Ma boutique</strong>.
                    Seules les annonces <strong class="text-white">actives</strong> apparaissent ici sur le marketplace public.
                </p>
                <a href="#produits" class="btn tropical-btn-register tropical-btn-register--wide">Voir les produits</a>
            </div>
            <div class="col-lg-6 text-center">
                <div class="tropical-about__visual mx-auto">
                    <div class="tropical-about__glow"></div>
                    <div class="tropical-about__frame tropical-about__frame--photo">
                        <img src="{{ asset('images/marketplace/about-section.jpg') }}" alt="AgriLink — agriculture et produits locaux" class="tropical-about__frame-img" width="640" height="640" loading="lazy" decoding="async">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{# ── Stats ── #}
<section id="stats" class="tropical-stats py-5">
    <div class="container px-2 px-md-3">
        <div class="row g-4 text-center tropical-stats__row">
            <div class="col-6 col-md-3">
                <div class="tropical-stat__num">{{ produits|length > 0 ? produits|length ~ '+' : '0' }}</div>
                <div class="tropical-stat__label">Produits listés</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="tropical-stat__num">4+</div>
                <div class="tropical-stat__label">Catégories</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="tropical-stat__num">{{ vendeurs|length > 0 ? vendeurs|length ~ '+' : '1+' }}</div>
                <div class="tropical-stat__label">Agriculteurs partenaires</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="tropical-stat__num">4.9</div>
                <div class="tropical-stat__label">Satisfaction (démo)</div>
            </div>
        </div>
    </div>
</section>

{# ── Category cards (filter links) ── #}
<section class="tropical-categories py-5 mb-4">
    <div class="container px-2 px-md-3">
        <h2 class="tropical-section-title text-center mb-4">Collections</h2>
        <div class="row g-3 g-lg-4">
            <div class="col-12 col-lg-7">
                <a href="{{ path('marketplace_index', qp|merge({cat: 'legume'})) }}" class="tropical-cat-card tropical-cat-card--wide d-block text-decoration-none rounded-4 p-4 p-lg-5 position-relative overflow-hidden">
                    <span class="tropical-cat-card__label">AgriLink</span>
                    <h3 class="tropical-cat-card__title text-white mb-2">Légumes &amp; fraîcheur</h3>
                    <span class="tropical-cat-card__more">Voir plus</span>
                </a>
            </div>
            <div class="col-12 col-lg-5">
                <div class="row g-3 g-lg-4 h-100">
                    <div class="col-12 col-sm-6">
                        <a href="{{ path('marketplace_index', qp|merge({cat: 'fruit'})) }}" class="tropical-cat-card tropical-cat-card--tall d-block text-decoration-none rounded-4 p-4 h-100 position-relative overflow-hidden">
                            <span class="tropical-cat-card__label">AgriLink</span>
                            <h3 class="tropical-cat-card__title text-white mb-0">Fruits</h3>
                            <span class="tropical-cat-card__more">Voir plus</span>
                        </a>
                    </div>
                    <div class="col-12 col-sm-6">
                        <a href="{{ path('marketplace_index', qp|merge({cat: 'equipement'})) }}" class="tropical-cat-card tropical-cat-card--tall tropical-cat-card--sand d-block text-decoration-none rounded-4 p-4 h-100 position-relative overflow-hidden">
                            <span class="tropical-cat-card__label">AgriLink</span>
                            <h3 class="tropical-cat-card__title text-white mb-0">Équipements</h3>
                            <span class="tropical-cat-card__more">Voir plus</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{# ── Footer ── #}
<footer class="tropical-footer py-4 mt-auto">
    <div class="container-fluid px-2 px-md-3 tropical-page-gutter">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
            <div class="d-flex align-items-center gap-2">
                <img src="{{ asset('logo_without_text.png') }}" alt="" width="24" height="24" class="rounded-circle opacity-50">
                <span class="small tropical-muted mb-0">© {{ 'now'|date('Y') }} AgriLink — Marketplace</span>
            </div>
            <a href="{{ is_granted('ROLE_USER') ? path('app_dashboard') : path('app_login') }}" class="small tropical-footer__link">
                <i class="bi bi-person-circle me-1"></i>Espace membre
            </a>
        </div>
    </div>
</footer>

{% if order_confirm %}
<div class="modal fade" id="marketplaceOrderConfirmModal" tabindex="-1" aria-labelledby="marketplaceOrderConfirmTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg overflow-hidden" style="border-radius:1rem;">
            <div class="modal-header border-0 text-white py-3" style="background:linear-gradient(135deg,#14532d,#22c55e);">
                <h2 class="modal-title fs-6 fw-bold mb-0 d-flex align-items-center gap-2" id="marketplaceOrderConfirmTitle">
                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                    Commande enregistrée
                </h2>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body px-4 py-4">
                <p class="text-secondary small mb-3">Merci ! Votre commande a bien été prise en compte.</p>
                <p class="mb-1 small text-uppercase fw-semibold text-muted" style="letter-spacing:0.04em;">Numéro de commande</p>
                <p class="mb-4">
                    <span class="mc-num--marketplace fs-5 d-inline-block">{% if app.user.isAgriPlus %}#CMD{{ "%03d"|format(order_confirm.commande_id) }}{% else %}#{{ order_confirm.numCommande }}{% endif %}</span>
                </p>
                <p class="small text-muted mb-2">
                    {% if order_confirm.paiement_en_ligne|default(false) %}
                        Prochaine étape : finaliser le paiement par carte (à venir).
                    {% else %}
                        Mode de paiement : <strong>à la livraison</strong>.
                    {% endif %}
                </p>
                <p class="small text-muted mb-0 fst-italic" id="marketplaceOrderConfirmAutoHint">Fermeture automatique dans quelques secondes…</p>
            </div>
            <div class="modal-footer border-0 px-4 pb-4 pt-0 gap-2">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
                <a href="{{ path('mes_commandes_index') }}" class="btn btn-success">Voir mes commandes</a>
            </div>
        </div>
    </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', function () {
    var el = document.getElementById('marketplaceOrderConfirmModal');
    if (!el || typeof bootstrap === 'undefined') return;
    var modal = bootstrap.Modal.getOrCreateInstance(el, { backdrop: true, keyboard: true });
    var autoMs = 5000;
    var hideTimer = null;
    function clearAutoHide() {
        if (hideTimer !== null) {
            clearTimeout(hideTimer);
            hideTimer = null;
        }
    }
    el.addEventListener('hide.bs.modal', clearAutoHide);
    modal.show();
    hideTimer = setTimeout(function () {
        hideTimer = null;
        modal.hide();
    }, autoMs);
});
</script>
{% endif %}

<script>
(function () {
    var produits = document.getElementById('produits');
    var nav = document.getElementById('tropicalNav');
    var form = document.getElementById('tropicalNavSearchForm');
    var input = document.getElementById('tropicalNavSearchInput');
    var cards = Array.prototype.slice.call(document.querySelectorAll('#marketplaceProductsWrap .tropical-card-shell'));
    var emptyState = document.getElementById('marketplaceLiveEmpty');
    var liveCount = document.getElementById('marketplaceLiveCount');
    var initialCount = cards.length;

    function normalizeText(v) {
        return String(v || '').toLowerCase().trim().replace(/\s+/g, ' ');
    }

    function applyLiveFilter(rawQuery) {
        if (!cards.length) {
            return;
        }

        var q = normalizeText(rawQuery);
        var visible = 0;

        cards.forEach(function (card) {
            var haystack = normalizeText(card.getAttribute('data-product-search'));
            var show = q === '' || haystack.indexOf(q) !== -1;
            card.classList.toggle('d-none', !show);
            if (show) visible += 1;
        });

        if (liveCount) {
            liveCount.textContent = String(visible);
        }

        if (emptyState) {
            emptyState.classList.toggle('d-none', visible > 0);
        }
    }

    function collapseNavIfOpen() {
        if (nav && nav.classList.contains('show') && typeof bootstrap !== 'undefined' && bootstrap.Collapse) {
            bootstrap.Collapse.getOrCreateInstance(nav, { toggle: false }).hide();
        }
    }
    if (form) {
        form.addEventListener('submit', function () {
            collapseNavIfOpen();
        });
    }
    if (input) {
        input.addEventListener('input', function () {
            // Live filtering as the user types (including first letter and deletions).
            applyLiveFilter(input.value);
        });
        input.addEventListener('search', function () {
            applyLiveFilter(input.value);
        });
    }
    try {
        var initialQ = new URLSearchParams(window.location.search).get('q') || '';
        if (cards.length) {
            applyLiveFilter(initialQ);
            if (input && initialQ !== '' && input.value !== initialQ) {
                input.value = initialQ;
            }
            if (input && initialQ === '') {
                if (liveCount) liveCount.textContent = String(initialCount);
            }
        }
        if (produits && initialQ) {
            requestAnimationFrame(function () {
                produits.scrollIntoView({ behavior: 'smooth', block: 'start' });
            });
        }
    } catch (e) { /* ignore */ }
})();
(function () {
    var panelEl = document.getElementById('marketplaceCartPanel');
    var wrap = document.querySelector('.tropical-cart-dropdown-wrap');
    var trigger = document.querySelector('[data-cart-apercu-url]');
    var money = new Intl.NumberFormat('fr-TN', { minimumFractionDigits: 3, maximumFractionDigits: 3 });

    function fmtDt(n) {
        if (n == null || isNaN(Number(n))) return money.format(0) + ' DT';
        return money.format(Number(n)) + ' DT';
    }

    function escapeHtml(s) {
        var d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
    }

    function closeCartDropdown() {
        if (!wrap || typeof bootstrap === 'undefined') return;
        var t = wrap.querySelector('[data-bs-toggle="dropdown"]');
        if (!t) return;
        var inst = bootstrap.Dropdown.getInstance(t);
        if (inst) inst.hide();
    }

    function setCartBadge(count) {
        var badge = document.querySelector('.js-marketplace-cart-badge');
        if (!badge) return;
        var n = parseInt(count, 10);
        if (isNaN(n) || n < 1) {
            badge.textContent = '0';
            badge.classList.add('d-none');
            badge.setAttribute('aria-hidden', 'true');
            return;
        }
        badge.textContent = String(n);
        badge.classList.remove('d-none');
        badge.setAttribute('aria-hidden', 'false');
    }

    function applyCartPreview(data) {
        if (!data || typeof data.count === 'undefined') return;
        setCartBadge(data.count);
        if (!panelEl) return;
        var titleCount = panelEl.querySelector('.js-marketplace-cart-modal-count');
        if (titleCount) titleCount.textContent = '(' + data.count + ')';
        var emptyEl = panelEl.querySelector('.js-marketplace-cart-preview-empty');
        var listWrap = panelEl.querySelector('.js-marketplace-cart-preview-list');
        var linesUl = panelEl.querySelector('.js-marketplace-cart-lines');
        var subtotalEl = panelEl.querySelector('.js-marketplace-cart-subtotal');
        if (!emptyEl || !listWrap || !linesUl) return;
        var lines = data.lines || [];
        if (lines.length === 0) {
            emptyEl.classList.remove('d-none');
            listWrap.classList.add('d-none');
            linesUl.innerHTML = '';
            if (subtotalEl) subtotalEl.textContent = fmtDt(0);
            return;
        }
        emptyEl.classList.add('d-none');
        listWrap.classList.remove('d-none');
        linesUl.innerHTML = lines.map(function (row) {
            var nom = row.nom || 'Produit';
            var pt = row.prixTotal != null ? row.prixTotal : 0;
            var pid = row.produitId != null ? String(row.produitId) : '';
            var stepper = pid !== ''
                ? '<div class="tropical-cart-qty-stepper">' +
                '<button type="button" class="tropical-cart-qty-stepper__btn js-marketplace-cart-qty-btn" data-delta="-1" data-produit-id="' + pid + '" aria-label="Diminuer la quantité">−</button>' +
                '<span class="tropical-cart-qty-stepper__val">' + row.quantite + '</span>' +
                '<button type="button" class="tropical-cart-qty-stepper__btn js-marketplace-cart-qty-btn" data-delta="1" data-produit-id="' + pid + '" aria-label="Augmenter la quantité">+</button>' +
                '</div>'
                : '<span class="tropical-cart-qty-stepper__val tropical-cart-qty-stepper__val--solo">' + row.quantite + '</span>';
            var removeBtn = pid !== ''
                ? '<button type="button" class="tropical-cart-line-remove js-marketplace-cart-remove-btn" data-produit-id="' + pid + '" title="Retirer du panier" aria-label="Retirer du panier"><i class="bi bi-trash3" aria-hidden="true"></i></button>'
                : '';
            return '<li class="tropical-cart-modal__line">' +
                '<div class="tropical-cart-modal__line-top">' +
                '<span class="tropical-cart-modal__line-name">' + escapeHtml(nom) + '</span>' +
                '<div class="tropical-cart-modal__line-top-end">' +
                '<span class="tropical-cart-modal__line-price">' + fmtDt(pt) + '</span>' +
                removeBtn +
                '</div></div>' +
                '<div class="tropical-cart-modal__line-qty-row">' +
                '<span class="tropical-cart-modal__line-qty-label">Quantité</span>' +
                stepper +
                '</div></li>';
        }).join('');
        if (subtotalEl) subtotalEl.textContent = fmtDt(data.totalPrix != null ? data.totalPrix : 0);
    }

    var exploreBtn = document.querySelector('.js-marketplace-cart-explore-products');
    if (exploreBtn) {
        exploreBtn.addEventListener('click', function (e) {
            e.preventDefault();
            closeCartDropdown();
            setTimeout(function () {
                var sec = document.getElementById('produits');
                if (sec) sec.scrollIntoView({ behavior: 'smooth', block: 'start' });
                var nav = document.getElementById('tropicalNav');
                if (nav && nav.classList.contains('show') && typeof bootstrap !== 'undefined' && bootstrap.Collapse) {
                    bootstrap.Collapse.getOrCreateInstance(nav, { toggle: false }).hide();
                }
            }, 200);
        });
    }

    document.querySelectorAll('.js-marketplace-cart-close-dropdown').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            closeCartDropdown();
        });
    });

    function postPanierQuantite(produitId, delta) {
        if (!panelEl || !produitId) return;
        var qUrl = panelEl.getAttribute('data-panier-quantite-url');
        var qToken = panelEl.getAttribute('data-panier-quantite-token');
        if (!qUrl || !qToken) return;
        var body = new URLSearchParams();
        body.set('produitId', String(produitId));
        body.set('delta', String(delta));
        body.set('_token', qToken);
        fetch(qUrl, {
            method: 'POST',
            body: body,
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            credentials: 'same-origin'
        })
            .then(function (r) {
                return r.text().then(function (text) {
                    var data = {};
                    try { data = text ? JSON.parse(text) : {}; } catch (e) { data = {}; }
                    return { ok: r.ok, data: data };
                });
            })
            .then(function (res) {
                if (res.data && typeof res.data.count !== 'undefined') {
                    applyCartPreview(res.data);
                }
                if (!res.ok && res.data && res.data.message) {
                    window.alert(res.data.message);
                }
            })
            .catch(function () {
                window.alert('Impossible de mettre à jour la quantité.');
            });
    }

    function postPanierSupprimer(produitId) {
        if (!panelEl || !produitId) return;
        var sUrl = panelEl.getAttribute('data-panier-supprimer-url');
        var sToken = panelEl.getAttribute('data-panier-supprimer-token');
        if (!sUrl || !sToken) return;
        var body = new URLSearchParams();
        body.set('produitId', String(produitId));
        body.set('_token', sToken);
        fetch(sUrl, {
            method: 'POST',
            body: body,
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json',
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            credentials: 'same-origin'
        })
            .then(function (r) {
                return r.text().then(function (text) {
                    var data = {};
                    try { data = text ? JSON.parse(text) : {}; } catch (e) { data = {}; }
                    return { ok: r.ok, data: data };
                });
            })
            .then(function (res) {
                if (res.data && typeof res.data.count !== 'undefined') {
                    applyCartPreview(res.data);
                }
                if (!res.ok && res.data && res.data.message) {
                    window.alert(res.data.message);
                }
            })
            .catch(function () {
                window.alert('Impossible de retirer le produit.');
            });
    }

    if (panelEl) {
        panelEl.addEventListener('click', function (e) {
            var qtyBtn = e.target.closest('.js-marketplace-cart-qty-btn');
            if (qtyBtn) {
                e.preventDefault();
                var pid = qtyBtn.getAttribute('data-produit-id');
                var delta = parseInt(qtyBtn.getAttribute('data-delta'), 10);
                if (!pid || (delta !== 1 && delta !== -1)) return;
                postPanierQuantite(pid, delta);
                return;
            }
            var rm = e.target.closest('.js-marketplace-cart-remove-btn');
            if (rm) {
                e.preventDefault();
                var rid = rm.getAttribute('data-produit-id');
                if (!rid) return;
                postPanierSupprimer(rid);
            }
        });
    }

    if (wrap && trigger && panelEl) {
        var url = trigger.getAttribute('data-cart-apercu-url');
        var loading = panelEl.querySelector('.js-marketplace-cart-preview-loading');
        var main = panelEl.querySelector('.js-marketplace-cart-preview-main');
        wrap.addEventListener('show.bs.dropdown', function () {
            if (!loading || !main) return;
            loading.classList.remove('d-none');
            main.classList.add('d-none');
            fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
                .then(function (r) {
                    return r.text().then(function (text) {
                        try { return text ? JSON.parse(text) : {}; } catch (e) { return {}; }
                    });
                })
                .then(function (data) {
                    loading.classList.add('d-none');
                    main.classList.remove('d-none');
                    applyCartPreview(data);
                })
                .catch(function () {
                    loading.classList.add('d-none');
                    main.classList.remove('d-none');
                    applyCartPreview({ count: 0, lines: [], totalPrix: 0 });
                });
        });
    }

    document.addEventListener('submit', function (e) {
        var form = e.target;
        if (!form || !form.classList || !form.classList.contains('js-marketplace-panier-form')) return;
        e.preventDefault();
        var fd = new FormData(form);
        fetch(form.action, {
            method: 'POST',
            body: fd,
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            },
            credentials: 'same-origin'
        })
            .then(function (r) {
                return r.text().then(function (text) {
                    var data = {};
                    try { data = text ? JSON.parse(text) : {}; } catch (err) { data = {}; }
                    return { ok: r.ok, data: data };
                });
            })
            .then(function (res) {
                if (res.data && typeof res.data.count !== 'undefined') {
                    applyCartPreview(res.data);
                }
                if (!res.ok && res.data && res.data.message) {
                    window.alert(res.data.message);
                }
            })
            .catch(function () {
                window.alert('Impossible d’ajouter au panier. Réessayez.');
            });
    });
})();
</script>
{% endblock %}
