{% extends 'base.html.twig' %}

{% block title %}Marketplace — AgriLink{% endblock %}
{% block body_class %}marketplace-tropical{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/marketplace-front.css') }}">
    <style>
        body.marketplace-tropical {
            --tropical-bg-image: url("{{ asset('images/marketplace/marketplace-background.jpg') }}");
        }
        /* ── Modal dialog — no side gaps ── */
#marketplaceRentalRequestModal {
    padding: 0 !important;
}
#marketplaceRentalRequestModal .modal-dialog {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) !important;
    margin: 0;
    width: min(900px, 100vw);
    max-width: 900px;
}

/* ── Content shell ── */
.modal-rental__content {
    border: 0;
    border-radius: 1.25rem;
    overflow: hidden;
    max-height: calc(100vh - 1rem);
    background: #fff;
    box-shadow: 0 32px 80px rgba(15, 23, 42, .4);
    display: flex;
    flex-direction: column;
}

/* ── Header — bright gradient ── */
.modal-rental__header {
    border: 0;
    background: linear-gradient(120deg, #14532d 0%, #16a34a 55%, #22c55e 100%);
    color: #fff;
    padding: 1.1rem 1.5rem .9rem;
}
.modal-rental__header .modal-title { font-weight: 800; color: #fff; font-size: 1.15rem; }
.modal-rental__header .btn-close { filter: invert(1) brightness(2); }

/* ── Progress bar ── */
.modal-rental__progress {
    height: .38rem;
    border-radius: 0;
    background: #dcfce7;
    overflow: hidden;
    margin: 0;
    flex-shrink: 0;
}
.modal-rental__progress-bar {
    height: 100%;
    border-radius: 0;
    background: linear-gradient(90deg, #22c55e, #84cc16);
    transition: width .3s ease;
}

/* ── Stepper badges — white/light strip ── */
#rentalStepper {
    background: #f0fdf4;
    padding: .7rem 1.5rem;
    gap: .5rem !important;
    margin: 0 !important;
    flex-shrink: 0;
    border-bottom: 1px solid #bbf7d0;
}
#rentalStepper .badge {
    border-radius: .5rem;
    padding: .45rem .8rem;
    font-size: .78rem;
    font-weight: 600;
}
#rentalStepper .text-bg-success {
    background: linear-gradient(120deg, #22c55e, #16a34a) !important;
    color: #fff !important;
}
#rentalStepper .text-bg-secondary {
    background: #e2e8f0 !important;
    color: #64748b !important;
}

/* ── Step body — white with comfortable padding ── */
.modal-rental__body {
    padding: 0;
    overflow-y: auto;
    max-height: calc(100vh - 230px);
    background: #fff;
}

/* ── Step panels ── */
.rental-step {
    border: none;
    border-radius: 0;
    padding: 1.5rem 1.75rem;
    background: #fff;
}

/* ── Form labels ── */
.rental-step .form-label {
    font-size: .82rem;
    font-weight: 700;
    color: #15803d;
    margin-bottom: .3rem;
}

/* ── Inputs — squarer, more balanced aspect ratio ── */
.rental-step .form-control,
.rental-step .form-select {
    padding: .6rem .85rem;
    font-size: .93rem;
    border-radius: .55rem;           /* less round = more square feel */
    border: 1.5px solid #bbf7d0;
    background: #f0fdf4;
    min-height: unset;
    height: 2.65rem;                 /* fixed height keeps all fields same square proportion */
    transition: border-color .2s, box-shadow .2s, background .2s;
    color: #14532d;
}
.rental-step .form-control:focus,
.rental-step .form-select:focus {
    border-color: #22c55e;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, .18);
    background: #fff;
    outline: none;
}
.rental-step textarea.form-control {
    height: auto;
    min-height: 82px;
}
.rental-step input[type="datetime-local"] {
    background: #fff;
    border-color: #d1d5db;
    color: #111827;
}
.rental-step input[type="datetime-local"]:focus {
    border-color: #9ca3af;
    box-shadow: 0 0 0 3px rgba(156, 163, 175, .18);
    background: #fff;
}
.rental-step input[type="datetime-local"].is-valid,
.rental-step .was-validated input[type="datetime-local"]:valid {
    border-color: #d1d5db !important;
    background-color: #fff !important;
    color: #111827 !important;
    box-shadow: none !important;
    background-image: none !important;
    padding-right: .85rem !important;
}
.rental-step .mb-3 { margin-bottom: .7rem !important; }
.rental-step .row { --bs-gutter-y: .55rem; }


/* ── Checkboxes ── */
.rental-step .form-check { margin-bottom: .35rem; min-height: 1.4rem; }
.rental-step .form-check-label { font-size: .9rem; color: #166534; }
.rental-step .form-check-input:checked {
    background-color: #16a34a;
    border-color: #16a34a;
}

/* ── Step 1 grid ── */
.rental-step--user .rental-step__grid-compact {
    max-width: 100%;
    --bs-gutter-x: 1rem;
    justify-content: flex-start;
}

/* ── Footer — light, clean, no dark green ── */
.modal-rental__footer {
    position: sticky;
    bottom: 0;
    z-index: 2;
    background: #f0fdf4;
    padding: .8rem 1.5rem;
    border-top: 1px solid #bbf7d0;
    display: flex;
    justify-content: flex-end;
    gap: .6rem;
}
.modal-rental__footer .btn {
    min-width: 120px;
    font-weight: 600;
    border-radius: .55rem;
    height: 2.55rem;
}
.modal-rental__footer .btn-outline-secondary {
    color: #64748b;
    border-color: #cbd5e1;
    background: #fff;
}
.modal-rental__footer .btn-outline-secondary:hover {
    background: #f8fafc;
    color: #334155;
}
.modal-rental__footer .btn-success,
.modal-rental__footer .btn-primary {
    background: linear-gradient(120deg, #22c55e, #16a34a);
    border: none;
    color: #fff;
    min-width: 140px;
}
.modal-rental__footer .btn-success:hover,
.modal-rental__footer .btn-primary:hover {
    background: linear-gradient(120deg, #16a34a, #15803d);
}

/* ── Mobile ── */
@media (max-width: 768px) {
    #marketplaceRentalRequestModal .modal-dialog {
        width: 100vw;
        max-width: 100vw;
    }
    .modal-rental__content { max-height: 100svh; border-radius: 0; }
    .modal-rental__body { max-height: calc(100svh - 200px); }
    .rental-step { padding: 1rem 1rem; }
    .modal-rental__footer { padding: .65rem 1rem; }
    #rentalStepper { padding: .6rem 1rem; }
    #rentalStepper .badge { font-size: .69rem; padding: .35rem .5rem; }
}
/* ── Custom Date-Time Picker ── */
.custom-dt-wrap { position: relative; }

.custom-dt-trigger {
    cursor: pointer;
    color: #111827;
    background: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: .55rem;
    height: 2.65rem;
    display: flex;
    align-items: center;
    font-size: .93rem;
    transition: border-color .2s, box-shadow .2s;
}
.custom-dt-trigger:hover,
.custom-dt-trigger:focus {
    border-color: #111827;
    box-shadow: 0 0 0 2px rgba(17,24,39,.12);
    background: #fff;
    outline: none;
}
.custom-dt-trigger.is-invalid { border-color: #dc2626; }

.custom-dt-popup {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 20000;
    background: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: .85rem;
    box-shadow: 0 20px 50px rgba(15,23,42,.28);
    padding: .9rem;
    min-width: 320px;
    animation: dtFadeIn .15s ease;
}
@keyframes dtFadeIn {
    from { opacity: 0; transform: translateY(-6px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* Calendar grid */
.cdt-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: .6rem;
}
.cdt-header .cdt-month-label {
    font-weight: 700;
    color: #111827;
    font-size: .95rem;
}
.cdt-header button {
    background: none;
    border: none;
    cursor: pointer;
    color: #111827;
    font-size: 1.1rem;
    padding: .2rem .4rem;
    border-radius: .35rem;
}
.cdt-header button:hover { background: #f3f4f6; }

.cdt-weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
    font-size: .72rem;
    font-weight: 700;
    color: #9ca3af;
    margin-bottom: .3rem;
    text-transform: uppercase;
}

.cdt-days {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 2px;
}
.cdt-day {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .85rem;
    border-radius: .4rem;
    cursor: pointer;
    color: #111827;
    font-weight: 500;
    transition: background .1s;
    border: none;
    background: none;
}
.cdt-day:hover:not(.cdt-day--disabled):not(.cdt-day--selected) {
    background: #f3f4f6;
}
.cdt-day--today {
    border: 1.5px solid #111827;
    color: #111827;
    font-weight: 700;
}
.cdt-day--selected {
    background: #111827;
    color: #fff !important;
    font-weight: 700;
}
.cdt-day--disabled {
    color: #9ca3af;
    background: #f3f4f6;
    cursor: not-allowed;
    pointer-events: none;
    opacity: .95;
}
.cdt-day--empty { cursor: default; }

/* Time row */
.cdt-time {
    display: flex;
    align-items: center;
    gap: .5rem;
    margin-top: .75rem;
    padding-top: .65rem;
    border-top: 1px solid #e5e7eb;
}
.cdt-time label {
    font-size: .8rem;
    font-weight: 700;
    color: #111827;
    white-space: nowrap;
    margin: 0;
}
.cdt-time select {
    flex: 1;
    padding: .2rem .45rem;
    border-radius: .45rem;
    border: 1px solid #d1d5db;
    background: #fff;
    color: #111827;
    font-size: .82rem;
    cursor: pointer;
    height: 1.9rem;
    max-height: 1.9rem;
    line-height: 1.15;
}
.cdt-time select:focus {
    border-color: #111827;
    outline: none;
    box-shadow: 0 0 0 2px rgba(17,24,39,.12);
}
.cdt-time select option {
    font-size: .82rem;
    padding: .2rem .3rem;
}

.cdt-confirm {
    margin-top: .75rem;
    width: 100%;
    background: #111827;
    border: none;
    color: #fff;
    font-weight: 700;
    border-radius: .5rem;
    padding: .45rem;
    cursor: pointer;
    font-size: .9rem;
    transition: background .15s;
}
.cdt-confirm:hover { background: #000; }

/* Step 3 legal conditions block */
.rental-terms-box {
    background: #374151;
    color: #f9fafb;
    border: 1px solid #4b5563;
    border-radius: .75rem;
    padding: .85rem 1rem;
}
.rental-terms-box__title {
    font-size: .92rem;
    font-weight: 700;
    margin-bottom: .45rem;
    color: #ffffff;
}
.rental-terms-box__list {
    margin: 0;
    padding-left: 1rem;
    font-size: .86rem;
    line-height: 1.45;
}
.rental-terms-box__list li { margin-bottom: .28rem; }

/* --- New landing layout inspired by requested screenshot --- */
.market-hero {
    padding: 2rem 0 1.25rem;
}
.market-hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 2rem;
    align-items: center;
}
.market-hero__visual {
    min-height: 360px;
    border-radius: 1rem;
    background: #d9fff2;
    border: 1px dashed rgba(22,163,74,.28);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}
.market-hero__visual-placeholder {
    color: #15803d;
    font-weight: 700;
    font-size: 1rem;
    text-align: center;
    padding: 1rem;
}
.market-hero__title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.05;
    font-weight: 800;
    color: #0f2b1e;
    margin-bottom: .85rem;
    letter-spacing: -0.02em;
}
.market-hero__lead {
    color: #3d5a4a;
    max-width: 50ch;
    margin-bottom: 1.4rem;
}
.market-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: .8rem;
}
.market-hero__btn-primary {
    border-radius: 999px;
    background: linear-gradient(120deg, #22c55e, #16a34a);
    color: #fff;
    border: 0;
    padding: .7rem 1.4rem;
    font-weight: 700;
    text-decoration: none;
}
.market-hero__btn-secondary {
    border-radius: 999px;
    border: 1px solid rgba(22,163,74,.3);
    color: #166534;
    background: #fff;
    padding: .7rem 1.3rem;
    font-weight: 700;
    text-decoration: none;
}
@media (max-width: 991.98px) {
    .market-hero__grid {
        grid-template-columns: 1fr;
        gap: 1.1rem;
    }
    .market-hero__visual {
        min-height: 260px;
    }
}

    </style>
{% endblock %}

{% block body %}

{# ── Navigation (transparent + lime CTA, reference layout) ── #}
<header class="tropical-header">
    <nav class="navbar navbar-expand-lg navbar-dark tropical-nav py-2">
        <div class="container-fluid px-2 px-md-3 tropical-page-gutter">
            <a class="navbar-brand tropical-brand" href="{{ path('marketplace_index') }}">
                <img src="{{ asset('logo_without_text.png') }}" alt="" width="34" height="34" class="rounded-circle me-2">
                AgriLink
            </a>
            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#tropicalNav" aria-controls="tropicalNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="tropicalNav">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0 align-items-lg-center gap-lg-1">
                    <li class="nav-item"><a class="nav-link tropical-nav-link" href="#hero">Accueil</a></li>
                    <li class="nav-item"><a class="nav-link tropical-nav-link" href="{{ is_granted('ROLE_USER') ? path('app_profile') : path('app_login') }}">Profil</a></li>
                    <li class="nav-item"><a class="nav-link tropical-nav-link" href="#about">À propos</a></li>
                    <li class="nav-item"><a class="nav-link tropical-nav-link" href="{{ path('marketplace_index', { cat: 'all' }) }}#produits">Boutique</a></li>
                    <li class="nav-item"><a class="nav-link tropical-nav-link" href="#contact">Contact</a></li>
                </ul>
                <div class="d-flex flex-wrap align-items-center gap-2 gap-lg-3 tropical-nav-end">
                    {# Ordre : recherche (gauche du groupe) → panier (libellé + badge) → compte → tableau de bord #}
                    <form method="get" action="{{ path('marketplace_index') }}" class="tropical-nav-search-form{{ filter_q != '' ? ' is-open has-query' : '' }}" id="tropicalNavSearchForm" role="search">
                        <input type="hidden" name="cat" value="{{ filter_cat }}">
                        <input type="hidden" name="region" value="{{ filter_region }}">
                        <input type="hidden" name="sort" value="{{ filter_sort }}">
                        <label class="visually-hidden" for="tropicalNavSearchInput">Rechercher par nom ou numéro de produit</label>
                        <input type="search" name="q" id="tropicalNavSearchInput" class="form-control tropical-nav-search-input" value="{{ filter_q }}" placeholder="Nom du produit ou n° (ID)…" title="Recherche par nom de produit ou par identifiant numérique du produit" autocomplete="off" maxlength="120">
                        <button type="button" class="tropical-nav-search-btn" id="tropicalNavSearch" title="Rechercher" aria-label="Rechercher">
                            <i class="bi bi-search" aria-hidden="true"></i>
                        </button>
                    </form>
                    {% if is_granted('ROLE_USER') %}
                        <div class="dropdown tropical-cart-dropdown-wrap">
                            <button type="button" class="tropical-nav-cart tropical-nav-cart--trigger tropical-cart-dropdown-toggle text-decoration-none border-0 bg-transparent p-0" id="marketplaceCartDropdown" data-bs-toggle="dropdown" data-bs-display="static" data-bs-auto-close="outside" aria-expanded="false" title="Aperçu du panier" aria-haspopup="true" data-cart-apercu-url="{{ path('marketplace_panier_apercu') }}">
                                <span class="tropical-nav-cart__icon-wrap">
                                    <i class="bi bi-bag tropical-nav-cart__icon" aria-hidden="true"></i>
                                    <span class="tropical-nav-cart__badge js-marketplace-cart-badge{{ panier_count > 0 ? '' : ' d-none' }}" aria-hidden="{{ panier_count > 0 ? 'false' : 'true' }}">{{ panier_count > 0 ? panier_count : 0 }}</span>
                                </span>
                                <span class="tropical-nav-cart__label d-sm-none">Panier</span>
                                <span class="tropical-nav-cart__label d-none d-sm-inline">Panier</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end tropical-cart-dropdown p-0" id="marketplaceCartPanel" aria-labelledby="marketplaceCartDropdown" data-panier-quantite-url="{{ path('marketplace_panier_ligne_quantite') }}" data-panier-quantite-token="{{ csrf_token('panier_quantite') }}" data-panier-supprimer-url="{{ path('marketplace_panier_ligne_supprimer') }}" data-panier-supprimer-token="{{ csrf_token('panier_supprimer') }}">
                                <div class="tropical-cart-modal__sheet tropical-cart-dropdown__sheet">
                                    <div class="tropical-cart-modal__header align-items-start">
                                        <h2 class="tropical-cart-modal__title mb-0" id="marketplaceCartPanelTitle">
                                            <span class="tropical-cart-modal__title-row">
                                                <i class="bi bi-bag tropical-cart-modal__title-icon" aria-hidden="true"></i>
                                                <span>Mon panier</span>
                                                <span class="tropical-cart-modal__count js-marketplace-cart-modal-count">({{ panier_count }})</span>
                                            </span>
                                        </h2>
                                        <button type="button" class="btn tropical-cart-modal__btn-close js-marketplace-cart-close-dropdown" aria-label="Fermer">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                    <div class="tropical-cart-modal__body">
                                        <div class="tropical-cart-modal__loading js-marketplace-cart-preview-loading text-center py-4 d-none" aria-live="polite">
                                            <div class="spinner-border tropical-cart-modal__spinner" role="status" style="width: 2rem; height: 2rem;"><span class="visually-hidden">Chargement…</span></div>
                                            <p class="small tropical-cart-modal__muted mt-2 mb-0">Chargement…</p>
                                        </div>
                                        <div class="js-marketplace-cart-preview-main">
                                            <div class="js-marketplace-cart-preview-empty tropical-cart-modal__empty text-center py-3 px-2 d-none">
                                                <div class="tropical-cart-modal__empty-icon mx-auto mb-2" aria-hidden="true">
                                                    <i class="bi bi-bag"></i>
                                                </div>
                                                <p class="tropical-cart-modal__empty-title mb-2">Votre panier est vide</p>
                                                <p class="tropical-cart-modal__empty-lead small mb-3">Explorez nos produits frais et ajoutez vos coups de cœur ici.</p>
                                                <button type="button" class="btn tropical-cart-modal__cta-explore js-marketplace-cart-explore-products">
                                                    <i class="bi bi-flower2 me-2" aria-hidden="true"></i>Explorer les produits
                                                </button>
                                            </div>
                                            <div class="js-marketplace-cart-preview-list d-none">
                                                <ul class="list-unstyled mb-0 tropical-cart-modal__lines js-marketplace-cart-lines"></ul>
                                                <div class="tropical-cart-modal__subtotal d-flex justify-content-between align-items-center mt-2 pt-3 border-top border-secondary border-opacity-25">
                                                    <span class="small text-white-50">Sous-total</span>
                                                    <strong class="tropical-cart-modal__subtotal-val js-marketplace-cart-subtotal">0,000 DT</strong>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="tropical-cart-modal__footer flex-column gap-2 border-0 pt-0 pb-3 px-3">
                                        <a href="{{ path('marketplace_panier_index') }}" class="btn tropical-cart-modal__cta-full w-100">Voir le panier complet</a>
                                        <button type="button" class="btn tropical-cart-modal__btn-secondary w-100 js-marketplace-cart-close-dropdown">Continuer les achats</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="tropical-nav-cart text-decoration-none" title="Connexion requise pour le panier">
                            <span class="tropical-nav-cart__icon-wrap">
                                <i class="bi bi-bag tropical-nav-cart__icon" aria-hidden="true"></i>
                            </span>
                            <span class="tropical-nav-cart__label d-sm-none">Panier</span>
                            <span class="tropical-nav-cart__label d-none d-sm-inline">Panier</span>
                        </a>
                    {% endif %}
                    <a class="tropical-nav-user" href="{{ is_granted('ROLE_USER') ? path('app_dashboard') : path('app_login') }}" title="{{ is_granted('ROLE_USER') ? 'Tableau de bord' : 'Connexion' }}">
                        <i class="bi bi-person"></i>
                    </a>
                </div>
            </div>
        </div>
    </nav>
</header>

{% for message in app.flashes('success') %}
    <div class="container-fluid px-2 px-md-3 tropical-page-gutter pt-2">
        <div class="alert alert-success alert-dismissible fade show mb-0 tropical-flash" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    </div>
{% endfor %}
{# Confirmation de commande : modale (numéro = valeur enregistrée en base, identique à « Mes commandes ») #}
{% for message in app.flashes('error') %}
    <div class="container-fluid px-2 px-md-3 tropical-page-gutter pt-2">
        <div class="alert alert-danger alert-dismissible fade show mb-0 tropical-flash" role="alert">
            {{ message }}
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    </div>
{% endfor %}

{# ── Hero redesigned to match requested screenshot layout ── #}
<section id="hero" class="market-hero">
    <div class="container-fluid px-2 px-md-3 tropical-page-gutter">
        <div class="market-hero__grid">
            <div class="market-hero__visual">
