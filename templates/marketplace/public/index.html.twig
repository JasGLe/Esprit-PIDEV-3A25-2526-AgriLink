{% if is_granted('ROLE_USER') %}
<div class="modal fade" id="marketplaceRentalRequestModal" tabindex="-1" aria-labelledby="marketplaceRentalRequestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content modal-rental__content">
            <div class="modal-header modal-rental__header">
                <div>
                    <h5 class="modal-title" id="marketplaceRentalRequestModalLabel">Demande de location</h5>
                    <small class="opacity-75">
                        <span id="rentalRequestProductName">Equipement</span> - <span id="rentalRequestDailyPrice">0,000 DT/jour</span>
                    </small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>

            {{ form_start(rental_request_form, {
                action: path('marketplace_rental_request_submit', query_params),
                attr: {
                    id: 'marketplaceRentalRequestForm',
                    class: 'needs-validation',
                    novalidate: 'novalidate',
                    'data-server-errors': (not rental_request_form.vars.valid and rental_request_form.vars.submitted) ? '1' : '0'
                }
            }) }}
                <div class="modal-body modal-rental__body">
                    {{ form_widget(rental_request_form.produit_id, { attr: { id: 'rentalRequestProductId' } }) }}
                    <input type="hidden"
                           id="rentalRequestProductFallback"
                           name="rental_target_product_id_fallback"
                           value="{{ rental_target_product_id|default('') }}">
                    {{ form_widget(rental_request_form._token) }}
                    {% if rental_request_form.vars.submitted and not rental_request_form.vars.valid %}
                        <div class="alert alert-danger py-2 px-3 mb-3" role="alert">
                            <strong>La demande n'a pas ete enregistree.</strong>
                            <ul class="mb-0 mt-2 ps-3 small">
                                {% for error in rental_request_form.vars.errors %}
                                    <li>{{ error.message }}</li>
                                {% endfor %}
                                {% for child in rental_request_form %}
                                    {% for error in child.vars.errors %}
                                        <li>{{ (child.vars.label ?: child.vars.name) }}: {{ error.message }}</li>
                                    {% endfor %}
                                {% endfor %}
                            </ul>
                        </div>
                    {% endif %}

                    <div class="modal-rental__progress">
                        <div class="modal-rental__progress-bar" id="rentalProgressBar"></div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 mb-3" id="rentalStepper">
                        <span class="badge text-bg-success" data-step-indicator="1">1. Infos utilisateur</span>
                        <span class="badge text-bg-secondary" data-step-indicator="2">2. Détails location</span>
                        <span class="badge text-bg-secondary" data-step-indicator="3">3. Engagements</span>
                        <span class="badge text-bg-secondary" data-step-indicator="4">4. Confirmation</span>
                    </div>

                    <div class="rental-step rental-step--user" data-step="1">
                        <div class="row g-2 rental-step__grid-compact">
                            <div class="col-xl-5 col-lg-5 col-md-6">{{ form_row(rental_request_form.fullName) }}</div>
                            <div class="col-xl-5 col-lg-5 col-md-6">{{ form_row(rental_request_form.email) }}</div>
                            <div class="col-xl-5 col-lg-5 col-md-6">{{ form_row(rental_request_form.phone) }}</div>
                            <div class="col-xl-5 col-lg-5 col-md-6">{{ form_row(rental_request_form.dateNaissance) }}</div>
                            <div class="col-xl-5 col-lg-5 col-md-6">{{ form_row(rental_request_form.address) }}</div>
                            <div class="col-xl-5 col-lg-5 col-md-6">{{ form_row(rental_request_form.identityNumber) }}</div>
                        </div>
                    </div>

                    <div class="rental-step d-none" data-step="2">
                        <div class="row g-2 rental-step__grid-compact">
                            <div class="col-md-6">
                                <label class="form-label" for="startDtTrigger">Début location <span class="text-danger">*</span></label>
                                <div class="custom-dt-wrap" id="startDtWrap">
                                    <input type="hidden" name="{{ rental_request_form.rentalStartAt.vars.full_name }}" id="rentalStartAt" value="{{ rental_request_form.rentalStartAt.vars.value ?? '' }}">
                                    <button type="button" class="form-control custom-dt-trigger text-start" id="startDtTrigger">
                                        <i class="bi bi-calendar3 me-2"></i><span id="startDtLabel">Sélectionner une date</span>
                                    </button>
                                    <div class="custom-dt-popup d-none" id="startDtPopup"></div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="endDtTrigger">Fin location <span class="text-danger">*</span></label>
                                <div class="custom-dt-wrap" id="endDtWrap">
                                    <input type="hidden" name="{{ rental_request_form.rentalEndAt.vars.full_name }}" id="rentalEndAt" value="{{ rental_request_form.rentalEndAt.vars.value ?? '' }}">
                                    <button type="button" class="form-control custom-dt-trigger text-start" id="endDtTrigger">
                                        <i class="bi bi-calendar3 me-2"></i><span id="endDtLabel">Sélectionner une date</span>
                                    </button>
                                    <div class="custom-dt-popup d-none" id="endDtPopup"></div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label for="rentalDurationPreview" class="form-label">Durée estimée</label>
                                <input type="text" class="form-control" id="rentalDurationPreview" placeholder="Calcul automatique" readonly>
                            </div>
                            <div class="col-md-6">{{ form_row(rental_request_form.paymentMethod) }}</div>
                            <div class="col-md-6">{{ form_row(rental_request_form.usageLocation) }}</div>
                            <div class="col-md-6">
                                {{ form_row(rental_request_form.transportResponsibility) }}
                                <div class="alert alert-warning py-2 px-3 mt-2 d-none" id="transportFeeNotice" role="alert">
                                    Le vendeur prend en charge le transport : <strong>+10 DT</strong> seront ajoutés au montant à payer.
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="rental-step d-none" data-step="3">
                        <div class="row g-2 rental-step__grid-compact">
                            <div class="col-12">
                                <div class="rental-terms-box">
                                    <div class="rental-terms-box__title">Conditions de location à accepter</div>
                                    <ul class="rental-terms-box__list">
                                        <li>Le locataire est responsable en cas de dommage, perte, vol et réparation/remplacement de l’équipement.</li>
                                        <li>Tout retard de restitution entraîne une pénalité de <strong>10 DT par heure de retard</strong>.</li>
                                        <li>Si le transport est assuré par le vendeur, un supplément de <strong>10 DT</strong> est ajouté.</li>
                                        <li>La demande n’est validée qu’après acceptation explicite des conditions ci-dessous.</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-check p-3 border rounded-3">
                                    <input class="form-check-input" type="checkbox" id="rentalAcceptAllConditions">
                                    <label class="form-check-label fw-semibold" for="rentalAcceptAllConditions">
                                        J'accepte toutes les conditions ci-dessus (dommage, perte, vol, réparation/remplacement).
                                    </label>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-check p-3 border rounded-3">
                                    <input class="form-check-input" type="checkbox" id="rentalAcceptLatePenalty">
                                    <label class="form-check-label fw-semibold" for="rentalAcceptLatePenalty">
                                        J'accepte la pénalité de retard: <strong>10 DT par heure de retard</strong>.
                                    </label>
                                </div>
                            </div>

                            {# Keep backend-required fields mapped but hidden #}
                        </div>
                    </div>

                    <div class="rental-step d-none" data-step="4">
                        <div class="alert alert-success mb-2">
                            Vérifiez vos informations puis cliquez sur <strong>Envoyer la demande</strong>.
                        </div>
                        <p class="small text-muted mb-0">
                            Votre demande sera transmise au vendeur pour validation.
                        </p>
                    </div>
                </div>

                <div class="modal-footer modal-rental__footer">
                    <button type="button" class="btn btn-outline-secondary" id="rentalPrevStepBtn">Précédent</button>
                    <button type="button" class="btn btn-success" id="rentalNextStepBtn">Suivant</button>
                    <button type="submit" class="btn btn-primary" id="rentalSubmitBtn" style="display:none;">Envoyer la demande</button>
                </div>
            {{ form_end(rental_request_form, { render_rest: false }) }}
        </div>
    </div>
</div>
{% endif %}

{% if is_granted('ROLE_USER') %}
<script>
(function () {
    'use strict';

    // ── Element references ────────────────────────────────────────────────────
    var modalEl      = document.getElementById('marketplaceRentalRequestModal');
    if (!modalEl || typeof bootstrap === 'undefined' || !bootstrap.Modal) return;

    var productIdInput = document.getElementById('rentalRequestProductId');
    var productFallbackInput = document.getElementById('rentalRequestProductFallback');
    var productNameEl  = document.getElementById('rentalRequestProductName');
    var dailyPriceEl   = document.getElementById('rentalRequestDailyPrice');
    var startInput     = document.getElementById('rentalStartAt');
    var endInput       = document.getElementById('rentalEndAt');
    var durationEl     = document.getElementById('rentalDurationPreview');
    var prevBtn        = document.getElementById('rentalPrevStepBtn');
    var nextBtn        = document.getElementById('rentalNextStepBtn');
    var submitBtn      = document.getElementById('rentalSubmitBtn');
    var formEl         = document.getElementById('marketplaceRentalRequestForm');
    var progressBar    = document.getElementById('rentalProgressBar');
    var transportFeeNotice = document.getElementById('transportFeeNotice');
    var steps          = Array.prototype.slice.call(document.querySelectorAll('.rental-step'));
    var indicators     = Array.prototype.slice.call(document.querySelectorAll('[data-step-indicator]'));
    var currentStep    = 1;
    var startPicker    = null;
    var endPicker      = null;

    function applyProductContext(produitId, produitNom, rentalPrice) {
        var pid = String(produitId || '').trim();
        if (pid !== '') {
            if (productIdInput) productIdInput.value = pid;
            if (productFallbackInput) productFallbackInput.value = pid;
        }
        if (produitNom && productNameEl) {
            productNameEl.textContent = produitNom;
        }
        if (rentalPrice !== undefined && rentalPrice !== null && dailyPriceEl) {
            var price = String(rentalPrice || '0.000');
            dailyPriceEl.textContent = price.replace('.', ',') + ' DT/jour';
        }
    }

    // ── Error UI helpers ──────────────────────────────────────────────────────

    /**
     * Show a custom validation error beneath a field.
     * Uses a <div class="invalid-feedback"> element appended once, then reused.
     */
    function showFieldError(field, message) {
        field.classList.add('is-invalid');
        var fb = field.parentElement.querySelector('.invalid-feedback');
        if (!fb) {
            fb = document.createElement('div');
            fb.className = 'invalid-feedback';
            field.parentElement.appendChild(fb);
        }
        fb.textContent = message;
    }

    function clearFieldError(field) {
        field.classList.remove('is-invalid');
        field.classList.remove('is-valid');
        var fb = field.parentElement ? field.parentElement.querySelector('.invalid-feedback') : null;
        if (fb) fb.textContent = '';
    }

    function markFieldValid(field) {
        field.classList.remove('is-invalid');
        field.classList.add('is-valid');
    }

    function clearAllErrorsInStep(stepEl) {
        stepEl.querySelectorAll('.is-invalid, .is-valid').forEach(function (el) {
            el.classList.remove('is-invalid', 'is-valid');
        });
        stepEl.querySelectorAll('.invalid-feedback').forEach(function (el) {
            el.textContent = '';
        });
    }

    // ── Validators per step ───────────────────────────────────────────────────
    // Each function returns true when the step is valid, false otherwise.
    // They also show/clear per-field error messages.

    function syncStep3BackendFields() {
        var stepEl = document.querySelector('.rental-step[data-step="3"]');
        if (!stepEl) return;
        var acceptAll = document.getElementById('rentalAcceptAllConditions');
        var acceptPenalty = document.getElementById('rentalAcceptLatePenalty');
        var agreeDamage = stepEl.querySelector('input[type="checkbox"][name$="[agreeDamage]"]');
        var agreeLoss = stepEl.querySelector('input[type="checkbox"][name$="[agreeLoss]"]');
        var agreeTheft = stepEl.querySelector('input[type="checkbox"][name$="[agreeTheft]"]');
        var agreeRepair = stepEl.querySelector('input[type="checkbox"][name$="[agreeRepairReplacement]"]');
        var penaltyText = stepEl.querySelector('[name$="[lateReturnPenalty]"]');

        var allChecked = !!(acceptAll && acceptAll.checked);
        if (agreeDamage) agreeDamage.checked = allChecked;
        if (agreeLoss) agreeLoss.checked = allChecked;
        if (agreeTheft) agreeTheft.checked = allChecked;
        if (agreeRepair) agreeRepair.checked = allChecked;
        if (penaltyText) {
            penaltyText.value = (acceptPenalty && acceptPenalty.checked)
                ? 'Le locataire accepte une pénalité de 10 DT par heure de retard.'
                : '';
        }
    }

