<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Facture commande #{{ commande.id }}</title>
    <style>
        body { font-family: DejaVu Sans, Arial, sans-serif; color: #111827; font-size: 12px; }
        .header { border-bottom: 2px solid #16a34a; padding-bottom: 10px; margin-bottom: 14px; }
        .title { font-size: 22px; font-weight: 700; color: #065f46; margin: 0; }
        .muted { color: #6b7280; }
        .grid { display: table; width: 100%; margin-bottom: 14px; }
        .col { display: table-cell; width: 50%; vertical-align: top; }
        .card { border: 1px solid #e5e7eb; border-radius: 8px; padding: 10px; margin-right: 8px; }
        .card h3 { margin: 0 0 8px; font-size: 13px; color: #111827; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #e5e7eb; padding: 7px; text-align: left; }
        th { background: #f3f4f6; font-size: 11px; text-transform: uppercase; }
        .text-end { text-align: right; }
        .total { margin-top: 12px; text-align: right; font-weight: 700; font-size: 14px; color: #065f46; }
    </style>
</head>
<body>
    <div class="header">
        <p class="title">Facture commande</p>
        <p class="muted">Référence: #CMD{{ "%03d"|format(commande.id) }} | Date: {{ commande.dateCommande|date('Y-m-d H:i') }}</p>
    </div>

    <div class="grid">
        <div class="col">
            <div class="card">
                <h3>Client</h3>
                <div>{{ commande.prenom }} {{ commande.nom }}</div>
                <div class="muted">{{ commande.email ?: '—' }}</div>
                <div class="muted">{{ commande.telephone ?: '—' }}</div>
            </div>
        </div>
        <div class="col">
            <div class="card">
                <h3>Livraison</h3>
                <div>{{ commande.adresse ?: '—' }}</div>
                {% if commande.complement %}<div class="muted">{{ commande.complement }}</div>{% endif %}
                <div class="muted">{{ [commande.codePostal, commande.ville]|filter(v => v)|join(' ') }}</div>
                <div>Statut: {{ commande.status }}</div>
            </div>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Produit</th>
                <th class="text-end">Qté</th>
                <th class="text-end">Prix unit.</th>
                <th class="text-end">Total</th>
            </tr>
        </thead>
        <tbody>
            {% for l in lignes %}
                <tr>
                    <td>{{ l.nomProduit }}</td>
                    <td class="text-end">{{ l.quantite }}</td>
                    <td class="text-end">{{ l.prixUnitaire|number_format(3, ',', ' ') }} DT</td>
                    <td class="text-end">{{ l.prixTotal|number_format(3, ',', ' ') }} DT</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="4">Aucune ligne.</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    {% set total_to_display = montant_vendeur is not null ? montant_vendeur : commande.prixTotal %}
    <div class="total">Total: {{ total_to_display|number_format(3, ',', ' ') }} DT</div>
</body>
</html>
