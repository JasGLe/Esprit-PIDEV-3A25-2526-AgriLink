{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Modifier la commande {% if mes_commandes_mode == 'vendeur' or mes_commandes_mode == 'admin' or is_granted('ROLE_AGRIPLUS') %}#CMD{{ "%03d"|format(commande.id) }}{% else %}#{{ commande.numCommande }}{% endif %} — AgriLink{% endblock %}
{% block page_title %}{% if mes_commandes_mode == 'vendeur' %}Modifier la livraison (client){% elseif mes_commandes_mode == 'admin' %}Modifier la livraison (admin){% else %}Modifier la livraison{% endif %}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/mes-commandes-dashboard.css') }}">
{% endblock %}

{% block dashboard_content %}
<div class="mc-orders-scope">
    <a href="{{ path('mes_commandes_show', { id: commande.id }) }}" class="mc-link d-inline-flex align-items-center gap-1 mb-3 small"><i class="bi bi-arrow-left" aria-hidden="true"></i> Retour au détail</a>

    <div class="mc-detail-card p-4 mb-4">
        <h2 class="mc-orders-title h5 mb-1">Commande <span class="mc-num">{% if mes_commandes_mode == 'vendeur' or mes_commandes_mode == 'admin' or is_granted('ROLE_AGRIPLUS') %}#CMD{{ "%03d"|format(commande.id) }}{% else %}#{{ commande.numCommande }}{% endif %}</span></h2>
        <p class="mc-orders-sub small mb-4">Mettez à jour l’adresse et les coordonnées de contact pour cette livraison.</p>

        {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
        <div class="row g-3">
            <div class="col-md-6">{{ form_row(form.prenom) }}</div>
            <div class="col-md-6">{{ form_row(form.nom) }}</div>
            <div class="col-12">{{ form_row(form.telephone) }}</div>
            <div class="col-12">{{ form_row(form.adresse) }}</div>
            <div class="col-12">{{ form_row(form.complement) }}</div>
            <div class="col-md-4">{{ form_row(form.codePostal) }}</div>
            <div class="col-md-8">{{ form_row(form.ville) }}</div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3 mt-4">
            {{ form_widget(form.save) }}
            <a href="{{ path('mes_commandes_show', { id: commande.id }) }}" class="mc-link small">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
