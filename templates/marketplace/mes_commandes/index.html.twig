{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}{% if mes_commandes_mode == 'admin' %}Gestion des commandes — AgriLink{% else %}Mes commandes — AgriLink{% endif %}{% endblock %}
{% block page_title %}{% if mes_commandes_mode == 'admin' %}Gestion des commandes{% else %}Mes commandes{% endif %}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/bootstrap-custom2.css') }}">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/mes-commandes-dashboard.css') }}">
{% endblock %}

{% block dashboard_content %}
{% import _self as mc %}

{% macro render_status(mes_commandes_mode, status, commande_id, dropdown_choices, pending_cancel, show_buyer_cancel_request, buyer_cancel_order_ref, force_statut_edit) %}
    {% set s = status|lower %}
    {% set redirect_target = 'index' %}
    {% set force_edit = force_statut_edit|default(false) %}
    {% if pending_cancel %}
        <p class="small text-warning mb-1"><i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>Demande d’annulation en attente</p>
    {% endif %}

    {% if s matches '/annul|cancel/' %}
        <span class="mc-badge mc-badge--danger"><i class="bi bi-x-circle me-1" aria-hidden="true"></i>Annulée</span>
    {% elseif s matches '/livree|livrée|livré|termine|reception|reçue|recue/' %}
        <span class="mc-badge mc-badge--success"><i class="bi bi-check2-circle me-1" aria-hidden="true"></i>Livrée</span>
    {% elseif dropdown_choices is iterable and dropdown_choices|length > 0 and commande_id is defined %}
        {% if s matches '/prepar/' %}
            {% set summary_badge = 'mc-badge--prep' %}
            {% set summary_icon = 'bi-box-seam' %}
            {% set summary_text = 'En préparation' %}
        {% elseif s matches '/exped/' %}
            {% set summary_badge = 'mc-badge--info' %}
            {% set summary_icon = 'bi-truck' %}
            {% set summary_text = 'Expédiée' %}
        {% else %}
            {% set summary_badge = 'mc-badge--warning' %}
            {% set summary_icon = 'bi-hourglass-split' %}
            {% set summary_text = 'En cours' %}
        {% endif %}
        <details class="mc-status-details">
            <summary class="mc-badge {{ summary_badge }} mc-status-details__summary">
                <i class="bi {{ summary_icon }} me-1" aria-hidden="true"></i>{{ summary_text }}
                <i class="bi bi-chevron-up ms-1 mc-status-details__caret" aria-hidden="true"></i>
            </summary>
            <div class="mc-status-popover mc-status-popover--above" role="region" aria-label="Changer le statut">
                <div class="mc-status-popover__inner">
                    <header class="mc-status-popover__head">
                        <span class="mc-status-popover__title">Changer le statut</span>
                    </header>
                    <div class="mc-status-popover__scroller">
                        <ul class="mc-status-popover__list">
                            {% for value, label in dropdown_choices %}
                                <li class="mc-status-popover__item{% if value == 'ANNULEE' %} mc-status-popover__item--danger-zone{% endif %}">
                                    <form method="post" action="{{ path('mes_commandes_statut', { id: commande_id }) }}" class="mc-status-popover__form">
                                        <input type="hidden" name="_token" value="{{ csrf_token('mes_commandes_statut') }}">
                                        <input type="hidden" name="_redirect" value="{{ redirect_target }}">
                                        <button type="submit" name="status" value="{{ value }}" class="mc-status-popover__opt{% if value == 'ANNULEE' %} mc-status-popover__opt--danger{% endif %}">
                                            <span class="mc-status-popover__opt-label">{{ label }}</span>
                                            <i class="bi bi-arrow-right-short mc-status-popover__opt-icon" aria-hidden="true"></i>
                                        </button>
                                    </form>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                    <span class="mc-status-popover__pointer" aria-hidden="true"></span>
                </div>
            </div>
        </details>
    {% else %}
        {% if s matches '/exped/' %}
            <span class="mc-badge mc-badge--info"><i class="bi bi-truck me-1" aria-hidden="true"></i>Expédiée</span>
        {% elseif s matches '/prepar/' %}
            <span class="mc-badge mc-badge--prep"><i class="bi bi-box-seam me-1" aria-hidden="true"></i>En préparation</span>
        {% else %}
            <span class="mc-badge mc-badge--warning"><i class="bi bi-hourglass-split me-1" aria-hidden="true"></i>En cours</span>
        {% endif %}
    {% endif %}
{% endmacro %}

{% macro render_actions(commande, mes_commandes_mode, deletable_commande_ids, pending_cancellation_map, buyer_cancel_eligible_map, buyer_cancel_reason_map) %}
    {% set can_delete = deletable_commande_ids[commande.id] ?? false %}
    {% set pending_cancel = pending_cancellation_map[commande.id] ?? false %}
    {% set cancel_eligible = buyer_cancel_eligible_map[commande.id] ?? false %}
    {% set cancel_reason = buyer_cancel_reason_map[commande.id] ?? '' %}
    {% set is_agriplus_buyer = mes_commandes_mode == 'acheteur' and is_granted('ROLE_AGRIPLUS') %}
    {% set del_title_disabled = mes_commandes_mode == 'vendeur'
        ? 'Suppression impossible (commande livrée ou multi-producteurs)'
        : (mes_commandes_mode == 'admin'
            ? 'Suppression réservée aux commandes livrées ou annulées'
            : 'Suppression impossible (commande livrée)') %}
    <div class="mc-act-toolbar">
        <button type="button" class="btn btn-sm mc-act mc-act--view" title="Voir les détails" data-bs-toggle="modal" data-bs-target="#mcOrderDetailModal" data-mc-order-detail-url="{{ path('mes_commandes_detail_modal', { id: commande.id }) }}"><i class="bi bi-search" aria-hidden="true"></i></button>
        <button type="button" class="btn btn-sm mc-act mc-act--edit" title="Modifier les coordonnées de livraison" data-bs-toggle="modal" data-bs-target="#mcOrderEditModal" data-mc-order-edit-url="{{ path('mes_commandes_edit_modal', { id: commande.id }) }}"><i class="bi bi-pencil" aria-hidden="true"></i></button>
        {% if is_agriplus_buyer %}
            {% if cancel_eligible %}
                <form method="post" action="{{ path('mes_commandes_cancel_request', { id: commande.id }) }}" class="d-inline js-mc-cancel-request-form" data-mc-order-ref="#CMD{{ "%03d"|format(commande.id) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_request_' ~ commande.id) }}">
                    <button type="button" class="btn btn-sm mc-act mc-act--agriplus-cancel js-mc-cancel-open" title="Demander l’annulation"><i class="bi bi-x-lg" aria-hidden="true"></i><span class="visually-hidden"> Demander l’annulation</span></button>
                </form>
            {% elseif pending_cancel %}
                <button type="button" class="btn btn-sm mc-act mc-act--agriplus-cancel" disabled title="Demande d’annulation en attente de traitement"><i class="bi bi-hourglass-split" aria-hidden="true"></i><span class="visually-hidden"> Annulation en attente</span></button>
            {% else %}
                <button type="button" class="btn btn-sm mc-act mc-act--agriplus-cancel" disabled title="{{ cancel_reason != '' ? cancel_reason : 'Annulation indisponible (délai 48 h dépassé, commande expédiée ou terminée)' }}"><i class="bi bi-x-lg" aria-hidden="true"></i><span class="visually-hidden"> Annulation indisponible</span></button>
            {% endif %}
        {% elseif can_delete %}
            <form method="post" action="{{ path('mes_commandes_delete', { id: commande.id }) }}" class="d-inline js-mc-delete-form" data-mc-order-ref="#CMD{{ "%03d"|format(commande.id) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_commande_' ~ commande.id) }}">
                <button type="submit" class="btn btn-sm mc-act mc-act--delete" title="Supprimer la commande"><i class="bi bi-trash" aria-hidden="true"></i></button>
            </form>
        {% else %}
            <button type="button" class="btn btn-sm mc-act mc-act--delete" disabled title="{{ del_title_disabled }}"><i class="bi bi-trash" aria-hidden="true"></i></button>
        {% endif %}
        <a href="{{ path('mes_commandes_pdf', { id: commande.id }) }}" class="btn btn-sm mc-act mc-act--pdf"><i class="bi bi-file-earmark-pdf me-1" aria-hidden="true"></i>Export PDF</a>
    </div>
{% endmacro %}

<div class="mc-orders-scope">
    <div class="mc-orders-head d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div class="flex-grow-1 min-w-0">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <h2 class="mc-orders-title mb-0">{% if mes_commandes_mode == 'admin' %}Gestion des commandes{% else %}Mes commandes{% endif %}</h2>
                {% if (mes_commandes_mode == 'vendeur' or mes_commandes_mode == 'admin') and count_annulations_attente > 0 %}
                    <span class="mc-alert-pill"><i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>{{ count_annulations_attente }} annulation{{ count_annulations_attente > 1 ? 's' : '' }} en attente</span>
                {% endif %}
            </div>
            {% if mes_commandes_mode == 'admin' %}
                <p class="mc-orders-sub mb-0 small">Vue globale : toutes les commandes passées sur le marketplace, quel que soit le client ou le vendeur.</p>
            {% elseif mes_commandes_mode == 'vendeur' %}
                <p class="mc-orders-sub mb-0 small">Consultez les commandes clients contenant vos produits .</p>
            {% else %}
                <p class="mc-orders-sub mb-0 small">Vos achats marketplace (liés à l’email de votre compte : {{ app.user.email }})</p>
            {% endif %}
        </div>
        <div class="mc-head-actions d-flex flex-column align-items-end gap-2 flex-shrink-0">
            <a href="{{ path('mes_commandes_index') }}" class="btn mc-btn-refresh d-inline-flex align-items-center gap-2">
                <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Actualiser
            </a>
            <div class="mc-pagination mc-pagination--top">
                {{ knp_pagination_render(commandes, 'marketplace/mes_commandes/_pagination.html.twig') }}
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="mc-stat-card">
                <span class="mc-stat-card__icon mc-stat-card__icon--green"><i class="bi bi-bag-check" aria-hidden="true"></i></span>
                <div>
                    <div class="mc-stat-card__label">Total</div>
                    <div class="mc-stat-card__val">{{ count_total }} commande{{ count_total > 1 ? 's' : '' }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mc-stat-card">
                <span class="mc-stat-card__icon mc-stat-card__icon--orange"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></span>
                <div>
                    <div class="mc-stat-card__label">En cours</div>
                    <div class="mc-stat-card__val">{{ count_en_cours }} en traitement</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mc-stat-card">
                <span class="mc-stat-card__icon mc-stat-card__icon--lime"><i class="bi bi-check2-all" aria-hidden="true"></i></span>
                <div>
                    <div class="mc-stat-card__label">Livrées</div>
                    <div class="mc-stat-card__val">{{ count_livrees }} réceptionnée{{ count_livrees > 1 ? 's' : '' }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="mc-table-wrap mc-table-wrap--allow-float">
        <div class="table-responsive">
            <table class="table mc-table mb-0">
                <thead>
                    <tr>
                        {% if mes_commandes_mode == 'vendeur' or mes_commandes_mode == 'admin' %}
                            <th>Client</th>
                            <th>Contact</th>
                        {% endif %}
                        <th>N° commande</th>
                        <th>Date</th>
                        {% if mes_commandes_mode == 'admin' %}
                            <th>Vendeur(s)</th>
                        {% else %}
                            <th>Montant</th>
                        {% endif %}
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% if mes_commandes_mode == 'vendeur' %}
                        {% for c in commandes %}
                            {% set client_nom = [c.prenom, c.nom]|filter(v => v)|join(' ')|trim %}
                            {% if client_nom is empty %}
                                {% set client_nom = 'Client' %}
                                {% set client_initial = '?' %}
                            {% else %}
                                {% set client_initial = client_nom|slice(0, 1)|upper %}
                            {% endif %}
                            {% set mv = montants_vendeur[c.id]|default(0) %}
                            <tr>
                                <td>
                                    <div class="mc-client-cell d-flex align-items-center gap-2">
                                        <span class="mc-avatar" aria-hidden="true">{{ client_initial }}</span>
                                        <span class="mc-client-name">{{ client_nom }}</span>
                                    </div>
                                </td>
                                <td class="mc-contact-cell">
                                    {% if c.telephone or c.email %}
                                        
<div class="mc-contact-stack">
    {% if c.telephone %}
        <div class="mc-contact-item">
            <i class="bi bi-telephone mc-muted" aria-hidden="true"></i>
            <span>{{ c.telephone }}</span>
        </div>
    {% endif %}

    {% if c.email %}
        <div class="mc-contact-item">
            <i class="bi bi-envelope mc-muted" aria-hidden="true"></i>
            <span>{{ c.email }}</span>
        </div>
    {% endif %}
</div>

                                    {% else %}
                                        <span class="mc-muted">—</span>
                                    {% endif %}
                                </td>
                                <td><span class="mc-num mc-num--nowrap">#CMD{{ "%03d"|format(c.id) }}</span></td>
                                <td class="mc-date mc-date--nowrap">{{ c.dateCommande|date('Y-m-d') }}</td>
                                <td><span class="mc-amount">{{ mv|number_format(3, ',', ' ') }} DT</span></td>
                                <td class="mc-status-cell">{{ mc.render_status(mes_commandes_mode, c.status, c.id, statut_choices_seller, pending_cancellation_map[c.id]|default(false), false, '', false) }}</td>
                                <td class="text-end mc-actions-cell">
                                    {% if pending_cancellation_map[c.id]|default(false) %}
                                        <div class="d-flex flex-wrap justify-content-end gap-1 mb-2">
                                            <form method="post" action="{{ path('mes_commandes_cancel_approve', { id: c.id }) }}" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cancel_approve_' ~ c.id) }}">
                                                <button type="submit" class="btn btn-sm btn-success">Accepter l’annulation</button>
                                            </form>
                                            <form method="post" action="{{ path('mes_commandes_cancel_reject', { id: c.id }) }}" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cancel_reject_' ~ c.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">Refuser</button>
                                            </form>
                                        </div>
                                    {% endif %}
                                    {{ mc.render_actions(commande=c, mes_commandes_mode=mes_commandes_mode, deletable_commande_ids=deletable_commande_ids|default({}), pending_cancellation_map=pending_cancellation_map|default({}), buyer_cancel_eligible_map=buyer_cancel_eligible_map|default({}), buyer_cancel_reason_map=buyer_cancel_reason_map|default({})) }}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-5 mc-empty">
                                    Aucune commande pour le moment. Les achats effectués sur le <a href="{{ path('marketplace_index') }}" class="mc-link">marketplace</a> pour vos annonces apparaîtront ici.
                                </td>
                            </tr>
                        {% endfor %}
                    {% elseif mes_commandes_mode == 'admin' %}
                        {% for c in commandes %}
                            {% set client_nom = [c.prenom, c.nom]|filter(v => v)|join(' ')|trim %}
                            {% if client_nom is empty %}
                                {% set client_nom = 'Client' %}
                                {% set client_initial = '?' %}
                            {% else %}
                                {% set client_initial = client_nom|slice(0, 1)|upper %}
                            {% endif %}
                            <tr>
                                <td>
                                    <div class="mc-client-cell d-flex align-items-center gap-2">
                                        <span class="mc-avatar" aria-hidden="true">{{ client_initial }}</span>
                                        <span class="mc-client-name">{{ client_nom }}</span>
                                    </div>
                                </td>
                                <td class="mc-contact-cell">
                                    {% if c.telephone or c.email %}
<div class="mc-contact-stack">
    {% if c.telephone %}
        <div class="mc-contact-item">
            <i class="bi bi-telephone mc-muted" aria-hidden="true"></i>
            <span>{{ c.telephone }}</span>
        </div>
    {% endif %}
    {% if c.email %}
        <div class="mc-contact-item">
            <i class="bi bi-envelope mc-muted" aria-hidden="true"></i>
            <span>{{ c.email }}</span>
        </div>
    {% endif %}
</div>
                                    {% else %}
                                        <span class="mc-muted">—</span>
                                    {% endif %}
                                </td>
                                <td><span class="mc-num mc-num--nowrap">#CMD{{ "%03d"|format(c.id) }}</span></td>
                                <td class="mc-date mc-date--nowrap">{{ c.dateCommande|date('Y-m-d') }}</td>
                                <td class="mc-seller-cell"><span class="mc-seller-name">{{ vendeurs_par_commande[c.id]|default('—') }}</span></td>
                                <td class="mc-status-cell">{{ mc.render_status(mes_commandes_mode, c.status, c.id, statut_choices_by_commande[c.id]|default({}), pending_cancellation_map[c.id]|default(false), false, '', true) }}</td>
                                <td class="text-end mc-actions-cell">
                                    {% if pending_cancellation_map[c.id]|default(false) %}
                                        <div class="d-flex flex-wrap justify-content-end gap-1 mb-2">
                                            <form method="post" action="{{ path('mes_commandes_cancel_approve', { id: c.id }) }}" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cancel_approve_' ~ c.id) }}">
                                                <button type="submit" class="btn btn-sm btn-success">Accepter l’annulation</button>
                                            </form>
                                            <form method="post" action="{{ path('mes_commandes_cancel_reject', { id: c.id }) }}" class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cancel_reject_' ~ c.id) }}">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary">Refuser</button>
                                            </form>
                                        </div>
                                    {% endif %}
                                    {{ mc.render_actions(commande=c, mes_commandes_mode=mes_commandes_mode, deletable_commande_ids=deletable_commande_ids|default({}), pending_cancellation_map=pending_cancellation_map|default({}), buyer_cancel_eligible_map=buyer_cancel_eligible_map|default({}), buyer_cancel_reason_map=buyer_cancel_reason_map|default({})) }}
