                                <td><span class="mc-amount">{{ c.prixTotal|number_format(3, ',', ' ') }} DT</span></td>
                                <td class="mc-status-cell">{{ mc.render_status(mes_commandes_mode, c.status, c.id, statut_choices_by_commande[c.id]|default({}), pending_cancellation_map[c.id]|default(false), buyer_cancel_eligible_map[c.id]|default(false), '#CMD' ~ ('%03d'|format(c.id)), false) }}</td>
                                <td class="text-end mc-actions-cell">
                                    {{ mc.render_actions(commande=c, mes_commandes_mode=mes_commandes_mode, deletable_commande_ids=deletable_commande_ids|default({}), pending_cancellation_map=pending_cancellation_map|default({}), buyer_cancel_eligible_map=buyer_cancel_eligible_map|default({}), buyer_cancel_reason_map=buyer_cancel_reason_map|default({})) }}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center py-5 mc-empty">
                                    Aucune commande pour le moment. Passez commande sur le <a href="{{ path('marketplace_index') }}" class="mc-link">marketplace</a>.
                                </td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade mc-order-detail-modal" id="mcOrderDetailModal" tabindex="-1" aria-labelledby="mcOrderDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content mc-order-detail-modal__content border-0 shadow-lg">
            <div class="modal-header mc-order-detail-modal__header border-0">
                <h2 class="modal-title h5 mb-0 mc-order-detail-modal__title" id="mcOrderDetailModalLabel">Détail de la commande</h2>
                <button type="button" class="btn-close btn-close-white mc-order-detail-modal__close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body mc-order-detail-modal__body p-0" id="mcOrderDetailModalBody">
                <div class="mc-order-detail-modal__loading p-4 text-center mc-muted">Chargement…</div>
            </div>
        </div>
    </div>
</div>

{% include 'marketplace/mes_commandes/_order_edit_modal.html.twig' %}

<div class="modal fade" id="mcDeleteConfirmModal" tabindex="-1" aria-labelledby="mcDeleteConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content boutique-confirm__content border-0 shadow-lg">
            <div class="modal-header boutique-confirm__header border-0">
                <h2 class="modal-title h6 mb-0 boutique-confirm__title" id="mcDeleteConfirmModalLabel">
                    <span class="boutique-confirm__icon" aria-hidden="true">🗑️</span>
                    Supprimer la commande
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body boutique-confirm__body">
                <p class="mb-1">Cette action est définitive et ne peut pas être annulée.</p>
            </div>
            <div class="modal-footer boutique-confirm__footer border-0">
                <button type="button" class="btn btn-sm btn-outline-secondary boutique-confirm__btn-cancel" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-sm btn-danger boutique-confirm__btn-confirm js-mc-delete-confirm">Supprimer</button>
            </div>
        </div>
    </div>
</div>

{% if mes_commandes_mode == 'acheteur' %}
<div class="modal fade" id="mcCancelRequestModal" tabindex="-1" aria-labelledby="mcCancelRequestModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content boutique-confirm__content mc-cancel-request-modal__content border-0 shadow-lg">
            <div class="modal-header boutique-confirm__header mc-cancel-request-modal__header border-0">
                <h2 class="modal-title h6 mb-0 boutique-confirm__title mc-cancel-request-modal__title" id="mcCancelRequestModalLabel">
                    <span class="boutique-confirm__icon mc-cancel-request-modal__icon" aria-hidden="true"><i class="bi bi-x-lg"></i></span>
                    Demande d’annulation
                </h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body boutique-confirm__body mc-cancel-request-modal__body">
                <p class="mb-2">Commande <strong class="js-mc-cancel-order-ref">—</strong>.</p>
                <p class="mb-2">Votre demande d’annulation sera envoyée pour traitement.</p>
                <p class="mb-2 text-secondary small">Traitée par : <strong>Admin</strong> ou <strong>Responsable de la commande</strong>.</p>
                <p class="mb-0 text-secondary small">Disponible dans les 48 h suivant la commande.</p>
            </div>
            <div class="modal-footer boutique-confirm__footer mc-cancel-request-modal__footer border-0">
                <button type="button" class="btn btn-sm btn-outline-secondary boutique-confirm__btn-cancel" data-bs-dismiss="modal">Retour</button>
                <button type="button" class="btn btn-sm btn-danger boutique-confirm__btn-confirm js-mc-cancel-confirm"><i class="bi bi-x-lg me-1" aria-hidden="true"></i>Confirmer la demande</button>
            </div>
        </div>
    </div>
</div>
{% endif %}

<script>
(function () {
    function bindMcStatusDetails(scope) {
        var root = scope || document;
        root.querySelectorAll('.mc-status-details').forEach(function (el) {
            if (el.dataset.mcStatusBound === '1') {
                return;
            }
            el.dataset.mcStatusBound = '1';
            el.addEventListener('toggle', function () {
                var row = el.closest('tr');
                if (row) {
                    row.classList.toggle('mc-row-status-open', !!el.open);
                }
                if (!el.open) {
                    return;
                }
                var scopeRoot = el.closest('.mc-orders-scope');
                if (!scopeRoot) {
                    return;
                }
                scopeRoot.querySelectorAll('.mc-status-details').forEach(function (o) {
                    if (o !== el) {
                        var otherRow = o.closest('tr');
                        if (otherRow) {
                            otherRow.classList.remove('mc-row-status-open');
                        }
                        o.removeAttribute('open');
                    }
                });
            });
        });
    }

    var listScope = document.querySelector('.mc-orders-scope');
    if (listScope) {
        bindMcStatusDetails(listScope);
    }

    var modalEl = document.getElementById('mcOrderDetailModal');
    var bodyEl = document.getElementById('mcOrderDetailModalBody');
    if (!modalEl || !bodyEl) {
        return;
    }

    modalEl.addEventListener('show.bs.modal', function (event) {
        var btn = event.relatedTarget;
        var url = btn && btn.getAttribute('data-mc-order-detail-url');
        if (!url) {
            return;
        }
        bodyEl.innerHTML = '<div class="mc-order-detail-modal__loading p-4 text-center mc-muted">Chargement…</div>';
        fetch(url, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            credentials: 'same-origin'
        })
            .then(function (r) {
                if (!r.ok) {
                    throw new Error('load');
                }
                return r.text();
            })
            .then(function (html) {
                bodyEl.innerHTML = html;
                var inner = bodyEl.querySelector('[data-mc-order-modal-root]');
                bindMcStatusDetails(inner || bodyEl);
            })
            .catch(function () {
                bodyEl.innerHTML = '<div class="p-4 text-center mc-order-detail-modal__err">Impossible de charger le détail de la commande.</div>';
            });
    });

    modalEl.addEventListener('hidden.bs.modal', function () {
        bodyEl.innerHTML = '<div class="mc-order-detail-modal__loading p-4 text-center mc-muted">Chargement…</div>';
    });
})();
</script>

<script>
(function () {
    var deleteModalEl = document.getElementById('mcDeleteConfirmModal');
    if (deleteModalEl && typeof bootstrap !== 'undefined' && bootstrap.Modal) {
        var deleteModal = bootstrap.Modal.getOrCreateInstance(deleteModalEl, { backdrop: 'static' });
        var deleteConfirmBtn = deleteModalEl.querySelector('.js-mc-delete-confirm');
        var pendingDeleteForm = null;
        document.addEventListener('submit', function (event) {
            var form = event.target;
            if (!(form instanceof HTMLFormElement) || !form.classList.contains('js-mc-delete-form')) return;
            event.preventDefault();
            pendingDeleteForm = form;
            deleteModal.show();
        }, true);
        if (deleteConfirmBtn) {
            deleteConfirmBtn.addEventListener('click', function () {
                if (!pendingDeleteForm) return deleteModal.hide();
                var f = pendingDeleteForm;
                pendingDeleteForm = null;
                deleteModal.hide();
                f.submit();
            });
        }
        deleteModalEl.addEventListener('hidden.bs.modal', function () { pendingDeleteForm = null; });
    }

    var cancelModalEl = document.getElementById('mcCancelRequestModal');
    if (cancelModalEl && typeof bootstrap !== 'undefined' && bootstrap.Modal) {
        var cancelModal = bootstrap.Modal.getOrCreateInstance(cancelModalEl, { backdrop: 'static' });
        var refEl = cancelModalEl.querySelector('.js-mc-cancel-order-ref');
        var cancelConfirmBtn = cancelModalEl.querySelector('.js-mc-cancel-confirm');
        var pendingCancelForm = null;
        document.addEventListener('click', function (event) {
            var btn = event.target && event.target.closest && event.target.closest('.js-mc-cancel-open');
            if (!btn) return;
            var form = btn.closest('form.js-mc-cancel-request-form');
            if (!form) return;
            event.preventDefault();
            pendingCancelForm = form;
            if (refEl) refEl.textContent = form.getAttribute('data-mc-order-ref') || 'cette commande';
            cancelModal.show();
        }, true);
        if (cancelConfirmBtn) {
            cancelConfirmBtn.addEventListener('click', function () {
                if (!pendingCancelForm) return cancelModal.hide();
                var f = pendingCancelForm;
                pendingCancelForm = null;
                cancelModal.hide();
                f.submit();
            });
        }
        cancelModalEl.addEventListener('hidden.bs.modal', function () { pendingCancelForm = null; });
    }
})();
</script>
{% endblock %}
