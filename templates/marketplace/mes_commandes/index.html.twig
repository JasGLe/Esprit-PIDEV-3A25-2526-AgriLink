{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Mes commandes — AgriLink{% endblock %}
{% block page_title %}Mes commandes{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="{{ asset('css/mes-commandes-dashboard.css') }}">
{% endblock %}

{% block dashboard_content %}
<div class="mc-orders-scope">
    <div class="mc-orders-head d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div class="flex-grow-1 min-w-0">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                <h2 class="mc-orders-title mb-0">Mes commandes</h2>
                {% if mes_commandes_mode == 'vendeur' and count_annulations_attente > 0 %}
                    <span class="mc-alert-pill"><i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>{{ count_annulations_attente }} annulation{{ count_annulations_attente > 1 ? 's' : '' }} en attente</span>
                {% endif %}
            </div>
            {% if mes_commandes_mode == 'vendeur' %}
                <p class="mc-orders-sub mb-0 small">Consultez les commandes clients contenant vos produits (tous acheteurs marketplace).</p>
            {% else %}
                <p class="mc-orders-sub mb-0 small">Vos achats marketplace (liés à l’email de votre compte : {{ app.user.email }})</p>
            {% endif %}
        </div>
        <a href="{{ path('mes_commandes_index') }}" class="btn mc-btn-refresh d-inline-flex align-items-center gap-2 flex-shrink-0">
            <i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Actualiser
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="mc-stat-card">
                <span class="mc-stat-card__icon mc-stat-card__icon--green"><i class="bi bi-bag-check" aria-hidden="true"></i></span>
                <div>
                    <div class="mc-stat-card__label">Total</div>
                    <div class="mc-stat-card__val">{{ count_total }} commande{{ count_total > 1 ? 's' : '' }}</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mc-stat-card">
                <span class="mc-stat-card__icon mc-stat-card__icon--orange"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></span>
                <div>
                    <div class="mc-stat-card__label">En cours</div>
                    <div class="mc-stat-card__val">{{ count_en_cours }} en traitement</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="mc-stat-card">
                <span class="mc-stat-card__icon mc-stat-card__icon--lime"><i class="bi bi-check2-all" aria-hidden="true"></i></span>
                <div>
                    <div class="mc-stat-card__label">Livrées</div>
                    <div class="mc-stat-card__val">{{ count_livrees }} réceptionnée{{ count_livrees > 1 ? 's' : '' }}</div>
                </div>
            </div>
        </div>
    </div>

    <div class="mc-table-wrap mc-table-wrap--allow-float">
        <div class="table-responsive">
            <table class="table mc-table mb-0">
                <thead>
                    <tr>
                        {% if mes_commandes_mode == 'vendeur' %}
                            <th>Client</th>
                            <th>Contact</th>
                        {% endif %}
                        <th>N° commande</th>
                        <th>Date</th>
                        <th>Montant</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% if mes_commandes_mode == 'vendeur' %}
                        {% for c in commandes %}
                            {% set client_nom = [c.prenom, c.nom]|filter(v => v)|join(' ')|trim %}
                            {% if client_nom is empty %}
                                {% set client_nom = 'Client' %}
                                {% set client_initial = '?' %}
                            {% else %}
                                {% set client_initial = client_nom|slice(0, 1)|upper %}
                            {% endif %}
                            {% set mv = montants_vendeur[c.id]|default(0) %}
                            <tr>
                                <td>
                                    <div class="mc-client-cell d-flex align-items-center gap-2">
                                        <span class="mc-avatar" aria-hidden="true">{{ client_initial }}</span>
                                        <span class="mc-client-name">{{ client_nom }}</span>
                                    </div>
                                </td>
                                <td class="mc-contact-cell">
                                    {% if c.telephone or c.email %}
                                        
<div class="mc-contact-stack">
    {% if c.telephone %}
        <div class="mc-contact-item">
            <i class="bi bi-telephone mc-muted" aria-hidden="true"></i>
            <span>{{ c.telephone }}</span>
        </div>
    {% endif %}

    {% if c.email %}
        <div class="mc-contact-item">
            <i class="bi bi-envelope mc-muted" aria-hidden="true"></i>
            <span>{{ c.email }}</span>
        </div>
    {% endif %}
</div>

                                    {% else %}
                                        <span class="mc-muted">—</span>
                                    {% endif %}
                                </td>
                                <td><span class="mc-num">#{{ c.numCommande }}</span></td>
                                <td class="mc-date mc-date--nowrap">{{ c.dateCommande|date('Y-m-d') }}</td>
                                <td><span class="mc-amount">{{ mv|number_format(3, ',', ' ') }} DT</span></td>
                                <td class="mc-status-cell">{% include 'marketplace/mes_commandes/_status.html.twig' with { status: c.status, commande_id: c.id, dropdown_choices: statut_choices_seller, statut_redirect: 'index' } %}</td>
                                <td class="text-end mc-actions-cell">
                                    {% include 'marketplace/mes_commandes/_actions_toolbar.html.twig' with { commande: c } %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-5 mc-empty">
                                    Aucune commande pour le moment. Les achats effectués sur le <a href="{{ path('marketplace_index') }}" class="mc-link">marketplace</a> pour vos annonces apparaîtront ici.
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        {% for c in commandes %}
                            <tr>
                                <td><span class="mc-num">#{{ c.numCommande }}</span></td>
                                <td class="mc-date mc-date--nowrap">{{ c.dateCommande|date('Y-m-d') }}</td>
                                <td><span class="mc-amount">{{ c.prixTotal|number_format(3, ',', ' ') }} DT</span></td>
                                <td class="mc-status-cell">{% include 'marketplace/mes_commandes/_status.html.twig' with { status: c.status, commande_id: c.id, dropdown_choices: statut_choices_by_commande[c.id]|default({}), statut_redirect: 'index' } %}</td>
                                <td class="text-end mc-actions-cell">
                                    {% include 'marketplace/mes_commandes/_actions_toolbar.html.twig' with { commande: c } %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="text-center py-5 mc-empty">
                                    Aucune commande pour le moment. Passez commande sur le <a href="{{ path('marketplace_index') }}" class="mc-link">marketplace</a>.
                                </td>
                            </tr>
                        {% endfor %}
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade mc-order-detail-modal" id="mcOrderDetailModal" tabindex="-1" aria-labelledby="mcOrderDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content mc-order-detail-modal__content border-0 shadow-lg">
            <div class="modal-header mc-order-detail-modal__header border-0">
                <h2 class="modal-title h5 mb-0 mc-order-detail-modal__title" id="mcOrderDetailModalLabel">Détail de la commande</h2>
                <button type="button" class="btn-close btn-close-white mc-order-detail-modal__close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body mc-order-detail-modal__body p-0" id="mcOrderDetailModalBody">
                <div class="mc-order-detail-modal__loading p-4 text-center mc-muted">Chargement…</div>
            </div>
        </div>
    </div>
</div>

{% include 'marketplace/mes_commandes/_order_edit_modal.html.twig' %}

<script>
(function () {
    function bindMcStatusDetails(scope) {
        var root = scope || document;
        root.querySelectorAll('.mc-status-details').forEach(function (el) {
            if (el.dataset.mcStatusBound === '1') {
                return;
            }
            el.dataset.mcStatusBound = '1';
            el.addEventListener('toggle', function () {
                if (!el.open) {
                    return;
                }
                var scopeRoot = el.closest('.mc-orders-scope');
                if (!scopeRoot) {
                    return;
                }
                scopeRoot.querySelectorAll('.mc-status-details').forEach(function (o) {
                    if (o !== el) {
                        o.removeAttribute('open');
                    }
                });
            });
        });
    }

    var listScope = document.querySelector('.mc-orders-scope');
    if (listScope) {
        bindMcStatusDetails(listScope);
    }

    var modalEl = document.getElementById('mcOrderDetailModal');
    var bodyEl = document.getElementById('mcOrderDetailModalBody');
    if (!modalEl || !bodyEl) {
        return;
    }

    modalEl.addEventListener('show.bs.modal', function (event) {
        var btn = event.relatedTarget;
        var url = btn && btn.getAttribute('data-mc-order-detail-url');
        if (!url) {
            return;
        }
        bodyEl.innerHTML = '<div class="mc-order-detail-modal__loading p-4 text-center mc-muted">Chargement…</div>';
        fetch(url, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            credentials: 'same-origin'
        })
            .then(function (r) {
                if (!r.ok) {
                    throw new Error('load');
                }
                return r.text();
            })
            .then(function (html) {
                bodyEl.innerHTML = html;
                var inner = bodyEl.querySelector('[data-mc-order-modal-root]');
                bindMcStatusDetails(inner || bodyEl);
            })
            .catch(function () {
                bodyEl.innerHTML = '<div class="p-4 text-center mc-order-detail-modal__err">Impossible de charger le détail de la commande.</div>';
            });
    });

    modalEl.addEventListener('hidden.bs.modal', function () {
        bodyEl.innerHTML = '<div class="mc-order-detail-modal__loading p-4 text-center mc-muted">Chargement…</div>';
    });
})();
</script>
{% endblock %}
