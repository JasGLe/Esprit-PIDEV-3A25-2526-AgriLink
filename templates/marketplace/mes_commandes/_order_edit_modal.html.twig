<div class="modal fade mc-order-edit-modal" id="mcOrderEditModal" tabindex="-1" aria-labelledby="mcOrderEditModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content mc-order-edit-modal__content border-0 shadow-lg">
            <div class="modal-header mc-order-edit-modal__header border-0">
                <h2 class="modal-title h5 mb-0 mc-order-edit-modal__title" id="mcOrderEditModalLabel">Modifier la commande</h2>
                <button type="button" class="btn-close btn-close-white mc-order-edit-modal__close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body mc-order-edit-modal__body p-0" id="mcOrderEditModalBody">
                <div class="mc-order-edit-modal__loading p-4 text-center mc-muted">Chargement…</div>
            </div>
        </div>
    </div>
</div>

<script>
(function () {
    var editModalEl = document.getElementById('mcOrderEditModal');
    var editBodyEl = document.getElementById('mcOrderEditModalBody');
    if (!editModalEl || !editBodyEl) {
        return;
    }

    editModalEl.addEventListener('show.bs.modal', function (event) {
        var btn = event.relatedTarget;
        var url = btn && btn.getAttribute('data-mc-order-edit-url');
        if (!url) {
            return;
        }
        editBodyEl.innerHTML = '<div class="mc-order-edit-modal__loading p-4 text-center mc-muted">Chargement…</div>';
        fetch(url, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            credentials: 'same-origin'
        })
            .then(function (r) {
                if (!r.ok) {
                    throw new Error('load');
                }
                return r.text();
            })
            .then(function (html) {
                editBodyEl.innerHTML = html;
            })
            .catch(function () {
                editBodyEl.innerHTML = '<div class="p-4 text-center mc-order-detail-modal__err">Impossible de charger le formulaire.</div>';
            });
    });

    editModalEl.addEventListener('hidden.bs.modal', function () {
        editBodyEl.innerHTML = '<div class="mc-order-edit-modal__loading p-4 text-center mc-muted">Chargement…</div>';
    });

    editBodyEl.addEventListener('submit', function (e) {
        var form = e.target;
        if (form.tagName !== 'FORM' || !form.getAttribute('data-mc-order-edit-form')) {
            return;
        }
        e.preventDefault();
        var submitBtn = form.querySelector('button[type="submit"], input[type="submit"]');
        if (submitBtn) {
            submitBtn.disabled = true;
        }
        fetch(form.getAttribute('action') || form.action, {
            method: 'POST',
            body: new FormData(form),
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                Accept: 'application/json'
            },
            credentials: 'same-origin'
        })
            .then(function (r) {
                var ct = (r.headers.get('content-type') || '').toLowerCase();
                if (r.ok && ct.indexOf('application/json') !== -1) {
                    return r.json().then(function (data) {
                        if (data && data.ok) {
                            var em = window.bootstrap && window.bootstrap.Modal.getInstance(editModalEl);
                            if (em) {
                                em.hide();
                            }
                            var dm = document.getElementById('mcOrderDetailModal');
                            if (dm && window.bootstrap) {
                                var di = window.bootstrap.Modal.getInstance(dm);
                                if (di) {
                                    di.hide();
                                }
                            }
                            window.location.reload();
                        }
                    });
                }
                if (r.status === 422) {
                    return r.text().then(function (html) {
                        editBodyEl.innerHTML = html;
                    });
                }
                throw new Error('save');
            })
            .catch(function () {
                window.alert('Enregistrement impossible. Réessayez ou actualisez la page.');
            })
            .finally(function () {
                if (submitBtn) {
                    submitBtn.disabled = false;
                }
            });
    });
})();
</script>
