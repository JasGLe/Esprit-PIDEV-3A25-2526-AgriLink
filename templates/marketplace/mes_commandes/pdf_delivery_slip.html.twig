<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Bon de livraison #CMD{{ "%03d"|format(commande.id) }}</title>
    <style>
        body { font-family: DejaVu Sans, Arial, sans-serif; color: #111827; font-size: 12px; }
        .header { border-bottom: 2px solid #0d9488; padding-bottom: 10px; margin-bottom: 14px; }
        .title { font-size: 20px; font-weight: 700; color: #0f766e; margin: 0; }
        .muted { color: #6b7280; }
        .grid { display: table; width: 100%; margin-bottom: 14px; }
        .col { display: table-cell; width: 50%; vertical-align: top; }
        .card { border: 1px solid #e5e7eb; border-radius: 8px; padding: 10px; margin-right: 8px; }
        .card h3 { margin: 0 0 8px; font-size: 13px; color: #111827; }
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th, td { border: 1px solid #e5e7eb; padding: 7px; text-align: left; }
        th { background: #f3f4f6; font-size: 11px; text-transform: uppercase; }
        .text-end { text-align: right; }
        .qr-block { margin-top: 20px; padding-top: 16px; border-top: 1px dashed #cbd5e1; text-align: center; }
        .qr-block img { width: 200px; height: 200px; }
        .qr-caption { font-size: 11px; color: #475569; margin-top: 8px; max-width: 360px; margin-left: auto; margin-right: auto; }
        .status-line { margin-top: 10px; font-size: 12px; }
    </style>
</head>
<body>
    <div class="header">
        <p class="title">Bon de livraison</p>
        <p class="muted">Référence: #CMD{{ "%03d"|format(commande.id) }} | Date commande: {{ commande.dateCommande|date('Y-m-d') }} | Statut: {{ commande.status }}</p>
    </div>

    <div class="grid">
        <div class="col">
            <div class="card">
                <h3>Destinataire</h3>
                <div>{{ commande.prenom }} {{ commande.nom }}</div>
                <div class="muted">{{ commande.telephone ?: '—' }}</div>
                <div class="muted">{{ commande.email ?: '—' }}</div>
            </div>
        </div>
        <div class="col">
            <div class="card">
                <h3>Adresse de livraison</h3>
                <div>{{ commande.adresse ?: '—' }}</div>
                {% if commande.complement %}<div class="muted">{{ commande.complement }}</div>{% endif %}
                <div class="muted">{{ [commande.codePostal, commande.ville]|filter(v => v)|join(' ') }}</div>
            </div>
        </div>
    </div>

    <table>
        <thead>
            <tr>
                <th>Produit</th>
                <th class="text-end">Qté</th>
                <th class="text-end">Prix unit.</th>
                <th class="text-end">Total</th>
            </tr>
        </thead>
        <tbody>
            {% for l in lignes %}
                <tr>
                    <td>{{ l.nomProduit }}</td>
                    <td class="text-end">{{ l.quantite }}</td>
                    <td class="text-end">{{ l.prixUnitaire|number_format(3, ',', ' ') }} DT</td>
                    <td class="text-end">{{ l.prixTotal|number_format(3, ',', ' ') }} DT</td>
                </tr>
            {% else %}
                <tr><td colspan="4">Aucune ligne.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    {% set total_to_display = montant_vendeur is not null ? montant_vendeur : commande.prixTotal %}
    <p class="status-line"><strong>Total (aperçu facture)</strong> : {{ total_to_display|number_format(3, ',', ' ') }} DT</p>

    {% if delivery_qr_data_uri is defined and delivery_qr_data_uri != '' %}
        <div class="qr-block">
            <img src="{{ delivery_qr_data_uri }}" alt="QR confirmation livraison">
            <p class="qr-caption">Scannez ce code avec un smartphone pour ouvrir la page de confirmation de livraison (sans connexion). Après remise du colis, le livreur ou le client peut valider pour passer la commande en <strong>livrée</strong>.</p>
        </div>
    {% endif %}
</body>
</html>
