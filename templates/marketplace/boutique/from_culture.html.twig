{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Mettre en vente — {{ culture.nom }}{% endblock %}
{% block page_title %}Mettre en vente{% endblock %}

{% block dashboard_content %}
    <nav aria-label="Fil d'Ariane" class="mb-3">
        <ol class="breadcrumb small mb-0">
            <li class="breadcrumb-item"><a href="{{ path('exploitation_index') }}" class="text-success text-decoration-none">Mes exploitations</a></li>
            <li class="breadcrumb-item"><a href="{{ path('boutique_index') }}" class="text-success text-decoration-none">Ma boutique</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nouvelle annonce</li>
        </ol>
    </nav>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-start gap-3 mb-4">
                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width:3rem;height:3rem;background:rgba(34,197,94,0.15);">
                    <svg style="width:1.5rem;height:1.5rem;color:#16a34a;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                </div>
                <div>
                    <h2 class="h5 fw-bold text-dark mb-1">Publier dans votre boutique</h2>
                    <p class="small text-muted mb-0">Culture : <strong>{{ culture.nom }}</strong> — l’annonce reste privée à votre espace (pas sur le marché public).</p>
                </div>
            </div>

            {{ form_start(form, { attr: { class: 'boutique-culture-vente-form js-price-optimizer-form', novalidate: 'novalidate', 'data-price-optimizer-url': path('boutique_price_optimizer_suggest') } }) }}
            <div class="row g-3">
                <div class="col-md-6">
                    {{ form_row(form.nom) }}
                </div>
                <div class="col-md-6">
                    {{ form_row(form.category) }}
                </div>
                <div class="col-md-4">
                    {{ form_row(form.uniteVente) }}
                </div>
                <div class="col-md-4">
                    {{ form_row(form.prixUnitaire) }}
                    <div id="aiPriceSuggestBox" class="small rounded-3 p-2 border bg-light d-none js-ai-price-box">
                        <div class="fw-semibold text-success mb-1">Suggestion prix</div>
                        <div id="aiPriceSuggestText" class="text-muted js-ai-price-text"></div>
                        <button type="button" id="applyAiPriceBtn" class="btn btn-sm btn-outline-success mt-2 d-none js-ai-price-apply">Appliquer ce prix</button>
                    </div>
                </div>
                <div class="col-md-4">
                    {{ form_row(form.quantite) }}
                </div>
                <div class="col-12">
                    {{ form_row(form.description) }}
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-4">
                <button type="submit" class="btn btn-success fw-semibold px-4">
                    <svg style="width:1rem;height:1rem;" class="me-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    Publier / Mettre en boutique
                </button>
                <a href="{{ path('exploitation_index') }}" class="btn btn-outline-secondary">Annuler</a>
            </div>
            {{ form_end(form) }}
        </div>
    </div>

    <script>
    (function () {
        const nomInput = document.getElementById('{{ form.nom.vars.id }}');
        const catInput = document.getElementById('{{ form.category.vars.id }}');
        const unitInput = document.getElementById('{{ form.uniteVente.vars.id }}');
        const qtyInput = document.getElementById('{{ form.quantite.vars.id }}');
        const priceInput = document.getElementById('{{ form.prixUnitaire.vars.id }}');
        const form = document.querySelector('.js-price-optimizer-form');
        const url = form ? (form.getAttribute('data-price-optimizer-url') || '') : '';
        const box = document.getElementById('aiPriceSuggestBox');
        const txt = document.getElementById('aiPriceSuggestText');
        const applyBtn = document.getElementById('applyAiPriceBtn');
        if (!nomInput || !catInput || !unitInput || !qtyInput || !priceInput || !box || !txt || !applyBtn || !url) return;

        let lastSuggested = null;
        let timer = null;

        async function askSuggestion() {
            const payload = {
                nom: nomInput.value || '',
                category: catInput.value || '',
                uniteVente: unitInput.value || '',
                quantite: parseInt(qtyInput.value || '0', 10)
            };
            if (!payload.category || payload.quantite <= 0) {
                box.classList.add('d-none');
                return;
            }
            try {
                const res = await fetch(url, {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (!data || data.ok !== true) {
                    box.classList.add('d-none');
                    return;
                }
                lastSuggested = data.suggestedPrice;
                txt.textContent = 'Prix suggere: ' + data.suggestedPrice.toFixed(3) + ' DT (moyenne marche: ' + data.marketAverage.toFixed(3) + ' DT, confiance: ' + data.confidence + '%)';
                applyBtn.classList.remove('d-none');
                box.classList.remove('d-none');
            } catch (e) {
                box.classList.add('d-none');
            }
        }

        function scheduleSuggest() {
            if (timer) clearTimeout(timer);
            timer = setTimeout(askSuggestion, 450);
        }

        [nomInput, catInput, unitInput, qtyInput].forEach((el) => {
            el.addEventListener('input', scheduleSuggest);
            el.addEventListener('change', scheduleSuggest);
        });

        applyBtn.addEventListener('click', function () {
            if (lastSuggested !== null) {
                priceInput.value = Number(lastSuggested).toFixed(3);
            }
        });

        askSuggestion();
    })();
    </script>
{% endblock %}
