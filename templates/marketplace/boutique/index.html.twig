{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Ma Boutique — AgriLink{% endblock %}
{% block page_title %}Ma Boutique{% endblock %}

{% block dashboard_content %}
    <style>
    .boutique-page .boutique-media {
    aspect-ratio: 4 / 3;
    max-height: 145px;
    background: linear-gradient(145deg, #1a4731 0%, #166534 30%, #15803d 60%, #3f6212 100%);
    border-bottom: 1px solid #166534;
    box-shadow: inset 0 -2px 8px rgba(0,0,0,0.12);
}
    .boutique-hero {
        background: linear-gradient(135deg, #bbf7d0 0%, #d9f99d 40%, #fef08a 80%, #bbf7d0 100%);
        border: 1px solid #86efac;
        border-radius: .95rem;
        padding: .9rem 1rem;
        margin-bottom: .95rem;
        box-shadow: 0 6px 24px rgba(22, 163, 74, 0.18);
    }
    .boutique-hero__title {
        font-size: 1rem;
        font-weight: 700;
        color: #14532d;
        margin-bottom: .2rem;
        letter-spacing: -.01em;
    }
    .boutique-hero__lead {
        margin: 0;
        font-size: .84rem;
        color: #166534;
        line-height: 1.45;
    }
    .boutique-hero__lead strong {
        color: #15803d;
        font-weight: 700;
    }
    .boutique-chip {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        border-radius: 999px;
        padding: .2rem .55rem;
        font-size: .72rem;
        font-weight: 700;
    }
    .boutique-chip--active {
        color: #14532d;
        background: #86efac;
        border: 1px solid #4ade80;
    }
    .boutique-chip--hidden {
        color: #78716c;
        background: #fef08a;
        border: 1px solid #fde047;
    }
    .boutique-actions-top .btn {
        border-radius: .72rem;
        font-size: .78rem;
        font-weight: 700;
        padding: .48rem .8rem;
        transition: all .18s ease;
        border-width: 1px;
    }
    .boutique-btn-marketplace {
        background: linear-gradient(135deg, #4ade80 0%, #22c55e 50%, #16a34a 100%);
        color: #052e16 !important;
        border-color: rgba(22, 163, 74, 0.4) !important;
        box-shadow: 0 4px 14px rgba(22, 163, 74, 0.30);
    }
    .boutique-btn-marketplace:hover {
        filter: brightness(1.05);
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(22, 163, 74, 0.40);
    }
    .boutique-btn-return {
        background: #ffffff;
        color: #15803d !important;
        border-color: #4ade80 !important;
        box-shadow: 0 2px 8px rgba(34, 197, 94, 0.12);
    }
    .boutique-btn-return:hover {
        background: #dcfce7;
        color: #14532d !important;
        transform: translateY(-1px);
    }
    .boutique-page .boutique-card {
        border: 1px solid #86efac;
        border-radius: 0.9rem;
        background: linear-gradient(160deg, #ffffff 0%, #f0fdf4 50%, #fefce8 100%);
        box-shadow: 0 4px 14px rgba(22, 163, 74, 0.10);
        transition: transform .18s ease, box-shadow .18s ease;
    }
    .boutique-page .boutique-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 24px rgba(22, 163, 74, 0.18);
        border-color: #22c55e;
    }
    .boutique-page .boutique-media {
        aspect-ratio: 4 / 3;
        max-height: 145px;
        background: linear-gradient(135deg, #bbf7d0 0%, #d9f99d 50%, #fef08a 100%);
        border-bottom: 1px solid #86efac;
    }
    .boutique-page .boutique-card .card-body {
        padding: .72rem .78rem;
    }
    .boutique-page .boutique-card .h6 {
        font-size: 1rem;
        margin-bottom: .15rem;
    }
    .boutique-page .boutique-card .small {
        font-size: .78rem !important;
    }
    .boutique-page .boutique-actions .btn {
        padding: .26rem .5rem;
        font-size: .75rem;
    }
</style>

    <div class="boutique-page">
    <div class="boutique-hero">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3">
            <div>
                <h2 class="boutique-hero__title">Gérez vos produits en toute simplicité</h2>
                <p class="boutique-hero__lead mb-2">Retrouvez ici toutes vos annonces boutique, mettez-les à jour rapidement et contrôlez leur visibilité.</p>
                <div class="d-flex flex-wrap gap-2">
                    <span class="boutique-chip boutique-chip--active">● Actif : visible sur le Marketplace</span>
                    <span class="boutique-chip boutique-chip--hidden">● Masqué : visible uniquement dans votre espace</span>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 boutique-actions-top">
                <a href="{{ path('marketplace_index') }}" class="btn boutique-btn-marketplace">
                    <svg style="width:1rem;height:1rem;" class="me-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                    Voir Marketplace
                </a>
                <a href="{{ path('exploitation_index') }}" class="btn boutique-btn-return">
                    ← Retour
                </a>
            </div>
        </div>
    </div>

    <p class="small text-muted mb-4">
        {{ produits|length }} annonce{{ produits|length > 1 ? 's' : '' }} dans votre boutique.
    </p>

    {% if produits is empty %}
        <div class="text-center py-5 rounded-3 border border-dashed border-secondary bg-white shadow-sm">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width:4rem;height:4rem;background:rgba(34,197,94,0.12);">
                <svg style="width:2rem;height:2rem;color:#16a34a;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3C9 3 5 6 5 10c0 2.5 1.5 4.5 3 6l1 5h6l1-5c1.5-1.5 3-3.5 3-6 0-4-4-7-7-7z"/>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 21h6M12 3v2M7.5 6.5l1 1M16.5 6.5l-1 1"/>
</svg>
            </div>
            <p class="text-muted mb-3">Aucune annonce pour le moment.</p>
            <p class="small text-muted mb-0">Depuis <strong>Mes exploitations</strong>, ouvrez une culture et cliquez sur <strong>Mettre en vente</strong>.</p>
        </div>
    {% else %}
        <div class="row g-3">
            {% for p in produits %}
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card boutique-card h-100 overflow-hidden">
                        <div class="ratio ratio-4x3 boutique-media d-flex align-items-center justify-content-center">
                            {% if p.image and p.image|trim != '' %}
                                <img src="{{ uploads_base_url }}/cultures/{{ p.image }}"
                                     alt="{{ p.nom }}"
                                     class="object-fit-cover w-100 h-100"
                                     onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'fs-1 text-success',textContent:'🌱'}))">
                            {% else %}
                               <svg style="width:3rem;height:3rem;color:#4ade80;opacity:.85;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2C9 2 5 5.5 5 9.5c0 2.8 1.5 5.2 4 6.8V19h6v-2.7c2.5-1.6 4-4 4-6.8C19 5.5 15 2 12 2z"/>
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19h6M12 2v4M7 7l1.5 1.5M17 7l-1.5 1.5"/>
</svg>
                            {% endif %}
                        </div>
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center gap-2 mb-2 small">
                                {% if p.active %}
                                    <span class="badge rounded-pill bg-success-subtle text-success">● Actif</span>
                                {% else %}
                                    <span class="badge rounded-pill bg-secondary-subtle text-secondary">Masqué</span>
                                {% endif %}
                                <span class="text-muted">{{ p.quantite }} en stock</span>
                            </div>
                            <h3 class="h6 fw-bold text-dark mb-1">{{ p.nom }}</h3>
                            {% set cat_parts = ' · ' in p.categorie ? p.categorie|split(' · ', 2) : [p.categorie] %}
                            <p class="small text-muted mb-2">{{ cat_parts[0] }}</p>
                            <p class="fw-bold text-success mb-3">{{ p.prixUnitaire|number_format(3, ',', ' ') }} DT{% if cat_parts[1] is defined %} / {{ cat_parts[1] }}{% endif %}</p>
                            {% if p.description %}
                                <p class="small text-muted flex-grow-1 mb-3">{{ p.description|length > 120 ? p.description|slice(0, 117) ~ '…' : p.description }}</p>
                            {% endif %}
                            <div class="d-flex flex-wrap gap-1 mt-auto boutique-actions">
                                <form action="{{ path('boutique_produit_basculer', {id: p.id}) }}" method="post" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('boutique_visible' ~ p.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        {% if p.active %}
                                            <svg style="width:0.9rem;height:0.9rem;" class="me-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
                                            Masquer
                                        {% else %}
                                            <svg style="width:0.9rem;height:0.9rem;" class="me-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                            Activer
                                        {% endif %}
                                    </button>
                                </form>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary boutique-edit-open"
                                        title="Modifier"
                                        data-url="{{ path('boutique_produit_modifier_fragment', {id: p.id}) }}">
                                    <svg style="width:0.9rem;height:0.9rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                </button>
                                <form action="{{ path('boutique_produit_supprimer', {id: p.id}) }}" method="post" class="d-inline js-boutique-delete-form" data-boutique-product="{{ p.nom|e('html_attr') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('boutique_supprimer' ~ p.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                        <svg style="width:0.9rem;height:0.9rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
    </div>

    {# Modal modifier l’annonce (reste sur /boutique) #}
    <div class="modal fade" id="modalEditBoutiqueAnnonce" tabindex="-1" aria-labelledby="modalEditBoutiqueAnnonceLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 bg-transparent shadow-none">
                <div id="modalEditBoutiqueAnnonceBody" class="p-0">
                    <div class="text-center py-5 text-muted small">Chargement…</div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalBoutiqueDeleteConfirm" tabindex="-1" aria-labelledby="modalBoutiqueDeleteConfirmLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content boutique-confirm__content border-0 shadow-lg">
                <div class="modal-header boutique-confirm__header border-0">
                    <h2 class="modal-title h6 mb-0 boutique-confirm__title" id="modalBoutiqueDeleteConfirmLabel">
                        <span class="boutique-confirm__icon" aria-hidden="true">🗑️</span>
                        Supprimer l’annonce
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body boutique-confirm__body">
                    <p class="mb-0">Cette action est définitive.</p>
                    <p class="mb-0 text-muted small">Annonce : <strong class="js-boutique-delete-name">—</strong></p>
                </div>
                <div class="modal-footer boutique-confirm__footer border-0">
                    <button type="button" class="btn btn-sm btn-outline-secondary boutique-confirm__btn-cancel" data-bs-dismiss="modal">Annuler</button>
                    <button type="button" class="btn btn-sm btn-danger boutique-confirm__btn-confirm js-boutique-delete-confirm">Supprimer</button>
                </div>
            </div>
        </div>
    </div>

    <script>
    (function () {
        const modalEl = document.getElementById('modalEditBoutiqueAnnonce');
        const bodyEl = document.getElementById('modalEditBoutiqueAnnonceBody');
        const boutiqueUrl = {{ path('boutique_index')|json_encode|raw }};

        if (!modalEl || !bodyEl || typeof bootstrap === 'undefined') {
            return;
        }

        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

        document.body.addEventListener('click', async function (e) {
            const btn = e.target.closest('.boutique-edit-open');
            if (!btn) {
                return;
            }
            e.preventDefault();
            const url = btn.getAttribute('data-url');
            if (!url) {
                return;
            }
            bodyEl.innerHTML = '<div class="text-center py-5 text-muted small">Chargement…</div>';
            modal.show();
            try {
                const res = await fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin',
                });
                if (!res.ok) {
                    throw new Error('HTTP ' + res.status);
                }
                bodyEl.innerHTML = await res.text();
            } catch (err) {
                bodyEl.innerHTML = '<div class="alert alert-danger m-3 mb-0">Impossible de charger le formulaire. Réessayez.</div>';
            }
        });

        document.body.addEventListener('submit', async function (e) {
            const form = e.target;
            if (!form.matches || !form.matches('form.boutique-edit-form')) {
                return;
            }
            e.preventDefault();
            try {
                const res = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin',
                });
                const ct = res.headers.get('content-type') || '';
                if (ct.includes('application/json')) {
                    const data = await res.json();
                    if (data.redirect) {
                        window.location.href = data.redirect;
                    }
                    return;
                }
                if (res.status === 422) {
                    bodyEl.innerHTML = await res.text();
                    return;
                }
                if (res.ok || res.redirected) {
                    window.location.href = boutiqueUrl;
                }
            } catch (err) {
                bodyEl.innerHTML = '<div class="alert alert-danger m-3 mb-0">Erreur lors de l’enregistrement.</div>';
            }
        });

        modalEl.addEventListener('hidden.bs.modal', function () {
            bodyEl.innerHTML = '<div class="text-center py-5 text-muted small">Chargement…</div>';
        });
    })();
    </script>

    <style>
        .boutique-confirm__content { border-radius: 1rem; overflow: hidden; }
        .boutique-confirm__header { background: linear-gradient(90deg, rgba(220,38,38,0.10), rgba(245,158,11,0.06)); }
        .boutique-confirm__title { display:flex; align-items:center; gap:.5rem; font-weight:700; }
        .boutique-confirm__icon { width:1.8rem; height:1.8rem; border-radius:.6rem; display:inline-flex; align-items:center; justify-content:center; background:rgba(220,38,38,0.10); }
        .boutique-confirm__body { padding: 1rem 1rem 0.75rem; }
        .boutique-confirm__footer { padding: 0.75rem 1rem 1rem; display:flex; gap:.5rem; }
        .boutique-confirm__btn-confirm { border-radius: .6rem; }
        .boutique-confirm__btn-cancel { border-radius: .6rem; }
    </style>

    <script>
    (function () {
        const modalEl = document.getElementById('modalBoutiqueDeleteConfirm');
        if (!modalEl || typeof bootstrap === 'undefined' || !bootstrap.Modal) return;

        const modal = bootstrap.Modal.getOrCreateInstance(modalEl, { backdrop: 'static' });
        const nameEl = modalEl.querySelector('.js-boutique-delete-name');
        const confirmBtn = modalEl.querySelector('.js-boutique-delete-confirm');
        let pendingForm = null;

        document.addEventListener('submit', function (event) {
            const form = event.target;
            if (!(form instanceof HTMLFormElement)) return;
            if (!form.classList.contains('js-boutique-delete-form')) return;

            event.preventDefault();
            pendingForm = form;
            if (nameEl) {
                nameEl.textContent = form.getAttribute('data-boutique-product') || 'cette annonce';
            }
            modal.show();
        }, true);

        if (confirmBtn) {
            confirmBtn.addEventListener('click', function () {
                if (!pendingForm) { modal.hide(); return; }
                const form = pendingForm;
                pendingForm = null;
                modal.hide();
                form.submit();
            });
        }

        modalEl.addEventListener('hidden.bs.modal', function () {
            pendingForm = null;
        });
    })();
    </script>
{% endblock %}
