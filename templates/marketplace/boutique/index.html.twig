    <script>
    (function () {
        const promoBtn = document.getElementById('boutiquePromoBtn');
        const promoBtnCount = document.getElementById('boutiquePromoBtnCount');
        const modalEl = document.getElementById('modalAddPromoCode');
        const formEl = document.getElementById('boutiquePromoForm');
        const selectedCountEl = document.getElementById('promoModalSelectedCount');
        const stateHintEl = document.getElementById('promoModalStateHint');
        const codeInput = formEl ? formEl.querySelector('input[name$="[code]"]') : null;
        const discountInput = formEl ? formEl.querySelector('input[name$="[discount_percent]"]') : null;
        const startInput = formEl ? formEl.querySelector('input[name$="[start_date]"]') : null;
        const endInput = formEl ? formEl.querySelector('input[name$="[end_date]"]') : null;
        const selectedIds = new Set();
        let productIdsInput = document.getElementById('boutiquePromoProductIds');
        const shouldKeepServerValues = formEl && formEl.getAttribute('data-server-errors') === '1';

        if (!promoBtn) return;
        if (!productIdsInput && formEl) {
            productIdsInput = formEl.querySelector('input[name$="[product_ids]"]');
        }
        if (!productIdsInput && formEl) {
            productIdsInput = document.createElement('input');
            productIdsInput.type = 'hidden';
            productIdsInput.name = 'promo_code_assign[product_ids]';
            productIdsInput.id = 'boutiquePromoProductIds';
            formEl.appendChild(productIdsInput);
        }
        if (!productIdsInput) return;

        if (productIdsInput.value) {
            productIdsInput.value
                .split(',')
                .map(v => parseInt(v.trim(), 10))
                .filter(v => Number.isFinite(v) && v > 0)
                .forEach(v => selectedIds.add(v));
        }

        function getSelectedIds() {
            return Array.from(selectedIds.values());
        }

        function syncUI() {
            const ids = getSelectedIds();
            promoBtn.classList.toggle('is-visible', ids.length > 0);
            if (promoBtnCount) {
                promoBtnCount.textContent = ids.length > 0 ? '(' + ids.length + ')' : '';
            }
            if (selectedCountEl) {
                selectedCountEl.textContent = ids.length + ' produit' + (ids.length > 1 ? 's' : '') + ' sélectionné' + (ids.length > 1 ? 's' : '');
            }
            document.querySelectorAll('.boutique-item').forEach(card => {
                const pid = parseInt(card.getAttribute('data-produit-id') || '0', 10);
                card.classList.toggle('is-selected', ids.includes(pid));
            });
        }

        function sameValue(values) {
            if (!values.length) return null;
            const first = values[0];
            for (const value of values) {
                if (String(value || '') !== String(first || '')) return null;
            }
            return first || '';
        }

        function selectedCards() {
            const ids = getSelectedIds();
            return Array.from(document.querySelectorAll('.boutique-item')).filter((card) => {
                const pid = parseInt(card.getAttribute('data-produit-id') || '0', 10);
                return ids.includes(pid);
            });
        }

        function hydratePromoForm() {
            const cards = selectedCards();
            const codes = cards.map((c) => c.getAttribute('data-promo-code') || '');
            const discounts = cards.map((c) => c.getAttribute('data-promo-discount') || '');
            const starts = cards.map((c) => c.getAttribute('data-promo-start') || '');
            const ends = cards.map((c) => c.getAttribute('data-promo-end') || '');
            const hasExpired = cards.some((c) => c.getAttribute('data-promo-expired') === '1');

            const commonCode = sameValue(codes);
            const commonDiscount = sameValue(discounts);
            const commonStart = sameValue(starts);
            const commonEnd = sameValue(ends);

            if (codeInput) codeInput.value = commonCode !== null ? commonCode : '';
            if (discountInput) discountInput.value = commonDiscount !== null ? commonDiscount : '';
            if (startInput) startInput.value = commonStart !== null ? commonStart : '';
            if (endInput) endInput.value = commonEnd !== null ? commonEnd : '';
            syncDateGuards();

            if (!stateHintEl) return;
            stateHintEl.classList.remove('d-none', 'is-warning');
            if (hasExpired) {
                stateHintEl.classList.add('is-warning');
                stateHintEl.innerHTML = '<span aria-hidden="true">⚠</span><span>Au moins un code est expiré. Mettez à jour les dates et enregistrez pour le réactiver.</span>';
            } else if (cards.length > 0 && commonCode !== null && commonCode !== '') {
                stateHintEl.innerHTML = '<span aria-hidden="true">✎</span><span>Code existant détecté : vous pouvez le modifier.</span>';
            } else {
                stateHintEl.classList.add('d-none');
                stateHintEl.textContent = '';
            }
        }

        function syncDateGuards() {
            if (!startInput || !endInput) return;
            const startVal = startInput.value || '';
            if (startVal !== '') {
                endInput.min = startVal;
                if (endInput.value && endInput.value <= startVal) {
                    endInput.value = '';
                }
            }
        }

        document.querySelectorAll('.boutique-item').forEach(function (card) {
            card.addEventListener('click', function (e) {
                if (
                    e.target.closest('form') ||
                    e.target.closest('button') ||
                    e.target.closest('a') ||
                    e.target.closest('input') ||
                    e.target.closest('select') ||
                    e.target.closest('textarea')
                ) {
                    return;
                }
                const pid = parseInt(card.getAttribute('data-produit-id') || '0', 10);
                if (!Number.isFinite(pid) || pid <= 0) return;
                if (selectedIds.has(pid)) {
                    selectedIds.delete(pid);
                } else {
                    selectedIds.add(pid);
                }
                syncUI();
            });
        });

        if (modalEl) {
            modalEl.addEventListener('show.bs.modal', function () {
                productIdsInput.value = getSelectedIds().join(',');
                if (!shouldKeepServerValues) {
                    hydratePromoForm();
                }
            });
        }

        if (formEl) {
            if (startInput) {
                startInput.addEventListener('change', syncDateGuards);
            }
            formEl.addEventListener('submit', function () {
                productIdsInput.value = getSelectedIds().join(',');
            });
        }

        syncUI();

        {% if open_promo_modal|default(false) %}
        if (modalEl && typeof bootstrap !== 'undefined' && bootstrap.Modal) {
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
        }
        {% endif %}
    })();
    </script>

    <script>
    (function () {
        const confirmEl = document.getElementById('modalConfirmRental');
        const rentalEl = document.getElementById('modalRentalForm');
        const rentalForm = document.getElementById('boutiqueRentalForm');
        const confirmName = document.getElementById('rentalConfirmProductName');
        const formName = document.getElementById('rentalFormProductName');
        const continueBtn = document.getElementById('rentalConfirmContinueBtn');
        if (!confirmEl || !rentalEl || !continueBtn || typeof bootstrap === 'undefined') return;

        function resolveHiddenPidInput() {
            return document.getElementById('rentalProductIdInput')
                || (rentalForm ? rentalForm.querySelector('input[name$="[product_id]"]') : null);
        }

        const confirmModal = bootstrap.Modal.getOrCreateInstance(confirmEl);
        const rentalModal = bootstrap.Modal.getOrCreateInstance(rentalEl);
        let pending = { id: null, name: 'cet équipement' };
        let shouldOpenRentalAfterConfirm = false;

        function setPendingFromButton(btn) {
            if (!btn) return;
            const id = parseInt(btn.getAttribute('data-produit-id') || '0', 10);
            const name = btn.getAttribute('data-produit-nom') || 'cet équipement';
            if (!id || id < 1) return;
            pending = { id: id, name: name };
            confirmEl.setAttribute('data-rental-product-id', String(id));
            confirmEl.setAttribute('data-rental-product-name', name);
            if (confirmName) confirmName.textContent = pending.name;
        }

        document.addEventListener('click', function (event) {
            const btn = event.target.closest('.boutique-rental-open');
            if (!btn) return;
            setPendingFromButton(btn);
        });

        confirmEl.addEventListener('show.bs.modal', function (event) {
            const trigger = event.relatedTarget;
            setPendingFromButton(trigger);
        });

        continueBtn.addEventListener('click', function () {
            const modalPid = parseInt(confirmEl.getAttribute('data-rental-product-id') || '0', 10);
            const modalPname = confirmEl.getAttribute('data-rental-product-name') || pending.name || 'cet équipement';
            const finalPid = (modalPid && modalPid > 0) ? modalPid : pending.id;
            const finalName = modalPname || pending.name || 'cet équipement';
            if (!finalPid || finalPid < 1) return;
            const hiddenPidInput = resolveHiddenPidInput();
            if (!hiddenPidInput) return;
            hiddenPidInput.value = String(finalPid);
            if (formName) formName.textContent = finalName;
            shouldOpenRentalAfterConfirm = true;
            confirmModal.hide();
        });

        confirmEl.addEventListener('hidden.bs.modal', function () {
            if (!shouldOpenRentalAfterConfirm) return;
            shouldOpenRentalAfterConfirm = false;
            rentalModal.show();
        });

        const serverHiddenPidInput = resolveHiddenPidInput();
        if (rentalForm && rentalForm.getAttribute('data-server-errors') === '1' && serverHiddenPidInput && serverHiddenPidInput.value) {
            const card = document.querySelector('.boutique-item[data-produit-id="' + serverHiddenPidInput.value + '"]');
            const name = card ? (card.getAttribute('data-produit-nom') || 'cet équipement') : 'cet équipement';
            if (formName) formName.textContent = name;
            rentalModal.show();
        }
    })();
    </script>

