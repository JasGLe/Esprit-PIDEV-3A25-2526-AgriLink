    <script>
    (function () {
        function initPriceOptimizer(root) {
            const scope = root || document;
            const forms = scope.querySelectorAll('.js-price-optimizer-form');
            forms.forEach((form) => {
                if (form.dataset.aiPriceBound === '1') {
                    return;
                }
                form.dataset.aiPriceBound = '1';

                const nomInput = form.querySelector('[id$="_nom"]');
                const catInput = form.querySelector('[id$="_category"]');
                const unitInput = form.querySelector('[id$="_uniteVente"]');
                const qtyInput = form.querySelector('[id$="_quantite"]');
                const priceInput = form.querySelector('[id$="_prixUnitaire"]');
                const box = form.querySelector('.js-ai-price-box');
                const txt = form.querySelector('.js-ai-price-text');
                const applyBtn = form.querySelector('.js-ai-price-apply');
                const url = form.getAttribute('data-price-optimizer-url') || '';
                if (!nomInput || !catInput || !unitInput || !qtyInput || !priceInput || !box || !txt || !applyBtn || !url) {
                    return;
                }

                let lastSuggested = null;
                let timer = null;
                const askSuggestion = async () => {
                    const payload = {
                        nom: nomInput.value || '',
                        category: catInput.value || '',
                        uniteVente: unitInput.value || '',
                        quantite: parseInt(qtyInput.value || '0', 10)
                    };
                    if (!payload.category || payload.quantite <= 0) {
                        box.classList.add('d-none');
                        return;
                    }
                    try {
                        const res = await fetch(url, {
                            method: 'POST',
                            headers: {'Content-Type': 'application/json'},
                            body: JSON.stringify(payload)
                        });
                        const data = await res.json();
                        if (!data || data.ok !== true) {
                            box.classList.add('d-none');
                            return;
                        }
                        lastSuggested = data.suggestedPrice;
                        txt.textContent = 'Prix suggere: ' + Number(data.suggestedPrice).toFixed(3) + ' DT (moyenne marche: ' + Number(data.marketAverage).toFixed(3) + ' DT, confiance: ' + data.confidence + '%)';
                        applyBtn.classList.remove('d-none');
                        box.classList.remove('d-none');
                    } catch (e) {
                        box.classList.add('d-none');
                    }
                };

                const schedule = () => {
                    if (timer) clearTimeout(timer);
                    timer = setTimeout(askSuggestion, 400);
                };

                [nomInput, catInput, unitInput, qtyInput].forEach((el) => {
                    el.addEventListener('input', schedule);
                    el.addEventListener('change', schedule);
                });
                applyBtn.addEventListener('click', () => {
                    if (lastSuggested !== null) {
                        priceInput.value = Number(lastSuggested).toFixed(3);
                    }
                });
                askSuggestion();
            });
        }

        window.initPriceOptimizer = initPriceOptimizer;
        initPriceOptimizer(document);
    })();
    </script>

    <script>
    (function () {
        const modalEl = document.getElementById('modalEditBoutiqueAnnonce');
        const bodyEl = document.getElementById('modalEditBoutiqueAnnonceBody');
        const boutiqueUrl = {{ path('boutique_index')|json_encode|raw }};

        if (!modalEl || !bodyEl || typeof bootstrap === 'undefined') {
            return;
        }

        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

        document.body.addEventListener('click', async function (e) {
            const btn = e.target.closest('.boutique-edit-open');
            if (!btn) {
                return;
            }
            e.preventDefault();
            const url = btn.getAttribute('data-url');
            if (!url) {
                return;
            }
            bodyEl.innerHTML = '<div class="text-center py-5 text-muted small">Chargement…</div>';
            modal.show();
            try {
                const res = await fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin',
                });
                if (!res.ok) {
                    throw new Error('HTTP ' + res.status);
                }
                bodyEl.innerHTML = await res.text();
                if (window.initPriceOptimizer) {
                    window.initPriceOptimizer(bodyEl);
                }
            } catch (err) {
                bodyEl.innerHTML = '<div class="alert alert-danger m-3 mb-0">Impossible de charger le formulaire. Réessayez.</div>';
            }
        });

        document.body.addEventListener('submit', async function (e) {
            const form = e.target;
            if (!form.matches || !form.matches('form.boutique-edit-form')) {
                return;
            }
            e.preventDefault();
            try {
                const res = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin',
                });
                const ct = res.headers.get('content-type') || '';
                if (ct.includes('application/json')) {
                    const data = await res.json();
                    if (data.redirect) {
                        window.location.href = data.redirect;
                    }
                    return;
                }
                if (res.status === 422) {
                    bodyEl.innerHTML = await res.text();
                    return;
                }
                if (res.ok || res.redirected) {
                    window.location.href = boutiqueUrl;
                }
            } catch (err) {
                bodyEl.innerHTML = '<div class="alert alert-danger m-3 mb-0">Erreur lors de l’enregistrement.</div>';
            }
        });

        modalEl.addEventListener('hidden.bs.modal', function () {
            bodyEl.innerHTML = '<div class="text-center py-5 text-muted small">Chargement…</div>';
        });
    })();
    </script>

    <script>
    (function () {
        var input = document.getElementById('boutiqueSearchInput');
        var chips = Array.prototype.slice.call(document.querySelectorAll('.boutique-filter__chip'));
        var items = Array.prototype.slice.call(document.querySelectorAll('.boutique-item'));
        var countEl = document.getElementById('boutiqueCount');
        var emptyEl = document.getElementById('boutiqueLiveEmpty');
        var activeCat = 'all';

        function norm(s) {
            return String(s || '').toLowerCase().trim().replace(/\s+/g, ' ');
        }

        function apply() {
            var q = input ? norm(input.value) : '';
            var visible = 0;
            items.forEach(function (el) {
                var name = norm(el.getAttribute('data-bname'));
                var catLabel = norm(el.getAttribute('data-bcatlabel'));
                var cat = el.getAttribute('data-bcat') || 'all';

                var matchCat = activeCat === 'all' || cat === activeCat;
                var matchQ = q === '' || name.indexOf(q) !== -1 || catLabel.indexOf(q) !== -1;
                var show = matchCat && matchQ;
                el.closest('.col-12')?.classList.toggle('d-none', !show);
                if (show) visible += 1;
            });

            if (countEl) countEl.textContent = String(visible);
            if (emptyEl) emptyEl.classList.toggle('d-none', visible > 0);
        }

        if (input) {
            input.addEventListener('input', apply);
            input.addEventListener('search', apply);
        }

        chips.forEach(function (btn) {
            btn.addEventListener('click', function () {
                chips.forEach(function (b) { b.classList.remove('is-active'); });
                btn.classList.add('is-active');
                activeCat = btn.getAttribute('data-bcat') || 'all';
                apply();
            });
        });

        apply();
    })();
    </script>

    <style>
        .boutique-confirm__content { border-radius: 1rem; overflow: hidden; }
        .boutique-confirm__header { background: linear-gradient(90deg, rgba(220,38,38,0.10), rgba(245,158,11,0.06)); }
        .boutique-confirm__title { display:flex; align-items:center; gap:.5rem; font-weight:700; }
        .boutique-confirm__icon { width:1.8rem; height:1.8rem; border-radius:.6rem; display:inline-flex; align-items:center; justify-content:center; background:rgba(220,38,38,0.10); }
        .boutique-confirm__body { padding: 1rem 1rem 0.75rem; }
        .boutique-confirm__footer { padding: 0.75rem 1rem 1rem; display:flex; gap:.5rem; }
        .boutique-confirm__btn-confirm { border-radius: .6rem; }
        .boutique-confirm__btn-cancel { border-radius: .6rem; }
    </style>

    <script>
    (function () {
        const modalEl = document.getElementById('modalBoutiqueDeleteConfirm');
        if (!modalEl || typeof bootstrap === 'undefined' || !bootstrap.Modal) return;

        const modal = bootstrap.Modal.getOrCreateInstance(modalEl, { backdrop: 'static' });
        const nameEl = modalEl.querySelector('.js-boutique-delete-name');
        const confirmBtn = modalEl.querySelector('.js-boutique-delete-confirm');
        let pendingForm = null;

        document.addEventListener('submit', function (event) {
            const form = event.target;
            if (!(form instanceof HTMLFormElement)) return;
            if (!form.classList.contains('js-boutique-delete-form')) return;

            event.preventDefault();
            pendingForm = form;
            if (nameEl) {
                nameEl.textContent = form.getAttribute('data-boutique-product') || 'cette annonce';
            }
            modal.show();
        }, true);

        if (confirmBtn) {
            confirmBtn.addEventListener('click', function () {
                if (!pendingForm) { modal.hide(); return; }
                const form = pendingForm;
                pendingForm = null;
                modal.hide();
                form.submit();
            });
        }

        modalEl.addEventListener('hidden.bs.modal', function () {
            pendingForm = null;
        });
    })();
    </script>
{% endblock %}
