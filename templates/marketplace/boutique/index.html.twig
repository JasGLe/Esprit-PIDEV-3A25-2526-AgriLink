{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Ma Boutique — AgriLink{% endblock %}
{% block page_title %}Ma Boutique{% endblock %}

{% block dashboard_content %}
    <div class="mb-4">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-md-between gap-3">
            <div>
                <p class="text-muted small mb-0">Gérez vos annonces ici. <strong>Actif</strong> = visible sur le <a href="{{ path('marketplace_index') }}" class="text-success text-decoration-none fw-medium">Marketplace</a> public ; <strong>Masqué</strong> = réservé à votre espace.</p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('marketplace_index') }}" class="btn btn-outline-warning btn-sm fw-semibold text-dark border-warning">
                    <svg style="width:1rem;height:1rem;" class="me-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                    Voir le marketplace public
                </a>
                <a href="{{ path('exploitation_index') }}" class="btn btn-outline-success btn-sm fw-medium">
                    ← Retour aux exploitations
                </a>
            </div>
        </div>
    </div>

    <p class="small text-muted mb-4">
        {{ produits|length }} annonce{{ produits|length > 1 ? 's' : '' }} dans votre boutique.
    </p>

    {% if produits is empty %}
        <div class="text-center py-5 rounded-3 border border-dashed border-secondary bg-white shadow-sm">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width:4rem;height:4rem;background:rgba(34,197,94,0.12);">
                <svg style="width:2rem;height:2rem;color:#16a34a;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                </svg>
            </div>
            <p class="text-muted mb-3">Aucune annonce pour le moment.</p>
            <p class="small text-muted mb-0">Depuis <strong>Mes exploitations</strong>, ouvrez une culture et cliquez sur <strong>Mettre en vente</strong>.</p>
        </div>
    {% else %}
        <div class="row g-4">
            {% for p in produits %}
                <div class="col-12 col-sm-6 col-xl-4">
                    <div class="card border-0 shadow-sm h-100 overflow-hidden">
                        <div class="ratio ratio-4x3 bg-light d-flex align-items-center justify-content-center">
                            {% if p.image and p.image|trim != '' %}
                                <img src="{{ uploads_base_url }}/cultures/{{ p.image }}"
                                     alt="{{ p.nom }}"
                                     class="object-fit-cover w-100 h-100"
                                     onerror="this.replaceWith(Object.assign(document.createElement('span'),{className:'fs-1 text-success',textContent:'🌱'}))">
                            {% else %}
                                <span class="fs-1 text-success">🌱</span>
                            {% endif %}
                        </div>
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex align-items-center gap-2 mb-2 small">
                                {% if p.active %}
                                    <span class="badge rounded-pill bg-success-subtle text-success">● Actif</span>
                                {% else %}
                                    <span class="badge rounded-pill bg-secondary-subtle text-secondary">Masqué</span>
                                {% endif %}
                                <span class="text-muted">{{ p.quantite }} en stock</span>
                            </div>
                            <h3 class="h6 fw-bold text-dark mb-1">{{ p.nom }}</h3>
                            {% set cat_parts = ' · ' in p.categorie ? p.categorie|split(' · ', 2) : [p.categorie] %}
                            <p class="small text-muted mb-2">{{ cat_parts[0] }}</p>
                            <p class="fw-bold text-success mb-3">{{ p.prixUnitaire|number_format(3, ',', ' ') }} DT{% if cat_parts[1] is defined %} / {{ cat_parts[1] }}{% endif %}</p>
                            {% if p.description %}
                                <p class="small text-muted flex-grow-1 mb-3">{{ p.description|length > 120 ? p.description|slice(0, 117) ~ '…' : p.description }}</p>
                            {% endif %}
                            <div class="d-flex flex-wrap gap-2 mt-auto">
                                <form action="{{ path('boutique_produit_basculer', {id: p.id}) }}" method="post" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('boutique_visible' ~ p.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                                        {% if p.active %}
                                            <svg style="width:0.9rem;height:0.9rem;" class="me-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
                                            Masquer
                                        {% else %}
                                            <svg style="width:0.9rem;height:0.9rem;" class="me-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                                            Activer
                                        {% endif %}
                                    </button>
                                </form>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary boutique-edit-open"
                                        title="Modifier"
                                        data-url="{{ path('boutique_produit_modifier_fragment', {id: p.id}) }}">
                                    <svg style="width:0.9rem;height:0.9rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                </button>
                                <form action="{{ path('boutique_produit_supprimer', {id: p.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Supprimer cette annonce ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('boutique_supprimer' ~ p.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                                        <svg style="width:0.9rem;height:0.9rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {# Modal modifier l’annonce (reste sur /boutique) #}
    <div class="modal fade" id="modalEditBoutiqueAnnonce" tabindex="-1" aria-labelledby="modalEditBoutiqueAnnonceLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 bg-transparent shadow-none">
                <div id="modalEditBoutiqueAnnonceBody" class="p-0">
                    <div class="text-center py-5 text-muted small">Chargement…</div>
                </div>
            </div>
        </div>
    </div>

    <script>
    (function () {
        const modalEl = document.getElementById('modalEditBoutiqueAnnonce');
        const bodyEl = document.getElementById('modalEditBoutiqueAnnonceBody');
        const boutiqueUrl = {{ path('boutique_index')|json_encode|raw }};

        if (!modalEl || !bodyEl || typeof bootstrap === 'undefined') {
            return;
        }

        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

        document.body.addEventListener('click', async function (e) {
            const btn = e.target.closest('.boutique-edit-open');
            if (!btn) {
                return;
            }
            e.preventDefault();
            const url = btn.getAttribute('data-url');
            if (!url) {
                return;
            }
            bodyEl.innerHTML = '<div class="text-center py-5 text-muted small">Chargement…</div>';
            modal.show();
            try {
                const res = await fetch(url, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin',
                });
                if (!res.ok) {
                    throw new Error('HTTP ' + res.status);
                }
                bodyEl.innerHTML = await res.text();
            } catch (err) {
                bodyEl.innerHTML = '<div class="alert alert-danger m-3 mb-0">Impossible de charger le formulaire. Réessayez.</div>';
            }
        });

        document.body.addEventListener('submit', async function (e) {
            const form = e.target;
            if (!form.matches || !form.matches('form.boutique-edit-form')) {
                return;
            }
            e.preventDefault();
            try {
                const res = await fetch(form.action, {
                    method: 'POST',
                    body: new FormData(form),
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    credentials: 'same-origin',
                });
                const ct = res.headers.get('content-type') || '';
                if (ct.includes('application/json')) {
                    const data = await res.json();
                    if (data.redirect) {
                        window.location.href = data.redirect;
                    }
                    return;
                }
                if (res.status === 422) {
                    bodyEl.innerHTML = await res.text();
                    return;
                }
                if (res.ok || res.redirected) {
                    window.location.href = boutiqueUrl;
                }
            } catch (err) {
                bodyEl.innerHTML = '<div class="alert alert-danger m-3 mb-0">Erreur lors de l’enregistrement.</div>';
            }
        });

        modalEl.addEventListener('hidden.bs.modal', function () {
            bodyEl.innerHTML = '<div class="text-center py-5 text-muted small">Chargement…</div>';
        });
    })();
    </script>
{% endblock %}
