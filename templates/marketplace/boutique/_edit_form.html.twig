<div class="card border-0 shadow-lg overflow-hidden {{ cancel_is_modal|default(false) ? 'd-flex flex-column' : '' }}" style="border-radius:1rem;max-width:100%;{{ cancel_is_modal|default(false) ? ' max-height:min(88vh,640px);' : '' }}">
    <div class="border-0 px-3 py-2 flex-shrink-0"
         style="background:linear-gradient(135deg,#1a1a2e 0%,#16213e 40%,#0f3460 100%);">
        <div class="d-flex align-items-center gap-2">
            <div class="d-flex align-items-center justify-content-center flex-shrink-0 rounded-2"
                 style="width:2rem;height:2rem;background:rgba(255,255,255,0.12);border:1px solid rgba(255,255,255,0.18);">
                <svg width="15" height="15" fill="none" stroke="#fff" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                </svg>
            </div>
            <div class="min-w-0">
                <h2 class="fw-bold mb-0 text-white" style="font-size:0.9rem;">Modifier l’annonce</h2>
                <p class="mb-0 text-truncate" style="color:rgba(255,255,255,0.6);font-size:0.7rem;">
                    {% if culture %}
                        <strong class="text-white">{{ culture.nom }}</strong> · boutique privée
                    {% else %}
                        {{ produit.nom }} · boutique privée
                    {% endif %}
                </p>
            </div>
        </div>
    </div>

    {% if not cancel_is_modal|default(false) %}
    <div class="d-flex gap-2 px-4 py-2 flex-shrink-0"
         style="background:linear-gradient(135deg,#1a1a2e,#0f3460);border-bottom:1px solid rgba(255,255,255,0.06);">
        <span class="px-2 py-1 rounded-pill d-flex align-items-center gap-1"
              style="background:rgba(99,179,237,0.2);font-size:0.65rem;color:#90cdf4;font-weight:600;border:1px solid rgba(99,179,237,0.25);">
            <svg width="8" height="8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            Identification
        </span>
        <span class="px-2 py-1 rounded-pill d-flex align-items-center gap-1"
              style="background:rgba(154,117,234,0.2);font-size:0.65rem;color:#d6bcfa;font-weight:600;border:1px solid rgba(154,117,234,0.25);">
            <svg width="8" height="8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            Tarification
        </span>
        <span class="px-2 py-1 rounded-pill d-flex align-items-center gap-1"
              style="background:rgba(72,187,120,0.2);font-size:0.65rem;color:#9ae6b4;font-weight:600;border:1px solid rgba(72,187,120,0.25);">
            <svg width="8" height="8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            Détails
        </span>
    </div>
    {% endif %}

    {{ form_start(form, {
        action: path('boutique_produit_modifier', {id: produit.id}),
        attr: {
            class: (cancel_is_modal|default(false) ? 'boutique-edit-form d-flex flex-column flex-grow-1 min-vh-0 overflow-hidden' : 'boutique-produit-edit-form') ~ ' js-price-optimizer-form',
            novalidate: 'novalidate',
            'data-price-optimizer-url': path('boutique_price_optimizer_suggest')
        }
    }) }}
    {% if cancel_is_modal|default(false) %}
        <input type="hidden" name="_from_boutique_modal" value="1">
    {% endif %}

    <div class="{{ cancel_is_modal|default(false) ? 'flex-grow-1 overflow-auto min-vh-0 px-3 py-2' : 'px-4 py-3' }}" style="background:#f8fafc;">
        <div class="vstack {{ cancel_is_modal|default(false) ? 'gap-2' : 'gap-3' }}">

            <div class="{{ cancel_is_modal|default(false) ? 'p-2' : 'p-3' }} rounded-3 bg-white border" style="border-color:#e8edf5!important;box-shadow:0 1px 4px rgba(0,0,0,0.04);">
                <p class="text-uppercase fw-bold text-secondary mb-2" style="font-size:0.62rem;letter-spacing:0.06em;">Identification</p>
                <div class="row g-2">
                    <div class="col-md-6">
                        <label class="form-label mb-0 pb-1" style="font-size:0.75rem;font-weight:600;color:#374151;" for="{{ form.nom.vars.id }}">Nom du produit</label>
                        {{ form_widget(form.nom, {attr: (form.nom.vars.attr|default({}))|merge({
                            class: 'form-control form-control-sm',
                            style: culture ? 'background-color:#f1f5f9;cursor:default;' : ''
                        })}) }}
                        {{ form_help(form.nom) }}
                        {{ form_errors(form.nom) }}
                    </div>
                    <div class="col-md-6">
                        <label class="form-label mb-0 pb-1" style="font-size:0.75rem;font-weight:600;color:#374151;">Catégorie</label>
                        {% if not is_equipement|default(false) %}
                            {{ form_widget(form.category, {attr: {
                                class: 'form-select form-select-sm'
                            }}) }}
                            {{ form_errors(form.category) }}
                        {% else %}
                            <div class="form-control form-control-sm d-flex align-items-center fw-semibold"
                                 style="background-color:#f1f5f9;border-color:#e2e8f0;color:#0f172a;cursor:default;">
                                Équipement
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="{{ cancel_is_modal|default(false) ? 'p-2' : 'p-3' }} rounded-3 bg-white border" style="border-color:#e8edf5!important;box-shadow:0 1px 4px rgba(0,0,0,0.04);">
                <p class="text-uppercase fw-bold text-secondary mb-2" style="font-size:0.62rem;letter-spacing:0.06em;">Prix &amp; stock</p>
                <div class="row g-2">
                    {% if not is_equipement|default(false) %}
                    <div class="col-12 col-md-4">
                        <label class="form-label mb-0 pb-1" style="font-size:0.75rem;font-weight:600;color:#374151;" for="{{ form.uniteVente.vars.id }}">Unité</label>
                        {{ form_widget(form.uniteVente, {attr: {
                            class: 'form-select form-select-sm'
                        }}) }}
                        {{ form_errors(form.uniteVente) }}
                    </div>
                    {% endif %}
                    <div class="col-12 {{ is_equipement|default(false) ? 'col-md-6' : 'col-md-4' }}">
                        <label class="form-label mb-0 pb-1" style="font-size:0.75rem;font-weight:600;color:#374151;" for="{{ form.prixUnitaire.vars.id }}">Prix</label>
                        <div class="input-group input-group-sm" style="border-radius:0.375rem;overflow:hidden;border:1px solid #e5e7eb;">
                            {{ form_widget(form.prixUnitaire, {attr: {
                                class: 'form-control border-0',
                                placeholder: '0.000'
                            }}) }}
                            <span class="input-group-text border-0 fw-bold px-2 py-0"
                                  style="background:linear-gradient(135deg,#22c55e,#16a34a);color:#fff;font-size:0.7rem;">DT</span>
                        </div>
                        {{ form_errors(form.prixUnitaire) }}
                        {% if not is_equipement|default(false) %}
                        <div class="small rounded-3 p-2 border bg-light d-none mt-2 js-ai-price-box">
                            <div class="fw-semibold text-success mb-1">Suggestion prix</div>
                            <div class="text-muted js-ai-price-text"></div>
                            <button type="button" class="btn btn-sm btn-outline-success mt-2 d-none js-ai-price-apply">Appliquer ce prix</button>
                        </div>
                        {% endif %}
                    </div>
                    <div class="col-12 {{ is_equipement|default(false) ? 'col-md-6' : 'col-md-4' }}">
                        <label class="form-label mb-0 pb-1" style="font-size:0.75rem;font-weight:600;color:#374151;" for="{{ form.quantite.vars.id }}">Quantité</label>
                        {{ form_widget(form.quantite, {attr: {
                            class: 'form-control form-control-sm'
                        }}) }}
                        {{ form_errors(form.quantite) }}
                    </div>
                </div>
            </div>

            <div class="{{ cancel_is_modal|default(false) ? 'p-2' : 'p-3' }} rounded-3 bg-white border" style="border-color:#e8edf5!important;box-shadow:0 1px 4px rgba(0,0,0,0.04);">
                <label class="form-label mb-1" style="font-size:0.75rem;font-weight:600;color:#374151;" for="{{ form.description.vars.id }}">
                    Description <span class="fw-normal text-muted">(optionnel)</span>
                </label>
                {{ form_widget(form.description, {attr: {
                    class: 'form-control form-control-sm',
                    style: 'resize:vertical;min-height:2.75rem;max-height:6rem;',
                    rows: cancel_is_modal|default(false) ? 2 : 3,
                    placeholder: 'Origine, qualité…'
                }}) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="d-flex align-items-start gap-2 px-2 py-1 rounded-2"
                 style="background:rgba(34,197,94,0.08);border:1px solid rgba(34,197,94,0.2);">
                <svg width="12" height="12" fill="none" stroke="#16a34a" viewBox="0 0 24 24" class="flex-shrink-0 mt-1" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
                <p class="mb-0" style="font-size:0.7rem;color:#15803d;line-height:1.35;">
                    Visible uniquement dans <strong>votre boutique</strong>.
                </p>
            </div>
        </div>
    </div>

    <div class="border-0 px-3 py-2 d-flex flex-wrap gap-2 justify-content-end align-items-center flex-shrink-0"
         style="background:#fff;border-top:1px solid #e5e7eb !important;">
        {% if cancel_is_modal|default(false) %}
            <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Annuler</button>
        {% else %}
            <a href="{{ path('boutique_index') }}" class="btn btn-sm btn-outline-secondary">Annuler</a>
        {% endif %}
        <button type="submit" class="btn btn-sm btn-success fw-semibold px-3">Enregistrer</button>
    </div>

    {{ form_end(form) }}
</div>
