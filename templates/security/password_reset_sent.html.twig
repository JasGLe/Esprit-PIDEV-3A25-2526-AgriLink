{% extends 'base.html.twig' %}

{% block title %}Email envoyé - AgriLink{% endblock %}

{% block body %}
{{ include('components/_auth_background.html.twig') }}
<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div>
            <div class="flex justify-center">
                <img src="{{ asset('logo_with_text.png') }}" alt="AgriLink Logo" class="logo logo-header">
            </div>
            <h2 class="mt-6 text-center text-3xl font-bold text-gray-900">
                Vérifiez votre boîte de réception
            </h2>
        </div>

        <div class="rounded-md bg-green-50 border border-green-200 p-6">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-6 w-6 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <div class="ml-4">
                    <p class="text-sm text-green-800">
                        Si un compte est associé à cette adresse email, vous recevrez un lien de réinitialisation dans quelques instants.
                    </p>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 space-y-4">
            <h3 class="text-lg font-medium text-gray-900">Que faire maintenant ?</h3>
            <ul class="space-y-3 text-sm text-gray-600">
                <li class="flex items-start">
                    <svg class="h-5 w-5 text-primary-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span>Vérifiez votre boîte de réception (et vos spams)</span>
                </li>
                <li class="flex items-start">
                    <svg class="h-5 w-5 text-primary-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span>Le lien expire dans <strong>1 heure</strong></span>
                </li>
                <li class="flex items-start">
                    <svg class="h-5 w-5 text-primary-500 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span>Cliquez sur le lien dans l'email pour créer un nouveau mot de passe</span>
                </li>
            </ul>
        </div>

        <div class="text-center space-y-4">
            <p class="text-sm text-gray-500">
                Vous n'avez pas reçu l'email ?
            </p>
            <a href="{{ path('app_forgot_password') }}" class="inline-flex items-center px-4 py-2 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                Renvoyer le lien
            </a>
        </div>

        <div class="text-center pt-4 border-t border-gray-200">
            <a href="{{ path('app_login') }}" class="font-medium text-primary-600 hover:text-primary-500">
                <svg class="inline-block h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
                </svg>
                Retour à la connexion
            </a>
        </div>
    </div>
</div>
{% endblock %}
