{% extends 'base.html.twig' %}

{% block title %}Inscription Fournisseur - AgriLink{% endblock %}

{% block body %}
{{ include('components/_auth_background.html.twig') }}
<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl w-full space-y-8">
        <div>
            <div class="flex justify-center">
                <img src="{{ asset('logo_with_text.png') }}" alt="AgriLink Logo" class="logo logo-header">
            </div>
            <h2 class="mt-6 text-center text-3xl font-bold text-gray-900">
                Inscription Fournisseur
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600">
                Rejoignez AgriLink en tant que fournisseur
            </p>
        </div>

        {# Flash messages #}
        {% for flash_message in app.flashes('error') %}
            <div class="rounded-md bg-red-50 border border-red-200 p-4">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm text-red-800">{{ flash_message }}</p>
                    </div>
                </div>
            </div>
        {% endfor %}

        {# Step indicators #}
        <div class="flex justify-center">
            <div class="flex items-center space-x-4">
                <div class="flex items-center" id="step1-indicator">
                    <span class="flex items-center justify-center w-8 h-8 rounded-full bg-primary-600 text-white text-sm font-medium">1</span>
                    <span class="ml-2 text-sm font-medium text-primary-600">Type de compte</span>
                </div>
                <div class="w-8 h-0.5 bg-gray-300"></div>
                <div class="flex items-center" id="step2-indicator">
                    <span class="flex items-center justify-center w-8 h-8 rounded-full bg-gray-300 text-gray-600 text-sm font-medium" id="step2-circle">2</span>
                    <span class="ml-2 text-sm font-medium text-gray-500" id="step2-text">Informations</span>
                </div>
            </div>
        </div>

        {{ form_start(registrationForm, {'attr': {'class': 'mt-8 space-y-6', 'id': 'fournisseur-form', 'novalidate': 'novalidate'}}) }}
            
            {# Section 1: Type Selection #}
            <div id="step1-section" class="bg-white rounded-xl shadow-md p-6 border border-gray-200">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">
                    <span class="mr-2">👤</span> Choisissez votre type de compte
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                    {# Personne Card #}
                    <div class="type-card cursor-pointer rounded-lg border-2 border-gray-200 p-4 hover:border-primary-500 transition-all duration-200" data-type="PERSONNE" id="card-personne">
                        <div class="flex items-start">
                            <div class="flex-shrink-0">
                                <span class="text-3xl">👤</span>
                            </div>
                            <div class="ml-4">
                                <h4 class="text-base font-semibold text-gray-900">Personne physique</h4>
                                <p class="mt-1 text-sm text-gray-600">Vous êtes un fournisseur individuel</p>
                            </div>
                        </div>
                    </div>
                    
                    {# Société Card #}
                    <div class="type-card cursor-pointer rounded-lg border-2 border-gray-200 p-4 hover:border-primary-500 transition-all duration-200" data-type="SOCIETE" id="card-societe">
                        <div class="flex items-start">
                            <div class="flex-shrink-0">
                                <span class="text-3xl">🏢</span>
                            </div>
                            <div class="ml-4">
                                <h4 class="text-base font-semibold text-gray-900">Société</h4>
                                <p class="mt-1 text-sm text-gray-600">Vous représentez une entreprise</p>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="hidden">
                    {{ form_widget(registrationForm.fournisseurTypeFournisseur) }}
                </div>
                {{ form_errors(registrationForm.fournisseurTypeFournisseur) }}
                
                <div class="flex justify-end">
                    <button type="button" id="btn-next" disabled class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 disabled:opacity-50 disabled:cursor-not-allowed">
                        Continuer
                        <svg class="ml-2 -mr-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </button>
                </div>
            </div>

            {# Section 2: Information Form #}
            <div id="step2-section" class="hidden">
                {# Back button #}
                <button type="button" id="btn-back" class="mb-4 inline-flex items-center text-sm text-gray-600 hover:text-primary-600">
                    <svg class="mr-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    Retour au choix du type
                </button>

                {# Common Information #}
                <div class="bg-white rounded-xl shadow-md p-6 border border-gray-200 mb-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">
                        <span class="mr-2">📝</span> Informations générales
                    </h3>
                    
                    <div class="space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                {{ form_label(registrationForm.nom) }}
                                {{ form_widget(registrationForm.nom) }}
                                {{ form_errors(registrationForm.nom) }}
                            </div>
                            <div>
                                {{ form_label(registrationForm.email) }}
                                {{ form_widget(registrationForm.email) }}
                                {{ form_errors(registrationForm.email) }}
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                {{ form_label(registrationForm.plainPassword.first) }}
                                <div class="relative">
                                    {{ form_widget(registrationForm.plainPassword.first, {
                                        'attr': {
                                            'class': 'password-input',
                                            'autocomplete': 'new-password'
                                        }
                                    }) }}
                                    <button type="button" class="password-toggle absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700" onclick="togglePasswordVisibility(this)">
                                        <svg class="h-5 w-5 eye-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                    </button>
                                </div>
                                {{ form_errors(registrationForm.plainPassword.first) }}
                                <p class="mt-1 text-xs text-gray-500">Minimum 6 caractères</p>
                            </div>
                            <div>
                                {{ form_label(registrationForm.plainPassword.second) }}
                                <div class="relative">
                                    {{ form_widget(registrationForm.plainPassword.second, {
                                        'attr': {
                                            'class': 'password-input',
                                            'autocomplete': 'new-password'
                                        }
                                    }) }}
                                    <button type="button" class="password-toggle absolute right-3 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-gray-700" onclick="togglePasswordVisibility(this)">
                                        <svg class="h-5 w-5 eye-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                        </svg>
                                    </button>
                                </div>
                                {{ form_errors(registrationForm.plainPassword.second) }}
                            </div>
                        </div>

                        <div>
                            {{ form_label(registrationForm.telephone) }}
                            {{ form_widget(registrationForm.telephone) }}
                            {{ form_errors(registrationForm.telephone) }}
                        </div>
                    </div>
                </div>

                {# Address Information #}
                <div class="bg-white rounded-xl shadow-md p-6 border border-gray-200 mb-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">
                        <span class="mr-2">📍</span> Adresse
                    </h3>
                    
                    <div class="space-y-4">
                        <div>
                            {{ form_label(registrationForm.gouvernant) }}
                            {{ form_widget(registrationForm.gouvernant) }}
                            {{ form_errors(registrationForm.gouvernant) }}
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                {{ form_label(registrationForm.ville) }}
                                {{ form_widget(registrationForm.ville) }}
                                {{ form_errors(registrationForm.ville) }}
                            </div>
                            <div>
                                {{ form_label(registrationForm.codePostale) }}
                                {{ form_widget(registrationForm.codePostale) }}
                                {{ form_errors(registrationForm.codePostale) }}
                            </div>
                        </div>
                    </div>
                </div>

                {# PERSONNE-specific fields #}
                <div id="personne-fields" class="hidden bg-white rounded-xl shadow-md p-6 border border-gray-200 mb-6 border-l-4 border-l-blue-500">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">
                        <span class="mr-2">🪪</span> Informations personnelles
                    </h3>
                    
                    <div>
                        {{ form_label(registrationForm.fournisseurCin) }}
                        {{ form_widget(registrationForm.fournisseurCin) }}
                        {{ form_errors(registrationForm.fournisseurCin) }}
                        <p class="mt-1 text-xs text-gray-500">8 chiffres, obligatoire pour les personnes physiques</p>
                    </div>
                </div>

                {# SOCIETE-specific fields #}
                <div id="societe-fields" class="hidden bg-white rounded-xl shadow-md p-6 border border-gray-200 mb-6 border-l-4 border-l-green-500">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">
                        <span class="mr-2">🏢</span> Informations de la société
                    </h3>
                    
                    <div class="space-y-4">
                        <div>
                            {{ form_label(registrationForm.fournisseurRaisonSocial) }}
                            {{ form_widget(registrationForm.fournisseurRaisonSocial) }}
                            {{ form_errors(registrationForm.fournisseurRaisonSocial) }}
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div>
                                {{ form_label(registrationForm.fournisseurNumRegistre) }}
                                {{ form_widget(registrationForm.fournisseurNumRegistre) }}
                                {{ form_errors(registrationForm.fournisseurNumRegistre) }}
                            </div>
                            <div>
                                {{ form_label(registrationForm.fournisseurFormeJuridique) }}
                                {{ form_widget(registrationForm.fournisseurFormeJuridique) }}
                                {{ form_errors(registrationForm.fournisseurFormeJuridique) }}
                            </div>
                        </div>

                        <div>
                            {{ form_label(registrationForm.fournisseurCapital) }}
                            {{ form_widget(registrationForm.fournisseurCapital) }}
                            {{ form_errors(registrationForm.fournisseurCapital) }}
                        </div>
                    </div>
                </div>

                {# Certifications #}
                <div class="bg-white rounded-xl shadow-md p-6 border border-gray-200 mb-6">
                    <h3 class="text-lg font-semibold text-gray-900 mb-4">
                        <span class="mr-2">🏅</span> Certifications (optionnel)
                    </h3>
                    
                    <div>
                        {{ form_label(registrationForm.fournisseurCertifications) }}
                        {{ form_widget(registrationForm.fournisseurCertifications) }}
                        {{ form_errors(registrationForm.fournisseurCertifications) }}
                        <p class="mt-1 text-xs text-gray-500">Listez vos certifications séparées par des virgules (ex: Bio, ISO 9001, HACCP)</p>
                    </div>
                </div>

                {# Terms and Submit #}
                <div class="bg-white rounded-xl shadow-md p-6 border border-gray-200">
                    <div class="flex items-center mb-6">
                        {{ form_widget(registrationForm.agreeTerms) }}
                        {{ form_label(registrationForm.agreeTerms) }}
                    </div>
                    {{ form_errors(registrationForm.agreeTerms) }}

                    <button type="submit" class="w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 transition-colors duration-200">
                        <span class="mr-2">📦</span>
                        Créer mon compte Fournisseur
                    </button>
                </div>
            </div>

        {{ form_end(registrationForm) }}

        <div class="text-center">
            <a href="{{ path('app_register') }}" class="inline-flex items-center text-sm text-gray-600 hover:text-primary-600">
                <svg class="mr-1 w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                Retour au choix du type de compte
            </a>
        </div>

        <div class="text-center">
            <p class="text-sm text-gray-600">
                Déjà inscrit ?
                <a href="{{ path('app_login') }}" class="font-medium text-primary-600 hover:text-primary-500">
                    Se connecter
                </a>
            </p>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Debug: Log all element queries
    console.log('=== Fournisseur Type Selection Debug ===');
    
    const typeSelect = document.getElementById('fournisseur_type');
    const personneFields = document.getElementById('personne-fields');
    const societeFields = document.getElementById('societe-fields');
    const cardPersonne = document.getElementById('card-personne');
    const cardSociete = document.getElementById('card-societe');
    const btnNext = document.getElementById('btn-next');
    const btnBack = document.getElementById('btn-back');
    const step1Section = document.getElementById('step1-section');
    const step2Section = document.getElementById('step2-section');
    const step2Circle = document.getElementById('step2-circle');
    const step2Text = document.getElementById('step2-text');
    
    // Debug logging
    console.log('typeSelect found:', typeSelect ? 'YES' : 'NO', typeSelect);
    console.log('cardPersonne found:', cardPersonne ? 'YES' : 'NO');
    console.log('cardSociete found:', cardSociete ? 'YES' : 'NO');
    console.log('btnNext found:', btnNext ? 'YES' : 'NO');
    
    // If typeSelect not found, try alternative selector
    if (!typeSelect) {
        console.error('❌ Select element not found with ID. Trying name attribute...');
        const altSelect = document.querySelector('[name="registration_fournisseur[fournisseurTypeFournisseur]"]');
        console.log('Alternative selector result:', altSelect);
        
        if (!altSelect) {
            console.error('❌ CRITICAL: Cannot find type select element!');
            alert('Erreur: Le champ de sélection du type de fournisseur est introuvable. Veuillez rafraîchir la page.');
            return;
        }
    }
    
    // Early exit if critical elements missing
    if (!cardPersonne || !cardSociete || !btnNext) {
        console.error('❌ CRITICAL: Missing required elements!');
        console.error('Missing:', {
            cardPersonne: !cardPersonne,
            cardSociete: !cardSociete,
            btnNext: !btnNext
        });
        alert('Erreur: Certains éléments du formulaire sont introuvables. Veuillez rafraîchir la page.');
        return;
    }

    let selectedType = typeSelect ? (typeSelect.value || null) : null;
    console.log('Initial selectedType:', selectedType);

    function updateTypeDisplay() {
        const isPersonne = selectedType === 'PERSONNE';
        const isSociete = selectedType === 'SOCIETE';
        
        console.log('updateTypeDisplay called:', { selectedType, isPersonne, isSociete });
        
        // Update card styles
        cardPersonne.classList.toggle('border-primary-500', isPersonne);
        cardPersonne.classList.toggle('bg-primary-50', isPersonne);
        cardPersonne.classList.toggle('border-gray-200', !isPersonne);
        
        cardSociete.classList.toggle('border-primary-500', isSociete);
        cardSociete.classList.toggle('bg-primary-50', isSociete);
        cardSociete.classList.toggle('border-gray-200', !isSociete);
        
        // Update hidden select
        if (typeSelect && selectedType) {
            typeSelect.value = selectedType;
            console.log('✅ Updated select value to:', typeSelect.value);
        }
        
        // Enable/disable next button
        btnNext.disabled = !selectedType;
        console.log('btnNext.disabled:', btnNext.disabled);
        
        // Show/hide type-specific fields
        if (personneFields) {
            personneFields.classList.toggle('hidden', !isPersonne);
        }
        if (societeFields) {
            societeFields.classList.toggle('hidden', !isSociete);
        }
        
        // Update required attributes based on type
        const cinInput = document.getElementById('registration_fournisseur_fournisseurCin');
        if (cinInput) {
            cinInput.required = isPersonne;
        }
    }

    // Card click handlers
    cardPersonne.addEventListener('click', function() {
        console.log('🖱️ Personne card clicked');
        selectedType = 'PERSONNE';
        updateTypeDisplay();
    });

    cardSociete.addEventListener('click', function() {
        console.log('🖱️ Société card clicked');
        selectedType = 'SOCIETE';
        updateTypeDisplay();
    });

    // Next button handler
    btnNext.addEventListener('click', function() {
        console.log('🚀 Next button clicked');
        
        if (!selectedType) {
            console.error('❌ No type selected!');
            alert('Veuillez sélectionner un type de fournisseur');
            return;
        }
        
        console.log('Advancing to step 2 with type:', selectedType);
        
        if (!step1Section || !step2Section) {
            console.error('❌ Step sections not found!');
            return;
        }
        
        step1Section.classList.add('hidden');
        step2Section.classList.remove('hidden');
        
        // Update step indicator
        if (step2Circle) {
            step2Circle.classList.remove('bg-gray-300', 'text-gray-600');
            step2Circle.classList.add('bg-primary-600', 'text-white');
        }
        if (step2Text) {
            step2Text.classList.remove('text-gray-500');
            step2Text.classList.add('text-primary-600');
        }
        
        console.log('✅ Advanced to step 2');
    });

    // Back button handler
    if (btnBack) {
        btnBack.addEventListener('click', function() {
            console.log('⬅️ Back button clicked');
            
            if (!step1Section || !step2Section) return;
            
            step2Section.classList.add('hidden');
            step1Section.classList.remove('hidden');
            
            // Reset step indicator
            if (step2Circle) {
                step2Circle.classList.add('bg-gray-300', 'text-gray-600');
                step2Circle.classList.remove('bg-primary-600', 'text-white');
            }
            if (step2Text) {
                step2Text.classList.add('text-gray-500');
                step2Text.classList.remove('text-primary-600');
            }
        });
    }

    // Also listen for direct select changes (for accessibility)
    if (typeSelect) {
        typeSelect.addEventListener('change', function() {
            console.log('📝 Select changed directly:', this.value);
            selectedType = this.value;
            updateTypeDisplay();
        });
    }

    // Initialize display based on any pre-selected value
    if (selectedType) {
        console.log('🔄 Initializing with pre-selected type:', selectedType);
        updateTypeDisplay();
    }
    
    console.log('=== Initialization Complete ===');
});

function togglePasswordVisibility(button) {
    const input = button.previousElementSibling;
    const isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';
    button.classList.toggle('opacity-50', !isPassword);
}
</script>
{% endblock %}
