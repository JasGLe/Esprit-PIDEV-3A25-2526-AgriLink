{% extends 'base.html.twig' %}

{% block title %}Inscription - AgriLink{% endblock %}

{% block body %}
{{ include('components/_auth_background.html.twig') }}
<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl w-full space-y-8">
        <div>
            <div class="flex justify-center">
                <img src="{{ asset('logo_with_text.png') }}" alt="AgriLink Logo" class="logo logo-header">
            </div>
            <h2 class="mt-6 text-center text-3xl font-bold text-gray-900">
                Rejoignez AgriLink
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600">
                Choisissez votre type de compte pour commencer
            </p>
        </div>

        {% for flash_message in app.flashes('info') %}
            <div class="rounded-md bg-blue-50 border border-blue-200 p-4">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm text-blue-800">{{ flash_message }}</p>
                    </div>
                </div>
            </div>
        {% endfor %}

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
            <!-- Agriculteur Card -->
            <a href="{{ path('app_register_agriculteur') }}" class="block group">
                <div class="bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 p-6 border-2 border-transparent hover:border-primary-500 transform hover:-translate-y-1">
                    <div class="text-center">
                        <span class="text-5xl block mb-4">🌾</span>
                        <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-primary-600">
                            Agriculteur
                        </h3>
                        <p class="text-gray-600 text-sm">
                            Vous êtes agriculteur et souhaitez gérer votre exploitation
                        </p>
                    </div>
                    <div class="mt-6">
                        <span class="block w-full text-center py-2 px-4 border border-primary-600 text-primary-600 rounded-md group-hover:bg-primary-600 group-hover:text-white transition-colors duration-200">
                            Commencer
                        </span>
                    </div>
                </div>
            </a>

            <!-- Fournisseur Card -->
            <a href="{{ path('app_register_fournisseur') }}" class="block group">
                <div class="bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 p-6 border-2 border-transparent hover:border-primary-500 transform hover:-translate-y-1">
                    <div class="text-center">
                        <span class="text-5xl block mb-4">📦</span>
                        <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-primary-600">
                            Fournisseur
                        </h3>
                        <p class="text-gray-600 text-sm">
                            Vous êtes fournisseur de produits ou services agricoles
                        </p>
                    </div>
                    <div class="mt-6">
                        <span class="block w-full text-center py-2 px-4 border border-primary-600 text-primary-600 rounded-md group-hover:bg-primary-600 group-hover:text-white transition-colors duration-200">
                            Commencer
                        </span>
                    </div>
                </div>
            </a>

            <!-- AgriPlus Card -->
            <a href="{{ path('app_register_agriplus') }}" class="block group">
                <div class="bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 p-6 border-2 border-transparent hover:border-yellow-500 transform hover:-translate-y-1 relative overflow-hidden">
                    <div class="absolute top-0 right-0 bg-yellow-500 text-white text-xs font-bold px-3 py-1 rounded-bl-lg">
                        Premium
                    </div>
                    <div class="text-center">
                        <span class="text-5xl block mb-4">⭐</span>
                        <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-yellow-600">
                            AgriPlus
                        </h3>
                        <p class="text-gray-600 text-sm">
                            Accédez aux fonctionnalités premium d'AgriLink
                        </p>
                    </div>
                    <div class="mt-6">
                        <span class="block w-full text-center py-2 px-4 border border-yellow-500 text-yellow-600 rounded-md group-hover:bg-yellow-500 group-hover:text-white transition-colors duration-200">
                            Commencer
                        </span>
                    </div>
                </div>
            </a>
        </div>

        <div class="text-center mt-8">
            <p class="text-sm text-gray-600">
                Déjà inscrit ?
                <a href="{{ path('app_login') }}" class="font-medium text-primary-600 hover:text-primary-500">
                    Se connecter
                </a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
