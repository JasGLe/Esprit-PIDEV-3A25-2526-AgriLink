{% extends 'base.html.twig' %}

{% block title %}Vérification en deux étapes - AgriLink{% endblock %}

{% block body %}
{{ include('components/_auth_background.html.twig') }}
<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div>
            <div class="flex justify-center">
                <span class="text-6xl">🔐</span>
            </div>
            <h2 class="mt-6 text-center text-3xl font-bold text-gray-900">
                Vérification en deux étapes
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600">
                Un code de vérification a été envoyé à<br>
                <span class="font-medium text-primary-600">{{ user.email|slice(0, 3) }}***{{ user.email|split('@')[1] }}</span>
            </p>
        </div>

        {# Error message #}
        {% if error %}
            <div class="rounded-md bg-red-50 border border-red-200 p-4">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                        </svg>
                    </div>
                    <div class="ml-3">
                        <p class="text-sm text-red-800">{{ error }}</p>
                    </div>
                </div>
            </div>
        {% endif %}

        {# Success message for resend #}
        <div id="success-message" class="hidden rounded-md bg-green-50 border border-green-200 p-4">
            <div class="flex">
                <div class="flex-shrink-0">
                    <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                    </svg>
                </div>
                <div class="ml-3">
                    <p id="success-text" class="text-sm text-green-800"></p>
                </div>
            </div>
        </div>

        {# Expiration timer #}
        <div class="text-center">
            <div id="timer-container" class="inline-flex items-center px-4 py-2 rounded-full {% if expiration_seconds > 60 %}bg-primary-100 text-primary-800{% elseif expiration_seconds > 0 %}bg-orange-100 text-orange-800{% else %}bg-red-100 text-red-800{% endif %}">
                <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span id="timer-text">
                    {% if expiration_seconds > 0 %}
                        Code valide pendant <span id="countdown">{{ (expiration_seconds / 60)|round(0, 'ceil') }}</span> min
                    {% else %}
                        Code expiré
                    {% endif %}
                </span>
            </div>
        </div>

        {# Remaining attempts #}
        {% if remaining_attempts < max_attempts %}
            <div class="text-center text-sm {% if remaining_attempts <= 1 %}text-red-600{% else %}text-orange-600{% endif %}">
                <svg class="inline h-4 w-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                </svg>
                {{ remaining_attempts }} tentative{{ remaining_attempts > 1 ? 's' : '' }} restante{{ remaining_attempts > 1 ? 's' : '' }}
            </div>
        {% endif %}

        {# OTP Form #}
        <form id="otp-form" class="mt-8 space-y-6" action="{{ path('app_2fa_verify') }}" method="post">
            <div>
                <label for="otp_code" class="block text-sm font-medium text-gray-700 text-center mb-4">
                    Entrez le code à 6 chiffres
                </label>
                
                {# Single input for OTP #}
                <div class="flex justify-center">
                    <input type="text" 
                           id="otp_code" 
                           name="otp_code" 
                           maxlength="6" 
                           pattern="[0-9]{6}"
                           inputmode="numeric"
                           autocomplete="one-time-code"
                           required
                           class="w-48 text-center text-2xl tracking-[0.5em] font-mono px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                           placeholder="000000"
                           autofocus>
                </div>
            </div>

            <div>
                <button type="submit" 
                        id="submit-btn"
                        class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 disabled:opacity-50 disabled:cursor-not-allowed">
                    <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    Vérifier le code
                </button>
            </div>
        </form>

        {# Resend and Cancel buttons #}
        <div class="flex flex-col space-y-3">
            {# Resend button #}
            <button type="button" 
                    id="resend-btn"
                    onclick="resendCode()"
                    class="w-full flex justify-center items-center py-2 px-4 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 disabled:opacity-50 disabled:cursor-not-allowed"
                    {% if not can_resend %}disabled{% endif %}>
                <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                </svg>
                <span id="resend-text">
                    {% if can_resend %}
                        Renvoyer le code
                    {% else %}
                        Renvoyer dans <span id="cooldown">{{ cooldown_seconds }}</span>s
                    {% endif %}
                </span>
            </button>

            {# Cancel link #}
            <a href="{{ path('app_2fa_cancel') }}" 
               class="w-full flex justify-center items-center py-2 px-4 border border-transparent text-sm font-medium text-gray-500 hover:text-gray-700">
                <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
                Annuler et retourner à la connexion
            </a>
        </div>

        {# Help text #}
        <div class="mt-6 text-center text-xs text-gray-500">
            <p>Vous n'avez pas reçu le code ?</p>
            <p class="mt-1">Vérifiez votre dossier spam ou cliquez sur "Renvoyer le code".</p>
        </div>
    </div>
</div>

<script>
    // Timer for OTP expiration
    let expirationSeconds = {{ expiration_seconds }};
    let cooldownSeconds = {{ cooldown_seconds }};
    
    function updateExpirationTimer() {
        if (expirationSeconds <= 0) {
            document.getElementById('timer-text').textContent = 'Code expiré';
            document.getElementById('timer-container').className = 'inline-flex items-center px-4 py-2 rounded-full bg-red-100 text-red-800';
            document.getElementById('submit-btn').disabled = true;
            return;
        }
        
        expirationSeconds--;
        const minutes = Math.floor(expirationSeconds / 60);
        const seconds = expirationSeconds % 60;
        
        let displayText;
        if (minutes > 0) {
            displayText = `Code valide pendant ${minutes}:${seconds.toString().padStart(2, '0')}`;
        } else {
            displayText = `Code valide pendant ${seconds}s`;
        }
        document.getElementById('timer-text').innerHTML = displayText;
        
        // Update color based on time remaining
        const container = document.getElementById('timer-container');
        if (expirationSeconds > 60) {
            container.className = 'inline-flex items-center px-4 py-2 rounded-full bg-primary-100 text-primary-800';
        } else if (expirationSeconds > 30) {
            container.className = 'inline-flex items-center px-4 py-2 rounded-full bg-orange-100 text-orange-800';
        } else {
            container.className = 'inline-flex items-center px-4 py-2 rounded-full bg-red-100 text-red-800';
        }
    }
    
    function updateCooldownTimer() {
        if (cooldownSeconds <= 0) {
            document.getElementById('resend-btn').disabled = false;
            document.getElementById('resend-text').textContent = 'Renvoyer le code';
            return;
        }
        
        cooldownSeconds--;
        document.getElementById('resend-text').innerHTML = `Renvoyer dans <span id="cooldown">${cooldownSeconds}</span>s`;
    }
    
    // Start timers
    if (expirationSeconds > 0) {
        setInterval(updateExpirationTimer, 1000);
    }
    if (cooldownSeconds > 0) {
        setInterval(updateCooldownTimer, 1000);
    }
    
    // Resend code via AJAX
    async function resendCode() {
        const btn = document.getElementById('resend-btn');
        const successMsg = document.getElementById('success-message');
        const successText = document.getElementById('success-text');
        
        btn.disabled = true;
        btn.innerHTML = '<svg class="animate-spin h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Envoi en cours...';
        
        try {
            const response = await fetch('{{ path('app_2fa_resend') }}', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                }
            });
            
            const data = await response.json();
            
            if (data.redirect) {
                window.location.href = data.redirect;
                return;
            }
            
            if (data.success) {
                // Show success message
                successText.textContent = data.message;
                successMsg.classList.remove('hidden');
                
                // Reset expiration timer
                expirationSeconds = data.expiration_seconds;
                document.getElementById('submit-btn').disabled = false;
                
                // Reset cooldown
                cooldownSeconds = data.cooldown_seconds;
                btn.innerHTML = '<svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg><span id="resend-text">Renvoyer dans <span id="cooldown">' + cooldownSeconds + '</span>s</span>';
                
                // Hide success message after 5 seconds
                setTimeout(() => {
                    successMsg.classList.add('hidden');
                }, 5000);
            } else {
                // Show error
                alert(data.message);
                if (data.cooldown) {
                    cooldownSeconds = data.cooldown;
                }
                btn.innerHTML = '<svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg><span id="resend-text">Renvoyer dans <span id="cooldown">' + cooldownSeconds + '</span>s</span>';
            }
        } catch (error) {
            alert('Erreur lors de l\'envoi du code. Veuillez réessayer.');
            btn.disabled = false;
            btn.innerHTML = '<svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg><span id="resend-text">Renvoyer le code</span>';
        }
    }
    
    // Auto-submit when 6 digits entered
    document.getElementById('otp_code').addEventListener('input', function(e) {
        // Only allow digits
        this.value = this.value.replace(/[^0-9]/g, '');
        
        // Auto-submit when 6 digits are entered
        if (this.value.length === 6) {
            // Small delay to show the last digit
            setTimeout(() => {
                document.getElementById('otp-form').submit();
            }, 100);
        }
    });
</script>
{% endblock %}
