{% extends 'base.html.twig' %}

{% block title %}Vérification Email - AgriLink{% endblock %}

{% block body %}
{{ include('components/_auth_background.html.twig') }}
<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div>
            <div class="flex justify-center">
                <span class="text-6xl">📧</span>
            </div>
            <h2 class="mt-6 text-center text-3xl font-bold text-gray-900">
                Vérifiez votre email
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600">
                Un code de vérification à 6 chiffres a été envoyé à
            </p>
            <p class="text-center text-sm font-medium text-primary-600">
                {{ user.email }}
            </p>
        </div>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="rounded-md p-4 {% if label == 'success' %}bg-green-50 border border-green-200{% elseif label == 'error' %}bg-red-50 border border-red-200{% elseif label == 'warning' %}bg-yellow-50 border border-yellow-200{% else %}bg-blue-50 border border-blue-200{% endif %}">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            {% if label == 'success' %}
                                <svg class="h-5 w-5 text-green-400" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                                </svg>
                            {% elseif label == 'error' %}
                                <svg class="h-5 w-5 text-red-400" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                                </svg>
                            {% elseif label == 'warning' %}
                                <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"/>
                                </svg>
                            {% else %}
                                <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                                </svg>
                            {% endif %}
                        </div>
                        <div class="ml-3">
                            <p class="text-sm {% if label == 'success' %}text-green-700{% elseif label == 'error' %}text-red-700{% elseif label == 'warning' %}text-yellow-700{% else %}text-blue-700{% endif %}">
                                {{ message }}
                            </p>
                        </div>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}

        {# Countdown timer #}
        {% if timeRemaining > 0 %}
        <div class="bg-white p-4 rounded-lg shadow-sm border border-gray-200 text-center">
            <p class="text-sm text-gray-600 mb-2">Le code expire dans :</p>
            <div id="countdown" class="text-2xl font-bold text-primary-600" data-expires="{{ timeRemaining }}">
                --:--
            </div>
        </div>
        {% else %}
        <div class="bg-red-50 p-4 rounded-lg border border-red-200 text-center">
            <p class="text-sm text-red-700">
                <svg class="inline h-5 w-5 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                </svg>
                Le code a expiré. Veuillez demander un nouveau code.
            </p>
        </div>
        {% endif %}

        {# Verification form #}
        <form method="post" action="{{ path('app_verify_email') }}" class="mt-8 space-y-6">
            <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
                <label for="verification_code" class="block text-sm font-medium text-gray-700 mb-2">
                    Code de vérification
                </label>
                <input type="text" 
                       name="verification_code" 
                       id="verification_code" 
                       maxlength="6"
                       pattern="[0-9]{6}"
                       inputmode="numeric"
                       autocomplete="one-time-code"
                       placeholder="000000"
                       class="appearance-none relative block w-full px-4 py-3 border border-gray-300 placeholder-gray-400 text-gray-900 rounded-md focus:outline-none focus:ring-primary-500 focus:border-primary-500 text-center text-2xl tracking-widest font-mono"
                       required>
                <p class="mt-2 text-xs text-gray-500 text-center">
                    Entrez le code à 6 chiffres reçu par email
                </p>
            </div>

            <div class="flex flex-col space-y-3">
                <button type="submit" 
                        class="group relative w-full flex justify-center py-3 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500 disabled:opacity-50 disabled:cursor-not-allowed"
                        {% if timeRemaining <= 0 %}disabled{% endif %}>
                    <span class="absolute left-0 inset-y-0 flex items-center pl-3">
                        <svg class="h-5 w-5 text-primary-500 group-hover:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                    </span>
                    Vérifier mon email
                </button>
            </div>
        </form>

        {# Resend code section #}
        <div class="bg-gray-50 p-4 rounded-lg border border-gray-200">
            <p class="text-sm text-gray-600 text-center mb-3">
                Vous n'avez pas reçu le code ?
            </p>
            
            {% if canResend %}
                <form method="post" action="{{ path('app_resend_verification') }}">
                    <button type="submit" 
                            id="resend-btn"
                            class="w-full flex justify-center py-2 px-4 border border-primary-300 text-sm font-medium rounded-md text-primary-700 bg-white hover:bg-primary-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                        <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                        </svg>
                        Renvoyer le code
                    </button>
                </form>
            {% else %}
                <button type="button" 
                        id="resend-btn-disabled"
                        disabled
                        class="w-full flex justify-center py-2 px-4 border border-gray-300 text-sm font-medium rounded-md text-gray-400 bg-gray-100 cursor-not-allowed"
                        data-wait-seconds="{{ resendWaitSeconds }}">
                    <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <span id="resend-countdown">Patienter {{ resendWaitSeconds }}s</span>
                </button>
                {% if resendMessage %}
                    <p class="mt-2 text-xs text-yellow-600 text-center">{{ resendMessage }}</p>
                {% endif %}
            {% endif %}
        </div>

        {# Skip verification (prominent button) #}
        <div class="bg-gradient-to-r from-gray-50 to-gray-100 p-6 rounded-lg border-2 border-dashed border-gray-300">
            <div class="text-center">
                <h3 class="text-sm font-medium text-gray-900 mb-2">
                    Pas le temps maintenant ?
                </h3>
                <p class="text-xs text-gray-600 mb-4">
                    Vous pourrez vérifier votre email plus tard depuis votre profil
                </p>
                <a href="{{ path('app_skip_verification') }}" 
                   class="inline-flex items-center px-6 py-3 border-2 border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 hover:border-gray-400 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-all">
                    <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                    </svg>
                    Passer et accéder à mon compte
                </a>
            </div>
        </div>

        {# Help section #}
        <div class="bg-blue-50 p-4 rounded-lg border border-blue-200">
            <h4 class="text-sm font-medium text-blue-800 mb-2">
                <svg class="inline h-4 w-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-8-3a1 1 0 00-.867.5 1 1 0 11-1.731-1A3 3 0 0113 8a3.001 3.001 0 01-2 2.83V11a1 1 0 11-2 0v-1a1 1 0 011-1 1 1 0 100-2zm0 8a1 1 0 100-2 1 1 0 000 2z" clip-rule="evenodd"/>
                </svg>
                Besoin d'aide ?
            </h4>
            <ul class="text-xs text-blue-700 space-y-1">
                <li>• Vérifiez votre dossier de courrier indésirable (spam)</li>
                <li>• Assurez-vous que l'adresse email est correcte</li>
                <li>• Le code est valable pendant 15 minutes</li>
            </ul>
        </div>
    </div>
</div>

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Countdown timer for code expiration
    const countdownEl = document.getElementById('countdown');
    if (countdownEl) {
        // Validate and parse time remaining
        let timeRemaining = parseInt(countdownEl.dataset.expires, 10);
        
        // Handle invalid or missing data
        if (isNaN(timeRemaining) || timeRemaining < 0) {
            console.error('Invalid or missing expiration time:', countdownEl.dataset.expires);
            countdownEl.innerHTML = '<span class="text-red-600">Erreur de chargement</span>';
            return;
        }
        
        function updateCountdown() {
            if (timeRemaining <= 0) {
                countdownEl.innerHTML = '<span class="text-red-600">Expiré</span>';
                return;
            }
            
            const hours = Math.floor(timeRemaining / 3600);
            const minutes = Math.floor((timeRemaining % 3600) / 60);
            const seconds = timeRemaining % 60;
            
            countdownEl.textContent = 
                String(hours).padStart(2, '0') + ':' + 
                String(minutes).padStart(2, '0') + ':' + 
                String(seconds).padStart(2, '0');
            
            timeRemaining--;
        }
        
        // Initialize display immediately
        updateCountdown();
        
        // Update every second
        const intervalId = setInterval(function() {
            updateCountdown();
            
            // Stop interval when expired
            if (timeRemaining < 0) {
                clearInterval(intervalId);
            }
        }, 1000);
    }

    // Countdown for resend button
    const resendDisabledBtn = document.getElementById('resend-btn-disabled');
    if (resendDisabledBtn) {
        let waitSeconds = parseInt(resendDisabledBtn.dataset.waitSeconds);
        const countdownSpan = document.getElementById('resend-countdown');
        
        function updateResendCountdown() {
            if (waitSeconds <= 0) {
                // Reload page to enable the button
                window.location.reload();
                return;
            }
            
            countdownSpan.textContent = 'Patienter ' + waitSeconds + 's';
            waitSeconds--;
        }
        
        updateResendCountdown();
        setInterval(updateResendCountdown, 1000);
    }

    // Auto-format and validate verification code input
    const codeInput = document.getElementById('verification_code');
    if (codeInput) {
        codeInput.addEventListener('input', function(e) {
            // Only allow digits
            this.value = this.value.replace(/[^0-9]/g, '');
            
            // Auto-submit when 6 digits entered
            if (this.value.length === 6) {
                // Optional: auto-submit after short delay
                // setTimeout(() => this.form.submit(), 300);
            }
        });

        // Focus on load
        codeInput.focus();
    }
});
</script>
{% endblock %}
{% endblock %}
