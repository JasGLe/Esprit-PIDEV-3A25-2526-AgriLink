<!DOCTYPE html>
<html lang="{{ app.request.locale|default('fr') }}" dir="{{ app.request.locale starts with 'ar' ? 'rtl' : 'ltr' }}">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}AgriLink{% endblock %}</title>
        <link rel="icon" href="{{ asset('logo_without_text.png') }}">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        {# Bootstrap CSS #}
        <link rel="stylesheet" href="{{ asset('build/app.css') }}">

        {# AgriLink Logo Styles #}
        <link rel="stylesheet" href="{{ asset('css/logo-styles.css') }}">

        {# Google Fonts - Inter #}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

        {% if onesignal_enabled %}
            <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
            <script>
            window.OneSignalDeferred = window.OneSignalDeferred || [];
            OneSignalDeferred.push(async function(OneSignal) {
                await OneSignal.init({
                    appId: "24893d76-b78b-45ff-9402-851673f09b0c",
                    allowLocalhostAsSecureOrigin: true,
                    notifyButton: { enable: false }
                });

                {% if app.user %}
                // Link the browser subscription to Symfony user id for role-targeted pushes.
                await OneSignal.login("{{ app.user.id }}");
                {% endif %}

                // Debug visibility in browser console.
                try {
                    const permission = await OneSignal.Notifications.permission;
                    console.log('[OneSignal] initialized, permission:', permission);
                } catch (e) {
                    console.log('[OneSignal] init debug error:', e);
                }
            });

            async function agriLinkRequestPushPermission() {
                if (!window.OneSignal) {
                    console.warn('[OneSignal] SDK not loaded yet');
                    return;
                }

                try {
                    if (window.OneSignal.Notifications && typeof window.OneSignal.Notifications.requestPermission === 'function') {
                        await window.OneSignal.Notifications.requestPermission();
                        return;
                    }

                    if (typeof window.OneSignal.showNativePrompt === 'function') {
                        await window.OneSignal.showNativePrompt();
                    }
                } catch (e) {
                    console.error('[OneSignal] permission prompt failed:', e);
                }
            }
            </script>
        {% endif %}

        {# Bootstrap JS Bundle (includes Popper) - loaded at end of body for better performance #}
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" crossorigin="anonymous"></script>
    </head>
    <body class="{% block body_class %}bg-light min-vh-100{% endblock %}">
        {# Display notifications for authenticated users #}
        {% if app.user %}
            {% include 'components/user_notifications_simple.html.twig' %}
        {% endif %}
        
        {% block body %}{% endblock %}

        {% if app.user and onesignal_enabled and onesignal_app_id is not empty %}
            <script>
            document.querySelectorAll('a[href*="{{ path("app_logout") }}"]').forEach(function (el) {
                el.addEventListener('click', function () {
                    try {
                        if (window.OneSignal && typeof window.OneSignal.logout === 'function') {
                            window.OneSignal.logout();
                        }
                    } catch (e) {}
                });
            });
            </script>
        {% endif %}
    </body>
</html>
