{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}{{ annonce.titre }} - AgriLink{% endblock %}
{% block page_title %}Details de l'annonce{% endblock %}

{% block dashboard_content %}
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h2 class="fs-3 fw-bold text-dark mb-1">{{ annonce.titre }}</h2>
            <p class="text-muted mb-0">Annonce #{{ annonce.id }}</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="{{ path('annonce_edit', {id: annonce.id}) }}" class="btn btn-outline-secondary">Modifier</a>
            <a href="{{ path('annonce_index') }}" class="btn btn-outline-primary">Retour a la liste</a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="row g-4">
                        <div class="col-12 col-md-6">
                            <div class="small text-muted mb-1">Type</div>
                            <div class="fw-semibold text-dark">{{ annonce.type }}</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="small text-muted mb-1">Statut</div>
                            <div class="fw-semibold text-dark">{{ annonce.status }}</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="small text-muted mb-1">Quantite</div>
                            <div class="fw-semibold text-dark">{{ annonce.quantite }}</div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="small text-muted mb-1">Prix unitaire</div>
                            <div class="fw-semibold text-dark">{{ annonce.prixUnitaire|number_format(2, '.', ' ') }} TND</div>
                        </div>
                        <div class="col-12">
                            <div class="small text-muted mb-1">Photos</div>
                            {% if annonce.photos %}
                                <a href="{{ annonce.photos }}" target="_blank" rel="noopener noreferrer" class="fw-semibold text-decoration-none">
                                    Voir la ressource
                                </a>
                            {% else %}
                                <div class="text-muted">Aucune photo fournie.</div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
