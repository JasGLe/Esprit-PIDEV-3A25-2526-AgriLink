{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Changer le mot de passe - AgriLink{% endblock %}

{% block dashboard_content %}
    <div class="mb-8">
        <div class="flex items-center space-x-4">
            <a href="{{ path('app_profile') }}" class="text-gray-500 hover:text-gray-700">
                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
            </a>
            <h1 class="text-2xl font-bold text-gray-900">Changer le mot de passe</h1>
        </div>
    </div>

    <div class="max-w-2xl">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            {# Colonne principale: Formulaire #}
            <div class="lg:col-span-2">
                {% embed 'components/_card.html.twig' %}
                    {% block card_content %}
                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                            <div class="space-y-6">
                                {# Mot de passe actuel #}
                                <div>
                                    {{ form_label(form.currentPassword) }}
                                    {{ form_widget(form.currentPassword) }}
                                    {{ form_errors(form.currentPassword) }}
                                </div>

                                <hr class="border-gray-200">

                                {# Nouveau mot de passe #}
                                <div>
                                    {{ form_label(form.newPassword.first) }}
                                    {{ form_widget(form.newPassword.first, {'attr': {'id': 'new-password-field'}}) }}
                                    {{ form_errors(form.newPassword.first) }}
                                    
                                    {# Indicateur de force du mot de passe #}
                                    <div class="mt-2">
                                        <div class="flex gap-1 h-1">
                                            <div id="strength-1" class="flex-1 rounded bg-gray-200 transition-colors duration-200"></div>
                                            <div id="strength-2" class="flex-1 rounded bg-gray-200 transition-colors duration-200"></div>
                                            <div id="strength-3" class="flex-1 rounded bg-gray-200 transition-colors duration-200"></div>
                                            <div id="strength-4" class="flex-1 rounded bg-gray-200 transition-colors duration-200"></div>
                                        </div>
                                        <p id="strength-text" class="mt-1 text-xs text-gray-500"></p>
                                    </div>
                                </div>

                                {# Confirmer le nouveau mot de passe #}
                                <div>
                                    {{ form_label(form.newPassword.second) }}
                                    {{ form_widget(form.newPassword.second) }}
                                    {{ form_errors(form.newPassword.second) }}
                                </div>
                            </div>

                            <div class="mt-6 flex items-center justify-end space-x-3 pt-6 border-t border-gray-200">
                                <a href="{{ path('app_profile') }}" class="px-4 py-2 border border-gray-300 rounded-md text-sm font-medium text-gray-700 bg-white hover:bg-gray-50">
                                    Annuler
                                </a>
                                <button type="submit" class="px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                                    Changer le mot de passe
                                </button>
                            </div>
                        {{ form_end(form) }}
                    {% endblock %}
                {% endembed %}
            </div>

            {# Colonne latérale: Exigences du mot de passe #}
            <div class="lg:col-span-1">
                {% embed 'components/_card.html.twig' %}
                    {% block card_title %}Exigences du mot de passe{% endblock %}
                    {% block card_content %}
                        <ul class="space-y-2 text-sm">
                            <li id="req-length" class="flex items-center text-gray-500">
                                <svg class="req-icon h-4 w-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="10" stroke-width="2"/>
                                </svg>
                                Au moins 8 caractères
                            </li>
                            <li id="req-upper" class="flex items-center text-gray-500">
                                <svg class="req-icon h-4 w-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="10" stroke-width="2"/>
                                </svg>
                                Une lettre majuscule
                            </li>
                            <li id="req-lower" class="flex items-center text-gray-500">
                                <svg class="req-icon h-4 w-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="10" stroke-width="2"/>
                                </svg>
                                Une lettre minuscule
                            </li>
                            <li id="req-digit" class="flex items-center text-gray-500">
                                <svg class="req-icon h-4 w-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="10" stroke-width="2"/>
                                </svg>
                                Un chiffre
                            </li>
                            <li id="req-special" class="flex items-center text-gray-500">
                                <svg class="req-icon h-4 w-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="10" stroke-width="2"/>
                                </svg>
                                Un caractère spécial (!@#$%^&*...)
                            </li>
                        </ul>
                        
                        <div class="mt-4 p-3 bg-amber-50 border border-amber-200 rounded-md">
                            <div class="flex">
                                <svg class="h-5 w-5 text-amber-400 mr-2 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                                </svg>
                                <p class="text-xs text-amber-700">
                                    Après le changement de mot de passe, vous recevrez un email de confirmation.
                                </p>
                            </div>
                        </div>
                    {% endblock %}
                {% endembed %}
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const passwordField = document.getElementById('new-password-field');
            const strengthBars = [
                document.getElementById('strength-1'),
                document.getElementById('strength-2'),
                document.getElementById('strength-3'),
                document.getElementById('strength-4')
            ];
            const strengthText = document.getElementById('strength-text');
            
            const requirements = {
                length: { el: document.getElementById('req-length'), regex: /.{8,}/ },
                upper: { el: document.getElementById('req-upper'), regex: /[A-Z]/ },
                lower: { el: document.getElementById('req-lower'), regex: /[a-z]/ },
                digit: { el: document.getElementById('req-digit'), regex: /[0-9]/ },
                special: { el: document.getElementById('req-special'), regex: /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]/ }
            };

            const checkIcon = `<svg class="req-icon h-4 w-4 mr-2 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>`;
            
            const circleIcon = `<svg class="req-icon h-4 w-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="10" stroke-width="2"/>
            </svg>`;

            function updateRequirement(req, passed) {
                const icon = req.el.querySelector('.req-icon');
                if (passed) {
                    req.el.classList.remove('text-gray-500');
                    req.el.classList.add('text-green-600');
                    icon.outerHTML = checkIcon;
                } else {
                    req.el.classList.remove('text-green-600');
                    req.el.classList.add('text-gray-500');
                    icon.outerHTML = circleIcon;
                }
            }

            function updateStrength(score) {
                const colors = ['bg-gray-200', 'bg-red-500', 'bg-orange-500', 'bg-yellow-500', 'bg-green-500'];
                const texts = ['', 'Très faible', 'Faible', 'Moyen', 'Fort'];
                const textColors = ['', 'text-red-500', 'text-orange-500', 'text-yellow-600', 'text-green-600'];

                strengthBars.forEach((bar, index) => {
                    bar.className = 'flex-1 rounded transition-colors duration-200 ';
                    if (index < score) {
                        bar.classList.add(colors[score]);
                    } else {
                        bar.classList.add('bg-gray-200');
                    }
                });

                strengthText.textContent = texts[score] || '';
                strengthText.className = 'mt-1 text-xs ' + (textColors[score] || 'text-gray-500');
            }

            if (passwordField) {
                passwordField.addEventListener('input', function() {
                    const password = this.value;
                    let score = 0;

                    for (const [key, req] of Object.entries(requirements)) {
                        const passed = req.regex.test(password);
                        updateRequirement(req, passed);
                        if (passed) score++;
                    }

                    // Convert 5-point score to 4-bar display
                    const barScore = Math.min(4, Math.ceil(score * 0.8));
                    updateStrength(password.length > 0 ? barScore : 0);
                });
            }
        });
    </script>
{% endblock %}
