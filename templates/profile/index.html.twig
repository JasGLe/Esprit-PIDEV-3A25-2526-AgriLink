{% extends 'layouts/app.html.twig' %}

{% block title %}Mon profil - AgriLink{% endblock %}

{% block page_content %}
    <div class="mb-8">
        <div class="flex justify-between items-center">
            <h1 class="text-2xl font-bold text-gray-900">Mon profil</h1>
            <a href="{{ path('app_profile_edit') }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700">
                Modifier mon profil
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {# Colonne gauche: Avatar et infos de base #}
        <div class="lg:col-span-1">
            {% embed 'components/_card.html.twig' %}
                {% block card_content %}
                    <div class="text-center">
                        {{ include('components/_avatar.html.twig', {user: app.user, size: 'large', classes: 'mx-auto'}) }}
                        <h3 class="mt-4 text-lg font-semibold text-gray-900">{{ app.user.displayName }}</h3>
                        <p class="text-sm text-gray-500">{{ app.user.email }}</p>
                        <div class="mt-3 flex justify-center">
                            {{ include('components/_role_badge.html.twig', {role: app.user.roles|first}) }}
                        </div>
                        <div class="mt-4 pt-4 border-t border-gray-200">
                            <div class="flex items-center justify-center text-sm text-gray-500">
                                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                Membre depuis {{ app.user.createdAt|date('d/m/Y') }}
                            </div>
                        </div>
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed 'components/_card.html.twig' with {classes: 'mt-6'} %}
                {% block card_title %}Statut du compte{% endblock %}
                {% block card_content %}
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-sm text-gray-600">Compte actif</span>
                            {% if app.user.isActive %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    Actif
                                </span>
                            {% else %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                    Inactif
                                </span>
                            {% endif %}
                        </div>
                    </div>
                {% endblock %}
            {% endembed %}
        </div>

        {# Colonne droite: Informations détaillées #}
        <div class="lg:col-span-2">
            {% embed 'components/_card.html.twig' %}
                {% block card_title %}Informations personnelles{% endblock %}
                {% block card_content %}
                    <dl class="divide-y divide-gray-200">
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Nom complet</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.fullName ?: 'Non renseigné' }}
                            </dd>
                        </div>
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Email</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.email }}
                            </dd>
                        </div>
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Téléphone</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.phoneNumber ?: 'Non renseigné' }}
                            </dd>
                        </div>
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Rôle</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.roleBadge }}
                            </dd>
                        </div>
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Dernière mise à jour</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.updatedAt|date('d/m/Y à H:i') }}
                            </dd>
                        </div>
                    </dl>
                {% endblock %}
            {% endembed %}
        </div>
    </div>
{% endblock %}
