{% extends 'layouts/dashboard_layout.html.twig' %}

{% block title %}Mon profil - AgriLink{% endblock %}

{% block dashboard_content %}
    <div class="mb-8">
        <div class="flex justify-between items-center">
            <h1 class="text-2xl font-bold text-gray-900">Mon profil</h1>
            <div class="flex space-x-3">
                <a href="{{ path('app_profile_edit') }}" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-primary-600 hover:bg-primary-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary-500">
                    <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                    </svg>
                    Modifier mon profil
                </a>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {# Colonne gauche: Avatar et infos de base #}
        <div class="lg:col-span-1">
            {% embed 'components/_card.html.twig' %}
                {% block card_content %}
                    <div class="text-center">
                        <div class="mx-auto">
                            {{ include('components/_avatar.html.twig', {user: app.user, size: 'large'}) }}
                        </div>
                        <h3 class="mt-4 text-lg font-semibold text-gray-900">{{ app.user.displayName }}</h3>
                        <p class="text-sm text-gray-500">{{ app.user.email }}</p>
                        <div class="mt-3 flex justify-center">
                            {{ include('components/_role_badge.html.twig', {role: app.user.roles|first}) }}
                        </div>
                        <div class="mt-4 pt-4 border-t border-gray-200">
                            <div class="flex items-center justify-center text-sm text-gray-500">
                                <svg class="h-4 w-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                Membre depuis {{ app.user.createdAt ? app.user.createdAt|date('d/m/Y') : 'N/A' }}
                            </div>
                        </div>
                    </div>
                {% endblock %}
            {% endembed %}

            {% embed 'components/_card.html.twig' with {classes: 'mt-6'} %}
                {% block card_title %}Statut du compte{% endblock %}
                {% block card_content %}
                    <div class="space-y-3">
                        <div class="flex items-center justify-between">
                            <span class="text-sm text-gray-600">Compte</span>
                            {% if app.user.isActive %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    <svg class="h-3 w-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                    </svg>
                                    Actif
                                </span>
                            {% else %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                                    <svg class="h-3 w-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                                    </svg>
                                    Inactif
                                </span>
                            {% endif %}
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-sm text-gray-600">Email vérifié</span>
                            {% if app.user.emailVerified %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    <svg class="h-3 w-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                    </svg>
                                    Vérifié
                                </span>
                            {% else %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                    <svg class="h-3 w-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                                    </svg>
                                    Non vérifié
                                </span>
                            {% endif %}
                        </div>
                        {% if app.user.twoFactorEnabled %}
                        <div class="flex items-center justify-between">
                            <span class="text-sm text-gray-600">2FA</span>
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                <svg class="h-3 w-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd" />
                                </svg>
                                Activé
                            </span>
                        </div>
                        {% endif %}
                    </div>
                {% endblock %}
            {% endembed %}

            {# Lien vers les paramètres de sécurité #}
            {% embed 'components/_card.html.twig' with {classes: 'mt-6'} %}
                {% block card_content %}
                    <a href="{{ path('app_profile_change_password') }}" class="flex items-center justify-between text-sm text-primary-600 hover:text-primary-800 font-medium">
                        <span class="flex items-center">
                            <svg class="h-5 w-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                            </svg>
                            Paramètres de sécurité
                        </span>
                        <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </a>
                {% endblock %}
            {% endembed %}
        </div>

        {# Colonne droite: Informations détaillées #}
        <div class="lg:col-span-2 space-y-6">
            {# Informations personnelles #}
            {% embed 'components/_card.html.twig' %}
                {% block card_title %}Informations personnelles{% endblock %}
                {% block card_content %}
                    <dl class="divide-y divide-gray-200">
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Nom complet</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.nom ?: 'Non renseigné' }}
                            </dd>
                        </div>
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Email</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 flex items-center">
                                {{ app.user.email }}
                                {% if app.user.emailVerified %}
                                    <svg class="h-4 w-4 ml-2 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                    </svg>
                                {% endif %}
                            </dd>
                        </div>
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Date de naissance</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.dateNaissance ? app.user.dateNaissance|date('d/m/Y') : 'Non renseigné' }}
                            </dd>
                        </div>
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Rôle</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.roleBadge }}
                            </dd>
                        </div>
                    </dl>
                {% endblock %}
            {% endembed %}

            {# Informations de contact #}
            {% embed 'components/_card.html.twig' %}
                {% block card_title %}Contact{% endblock %}
                {% block card_content %}
                    <dl class="divide-y divide-gray-200">
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Téléphone</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2 flex items-center">
                                {{ app.user.telephone ?: 'Non renseigné' }}
                                {% if app.user.telephone and app.user.phoneVerified %}
                                    <svg class="h-4 w-4 ml-2 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                                    </svg>
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                {% endblock %}
            {% endembed %}

            {# Localisation #}
            {% embed 'components/_card.html.twig' %}
                {% block card_title %}Localisation{% endblock %}
                {% block card_content %}
                    <dl class="divide-y divide-gray-200">
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Gouvernorat</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.gouvernant ?: 'Non renseigné' }}
                            </dd>
                        </div>
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Ville</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.ville ?: 'Non renseigné' }}
                            </dd>
                        </div>
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Code postal</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.codePostale ?: 'Non renseigné' }}
                            </dd>
                        </div>
                    </dl>
                {% endblock %}
            {% endembed %}

            {# Section spécifique Agriculteur #}
            {% if app.user.isAgriculteur or app.user.isAgriPlus %}
            {% embed 'components/_card.html.twig' %}
                {% block card_title %}
                    <span class="flex items-center">
                        <svg class="h-5 w-5 mr-2 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                        Informations agriculteur
                    </span>
                {% endblock %}
                {% block card_content %}
                    <dl class="divide-y divide-gray-200">
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Années d'expérience</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {% if app.user.agriculteurExpAnnee is not null %}
                                    {{ app.user.agriculteurExpAnnee }} an{% if app.user.agriculteurExpAnnee > 1 %}s{% endif %}
                                {% else %}
                                    Non renseigné
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                {% endblock %}
            {% endembed %}
            {% endif %}

            {# Section spécifique AgriPlus #}
            {% if app.user.isAgriPlus %}
            {% embed 'components/_card.html.twig' %}
                {% block card_title %}
                    <span class="flex items-center">
                        <svg class="h-5 w-5 mr-2 text-yellow-500" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                        Abonnement AgriPlus
                    </span>
                {% endblock %}
                {% block card_content %}
                    <dl class="divide-y divide-gray-200">
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Plan d'abonnement</dt>
                            <dd class="mt-1 text-sm sm:mt-0 sm:col-span-2">
                                {% set planColors = {
                                    'BASIC': 'bg-blue-100 text-blue-800',
                                    'PREMIUM': 'bg-purple-100 text-purple-800',
                                    'ENTERPRISE': 'bg-yellow-100 text-yellow-800'
                                } %}
                                {% set planLabels = {
                                    'BASIC': 'Basic',
                                    'PREMIUM': 'Premium',
                                    'ENTERPRISE': 'Enterprise'
                                } %}
                                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium {{ planColors[app.user.agriplusAbonnement] ?? 'bg-gray-100 text-gray-800' }}">
                                    {{ planLabels[app.user.agriplusAbonnement] ?? app.user.agriplusAbonnement ?? 'Non défini' }}
                                </span>
                            </dd>
                        </div>
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Date d'expiration</dt>
                            <dd class="mt-1 text-sm sm:mt-0 sm:col-span-2">
                                {% if app.user.agriplusDateExpiration %}
                                    {% if app.user.hasValidAgriplusSubscription %}
                                        <span class="text-green-600">{{ app.user.agriplusDateExpiration|date('d/m/Y') }}</span>
                                        <span class="text-gray-500 ml-2">(Actif)</span>
                                    {% else %}
                                        <span class="text-red-600">{{ app.user.agriplusDateExpiration|date('d/m/Y') }}</span>
                                        <span class="text-red-500 ml-2">(Expiré)</span>
                                    {% endif %}
                                {% else %}
                                    <span class="text-gray-500">Non définie</span>
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                {% endblock %}
            {% endembed %}
            {% endif %}

            {# Section spécifique Fournisseur #}
            {% if app.user.isFournisseur %}
            {% embed 'components/_card.html.twig' %}
                {% block card_title %}
                    <span class="flex items-center">
                        <svg class="h-5 w-5 mr-2 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                        </svg>
                        Informations fournisseur
                    </span>
                {% endblock %}
                {% block card_content %}
                    <dl class="divide-y divide-gray-200">
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Type de fournisseur</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {% if app.user.fournisseurTypeFournisseur == 'PERSONNE' %}
                                    Personne physique
                                {% elseif app.user.fournisseurTypeFournisseur == 'SOCIETE' %}
                                    Société
                                {% else %}
                                    Non renseigné
                                {% endif %}
                            </dd>
                        </div>

                        {# Champs Personne Physique #}
                        {% if app.user.fournisseurTypeFournisseur == 'PERSONNE' %}
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">CIN</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.fournisseurCin ?: 'Non renseigné' }}
                                <span class="ml-2 text-xs text-gray-400">(Non modifiable)</span>
                            </dd>
                        </div>
                        {% endif %}

                        {# Champs Société #}
                        {% if app.user.fournisseurTypeFournisseur == 'SOCIETE' %}
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Raison sociale</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.fournisseurRaisonSocial ?: 'Non renseigné' }}
                            </dd>
                        </div>
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">N° Registre de commerce</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.fournisseurNumRegistre ?: 'Non renseigné' }}
                                <span class="ml-2 text-xs text-gray-400">(Non modifiable)</span>
                            </dd>
                        </div>
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Forme juridique</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {{ app.user.fournisseurFormeJuridique ?: 'Non renseigné' }}
                            </dd>
                        </div>
                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Capital social</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {% if app.user.fournisseurCapital %}
                                    {{ app.user.fournisseurCapital|number_format(2, ',', ' ') }} TND
                                {% else %}
                                    Non renseigné
                                {% endif %}
                            </dd>
                        </div>
                        {% endif %}

                        <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4">
                            <dt class="text-sm font-medium text-gray-500">Certifications</dt>
                            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
                                {% if app.user.fournisseurCertifications %}
                                    <div class="whitespace-pre-line">{{ app.user.fournisseurCertifications }}</div>
                                {% else %}
                                    <span class="text-gray-400">Aucune certification renseignée</span>
                                {% endif %}
                            </dd>
                        </div>
                    </dl>
                {% endblock %}
            {% endembed %}
            {% endif %}

            {# Dernière mise à jour #}
            <div class="text-sm text-gray-500 text-right">
                Dernière mise à jour : {{ app.user.updatedAt ? app.user.updatedAt|date('d/m/Y à H:i') : 'N/A' }}
            </div>
        </div>
    </div>
{% endblock %}
